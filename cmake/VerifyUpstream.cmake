foreach(required UPSTREAM_DIR PATCH_DIR GENERATION_FILE EXPECTED_REVISION)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing upstream verification argument: ${required}")
    endif()
endforeach()
find_program(git_program git REQUIRED)
execute_process(COMMAND "${git_program}" -C "${UPSTREAM_DIR}" rev-parse HEAD
    RESULT_VARIABLE status OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR NOT revision STREQUAL EXPECTED_REVISION)
    message(FATAL_ERROR "Upstream revision changed since game generation")
endif()
file(READ "${GENERATION_FILE}" generation)
string(JSON patch_count LENGTH "${generation}" patches)
file(GLOB actual_patches RELATIVE "${PATCH_DIR}" "${PATCH_DIR}/*.patch")
set(expected_patches)
if(patch_count GREATER 0)
    math(EXPR last_patch "${patch_count} - 1")
    foreach(index RANGE ${last_patch})
        string(JSON name MEMBER "${generation}" patches ${index})
        if(NOT name MATCHES "^[a-zA-Z0-9_.-]+\\.patch$")
            message(FATAL_ERROR "Invalid upstream patch name in generation.json")
        endif()
        string(JSON expected GET "${generation}" patches "${name}")
        if(NOT EXISTS "${PATCH_DIR}/${name}")
            message(FATAL_ERROR "Missing generation patch: ${name}")
        endif()
        file(SHA256 "${PATCH_DIR}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Upstream patch changed since generation: ${name}")
        endif()
        list(APPEND expected_patches "${name}")
    endforeach()
endif()
list(SORT actual_patches)
list(SORT expected_patches)
if(NOT expected_patches STREQUAL actual_patches)
    message(FATAL_ERROR "The generated corpus does not identify exactly the current patch set")
endif()
# The following build command runs tools/verify_upstream.py, which constructs
# the complete expected tree in a temporary index and compares every input.
# Individual reverse-apply checks are insufficient for overlapping patch stacks.
message(STATUS "Verified pinned upstream and ${patch_count} required patch digests")
