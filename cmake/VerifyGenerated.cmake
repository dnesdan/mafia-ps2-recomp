if(NOT DEFINED GENERATED_DIR OR NOT DEFINED EXPECTED_MANIFEST_SHA256)
    message(FATAL_ERROR "Generated directory and source manifest digest are required")
endif()
set(manifest "${GENERATED_DIR}/sources.sha256")
if(NOT EXISTS "${manifest}" OR IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "Missing generated source integrity manifest: ${manifest}")
endif()
file(SHA256 "${manifest}" manifest_digest)
if(NOT manifest_digest STREQUAL EXPECTED_MANIFEST_SHA256)
    message(FATAL_ERROR "Generated source integrity manifest changed; regenerate and reconfigure")
endif()
file(STRINGS "${manifest}" entries ENCODING UTF-8)
set(listed_sources)
foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^([0-9a-f]+)  ([a-zA-Z0-9_.+-]+\\.(cpp|h|hpp))$")
        message(FATAL_ERROR "Invalid generated source integrity entry")
    endif()
    set(expected "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    string(LENGTH "${expected}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT EXISTS "${GENERATED_DIR}/${name}" OR IS_SYMLINK "${GENERATED_DIR}/${name}")
        message(FATAL_ERROR "Invalid or missing generated input: ${name}")
    endif()
    file(SHA256 "${GENERATED_DIR}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Generated source changed since analysis: ${name}")
    endif()
    list(APPEND listed_sources "${name}")
endforeach()
file(GLOB actual_sources RELATIVE "${GENERATED_DIR}" "${GENERATED_DIR}/*.cpp" "${GENERATED_DIR}/*.h" "${GENERATED_DIR}/*.hpp")
list(SORT listed_sources)
list(SORT actual_sources)
if(NOT listed_sources STREQUAL actual_sources)
    message(FATAL_ERROR "Generated source manifest does not exactly cover the source/header set")
endif()
list(LENGTH listed_sources source_count)
message(STATUS "Verified ${source_count} generated source/header hashes")
