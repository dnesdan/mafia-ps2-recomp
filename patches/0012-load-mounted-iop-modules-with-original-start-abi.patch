+    IopFileReadResult IopModuleLoader::readTranslatedHostFile(IopHost &host, std::string_view hostPath,
+                                                             size_t maximumBytes, std::vector<uint8_t> &bytes)
+    {
+        bytes.clear();
+        if (hostPath.empty() || hostPath.find('\0') != std::string_view::npos || maximumBytes == 0u)
+            return IopFileReadResult::NotFound;
+        const uint64_t handle = host.openHostFile(hostPath);
+        if (handle == 0u)
+            return IopFileReadResult::NotFound;
+        struct CloseFile
+        {
+            IopHost &host;
+            uint64_t handle;
+            ~CloseFile() noexcept { try { host.closeHostFile(handle); } catch (...) {} }
+        } close{host, handle};
+
+        uint64_t size = 0u;
+        if (!host.hostFileSize(handle, size) || size == 0u || size > maximumBytes)
+            return IopFileReadResult::InvalidSize;
+        std::vector<uint8_t> contents(static_cast<size_t>(size));
+        size_t bytesRead = 0u;
+        if (!host.readHostFile(handle, 0u, contents.data(), contents.size(), bytesRead) || bytesRead != contents.size())
+            return IopFileReadResult::ReadFailure;
+        bytes = std::move(contents);
+        return IopFileReadResult::Success;
+    }
