+int main()
+{
+    const iop_test::Test tests[] = {
+        {"modeled MODLOAD mounted devices and aliases", mountedDevicesAndAliases},
+        {"modeled MODLOAD rejects illegal devices and paths", illegalDevicesAndPaths},
+        {"modeled MODLOAD requires mount and translation", absentMountOrTranslation},
+        {"modeled MODLOAD bounds original guest strings", boundedGuestStrings},
+    };
+    return iop_test::run(tests);
+}
