+        {
+            PolicyHost host;
+            require(evaluate(host, path) != 0u, "unsupported or malformed boot path was approved");
+            require(host.translations == 0u, "invalid path reached the mounted-device translator");
+        }
+    }
+
+    void absentMountOrTranslation()
+    {
+        for (const std::string_view path : {"cdrom0:CHILD.IRX;1", "host:CHILD.IRX", "mc0:CHILD.IRX"})
+        {
+            PolicyHost absentMount;
+            absentMount.mounted = false;
+            require(evaluate(absentMount, path) != 0u && absentMount.translations == 0u,
+                    "unmounted path fell back to a raw host path");
+            PolicyHost absentTranslation;
+            absentTranslation.translated = false;
+            require(evaluate(absentTranslation, path) != 0u && absentTranslation.translations == 1u,
+                    "missing translation approved an unavailable path");
+            PolicyHost invalidTranslation;
+            invalidTranslation.invalidTranslation = true;
+            require(evaluate(invalidTranslation, path) != 0u && invalidTranslation.translations == 1u,
+                    "NUL-containing host translation was accepted");
+        }
+    }
+
+    void boundedGuestStrings()
+    {
+        for (const uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            PolicyHost host;
+            IopEmulator iop(host);
+            const std::string path = "cdrom0:LAST.IRX;1";
+            const uint32_t address = 0x200000u - static_cast<uint32_t>(path.size() + 1u);
+            require(iop.writeMemory(address, path.c_str(), path.size() + 1u), "could not install exact-end path");
+            auto image = policyEntry(address | alias, {});
+            require(iop.loadModuleImage("authored-boundary", image.bytes, nullptr, 0u).moduleId > 0 &&
+                        word(iop, kResult) == 0u, "bounded exact-end alias path was rejected");
+            noFileOperation(host);
+        }
+        for (const uint32_t address : {0u, 0x8000u, 0xBF801000u, 0xBFFFFFFFu})
+        {
+            PolicyHost host;
+            IopEmulator iop(host);
+            const auto image = policyEntry(address, {});
+            bool failed = false;
+            try { (void)iop.loadModuleImage("authored-invalid-pointer", image.bytes, nullptr, 0u); }
+            catch (const std::runtime_error &error)
+            {
+                failed = std::string_view(error.what()).find("MODLOAD: path") != std::string_view::npos;
+            }
+            require(failed && word(iop, kResult) == kCanary && host.translations == 0u,
+                    "invalid path pointer produced a policy result or reached the translator");
+            noFileOperation(host);
+        }
+        for (const bool atRamEnd : {false, true})
+        {
+            PolicyHost host;
+            IopEmulator iop(host);
+            auto image = policyEntry(atRamEnd ? 0xA01FFFFFu : kPath, std::string(1025u, 'x'));
+            if (atRamEnd)
+            {
+                const uint8_t byte = 'x';
+                require(iop.writeMemory(0x1FFFFFu, &byte, 1u), "could not install unterminated end byte");
+            }
+            bool failed = false;
+            try { (void)iop.loadModuleImage("authored-unterminated", image.bytes, nullptr, 0u); }
+            catch (const std::runtime_error &error)
+            {
+                failed = std::string_view(error.what()).find("MODLOAD: path") != std::string_view::npos;
+            }
+            require(failed && host.translations == 0u && word(iop, kResult) == kCanary,
+                    "overlong or RAM-wrapping path escaped string preflight");
+            noFileOperation(host);
+        }
+    }
+}
