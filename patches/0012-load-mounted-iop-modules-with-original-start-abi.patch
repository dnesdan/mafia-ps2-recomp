+    constexpr uint32_t kPath = 0x10200u;
+    constexpr uint32_t kResult = 0x10C00u;
+    constexpr uint32_t kCanary = 0xA5A5A5A5u;
+
+    iop_test::Irx policyEntry(uint32_t pathAddress, std::string_view path)
+    {
+        iop_test::Irx image(0x10000u, 0x1000u);
+        // Authored caller saves its real return address, calls import 15 and
+        // records that import's result before returning resident from _start.
+        image.words(0u, {
+            0x27BDFFE0u, 0xAFBF001Cu,
+            0x3C040000u | (pathAddress >> 16u), 0x34840000u | (pathAddress & 0xFFFFu),
+            0x0C004025u, 0u, // jal 0x10094: modload:15
+            0x3C080001u, 0x35080C00u, 0xAD020000u,
+            0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x24020000u,
+        });
+        image.words(0x80u, {
+            0x41E00000u, 0u, 0x0106u, 0x6C646F6Du, 0x0064616Fu,
+            0x03E00008u, 0x2400000Fu, 0u, 0u,
+        });
+        require(path.size() < 0x900u, "authored path overlaps result storage");
+        std::copy(path.begin(), path.end(), image.bytes.begin() + 0x300u);
+        image.words(0xC00u, {kCanary});
+        return image;
+    }
+
+    uint32_t word(IopEmulator &iop, uint32_t address)
+    {
+        std::array<uint8_t, 4u> bytes{};
+        require(iop.readMemory(address, bytes.data(), bytes.size()), "authored result is outside IOP RAM");
+        return uint32_t(bytes[0u]) | (uint32_t(bytes[1u]) << 8u) |
+               (uint32_t(bytes[2u]) << 16u) | (uint32_t(bytes[3u]) << 24u);
+    }
+
+    void noFileOperation(const PolicyHost &host)
+    {
+        require(host.opens == 0u && host.sizeCalls == 0u && host.reads == 0u && host.closes == 0u,
+                "device policy opened or inspected a host file");
+    }
+
+    uint32_t evaluate(PolicyHost &host, std::string_view path, uint32_t alias = 0u)
+    {
+        IopEmulator iop(host);
+        const auto image = policyEntry(kPath | alias, path);
+        const auto loaded = iop.loadModuleImage("authored-policy", image.bytes, nullptr, 0u);
+        require(loaded.moduleId > 0 && loaded.startResult == 0, "authored policy caller did not return");
+        iop.checkExecutionFailure();
+        noFileOperation(host);
+        return word(iop, kResult);
+    }
+
+    void mountedDevicesAndAliases()
+    {
+        for (const std::string_view path : {
+                 "cdrom0:\\MODULES\\CHILD.IRX;1", "CdRoM:Folder/Child.irx;27",
+                 "host0:modules/child.irx", "host:modules/child with space.irx",
+                 "mc0:/MODULES/child.irx"})
+        {
+            for (const uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+            {
+                PolicyHost host;
+                require(evaluate(host, path, alias) == 0u, "mapped supported device was rejected");
+                require(host.translations == 1u && host.translatedGuest == path,
+                        "policy changed path spelling or translated more than once");
+            }
+        }
+    }
