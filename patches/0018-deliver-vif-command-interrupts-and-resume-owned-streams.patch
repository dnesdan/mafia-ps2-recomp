+    constexpr uint32_t IntcMask = 0x1000F010u;
+    constexpr uint32_t Interrupt = 1u << 11u;
+    constexpr uint32_t InterruptStall = 1u << 10u;
+    constexpr uint32_t Stalls = 7u << 8u;
+
+    inline VIFRegisters &registers(PS2Memory &memory, unsigned unit)
+    {
+        return unit ? memory.vif1_regs : memory.vif0_regs;
+    }
+
+    inline auto &pending(PS2Memory &memory, unsigned unit)
+    {
+        return unit ? memory.m_pendingVif1Transfers : memory.m_pendingVif0Transfers;
+    }
+
+    inline size_t pendingBytes(PS2Memory &memory, unsigned unit)
+    {
+        size_t bytes = 0;
+        for (const auto &transfer : pending(memory, unit))
+            bytes += transfer.chainData.empty() ? size_t(transfer.qwc) * 16u : transfer.chainData.size();
+        return bytes;
+    }
+
+    inline void updateFifoCount(PS2Memory &memory, unsigned unit)
+    {
+        auto &regs = registers(memory, unit);
+        const size_t capacityQwc = unit ? 16u : 8u;
+        const bool activeDma = (memory.m_ioRegisters[unit ? 0x10009000u : 0x10008000u] & 0x100u) != 0u;
+        // Retained decoder input is not a hardware FIFO byte counter. Console
+        // intstall tests report FQC=0 after a short DMA completes with VIS set.
+        // This untimed model reports a full FIFO only while a larger DMA is
+        // backpressured; it does not expose the owned decoder tail as FIFO data.
+        const uint32_t qwords = activeDma && (regs.stat & Stalls) && pendingBytes(memory, unit) > capacityQwc * 16u
+                                    ? static_cast<uint32_t>(capacityQwc) : 0u;
+        regs.stat = (regs.stat & ~0x1F000000u) | (qwords << 24u);
+    }
+
+    inline void defer(PS2Memory &memory, unsigned unit, const uint8_t *data, uint32_t bytes)
+    {
+        if (bytes)
+        {
+            PS2Memory::PendingTransfer transfer;
+            transfer.chainData.assign(data, data + bytes);
+            pending(memory, unit).push_back(std::move(transfer));
+        }
+        auto &regs = registers(memory, unit);
+        if ((regs.stat & InterruptStall) && pendingBytes(memory, unit) >= 4u)
+            regs.stat = (regs.stat & ~3u) | 2u; // VPS: decoder held by I-bit, including split input.
+        updateFifoCount(memory, unit);
+    }
+
+    inline void cancelDma(PS2Memory &memory, unsigned unit)
+    {
+        const size_t capacityBytes = unit ? 256u : 128u;
+        if (pendingBytes(memory, unit) <= capacityBytes)
+            return;
+        // The untimed DMA staging queue also owns bytes held outside the full
+        // FIFO. Cancelling CHCR must discard that untransferred suffix, while
+        // preserving the prefetched FIFO prefix until VIF consumes or resets it.
+        PS2Memory::PendingTransfer fifo;
+        fifo.chainData.reserve(capacityBytes);
+        auto &queue = pending(memory, unit);
+        for (const auto &transfer : queue)
+        {
+            if (transfer.qwc)
+                throw std::runtime_error("VIF DMA cancellation reached an unstaged source");
+            const size_t take = std::min(capacityBytes - fifo.chainData.size(), transfer.chainData.size());
+            fifo.chainData.insert(fifo.chainData.end(), transfer.chainData.begin(), transfer.chainData.begin() + take);
+            if (fifo.chainData.size() == capacityBytes)
+                break;
+        }
+        queue.clear();
+        queue.push_back(std::move(fifo));
+    }
+
+    inline void joinDeferred(PS2Memory &memory, unsigned unit,
+                             const uint8_t *&data, uint32_t &bytes, std::vector<uint8_t> &storage)
+    {
+        auto &queue = pending(memory, unit);
+        if (queue.empty())
+            return;
+        const size_t previous = pendingBytes(memory, unit);
+        if (previous > std::numeric_limits<uint32_t>::max() - bytes)
+            throw std::runtime_error("VIF deferred input exceeds the stream size limit");
+        storage.reserve(previous + bytes);
+        for (const auto &transfer : queue)
+        {
+            // DMA source descriptors are removed by processPendingTransfers
+            // before it enters the decoder. Only retained stream bytes belong here.
+            if (transfer.qwc || transfer.chainData.empty())
+                throw std::runtime_error("VIF decoder entered with an undrained DMA source");
+            storage.insert(storage.end(), transfer.chainData.begin(), transfer.chainData.end());
+        }
+        if (bytes)
+            storage.insert(storage.end(), data, data + bytes);
+        queue.clear();
+        data = storage.data();
+        bytes = static_cast<uint32_t>(storage.size());
+        updateFifoCount(memory, unit);
+    }
+
+    inline void completeInterrupt(PS2Memory &memory, unsigned unit, uint8_t opcode)
+    {
+        auto &regs = registers(memory, unit);
+        // Hardware intstall tests show MARK.I sets INT without VIS and lets
+        // subsequent commands execute. Other I-bit commands stall the stream.
+        // See ps2autotests tests/dma/vif/intstall.{cpp,expected}; the manual's
+        // repeated following-MARK wording is ambiguous for this command.
+        regs.stat |= Interrupt;
+        if (opcode != 0x07u)
+            regs.stat |= InterruptStall;
+        memory.m_ioRegisters[IntcStat] |= 1u << (4u + unit);
+    }
+
+    // Required data after one supported command. Waiting for a split payload
+    // must not execute its effects or deliver its I-bit interrupt early.
+    inline std::optional<uint32_t> payloadBytes(const VIFRegisters &regs, uint32_t command, unsigned unit)
+    {
+        const uint8_t opcode = (command >> 24u) & 0x7Fu;
+        const uint32_t count = ((command >> 16u) & 0xFFu) ? ((command >> 16u) & 0xFFu) : 256u;
+        switch (opcode)
+        {
+        case 0x00: case 0x01: case 0x04: case 0x05: case 0x07:
+        case 0x10: case 0x11: case 0x13:
+            return 0u;
+        case 0x02: case 0x03: case 0x06: case 0x14: case 0x15: case 0x17:
+            return unit ? std::optional<uint32_t>(0u) : std::nullopt;
+        case 0x20:
+            return 4u;
+        case 0x30: case 0x31:
+            return 16u;
+        case 0x4A:
+            return count * 8u;
+        case 0x50: case 0x51:
+            return unit ? std::optional<uint32_t>(((command & 0xFFFFu) ? (command & 0xFFFFu) : 65536u) * 16u)
+                        : std::nullopt;
+        default:
+            if ((opcode & 0x60u) != 0x60u)
+                return std::nullopt;
+            const uint32_t vn = (opcode >> 2u) & 3u;
+            const uint32_t vl = opcode & 3u;
+            const uint32_t bits = vl == 0u ? 32u : vl == 1u ? 16u : vl == 2u ? 8u : 16u;
+            const uint32_t vectorBytes = vl == 3u && vn == 3u ? 2u : (vn + 1u) * bits / 8u;
+            const uint32_t cl = std::max(1u, regs.cycle & 0xFFu);
+            const uint32_t wl = std::max(1u, (regs.cycle >> 8u) & 0xFFu);
+            const uint32_t sourceVectors = cl < wl ? (count / wl) * cl + std::min(count % wl, cl) : count;
+            return (sourceVectors * vectorBytes + 3u) & ~3u;
+        }
+    }
+}
