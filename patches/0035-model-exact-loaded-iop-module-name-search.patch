+        int32_t searchModuleByNameFromRam(uint32_t nameAddress) const
+        {
+            // Reuse the bounded, owned-RAM string reader without any path
+            // translation or normalization. PS2SDK MODLOAD compares exact
+            // names and selects the greatest matching loaded module ID.
+            // https://ps2dev.github.io/ps2sdk/modload_8c_source.html#l00583
+            const std::string name = modulePathFromRam(nameAddress);
+            int32_t found = -202; // KE_UNKNOWN_MODULE.
+            for (const auto &[id, module] : modules)
+                if (module.name == name && id > found)
+                    found = id;
+            // Strict IRXs store the declared IOPMOD name here. Metadata-less
+            // images retain the loader's existing ModuleInfo filename fallback.
+            return found;
+        }
