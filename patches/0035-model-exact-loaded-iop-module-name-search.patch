                 case 15u:
                     setV0(mountedModulePath(modulePathFromRam(a0)).empty() ? 1u : 0u);
                     return ImportDisposition::Handled;
+                case 22u: // SearchModuleByName(const char *name), MODLOAD 1.x.
+                    if ((call.version >> 8u) != 1u ||
+                        imports.resolve(call.library, call.ordinal, call.version) != 0u)
+                        break;
+                    setV0(static_cast<uint32_t>(searchModuleByNameFromRam(a0)));
