+
+    void rawOwnerAndHostReentryStayExplicit()
+    {
+        Fixture f;
+        require(f.read() == 1u && f.call(39u) == 1u, "raw-owner abort setup failed");
+        IopCpuState cpu{}; cpu.gpr[4] = 2u; cpu.gpr[5] = 1u; cpu.gpr[6] = 0x3600u;
+        require(f.intrman.dispatchImport(4u, cpu, f.executor), "IRQ owner setup failed");
+        const uint64_t due = f.deadline();
+        iop_vblank_test::rejects([&] { f.due(due); }, "supplied raw IRQ2 owner");
+        require(f.host.reads == 0u && f.executor.calls.empty() && f.call(11u, 1u) == 1u,
+                "abort bypassed the supplied IRQ owner or published canceled bytes");
+        require(f.intrman.dispatchImport(5u, cpu, f.executor), "IRQ owner release failed");
+        f.due(due);
+        require(f.executor.calls.size() == 1u, "ownership rejection consumed the pending abort");
+
+        Fixture host;
+        require(host.read() == 1u, "host-reentry setup failed");
+        host.host.onRead = [&]
+        {
+            iop_vblank_test::rejects([&] { (void)host.call(39u); }, "break during host I/O is unsupported");
+            require(host.call(8u) == 0u && poll(host, 1u) == -418,
+                    "unsupported host reentry changed the active driver's error or event");
+        };
+        host.due(host.deadline()); host.matches();
+        require(host.host.reads == 1u && host.executor.calls.size() == 1u && host.call(8u) == 0u,
+                "rejected host reentry corrupted the continuing read");
+    }
+
+    iop_vblank_test::Program program(uint16_t requested = 0x0101u, uint16_t provided = 0u, bool masked = false)
+    {
+        iop_vblank_test::Program p;
+        p.imports(0x1000u, "cdvdman", {114u, 49u, 50u, 39u, 37u, 11u});
+        p.image.words(0x1008u, {requested}); p.image.words(0x2020u, {0u});
+        p.begin();
+        if (provided)
+        {
+            p.image.words(0x1800u, {0x41C00000u, 0u, provided, 0x64766463u, 0x006E616Du});
+            for (uint32_t i = 0; i <= 39u; ++i) p.image.words(0x1814u + i * 4u, {p.base + 0xA00u});
+            p.constant(4u, p.base + 0x1800u); p.call(p.stub(0x1500u));
+        }
+        else
+        {
+            p.constant(28u, 0x11223344u); p.constant(4u, p.base + 0x800u); p.call(p.stub(0x1000u, 1u));
+            p.constant(28u, 0xAABBCCDDu); p.constant(4u, p.base + 0x900u); p.call(p.stub(0x1000u, 4u));
+            p.constant(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1000u, 2u));
+            if (masked)
+            {
+                p.constant(4u, p.data(0x70u)); p.call(p.stub(0x1100u));
+                p.constant(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1100u, 4u));
+            }
+            p.constant(4u, 1u); p.constant(5u, 2u); p.constant(6u, 0x30000u); p.constant(7u, p.data(0x20u));
+            p.call(p.stub(0x1000u)); p.store(2u, p.data(0x40u));
+        }
+        p.constant(28u, 0x55667788u);
+        p.constant(4u, UINT32_MAX); p.constant(5u, UINT32_MAX);
+        p.call(p.stub(0x1000u, 3u)); p.store(2u, p.data(0x44u)); p.store(28u, p.data(0x48u)); p.finish();
+        p.recordingHandler(0x800u, 0u); p.recordingHandler(0x900u, 0u);
+        p.begin(0xA00u); p.constant(8u, 0xABCDEF01u); p.store(8u, p.data()); p.finish(0x5A3u);
+        return p;
+    }
+
+    void authoredMipsAbortAndProviderPrecedence()
+    {
+        DiscHost host; IopEmulator iop(host); const auto p = program();
+        const std::vector<uint8_t> canary(4096u, 0xCCu);
+        require(iop.writeMemory(0x30000u, canary.data(), canary.size()), "MIPS buffer setup failed");
+        iop_vblank_test::start(iop, p); iop_vblank_test::advance(iop, 5000u);
+        std::vector<uint8_t> after(canary.size());
+        require(iop.readMemory(0x30000u, after.data(), after.size()) && after == canary && host.reads == 0u &&
+                    iop_vblank_test::word(iop, p.data(0x40u)) == 1u && iop_vblank_test::word(iop, p.data(0x44u)) == 1u &&
+                    iop_vblank_test::word(iop, p.data(0x48u)) == 0x55667788u && iop_vblank_test::word(iop, p.data()) == 2u &&
+                    iop_vblank_test::word(iop, p.data(0x100u)) == 1u && iop_vblank_test::word(iop, p.data(0x104u)) == 0x11223344u &&
+                    iop_vblank_test::word(iop, p.data(0x108u)) == 1u && iop_vblank_test::word(iop, p.data(0x110u)) == 8u &&
+                    iop_vblank_test::word(iop, p.data(0x114u)) == 0xAABBCCDDu && iop_vblank_test::word(iop, p.data(0x118u)) == 1u,
+                "MIPS cancellation lost the byte bounds, original continuation, ordered reasons, GP or IRQ context");
+        for (const auto [provided, requested] : {std::pair<uint16_t, uint16_t>{0x0101u, 0x0101u},
+                                                {0x0106u, 0x0101u}, {0x0201u, 0x0201u}})
+        {
+            DiscHost h; IopEmulator provider(h); const auto fixture = program(requested, provided);
+            iop_vblank_test::start(provider, fixture);
+            require(iop_vblank_test::word(provider, fixture.data()) == 0xABCDEF01u &&
+                        iop_vblank_test::word(provider, fixture.data(0x44u)) == 0x5A3u && h.reads == 0u,
+                    "modeled abort shadowed a compatible supplied export");
+        }
+        DiscHost h; IopEmulator missing(h); const auto badVersion = program(0x0201u, 0x0101u);
+        iop_vblank_test::rejects([&] { iop_vblank_test::start(missing, badVersion); }, "missing import cdvdman:39");
+    }
+
+    void authoredMaskedResetAndStickyCallbackFault()
+    {
+        for (const bool reset : {false, true})
+        {
+            DiscHost host; IopEmulator iop(host); const auto p = program(0x0101u, 0u, true);
+            const std::vector<uint8_t> canary(4096u, 0xCCu);
+            require(iop.writeMemory(0x30000u, canary.data(), canary.size()), "masked MIPS buffer setup failed");
+            iop_vblank_test::start(iop, p); iop_vblank_test::advance(iop, 5000u);
+            require(host.reads == 0u && iop_vblank_test::word(iop, p.data()) == 0u, "masked abort invoked original callbacks");
+            if (reset)
+            {
+                iop.reset(); iop_vblank_test::advance(iop, 10000u);
+                require(host.reads == 0u, "full reset resurrected canceled payload");
+            }
+            else
+            {
+                iop_vblank_test::Program resume(0x20000u); resume.begin();
+                resume.load(8u, 0xBF801074u); resume.emit(0x35080004u); resume.store(8u, 0xBF801074u);
+                resume.constant(4u, 1u); resume.call(resume.stub(0x1100u, 1u)); resume.finish();
+                iop_vblank_test::start(iop, resume); iop_vblank_test::advance(iop, 1000u);
+                require(iop_vblank_test::word(iop, p.data()) == 2u, "real I_MASK/CPU resume lost pending abort completion");
+            }
+        }
+        DiscHost host; IopEmulator iop(host); auto p = program();
+        p.begin(0x800u); p.call(p.stub(0x1400u)); p.finish();
+        const std::vector<uint8_t> canary(4096u, 0xCCu);
+        require(iop.writeMemory(0x30000u, canary.data(), canary.size()), "fault fixture failed");
+        iop_vblank_test::start(iop, p);
+        iop_vblank_test::rejects([&] { iop_vblank_test::advance(iop, 5000u); }, "missing import absent:42");
+        const uint64_t instructions = iop.instructions(); iop.runEeCycles(80000u);
+        iop_vblank_test::rejects([&] { iop.checkExecutionFailure(); }, "missing import absent:42");
+        require(iop.instructions() == instructions && host.reads == 0u && iop_vblank_test::word(iop, p.data()) == 0u,
+                "abort callback failure was swallowed or allowed its user callback to run");
+    }
+}
