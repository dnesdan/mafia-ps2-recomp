diff --git a/ps2xIOP/tests/iop_cdvd_break_fixtures.h b/ps2xIOP/tests/iop_cdvd_break_fixtures.h
new file mode 100644
index 0000000..fc05c15
--- /dev/null
+++ b/ps2xIOP/tests/iop_cdvd_break_fixtures.h
@@ -0,0 +1,373 @@
+#pragma once
+
+#include "iop_cdvd_stream_read_fixtures.h"
+
+namespace iop_cdvd_break_test
+{
+    using namespace iop_stream_read_test;
+
+    int32_t poll(Fixture &f, uint32_t bits)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = static_cast<uint32_t>(f.cdvd.interruptEventFlag());
+        cpu.gpr[5] = bits;
+        require(f.kernel.dispatchEventImport(11u, cpu), "completion event poll unresolved");
+        return static_cast<int32_t>(cpu.gpr[2]);
+    }
+
+    void idleAbortDoesNotInventWork()
+    {
+        Fixture f;
+        require(f.call(37u, 0x3100u, 0u, 0u, 0u, 0xAABBCCDDu) == 0u, "user setup failed");
+        for (unsigned i = 0; i < 2; ++i)
+            require(f.call(39u, UINT32_MAX, UINT32_MAX, UINT32_MAX, UINT32_MAX) == 1u &&
+                        f.call(8u) == 1u && poll(f, 0x29u) == 0 && f.call(11u, 1u) == 0u &&
+                        f.call(50u, uint32_t(-3)) == 0u && f.cdvd.nextEventCycle(UINT64_MAX) == UINT64_MAX,
+                    "idle Break did not set ABRT/event without inventing an active command");
+        f.due(10000u);
+        require(f.executor.calls.empty() && f.host.reads == 0u && f.host.opens == 0u &&
+                    !f.cdvd.takeCompletionCallback() && f.call(37u, 0u) == 0x3100u &&
+                    f.cdvd.registeredStream1Callback().address == 0x3000u && f.call(50u, uint32_t(-1)) == 2u,
+                "idle Break touched media, generated callbacks or stopped the original driver's stream mode");
+        require(f.call(46u) == 1u && f.call(8u) == 0u, "a new command did not clear the old abort error");
+        f.due(f.deadline());
+        require(f.executor.calls.size() == 1u && f.executor.calls[0].argument == 1u,
+                "idle cancellation damaged the next stream callback");
+    }
+
+    void abortBeforeDmaDropsTheBufferLease()
+    {
+        Fixture f;
+        require(f.call(37u, 0x3100u, 0u, 0u, 0u, 0xABCDu) == 0u, "user setup failed");
+        const uint32_t buffer = f.memory.allocate(4096u);
+        require(buffer && f.memory.zeroRam(buffer, 4096u) && f.read(1u, 2u, buffer) == 1u, "leased read setup failed");
+        require(poll(f, 1u) == -418, "read did not clear completion");
+        f.now += 3u;
+        require(f.call(39u) == 1u && f.call(8u) == 1u && poll(f, 0x29u) == 0 &&
+                    f.call(11u, 1u) == 1u && f.call(50u, uint32_t(-3)) == 1u,
+                "Break conflated the signaled event with completed driver work");
+        const uint64_t due = f.deadline();
+        require(f.memory.freeAllocation(buffer) && f.memory.allocate(4096u) == buffer,
+                "cannot reuse canceled DMA destination");
+        f.memory.write32(buffer, 0x12345678u);
+        f.due(due - 1u);
+        require(f.executor.calls.empty() && f.host.reads == 0u, "abort completed synchronously");
+        f.executor.action = [&](const Call &call)
+        {
+            require(call.interrupt && f.call(8u) == 1u && f.call(11u, 1u) == 0u &&
+                        f.call(50u, uint32_t(-3)) == 0u && poll(f, 0x29u) == 0,
+                    "abort callback observed stale driver state or lost interrupt scope");
+        };
+        f.due(due); f.due(due + 5000u);
+        require(f.host.reads == 0u && f.host.opens == 0u && f.memory.read32(buffer) == 0x12345678u &&
+                    f.executor.calls.size() == 2u && f.executor.calls[0].function == 0x3000u &&
+                    f.executor.calls[0].argument == 1u && f.executor.calls[0].gp == 0x12345678u &&
+                    f.executor.calls[1].function == 0x3100u && f.executor.calls[1].argument == 8u &&
+                    f.executor.calls[1].gp == 0xABCDu && !f.intrman.inInterruptContext() &&
+                    !f.cdvd.takeCompletionCallback(),
+                "canceled payload was touched or Break/read callback reasons and order were confused");
+    }
+
+    void repeatedAbortCannotPostponeOrDuplicate()
+    {
+        for (const bool read : {false, true})
+        {
+            Fixture f;
+            require(f.call(37u, 0x3100u) == 0u && (read ? f.read() : f.call(46u)) == 1u && f.call(39u) == 1u,
+                    "repeat setup failed");
+            const uint64_t due = f.deadline();
+            for (unsigned i = 0; i < 8; ++i)
+            {
+                ++f.now;
+                require(f.call(39u) == 1u && f.cdvd.nextEventCycle(UINT64_MAX) == due,
+                        "repeated Break postponed its accepted completion");
+            }
+            require(f.call(46u) == 0u && f.read(0u, 1u, UINT32_MAX, UINT32_MAX) == 0u,
+                    "pending abort allowed a command to steal its slot");
+            f.due(due); f.due(due + 5000u);
+            require(f.executor.calls.size() == 2u && f.executor.calls[1].argument == 8u && f.host.reads == 0u,
+                    "repeated abort or canceled Nop produced duplicate callbacks or I/O");
+        }
+    }
+
+    void maskedAbortAndLiveModeKeepTheirOwnState()
+    {
+        for (unsigned gates = 1; gates <= 3; ++gates)
+        {
+            Fixture f;
+            require(f.call(37u, 0x3100u) == 0u && f.read() == 1u && f.call(39u) == 1u, "masked abort setup failed");
+            if (gates & 1u) f.memory.setInterruptControl(0u);
+            if (gates & 2u) f.memory.setInterruptMask(0u);
+            const uint64_t due = f.deadline();
+            f.due(due + 1000u);
+            require(f.executor.calls.empty() && f.host.reads == 0u && f.call(11u, 1u) == 1u &&
+                        f.cdvd.nextEventCycle(due + 2000u) == due + 2000u,
+                    "masked abort ran its callback, retained an idle spin or lost driver wait");
+            require(f.call(49u, 0x3300u, 0u, 0u, 0u, 0x778899u) == 0u, "live callback replacement failed");
+            f.memory.setInterruptMask(4u);
+            if (gates & 1u)
+            {
+                f.due(due + 1001u);
+                require(f.executor.calls.empty(), "IRQ mask bypassed disabled CPU interrupts");
+            }
+            f.memory.setInterruptControl(1u); f.due(due + 1002u); f.due(due + 1003u);
+            require(f.executor.calls.size() == 2u && f.executor.calls[0].function == 0x3300u &&
+                        f.executor.calls[0].gp == 0x778899u && f.executor.calls[1].argument == 8u,
+                    "pending abort used an old callback slot or fired twice after unmasking");
+        }
+        Fixture stopped;
+        require(stopped.call(37u, 0x3100u) == 0u && stopped.read() == 1u && stopped.call(50u, 0u) == 0u &&
+                    stopped.call(39u) == 1u, "original SC0/Break stop sequence failed");
+        stopped.due(stopped.deadline());
+        require(stopped.executor.calls.size() == 1u && stopped.executor.calls[0].function == 0x3100u &&
+                    stopped.executor.calls[0].argument == 8u && stopped.call(11u, 0u) == 0u &&
+                    stopped.call(11u, 17u) == 0u,
+                "stopped stream was restarted by its old pending callback");
+    }
+
+    void alreadyCopiedPayloadIsNotRolledBackOrRepeated()
+    {
+        Fixture f;
+        require(f.call(37u, 0x3100u) == 0u && f.read() == 1u, "completed payload setup failed");
+        f.memory.setInterruptMask(0u); const uint64_t due = f.deadline();
+        f.due(due); f.matches();
+        require(f.host.reads == 1u && f.executor.calls.empty(), "masked payload setup failed");
+        require(f.call(39u) == 1u && f.call(8u) == 1u && f.call(50u, uint32_t(-3)) == 1u &&
+                    f.cdvd.nextEventCycle(due + 100u) == due + 100u,
+                "Break incorrectly resubmitted already-completed hardware work");
+        f.matches();
+        f.memory.write32(bufferAddress, 0xCAFEBABEu);
+        f.due(due + 1u); f.memory.setInterruptMask(4u); f.due(due + 2u);
+        require(f.host.reads == 1u && f.memory.read32(bufferAddress) == 0xCAFEBABEu &&
+                    f.executor.calls.size() == 2u && f.executor.calls[1].argument == 8u,
+                "abort replayed DMA, undid delivered bytes, or reported a successful read instead of Break");
+    }
+
+    void resetAndNextCommandDoNotInheritAbortState()
+    {
+        Fixture f;
+        require(f.read() == 1u && f.call(39u) == 1u, "reset setup failed");
+        const uint64_t due = f.deadline(); f.cdvd.reset(); f.due(due + 1000u);
+        require(f.executor.calls.empty() && f.host.reads == 0u && f.call(8u) == 0u &&
+                    f.call(50u, uint32_t(-3)) == 0u, "reset retained a canceled request or abort IRQ");
+        require(f.call(49u, 0x3300u) == 0u && f.call(50u, 2u) == 2u && f.read() == 1u,
+                "fresh command failed after reset");
+        f.due(f.deadline()); f.matches();
+        require(f.executor.calls.size() == 1u && f.host.reads == 1u && f.call(8u) == 0u,
+                "new read inherited the old cancellation");
+        require(f.call(37u, 0x3100u) == 0u && f.read() == 1u && f.call(39u) == 1u, "callback reset setup failed");
+        f.executor.action = [&](const Call &) { f.cdvd.reset(); (void)f.call(37u, 0x3500u); };
+        f.due(f.deadline());
+        require(f.executor.calls.size() == 2u, "old abort delivered a user callback into a reset device");
+    }
+
+    void successorReadCannotReceiveAnEarlyUserCallback()
+    {
+        for (const bool abort : {false, true})
+        {
+            Fixture f;
+            require(f.call(37u, 0x3100u) == 0u && f.memory.zeroRam(0x8000u, 4096u) && f.read() == 1u,
+                    "successor setup failed");
+            if (abort) require(f.call(39u) == 1u, "successor abort setup failed");
+            uint64_t second = 0u;
+            f.executor.action = [&](const Call &)
+            {
+                if (f.executor.calls.size() == 1u)
+                {
+                    require(f.read(3u, 2u, 0x8000u) == 1u, "stream callback could not submit a successor");
+                    second = f.deadline();
+                }
+            };
+            f.due(f.deadline());
+            require(f.executor.calls.size() == 1u && f.call(11u, 1u) == 1u,
+                    "user callback fired early after the stream callback submitted another Read2");
+            f.due(second); f.matches(3u, 0x8000u);
+            require(f.executor.calls.size() == 3u && f.executor.calls[1].function == 0x3000u &&
+                        f.executor.calls[2].function == 0x3100u && f.executor.calls[2].argument == 1u &&
+                        f.host.reads == (abort ? 1u : 2u), "successor completion inherited the old callback reason");
+        }
+        Fixture nop;
+        require(nop.call(37u, 0x3100u) == 0u && nop.read() == 1u && nop.call(39u) == 1u, "Nop successor setup failed");
+        uint64_t next = 0u;
+        nop.executor.action = [&](const Call &)
+        {
+            if (nop.executor.calls.size() == 1u)
+            {
+                require(nop.call(46u) == 1u, "stream callback could not submit Nop");
+                next = nop.deadline();
+            }
+        };
+        nop.due(nop.deadline()); nop.due(next);
+        require(nop.executor.calls.size() == 2u && nop.executor.calls.back().function == 0x3000u,
+                "successor Nop inherited the retired abort's user reason");
+    }
+
+    void invalidAbortPreflightPreservesTheOriginalRequest()
+    {
+        Fixture f;
+        require(f.read() == 1u, "overflow setup failed"); const uint64_t due = f.deadline();
+        f.now = UINT64_MAX;
+        iop_vblank_test::rejects([&] { (void)f.call(39u); }, "abort deadline exceeds");
+        require(f.call(8u) == 0u && poll(f, 1u) == -418 && f.cdvd.nextEventCycle(UINT64_MAX) == due,
+                "overflowing abort changed event, error or command ownership");
+        f.due(due); f.matches();
+        Fixture event;
+        require(event.read() == 1u, "deleted-event setup failed");
+        IopCpuState cpu{}; cpu.gpr[4] = static_cast<uint32_t>(event.cdvd.interruptEventFlag());
+        require(event.kernel.dispatchEventImport(5u, cpu) && cpu.gpr[2] == 0u, "event deletion failed");
+        iop_vblank_test::rejects([&] { (void)event.call(39u); }, "event flag was deleted");
+        require(event.call(8u) == 0u && event.host.reads == 0u && event.executor.calls.empty(),
+                "failed abort fabricated a terminal state");
+        Fixture unsupported;
+        require(unsupported.call(50u, 1u) == 1u, "unsupported mode setup failed");
+        cpu = {}; cpu.gpr[2] = 0x12345678u;
+        require(!unsupported.cdvd.dispatchImport(39u, cpu, unsupported.now) && cpu.gpr[2] == 0x12345678u &&
+                    unsupported.call(8u) == 0u, "unmodeled stream0 abort silently succeeded");
+    }
+
