+    void IopRpcBridge::capturePacketDma(IopCpuState &cpu)
+    {
+        constexpr uint32_t kMaxDescriptors = 32u; // SIFMAN's queued tag array
+        constexpr uint32_t kEeRamSize = 32u * 1024u * 1024u;
+        const auto fail = [](const char *cause)
+        {
+            throw std::runtime_error(std::string("Physical IOP packet RPC: callback SIF DMA ") + cause);
+        };
+        const uint32_t descriptorAddress = cpu.gpr[4];
+        const uint32_t count = cpu.gpr[5];
+        if (count == 0u || count > kMaxDescriptors || (descriptorAddress & 3u) != 0u ||
+            !ownedPacketRange(m_memory, descriptorAddress, size_t(count) * 16u))
+            fail("requires a complete aligned owned descriptor array");
+        if (m_packetTransfers->size() > kMaxDescriptors - count)
+            fail("exceeds the bounded ordered descriptor queue");
+
+        size_t totalBytes = 0u;
+        for (const auto &transfer : *m_packetTransfers)
+            totalBytes += transfer.data.size();
+        std::vector<SifEeTransfer> captured;
+        captured.reserve(count);
+        for (uint32_t index = 0u; index < count; ++index)
+        {
+            std::array<uint32_t, 4u> descriptor{};
+            if (!m_memory.readRam(descriptorAddress + index * 16u, descriptor.data(), sizeof(descriptor)))
+                fail("could not read its validated descriptor");
+            const auto [source, destination, size, attributes] = descriptor;
+            // PS2SDK iop/system/sifman/src/sifman.c:sif_dma_setup_tag rounds
+            // source words and EE quadwords. Only complete plain-data qwords
+            // are modeled here; do not invent bytes for partial hardware tags.
+            if (attributes != 0u || size == 0u || (size & 15u) != 0u ||
+                (source & 3u) != 0u || (destination & 15u) != 0u)
+                fail("requires plain aligned complete-quadword data descriptors");
+            if (size > IopMemory::RamSize || !ownedPacketRange(m_memory, source, size))
+                fail("source is outside complete owned IOP RAM");
+            // SIFMAN masks the EE DMA destination with 0x1fffffff. Accept
+            // physical/KSEG0/KSEG1 and the uncached RAM mirror, never MMIO or
+            // an arbitrary segment which happens to mask to a RAM address.
+            const uint32_t segment = destination & 0xE0000000u;
+            const uint32_t physical = destination & 0x1FFFFFFFu;
+            if ((segment != 0u && segment != 0x20000000u &&
+                 segment != 0x80000000u && segment != 0xA0000000u) ||
+                physical >= kEeRamSize || size > kEeRamSize - physical)
+                fail("destination is outside complete EE RAM");
+            if (size > IopMemory::RamSize - totalBytes)
+                fail("exceeds the bounded ordered byte queue");
+            totalBytes += size;
+            SifEeTransfer transfer{physical, std::vector<uint8_t>(size)};
+            if (!m_memory.readRam(source, transfer.data.data(), size))
+                fail("could not snapshot its validated source");
+            captured.push_back(std::move(transfer));
+        }
+        // No host EE access occurs here. Once captured, source ownership has
+        // passed to the transport so DmaStat may report the IOP send complete;
+        // the EE cannot observe RPC completion until these bytes are delivered.
+        m_packetTransfers->reserve(m_packetTransfers->size() + captured.size());
+        for (auto &transfer : captured)
+            m_packetTransfers->push_back(std::move(transfer));
+        cpu.gpr[2] = m_nextDmaId++;
+        if (m_nextDmaId > static_cast<uint32_t>(std::numeric_limits<int32_t>::max()))
+            m_nextDmaId = 1u;
     }
 
