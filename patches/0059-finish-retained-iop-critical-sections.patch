+#pragma once
+#include "iop_vblank_fixtures.h"
+#include "iop_cdvd_sync_fixtures.h"
+
+namespace iop_external_boundary_test
+{
+using namespace iop_vblank_test;
+using namespace ps2x::iop;
+constexpr uint32_t sid = 0x12345678u;
+struct Options
+{
+    bool forever = false, noOwner = false, selfDisable = false;
+    bool replaceServer = false, yield = false, dma = false, log = false;
+};
+
+inline Program program(Options o = {})
+{
+    Program p;
+    p.imports(0x1600u, "sifcmd", {17u});
+    p.imports(0x1700u, "thbase", {24u});
+    p.imports(0x1800u, "stdio", {4u});
+    p.image.words(0x2100u, {0u, 0u, 0u});
+    p.image.words(0x2300u, {0xAABBCCDDu});
+    p.image.words(0x2400u, {0u, 0u, p.base + 0x400u, 0x1000u, 20u});
+    const auto rpc = [&](uint32_t descriptor, uint32_t buffer)
+    {
+        p.constant(4u, descriptor); p.constant(5u, sid);
+        p.constant(6u, p.base + 0x800u); p.constant(7u, buffer);
+        p.emit(0xAFA00010u); p.emit(0xAFA00014u); p.emit(0xAFA00018u);
+        p.call(p.stub(0x1600u));
+    };
+    const auto mark = [&](uint32_t value, uint32_t offset)
+    { p.constant(8u, value); p.store(8u, p.data(offset)); };
+    const auto irq = [&]
+    {
+        p.constant(4u, 0x24u); p.constant(5u, 1u);
+        p.constant(6u, p.base + 0xC00u); p.constant(7u, 0u);
+        p.call(p.stub(0x1100u, 5u));
+        p.constant(4u, 0x24u); p.call(p.stub(0x1100u, 3u));
+    };
+    p.begin();
+    p.constant(4u, p.data(0x100u)); p.call(p.stub(0x1300u));
+    p.store(2u, p.data(0x40u)); rpc(p.data(0x200u), p.data(0x300u));
+    if (o.dma) irq();
+    p.constant(4u, p.base + 0x2400u); p.call(p.stub(0x1200u));
+    p.move(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1200u, 1u));
+    if (o.noOwner) { p.constant(4u, p.data(0x80u)); p.call(p.stub(0x1100u)); }
+    p.finish();
+
+    p.begin(0x400u);
+    p.constant(4u, p.data(0x80u)); p.call(p.stub(0x1100u));
+    if (o.dma)
+    {
+        p.constant(8u, 0x00010001u); p.store(8u, 0xBF8010C4u);
+        p.constant(8u, 0x01000201u); p.store(8u, 0xBF8010C8u);
+    }
+    mark(1u, 0x84u);
+    if (o.log && !o.dma) { p.constant(4u, p.data(0xE0u)); p.call(p.stub(0x1800u)); }
+    if (o.yield) { p.call(p.stub(0x1700u)); }
+    p.constant(8u, o.forever ? 0x7FFFFFFFu : 300u);
+    const uint32_t loop = p.cursor; p.emit(0x2508FFFFu);
+    const uint32_t branch = p.cursor;
+    p.emit(0x15000000u | static_cast<uint16_t>((loop - branch - 4u) / 4u)); p.emit(0u);
+    if (o.replaceServer) rpc(p.data(0x500u), p.data(0x600u));
+    mark(2u, 0x84u); // The owner is about to execute its matching ResumeIntr.
+    p.load(4u, p.data(0x80u)); p.call(p.stub(0x1100u, 1u));
+    if (!o.dma)
+    { p.load(4u, p.data(0x40u)); p.constant(5u, 1u); p.call(p.stub(0x1300u, 1u)); }
+    p.finish();
+
+    p.begin(0x800u);
+    if (o.selfDisable) { p.constant(4u, p.data(0xC0u)); p.call(p.stub(0x1100u)); }
+    p.load(8u, 0xBF801078u); p.store(8u, p.data(0x90u));
+    p.load(8u, p.data(0x84u)); p.store(8u, p.data(0x94u)); mark(1u, 0x98u);
+    p.load(4u, p.data(0x40u)); p.constant(5u, 1u); p.constant(6u, 0u); p.constant(7u, 0u);
+    p.call(p.stub(0x1300u, 2u));
+    p.load(8u, 0xBF801078u); p.store(8u, p.data(0x9Cu)); p.finish(p.data(0xA0u));
+
+    p.begin(0xC00u);
+    p.load(8u, 0xBF801078u); p.store(8u, p.data(0xB0u));
+    p.load(8u, p.data(0x84u)); p.store(8u, p.data(0xB4u));
+    p.load(8u, p.data(0xB8u)); p.emit(0x25080001u); p.store(8u, p.data(0xB8u));
+    if (o.log)
+    {
+        p.constant(4u, p.data(0xC8u)); p.call(p.stub(0x1100u));
+        p.constant(4u, p.data(0xE0u)); p.call(p.stub(0x1800u));
+    }
+    p.load(4u, p.data(0x40u)); p.constant(5u, 1u); p.call(p.stub(0x1300u, 1u)); p.finish();
+    return p;
+}
+
+inline void stopInSection(IopEmulator &iop, const Program &p)
+{
+    for (unsigned i = 0; word(iop, p.data(0x84u)) == 0u && i < 100u; ++i) advance(iop, 1u);
+    require(word(iop, p.data(0x84u)) == 1u, "authored critical section was not reached");
+}
+inline void call(IopEmulator &iop, const Program &p)
+{
+    const auto result = iop.executePacketRpc(sid, p.data(0x200u), 106u, {}, 4u);
+    require(result == std::vector<uint8_t>(4u), "RPC result was not the authored callback result");
+}
+
+inline void entryAndNestedWaitBoundaries()
+{
+    for (bool preEntry : {false, true})
+    {
+        Host host; IopEmulator iop(host); auto p = program(); start(iop, p);
+        if (preEntry) stopInSection(iop, p);
+        call(iop, p);
+        require(word(iop, p.data(0x90u)) == 1u && word(iop, p.data(0x9Cu)) == 1u &&
+            word(iop, p.data(0x94u)) == (preEntry ? 2u : 0u) && word(iop, p.data(0x84u)) == 2u,
+            "external callback entered or resumed inside a retained managed critical section");
+    }
+}
+inline void pendingDmaWaitsForTheOwnersResume()
+{
+    Host host; IopEmulator iop(host); auto p = program({.dma = true}); start(iop, p);
+    stopInSection(iop, p); call(iop, p);
+    require(word(iop, p.data(0xB0u)) == 1u && word(iop, p.data(0xB4u)) == 2u &&
+        word(iop, p.data(0xB8u)) == 1u, "due DMA IRQ ran inside the critical section or was lost/replayed");
+}
+inline void finiteBoundAndLostOwner()
+{
+    for (bool preEntry : {false, true})
+    {
+        Host host; IopEmulator iop(host); auto p = program({.forever = true}); start(iop, p);
+        if (preEntry) stopInSection(iop, p);
+        const auto before = iop.cycles();
+        rejects([&] { call(iop, p); }, "critical-section boundary exhausted its finite budget");
+        require(iop.cycles() - before <= 2'000'000u &&
+            (!preEntry || word(iop, p.data(0x98u)) == 0u) && word(iop, p.data(0x84u)) == 1u,
+            "boundary timeout exceeded its owned cap or fabricated callback/owner completion");
+    }
+    Host host; IopEmulator iop(host); auto p = program({.yield = true}); start(iop, p);
+    stopInSection(iop, p);
+    rejects([&] { call(iop, p); }, "lost its interrupt-disabled running owner");
+    require(word(iop, p.data(0x98u)) == 0u, "sleeping owner allowed a ready peer or packet callback to run");
+}
+inline void noOwnerAndSelfDisabledCallbacksStayRejected()
+{
+    Host host; IopEmulator iop(host); auto p = program({.noOwner = true}); start(iop, p);
+    const auto before = iop.cycles();
+    rejects([&] { call(iop, p); }, "no interrupt-disabled running owner");
+    require(iop.cycles() == before && word(iop, p.data(0x84u)) == 0u && word(iop, p.data(0x98u)) == 0u,
+        "unowned disabled state ran a ready peer or a callback");
+    Host secondHost; IopEmulator second(secondHost); auto own = program({.selfDisable = true}); start(second, own);
+    rejects([&] { call(second, own); }, "external kernel wait requires an interruptible owned invocation");
+    require(word(second, own.data(0x98u)) == 1u && word(second, own.data(0x84u)) == 0u,
+        "self-disabled callback borrowed a managed continuation");
+}
+inline void invalidInitialPacketDoesNotDrainAndChangedServerIsRevalidated()
+{
+    Host host; IopEmulator iop(host); auto p = program({.replaceServer = true}); start(iop, p);
+    stopInSection(iop, p);
+    const auto before = iop.cycles();
+    rejects([&] { (void)iop.executePacketRpc(sid + 1u, p.data(0x200u), 106u, {}, 4u); }, "no registered guest server");
+    require(iop.cycles() == before && word(iop, p.data(0x84u)) == 1u, "invalid initial packet pumped unrelated work");
+    const std::array<uint8_t, 4> input{1u,2u,3u,4u};
+    std::vector<SifEeTransfer> transfers{{0x1000u,{0x5Au}}};
+    rejects([&] { (void)iop.executePacketRpc(sid, p.data(0x200u), 106u, input, 4u, &transfers); }, "does not match its BIND result");
+    require(word(iop, p.data(0x84u)) == 2u && word(iop, p.data(0x98u)) == 0u &&
+        word(iop, p.data(0x300u)) == 0xAABBCCDDu && transfers.size() == 1u && transfers[0].data == std::vector<uint8_t>{0x5Au},
+        "changed server admitted a stale callback, request copy or EE transfer publication");
+}
+
+// Forward normal host behavior, with one explicit reentry point from an
+// authored stdio import. This exercises public API checks in a live CPU/IRQ.
+struct ReentryHost final : IopHost
+{
+    Host base; std::function<void()> onLog;
+    bool readGuest(uint32_t a,void *b,size_t n) const override { return base.readGuest(a,b,n); }
+    bool writeGuest(uint32_t a,const void *b,size_t n) override { return base.writeGuest(a,b,n); }
+    bool zeroGuest(uint32_t a,size_t n) override { return base.zeroGuest(a,n); }
+    bool normalizeGuestAddress(uint32_t a,uint32_t &b) const override { return base.normalizeGuestAddress(a,b); }
+    uint32_t allocateIopHandle(IopHandleKind k) override { return base.allocateIopHandle(k); }
+    uint32_t allocateGuest(uint32_t n,uint32_t a) override { return base.allocateGuest(n,a); }
+    void freeGuest(uint32_t a) override { base.freeGuest(a); }
+    void audioCommand(uint32_t a,uint32_t b,GuestBuffer c,GuestBuffer d) override { base.audioCommand(a,b,c,d); }
+    std::string hostPath(HostPathKind k) const override { return base.hostPath(k); }
+    std::string translateGuestPath(std::string_view p) const override { return base.translateGuestPath(p); }
+    uint64_t openHostFile(std::string_view p) override { return base.openHostFile(p); }
+    bool hostFileSize(uint64_t h,uint64_t &n) const override { return base.hostFileSize(h,n); }
+    bool readHostFile(uint64_t h,uint64_t o,void *p,size_t n,size_t &r) override { return base.readHostFile(h,o,p,n,r); }
+    void closeHostFile(uint64_t h) override { base.closeHostFile(h); }
+    int32_t memoryCard(const MemoryCardRequest &r) override { return base.memoryCard(r); }
+    bool hasGuestFunction(uint32_t a) const override { return base.hasGuestFunction(a); }
+    bool invokeGuestFunction(uint64_t t,uint32_t a,uint32_t b,uint32_t c,uint32_t d,uint32_t e,uint32_t *r) override
+    { return base.invokeGuestFunction(t,a,b,c,d,e,r); }
+    void log(LogLevel l,std::string_view s) override
+    { if (onLog && s.starts_with("[IOP printf]")) onLog(); else base.log(l,s); }
+};
+inline void nestedManagedAndIrqReentryStayRejected()
+{
+    for (bool irq : {false,true})
+    {
+        ReentryHost host; IopEmulator iop(host); auto p = program({.dma=irq,.log=true}); start(iop,p);
+        unsigned calls = 0;
+        host.onLog = [&] { ++calls; call(iop,p); };
+        rejects([&] { advance(iop,3000u); }, "cannot interrupt an active native or IRQ frame");
+        require(calls == 1u && word(iop,p.data(0x98u)) == 0u,
+            "nested managed/IRQ reentry admitted a packet callback");
+        const auto stopped = iop.instructions(); iop.runEeCycles(1000u);
+        require(iop.instructions() == stopped, "nested reentry failure was not sticky");
+    }
+}
+inline void cdvdPumpAlsoFinishesItsPeerCriticalSection()
+{
+    using namespace iop_cdvd_sync_test;
+    DiscHost host; IopEmulator iop(host); SyncProgram p;
+    p.begin(); p.thread(0x800u,0x2500u,40u,0x70u); p.stream(); p.read(); p.sync();
+    p.load(8u,0xBF801078u); p.store(8u,p.data(0xA8u)); p.finish();
+    p.begin(0x800u);
+    // Complete the real CDVD IRQ before entering a section that crosses the
+    // remainder of this host slice. Sync must not return with I_CTRL still 0.
+    p.constant(8u,60u); const auto prelude=p.cursor; p.emit(0x2508FFFFu); const auto preBranch=p.cursor;
+    p.emit(0x15000000u|static_cast<uint16_t>((prelude-preBranch-4u)/4u)); p.emit(0u);
+    p.constant(4u,p.data(0xA0u)); p.call(p.stub(0x1100u)); p.mark(1u,0xA4u);
+    p.constant(8u,300u); const auto loop=p.cursor; p.emit(0x2508FFFFu); const auto branch=p.cursor;
+    p.emit(0x15000000u|static_cast<uint16_t>((loop-branch-4u)/4u)); p.emit(0u);
+    p.mark(2u,0xA4u); p.load(4u,p.data(0xA0u)); p.call(p.stub(0x1100u,1u)); p.finish();
+    p.recordingHandler(0xA00u,0u); prepare(iop); start(iop,p); continued(iop,p); matches(iop,host);
+    require(word(iop,p.data(0xA4u))==2u && word(iop,p.data(0xA8u))==1u, "CDVD sync returned into its external CPU while the peer still held interrupts");
+}
