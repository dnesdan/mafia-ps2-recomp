 #include <regex>
 #include <sstream>
+#include <stdexcept>
 #include <utility>
 
 using namespace ps2recomp;
 
+// Interpret the emitted initializers by their C++ assignment/fill semantics so tests
+// can check every slot without depending on whether a span uses individual stores.
+static std::vector<std::string> registrationSlots(const std::string &source)
+{
+    std::smatch match;
+    if (!std::regex_search(source, match, std::regex("TableSlotCount = ([0-9]+)u;")))
+        throw std::runtime_error("missing generated table size");
+    std::vector<std::string> slots(std::stoul(match[1].str()));
+    const std::regex assignment("g_ps2RecompiledFunctionTable\\[([0-9]+)\\] = ([A-Za-z0-9_]+);");
+    const std::regex fill("std::fill_n\\(g_ps2RecompiledFunctionTable \\+ ([0-9]+)u, ([0-9]+)u, ([A-Za-z0-9_]+)\\);");
+    std::istringstream lines(source);
+    std::string line;
+    while (std::getline(lines, line))
+    {
+        if (std::regex_search(line, match, assignment))
+            slots.at(std::stoul(match[1].str())) = match[2].str();
+        else if (std::regex_search(line, match, fill))
+        {
+            const size_t first = std::stoul(match[1].str());
+            const size_t count = std::stoul(match[2].str());
+            if (first > slots.size() || count > slots.size() - first)
+                throw std::runtime_error("generated fill is outside the function table");
+            std::fill_n(slots.begin() + first, count, match[3].str());
+        }
+    }
+    return slots;
+}
