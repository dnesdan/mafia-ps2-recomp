+            // strictly when it is called by the packet transport.
+            host.file = image.bytes;
+            require(iop.loadModule("legacy-registration", nullptr, 0u).moduleId > 0,
+                    "legacy service registration failed");
+            const char *cause = variant == 0u ? "exception" : variant == 3u ? "missing import sifman:291" :
+                                variant >= 4u ? "missing import sifcmd:" : "ordered packet transport";
+            rejects([&] { (void)iop.executePacketRpc(sid, 0x10200u, 0u, {}, 4u); }, cause);
+            require(host.guestReads == 0u && host.guestWrites == 0u,
