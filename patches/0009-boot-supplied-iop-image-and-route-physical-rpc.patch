+        for (uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            Host aliasHost;
+            IopEmulator aliasIop(aliasHost);
+            Irx aliased = rpcServer(sid, 0x04030201u);
+            aliased.words(0x08u, {0x3C040001u | (alias >> 16u)});
+            aliased.words(0x18u, {0x3C060001u | (alias >> 16u)});
+            aliased.words(0x20u, {0x3C070001u | (alias >> 16u)});
