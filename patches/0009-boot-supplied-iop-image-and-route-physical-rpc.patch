+    void packetRpcOriginalCallback()
+    {
+        Host host;
+        IopEmulator iop(host);
+        constexpr uint32_t sid = 0x80000006u;
+        Irx image = rpcServer(sid, 0xAABBCCDDu);
+        // The authored guest consumes the request and returns a distinct buffer.
+        // Its first result is input[0] + function + input byte count.
+        image.words(0x300u, {0x8CA80000u, 0u, 0x01044021u, 0x01064021u,
+            0x3C020001u, 0x34420450u, 0xAC480000u, 0xAC440004u,
+            0xAC460008u, 0xAC47000Cu, 0x03E00008u, 0u});
+        require(iop.loadModuleImage("packet-server", image.bytes, nullptr, 0u).moduleId > 0,
+                "authored physical service did not start");
+        uint32_t server = 0u, buffer = 0u, callbackBuffer = 1u;
+        const uint64_t before = iop.instructions();
+        require(iop.getPacketRpcServer(sid, server, buffer, callbackBuffer) &&
+                server == 0x10200u && buffer == 0x10400u && callbackBuffer == 0u,
+                "BIND metadata does not come from actual RegisterRpc arguments");
+        iop.validatePacketRpc(sid, server, 8u, 16u);
+        require(iop.instructions() == before, "packet preflight invoked guest code");
+        const std::array<uint8_t, 8> input{4u, 3u, 2u, 1u, 9u, 8u, 7u, 6u};
+        const auto output = iop.executePacketRpc(sid, server, 0x12u, input, 16u);
+        const std::vector<uint8_t> expected{0x1Eu, 3u, 2u, 1u, 0x12u, 0u, 0u, 0u,
+                                             8u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
+        require(output == expected && iop.instructions() > before,
+                "packet reply did not preserve actual callback results and ABI");
+        require(word(iop, buffer) == 0x01020304u && word(iop, buffer + 8u) == 0xAABBCCDDu,
+                "packet copy omitted request bytes or modified bytes past the request");
+        require(host.guestReads == 0u && host.guestWrites == 0u,
+                "physical packet execution bypassed ordered transport with direct EE access");
