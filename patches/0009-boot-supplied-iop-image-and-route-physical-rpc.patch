+    void IopRpcBridge::validatePacketServer(const RpcServer &server) const
+    {
+        // The server pointer is opaque on the wire. Validate the fields already
+        // touched by this RegisterRpc model, without inferring a firmware-specific
+        // complete SifRpcServerData layout from the EE packet ABI.
+        if (server.serverData == 0u || (server.serverData & 3u) != 0u ||
+            !ownedPacketRange(m_memory, server.serverData, 0x30u))
+            packetFailure(server.sid, "registered server data is outside aligned owned IOP RAM");
+        if (server.function == 0u || (server.function & 3u) != 0u ||
+            !ownedPacketRange(m_memory, server.function, 4u))
+            packetFailure(server.sid, "registered callback is outside aligned owned IOP RAM");
+        if (server.buffer != 0u && !ownedPacketRange(m_memory, server.buffer, 1u))
+            packetFailure(server.sid, "registered request buffer is outside owned IOP RAM");
+        if (server.callbackBuffer != 0u && !ownedPacketRange(m_memory, server.callbackBuffer, 1u))
+            packetFailure(server.sid, "registered callback buffer is outside owned IOP RAM");
+    }
+
+    bool IopRpcBridge::getPacketServer(uint32_t sid, uint32_t &serverOut,
+                                       uint32_t &bufferOut, uint32_t &callbackBufferOut) const
+    {
+        serverOut = bufferOut = callbackBufferOut = 0u;
+        const auto server = m_servers.find(sid);
+        if (server == m_servers.end())
+            return false;
+        validatePacketServer(server->second);
+        serverOut = server->second.serverData;
+        bufferOut = server->second.buffer;
+        callbackBufferOut = server->second.callbackBuffer;
+        return true;
+    }
+
+    void IopRpcBridge::validatePacketCall(uint32_t sid, uint32_t serverAddress,
+                                         uint32_t sendSize, uint32_t receiveSize) const
+    {
+        const auto server = m_servers.find(sid);
+        if (server == m_servers.end())
+            packetFailure(sid, "no registered guest server");
+        validatePacketServer(server->second);
+        if (serverAddress != server->second.serverData)
+            packetFailure(sid, "CALL server identity does not match its BIND result");
+        if (sendSize > IopMemory::RamSize || receiveSize > IopMemory::RamSize)
+            packetFailure(sid, "payload size exceeds IOP RAM");
+        if (sendSize != 0u && (server->second.buffer == 0u ||
+                             !ownedPacketRange(m_memory, server->second.buffer, sendSize)))
+            packetFailure(sid, "complete request buffer is outside owned IOP RAM");
+    }
+
+    std::vector<uint8_t> IopRpcBridge::executePacketCall(uint32_t sid, uint32_t serverAddress, uint32_t function,
+                                                       std::span<const uint8_t> input, uint32_t receiveSize,
+                                                       IopGuestExecutor &executor)
+    {
+        if (input.size() > IopMemory::RamSize)
+            packetFailure(sid, "payload size exceeds IOP RAM");
+        validatePacketCall(sid, serverAddress, static_cast<uint32_t>(input.size()), receiveSize);
+        if (m_packetCallActive)
+            packetFailure(sid, "reentrant packet callback is unsupported");
+
+        // The guest may register/remove services while its callback runs. Keep a
+        // value snapshot, never a map reference which that code could invalidate.
+        const RpcServer server = m_servers.at(sid);
+        struct PacketCallGuard
+        {
+            bool &active;
+            explicit PacketCallGuard(bool &value) : active(value) { active = true; }
+            ~PacketCallGuard() { active = false; }
+        } guard(m_packetCallActive);
+        if (!input.empty() && !m_memory.writeRam(server.buffer, input.data(), input.size()))
+            packetFailure(sid, "validated request copy failed");
+
+        const uint32_t resultAddress = executor.executeGuestFunction(server.function, function, server.buffer,
+                                                                     static_cast<uint32_t>(input.size()), 0u, server.gp);
+        if (receiveSize == 0u)
+            return {};
+        if (resultAddress == 0u || !ownedPacketRange(m_memory, resultAddress, receiveSize))
+            packetFailure(sid, "callback did not return the complete requested result in owned IOP RAM");
+
+        std::vector<uint8_t> result(receiveSize);
+        if (!m_memory.readRam(resultAddress, result.data(), result.size()))
+            packetFailure(sid, "validated callback result read failed");
+        // The caller owns EE payload DMA and END-packet ordering. There are no
+        // direct EE reads/writes, zero padding, or null-result substitutions here.
+        return result;
+    }
