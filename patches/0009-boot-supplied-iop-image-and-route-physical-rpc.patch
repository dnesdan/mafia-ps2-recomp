+            if (variant == 0u)
+                image.words(0x300u, {0x0000000Cu});
+            else
+            {
+                const bool dma = variant == 1u || variant == 3u;
+                constexpr std::array<uint16_t, 5> unsupportedCommands{15u, 16u, 23u, 28u, 29u};
+                const uint32_t ordinal = variant == 3u ? 0x123u : variant >= 4u ? unsupportedCommands[variant - 4u] :
+                                         dma ? 7u : 12u;
+                image.words(0x100u, {0x41E00000u, 0u, 0x0101u,
+                    dma ? 0x6D666973u : 0x63666973u, dma ? 0x00006E61u : 0x0000646Du,
+                    0x03E00008u, 0x24000000u | ordinal, 0u, 0u});
+                image.words(0x300u, {0x3C040001u, 0x34840480u, 0x24050001u, jal(0x10114u), 0u});
+                image.words(0x480u, {0x10400u, 0x800u, 4u, 0u});
