+        const uint64_t before = iop.instructions();
+        const std::vector<uint8_t> oversized(257u, 0xFFu); // one byte beyond owned module data
+        rejects([&] { (void)iop.executePacketRpc(sid, server + 4u, 0u, {}, 4u); }, "identity");
+        rejects([&] { (void)iop.executePacketRpc(sid, server, 0u, oversized, 4u); }, "complete request buffer");
+        rejects([&] { iop.validatePacketRpc(sid, server, 0u, 0x200001u); }, "payload size");
+        rejects([&] { iop.validatePacketRpc(123u, server, 0u, 4u); }, "no registered guest server");
+        require(iop.instructions() == before && word(iop, buffer) == 0x13579BDFu &&
+                word(iop, 0x10500u) == 0u, "failed preflight executed code or partially copied the request");
+        iop.checkExecutionFailure();
+        require(iop.executePacketRpc(sid, server, 0u, {}, 4u) ==
+                std::vector<uint8_t>({0xDFu, 0x9Bu, 0x57u, 0x13u}),
+                "preflight rejection poisoned a valid later call");
+        require(iop.stopModule(loaded.moduleId, nullptr), "packet server did not unload");
+        require(!iop.getPacketRpcServer(sid, server, buffer, callbackBuffer),
+                "unloaded module remained a physical BIND target");
