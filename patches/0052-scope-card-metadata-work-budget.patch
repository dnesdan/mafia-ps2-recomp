diff --git a/ps2xIOP/tests/iop_card_metadata_fixtures.h b/ps2xIOP/tests/iop_card_metadata_fixtures.h
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/tests/iop_card_metadata_fixtures.h
@@ -0,0 +1,111 @@
+#pragma once
+
+#include "iop_vblank_fixtures.h"
+
+namespace iop_card_metadata_test
+{
+    using namespace iop_vblank_test;
+    using ps2x::iop::SifEeTransfer;
+
+    inline Program metadataProgram(uint32_t sid, bool signal)
+    {
+        Program p;
+        p.image.bytes.resize(0x4100u, 0u);
+        for (uint32_t at : {68u, 72u})
+        {
+            p.image.bytes[at] = 0u;
+            p.image.bytes[at + 1u] = 0x40u;
+            p.image.bytes[at + 2u] = p.image.bytes[at + 3u] = 0u;
+        }
+        p.imports(0x1800u, "sifcmd", {17u});
+        p.imports(0x1900u, "thbase", {33u});
+        p.image.words(0x2400u, {0u, 0u, p.base + 0xB00u, 0x1000u, 20u});
+        p.image.words(0x2300u, {0x12345678u});
+        p.begin();
+        p.constant(4u, p.data(0x100u)); p.call(p.stub(0x1300u)); p.store(2u, p.data(0x40u));
+        p.constant(4u, p.data(0x400u)); p.call(p.stub(0x1200u)); p.store(2u, p.data(0x44u));
+        p.constant(4u, p.data(0x200u)); p.constant(5u, sid);
+        p.constant(6u, p.base + 0x600u); p.constant(7u, p.data(0x800u));
+        p.emit(0xAFA00010u); p.emit(0xAFA00014u); p.emit(0xAFA00018u);
+        p.call(p.stub(0x1800u)); p.finish();
+
+        p.begin(0x600u);
+        if (signal)
+        {
+            p.load(4u, p.data(0x44u)); p.constant(5u, 0u);
+            p.call(p.stub(0x1200u, 1u));
+        }
+        p.load(4u, p.data(0x40u)); p.constant(5u, 8u);
+        p.constant(6u, 0u); p.constant(7u, 0u);
+        p.call(p.stub(0x1300u, 2u)); p.finish(p.data(0x300u));
+
+        p.begin(0xB00u); p.constant(4u, 70000u); p.call(p.stub(0x1900u));
+        p.constant(8u, 1u); p.store(8u, p.data(0x48u));
+        p.load(4u, p.data(0x40u)); p.constant(5u, 8u);
+        p.call(p.stub(0x1300u, 1u)); p.finish();
+        return p;
+    }
+
+    inline void checkMetadataInvocation(uint32_t sid, uint32_t function, size_t inputSize,
+                                        bool signal, bool success, uint64_t maximum)
+    {
+        Host host;
+        IopEmulator iop(host);
+        const auto p = metadataProgram(sid, signal);
+        start(iop, p);
+        uint32_t server = 0u, buffer = 0u, callback = 0u;
+        require(iop.getPacketRpcServer(sid, server, buffer, callback), "metadata regression server absent");
+        std::vector<uint8_t> input(inputSize, 0u);
+        if (inputSize >= 1044u)
+        {
+            input[8] = 3u; input[9] = 2u;
+            constexpr char path[] = "/TEST/SAVE";
+            std::memcpy(input.data() + 20u, path, sizeof(path));
+        }
+        const uint64_t before = iop.cycles();
+        std::vector<SifEeTransfer> transfers{{0x4000u, {0xA5u}}};
+        bool failed = false;
+        try
+        {
+            const auto output = iop.executePacketRpc(sid, server, function, input, 4u, &transfers);
+            require(output == std::vector<uint8_t>({0x78u, 0x56u, 0x34u, 0x12u}),
+                    "metadata callback result changed");
+        }
+        catch (const std::runtime_error &error)
+        {
+            failed = true;
+            require(std::string_view(error.what()).find("external kernel wait exhausted its invocation budget") !=
+                        std::string_view::npos, "metadata test failed for another reason");
+        }
+        const uint64_t elapsed = iop.cycles() - before;
+        require(failed != success, "metadata wait completed with the wrong budget scope");
+        require(elapsed >= 2'000'000u && elapsed <= maximum + 20'000u,
+                "metadata wait did not retain its finite cycle bound");
+        if (success)
+            require(word(iop, p.data(0x48u)) == 1u && transfers.empty(),
+                    "metadata wait bypassed real peer or leaked ordered output");
+        else
+            require(transfers.size() == 1u && transfers[0].data == std::vector<uint8_t>({0xA5u}),
+                    "failed metadata callback published partial EE output");
+    }
+
+    inline void metadataCallbacksWaitForRealPeers()
+    {
+        // An authored peer signals the same event pattern after 70 ms of modeled
+        // IOP time (>2M cycles). No original driver/game bytes are embedded here.
+        checkMetadataInvocation(0x80000400u, 2u, 1044u, true, true, 64'000'000u);
+        checkMetadataInvocation(0x80000400u, 1u, 48u, true, true, 64'000'000u);
+    }
+
+    inline void metadataBudgetsStayScopedAndFinite()
+    {
+        for (size_t bytes : {47u, 49u, 1044u})
+            checkMetadataInvocation(0x80000400u, 1u, bytes, true, false, 2'000'000u);
+        for (size_t bytes : {48u, 1043u, 1045u})
+            checkMetadataInvocation(0x80000400u, 2u, bytes, true, false, 2'000'000u);
+        checkMetadataInvocation(0x80000400u, 4u, 1044u, true, false, 2'000'000u);
+        checkMetadataInvocation(0x12345678u, 1u, 48u, true, false, 2'000'000u);
+        checkMetadataInvocation(0x12345678u, 2u, 1044u, true, false, 2'000'000u);
+        checkMetadataInvocation(0x80000400u, 2u, 1044u, false, false, 64'000'000u);
+    }
+}
