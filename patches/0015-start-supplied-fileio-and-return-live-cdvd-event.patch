+++ b/ps2xIOP/tests/iop_ioman_devctl_tests.cpp
@@ -0,0 +1,307 @@
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/imports/iop_cdvd.h"
+#include "emulator/imports/iop_ioman.h"
+#include "emulator/iop_emulator.h"
+#include "emulator/services/iop_rpc.h"
+#include "iop_compat_test_support.h"
+
+#include <functional>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+    using iop_test::require;
+
+    class NoGuestCallback final : public IopGuestExecutor
+    {
+    public:
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override
+        {
+            throw std::runtime_error("unexpected device callback");
+        }
+    };
+
+    struct Fixture
+    {
+        iop_test::Host host;
+        IopMemory memory;
+        IopKernel kernel{memory};
+        IopCdvd cdvd{host, memory, kernel};
+        IopIoman ioman{memory, cdvd};
+        NoGuestCallback executor;
+
+        void path(uint32_t address, const std::string &value = "cdrom0:")
+        {
+            require(memory.writeRam(address, value.c_str(), value.size() + 1u), "could not install device path");
+        }
+
+        IopCpuState arguments(uint32_t pathAddress = 0x10000u, uint32_t stack = 0x11000u,
+                              uint32_t output = 0x12000u, uint32_t outputSize = 12u)
+        {
+            path(pathAddress);
+            require(memory.zeroRam(stack, 24u), "could not install O32 arguments");
+            std::vector<uint8_t> bytes(outputSize, 0xCAu);
+            require(memory.writeRam(output, bytes.data(), bytes.size()), "could not install output canaries");
+            memory.write32(stack + 16u, output);
+            memory.write32(stack + 20u, outputSize);
+            IopCpuState cpu{};
+            cpu.gpr[2] = 0xDEADBEEFu;
+            cpu.gpr[4] = pathAddress;
+            cpu.gpr[5] = 0x4391u;
+            cpu.gpr[29] = stack;
+            return cpu;
+        }
+
+        void invoke(IopCpuState &cpu)
+        {
+            require(ioman.dispatchImport(31u, cpu, executor), "modeled CDVD Devctl is absent");
+        }
+
+        int32_t event(uint16_t ordinal, uint32_t id, uint32_t bits = 0u, uint32_t output = 0u)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = id;
+            cpu.gpr[5] = bits;
+            cpu.gpr[7] = output;
+            require(kernel.dispatchEventImport(ordinal, cpu), "kernel event import is absent");
+            return static_cast<int32_t>(cpu.gpr[2]);
+        }
+    };
+
+    void queryUsesActualSharedEvent()
+    {
+        Fixture f;
+        auto cpu = f.arguments();
+        f.invoke(cpu);
+        const uint32_t id = f.memory.read32(0x12000u);
+        require(cpu.gpr[2] == 0u && id != 0u &&
+                    f.event(11u, id, 0x29u, 0x12100u) == 0 &&
+                    f.memory.read32(0x12100u) == 0x29u &&
+                    f.event(11u, id, 0x10u) == -418,
+                "Devctl did not return a real event without the power-off bit");
+        require(f.memory.read32(0x12004u) == 0xCACACACAu &&
+                    f.memory.read32(0x12008u) == 0xCACACACAu,
+                "event query overwrote bytes beyond its one result word");
+
+        IopCpuState sc{};
+        sc.gpr[4] = static_cast<uint32_t>(-11);
+        require(f.cdvd.dispatchImport(50u, sc) && sc.gpr[2] == id,
+                "Devctl returned an event independent of sceCdSC(-11)");
+        require(f.event(8u, id, 0u) == 0, "could not clear actual event bits");
+        f.invoke(cpu);
+        require(f.memory.read32(0x12000u) == id && f.event(11u, id, 0x29u) == -418,
+                "repeated query re-created the event or fabricated completion bits");
+        require(f.event(6u, id, 0x10u) == 0, "could not signal the actual kernel event");
+        f.invoke(cpu);
+        require(f.memory.read32(0x12000u) == id && f.event(11u, id, 0x10u) == 0,
+                "query reset or replaced existing power-off event state");
+        require(!f.cdvd.takeCompletionCallback() && !f.memory.takeDmaStart() &&
+                    f.memory.interruptStatus() == 0u && f.host.guestWrites == 0u,
+                "event query generated unrelated callbacks, DMA, interrupts or EE writes");
+    }
+
+    void aliasesAndExactEndRanges()
+    {
+        for (const uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            for (const bool stackAtEnd : {false, true})
+            {
+                Fixture f;
+                const uint32_t stack = alias | (stackAtEnd ? IopMemory::RamSize - 24u : 0x11000u);
+                const uint32_t output = alias | (stackAtEnd ? 0x12000u : IopMemory::RamSize - 4u);
+                auto cpu = f.arguments(alias | 0x10000u, stack, output, 4u);
+                f.memory.write8(output - 1u, 0xA5u);
+                f.invoke(cpu);
+                require(cpu.gpr[2] == 0u && f.memory.read32(output) != 0u &&
+                            f.memory.read8(output - 1u) == 0xA5u,
+                        "valid exact-end stack/output alias failed or damaged a canary");
+            }
+        }
+        for (const std::string path : {"cdrom:", "cdrom00:", "cdrom0:\\ignored-name"})
+        {
+            Fixture f;
+            auto cpu = f.arguments();
+            f.path(0x10000u, path);
+            f.invoke(cpu);
+            require(cpu.gpr[2] == 0u, "valid unit-zero device syntax did not resolve");
+        }
+    }
+
+    void invalidArgumentsFailBeforeEventAcquisition()
+    {
+        using Alter = std::function<void(Fixture &, IopCpuState &)>;
+        const Alter examples[] = {
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[4] = 0u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[4] = 0xC0010000u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[4] = 0x8000u; },
+            [](Fixture &f, IopCpuState &cpu)
+            {
+                f.memory.write8(IopMemory::RamSize - 1u, 'c');
+                cpu.gpr[4] = 0xA0000000u | (IopMemory::RamSize - 1u);
+            },
+            [](Fixture &f, IopCpuState &)
+            {
+                std::array<uint8_t, 1024u> path{};
+                path.fill('c');
+                require(f.memory.writeRam(0x10000u, path.data(), path.size()), "could not install unterminated path");
+            },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[7] = 1u; cpu.gpr[6] = 0xFFFFFFFFu; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0x11001u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0x8000u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0xFFFFFFF0u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0xA01FFFF0u; },
+            [](Fixture &, IopCpuState &cpu) { cpu.gpr[29] = 0x20011000u; },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11010u, 0u); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11010u, 0x12001u); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11010u, 0xC0012000u); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11010u, 0xA01FFFFCu); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11014u, 3u); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11014u, 16u); },
+            [](Fixture &f, IopCpuState &) { f.memory.write32(0x11014u, 0xFFFFFFFFu); },
+        };
+        for (const auto &alter : examples)
+        {
+            Fixture f;
+            auto cpu = f.arguments();
+            alter(f, cpu);
+            const std::vector<uint8_t> before(f.memory.ram().begin(), f.memory.ram().end());
+            const uint32_t idBefore = static_cast<uint32_t>(f.kernel.createInternalEventFlag(0u, 0u, 0u));
+            bool rejected = false;
+            try { f.invoke(cpu); }
+            catch (const std::runtime_error &error)
+            {
+                rejected = std::string_view(error.what()).find("Devctl") != std::string_view::npos;
+            }
+            const uint32_t idAfter = static_cast<uint32_t>(f.kernel.createInternalEventFlag(0u, 0u, 0u));
+            require(rejected && cpu.gpr[2] == 0xDEADBEEFu && idAfter == idBefore + 1u &&
+                        std::equal(before.begin(), before.end(), f.memory.ram().begin()),
+                    "malformed Devctl acquired an event, changed RAM, or reported success");
+        }
+    }
+
+    void unsupportedRoutesRemainUnhandled()
+    {
+        for (const std::string path : {"host:", "cdrom1:", "CDROM0:", "cdromx:", "cdrom0", ""})
+        {
+            Fixture f;
+            auto cpu = f.arguments();
+            f.path(0x10000u, path);
+            const std::vector<uint8_t> before(f.memory.ram().begin(), f.memory.ram().end());
+            require(!f.ioman.dispatchImport(31u, cpu, f.executor) && cpu.gpr[2] == 0xDEADBEEFu &&
+                        std::equal(before.begin(), before.end(), f.memory.ram().begin()),
+                    "unsupported device route fabricated a Devctl response");
+        }
+        Fixture f;
+        auto cpu = f.arguments();
+        cpu.gpr[5] = 0x4392u;
+        require(!f.ioman.dispatchImport(31u, cpu, f.executor) && cpu.gpr[2] == 0xDEADBEEFu,
+                "unsupported CDVD command fabricated success");
+
+        // A genuinely registered driver must not be shadowed by this model.
+        f.path(0x13000u, "cdrom");
+        require(f.memory.zeroRam(0x13100u, 24u) && f.memory.zeroRam(0x13200u, 8u),
+                "could not install authored driver metadata");
+        f.memory.write32(0x13100u, 0x13000u);
+        f.memory.write32(0x13110u, 0x13200u);
+        IopCpuState add{};
+        add.gpr[4] = 0x13100u;
+        require(f.ioman.dispatchImport(20u, add, f.executor) && add.gpr[2] == 0u,
+                "could not register authored original-driver metadata");
+        cpu.gpr[5] = 0x4391u;
+        require(!f.ioman.dispatchImport(31u, cpu, f.executor),
+                "modeled CDVD query silently replaced a registered original device");
+    }
+
+    void deletedEventAndResetLifetime()
+    {
+        Fixture f;
+        auto cpu = f.arguments();
+        f.invoke(cpu);
+        const uint32_t id = f.memory.read32(0x12000u);
+        require(f.event(5u, id) == 0, "could not delete event for lifetime regression");
+        f.memory.write32(0x12000u, 0xCACACACAu);
+        cpu.gpr[2] = 0xDEADBEEFu;
+        bool rejected = false;
+        try { f.invoke(cpu); }
+        catch (const std::runtime_error &error)
+        {
+            rejected = std::string_view(error.what()).find("deleted before reset") != std::string_view::npos;
+        }
+        require(rejected && f.memory.read32(0x12000u) == 0xCACACACAu && cpu.gpr[2] == 0xDEADBEEFu,
+                "deleted CDVD event was returned or silently recreated");
+        f.kernel.reset();
+        f.cdvd.reset();
+        f.ioman.reset();
+        f.invoke(cpu);
+        const uint32_t resetId = f.memory.read32(0x12000u);
+        require(cpu.gpr[2] == 0u && f.event(11u, resetId, 0x29u) == 0 &&
+                    f.event(11u, resetId, 0x10u) == -418,
+                "reset did not establish a fresh normal CDVD event lifetime");
+    }
+
+    iop_test::Irx authoredDevctl(uint32_t command)
+    {
+        iop_test::Irx image;
+        image.words(0u, {
+            0x27BDFFD0u, 0xAFBF002Cu, 0x3C040001u, 0x34840400u,
+            0x34050000u | command, 0x00003021u, 0x00003821u,
+            0x3C080001u, 0x35080440u, 0xAFA80010u,
+            0x24090004u, 0xAFA90014u, 0x0C004045u, 0u,
+            0x3C080001u, 0xAD020444u, 0x2404FFF5u, 0x00002821u,
+            0x0C004055u, 0u, 0x3C080001u, 0xAD020448u,
+            0x8FBF002Cu, 0x27BD0030u, 0x03E00008u, 0x24020000u,
+        });
+        image.words(0x100u, {
+            0x41E00000u, 0u, 0x0104u, 0x616D6F69u, 0x0000006Eu,
+            0x03E00008u, 0x2400001Fu, 0u, 0u,
+        });
+        image.words(0x140u, {
+            0x41E00000u, 0u, 0x0101u, 0x64766463u, 0x006E616Du,
+            0x03E00008u, 0x24000032u, 0u, 0u,
+        });
+        std::memcpy(image.bytes.data() + 0x100u + 0x400u, "cdrom0:", 8u);
+        return image;
+    }
+
+    void authoredImportsUseRealO32Arguments()
+    {
+        iop_test::Host host;
+        IopEmulator iop(host);
+        const auto image = authoredDevctl(0x4391u);
+        const auto loaded = iop.loadModuleImage("authored-devctl", image.bytes, nullptr, 0u);
+        std::array<uint32_t, 3u> result{};
+        require(loaded.moduleId > 0 && loaded.startResult == 0 &&
+                    iop.readMemory(0x10440u, result.data(), sizeof(result)) &&
+                    result[0] != 0u && result[1] == 0u && result[2] == result[0],
+                "actual authored O32 imports did not return the same live CDVD event");
+        require(host.guestWrites == 0u, "Devctl touched unrelated EE memory");
+
+        iop_test::Host unsupportedHost;
+        IopEmulator unsupported(unsupportedHost);
+        const auto invalid = authoredDevctl(0x4392u);
+        bool rejected = false;
+        try { (void)unsupported.loadModuleImage("authored-unsupported-devctl", invalid.bytes, nullptr, 0u); }
+        catch (const std::runtime_error &error)
+        {
+            rejected = std::string_view(error.what()).find("missing import ioman:31") != std::string_view::npos;
+        }
+        require(rejected && unsupportedHost.guestWrites == 0u,
+                "unsupported Devctl was not a strict missing operation");
+    }
+}
+
+int main()
+{
+    const iop_test::Test tests[] = {
+        {"CDVD Devctl returns the actual shared kernel event without signaling", queryUsesActualSharedEvent},
+        {"Devctl accepts complete aliases and exact-end O32/output ranges", aliasesAndExactEndRanges},
+        {"Malformed Devctl arguments reject before event or RAM mutation", invalidArgumentsFailBeforeEventAcquisition},
+        {"Unsupported devices and commands remain unhandled", unsupportedRoutesRemainUnhandled},
+        {"Deleted CDVD events fail until normal reset", deletedEventAndResetLifetime},
+        {"Authored IOP Devctl and SC imports share a live event", authoredImportsUseRealO32Arguments},
+    };
+    return iop_test::run(tests);
+}
