+        void requireOwnedRam(const IopMemory &memory, uint32_t address, size_t size, const char *description)
+        {
+            requireRamSpan(address, size, description);
+            if (!memory.ownsRamRange(address, size))
+                throw std::runtime_error(std::string("IOP Devctl ") + description + " is outside owned RAM");
