+#pragma once
+
+#include "iop_cdvd_sync_fixtures.h"
+
+namespace iop_cdvd_nested_sync_test
+{
+    using namespace iop_cdvd_sync_test;
+
+    struct NestedProgram : SyncProgram
+    {
+        NestedProgram() { imports(0x1900u, "thbase", {20u, 5u, 6u, 10u, 29u, 31u, 18u, 14u}); }
+        void entry(bool peer = false)
+        {
+            begin(); driver(); thread(0x400u, 0x2500u, 20u, 0x70u);
+            if (peer) thread(0x800u, 0x2540u, 60u, 0x74u);
+            finish();
+        }
+        void caller(uint32_t code = 0x400u, uint32_t result = 0x90u)
+        {
+            begin(code); constant(28u, 0x55667788u); store(29u, data(result));
+            devctl(); store(2u, data(result + 4u)); store(28u, data(result + 8u));
+            store(29u, data(result + 12u)); mark(1u, result + 16u); finish();
+        }
+        void driverBody(uint32_t mode = 0u, unsigned command = 1u, bool masked = false)
+        {
+            begin(0x600u); store(29u, data(0xB0u)); store(28u, data(0xB4u));
+            call(stub(0x1900u)); store(2u, data(0xB8u));
+            load(8u, data(0xC0u)); emit(0x25080001u); store(8u, data(0xC0u));
+            stream(); if (masked) mask(false);
+            if (command == 0u) cd(0u); else read();
+            if (command == 2u) cd(5u);
+            sync(mode); call(stub(0x1900u)); store(2u, data(0xBCu)); finish(0x456u);
+            recordingHandler(0xA00u, 0u);
+        }
+    };
+
+    void returned(IopEmulator &iop, const NestedProgram &p, uint32_t result = 0x90u)
+    {
+        require(word(iop, p.data(result + 4u)) == 0x456u &&
+                    word(iop, p.data(result + 8u)) == 0x55667788u &&
+                    word(iop, p.data(result)) == word(iop, p.data(result + 12u)) &&
+                    word(iop, p.data(result + 16u)) == 1u,
+                "managed Devctl lost its caller's return value, GP, stack or continuation");
+    }
+
+    void managedDriverPreservesBothCpus()
+    {
+        for (uint32_t mode : {0u, 5u})
+        for (unsigned command = 0u; command < 3u; ++command)
+        {
+            DiscHost host; IopEmulator iop(host); NestedProgram p;
+            p.entry(); p.caller(); p.driverBody(mode, command);
+            prepare(iop); start(iop, p); advance(iop, 10000u);
+            returned(iop, p); continued(iop, p);
+            require(word(iop, p.data(0xB8u)) == word(iop, p.data(0x70u)) &&
+                        word(iop, p.data(0xBCu)) == word(iop, p.data(0x70u)) &&
+                        word(iop, p.data(0xB4u)) == 0x11223344u &&
+                        word(iop, p.data(0xB0u)) != word(iop, p.data(0x90u)) &&
+                        word(iop, p.data(0xC0u)) == 1u && host.reads == (command == 1u ? 1u : 0u),
+                    "driver sync changed thread identity, reused the caller stack or replayed its import");
+            if (command == 1u) matches(iop, host);
+        }
+    }
+
+    void maskedDriverWaitRunsPeersWithoutReenteringOwner()
+    {
+        for (uint64_t chunk : {1u, 17u, 10000u})
+        {
+            DiscHost host; IopEmulator iop(host); NestedProgram p;
+            p.entry(true); p.caller(); p.driverBody(0u, 1u, true);
+            p.begin(0x800u);
+            p.load(4u, p.data(0x70u)); p.constant(5u, p.data(0x600u)); p.call(p.stub(0x1600u, 1u));
+            p.mark(1u, 0xD0u); p.delay(100u); p.load(8u, p.data(0xA0u)); p.store(8u, p.data(0xD4u));
+            p.mask(true); p.finish();
+            prepare(iop); start(iop, p);
+            for (uint64_t elapsed = 0; elapsed < 10000u; elapsed += chunk) advance(iop, chunk);
+            returned(iop, p); matches(iop, host);
+            require(word(iop, p.data(0xD0u)) == 1u && word(iop, p.data(0xD4u)) == 0u &&
+                        word(iop, p.data(0x608u)) == 4u && word(iop, p.data(0x624u)) == 4u &&
+                        word(iop, p.data(0xC0u)) == 1u && host.reads == 1u,
+                    "nested sync starved a peer, hid the event wait or redispatched the active Devctl");
+        }
+    }
+
+    void successorReadMustFinishBeforeManagedDriverReturns()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(); p.caller(); p.driverBody();
+        p.begin(0xA00u); p.load(8u, p.data()); p.emit(0x25080001u); p.store(8u, p.data());
+        p.constant(9u, 1u);
+        const uint32_t branch = p.cursor; p.emit(0u); p.emit(0u);
+        p.read(3u, buffer + 0x2000u);
+        const uint32_t done = p.cursor;
+        p.image.words(branch, {0x15090000u | static_cast<uint16_t>((done - branch - 4u) / 4u)});
+        p.finish();
+        prepare(iop); start(iop, p); advance(iop, 10000u);
+        returned(iop, p); continued(iop, p, 2u); matches(iop, host); matches(iop, host, 3u, buffer + 0x2000u);
+        require(host.reads == 2u && word(iop, p.data(0xC0u)) == 1u,
+                "successor wakeup replayed a managed import or returned before the second read");
+    }
+
+    void concurrentNativeWaitsRemainAnExplicitBoundary()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.begin(); p.driver(); p.thread(0x400u, 0x2500u, 20u, 0x70u);
+        p.thread(0x800u, 0x2540u, 40u, 0x74u); p.finish();
+        p.caller(); p.caller(0x800u, 0xE0u); p.driverBody(0u, 1u, true);
+        prepare(iop); start(iop, p);
+        rejects([&] { advance(iop, 12000u); }, "concurrent native waits");
+        require(word(iop, p.data(0xA0u)) == 0u && word(iop, p.data(0xF0u)) == 0u &&
+                    word(iop, p.data(0xC0u)) == 2u,
+                "independent guest callers were incorrectly resumed in native LIFO order");
+        iop.reset();
+    }
+
+    void mediaErrorIsNotLostInsideTheDriver()
+    {
+        DiscHost host; host.failRead = true; IopEmulator iop(host); NestedProgram p;
+        p.entry(); p.caller(); p.driverBody();
+        // Replace only the driver's final return; preserve the sync body.
+        p.cursor = 0x600u;
+        p.begin(0x600u); p.stream(); p.read(); p.sync(); p.cd(6u); p.store(2u, p.data(0xD0u)); p.finish(0x456u);
+        prepare(iop); start(iop, p); advance(iop, 10000u); returned(iop, p);
