+    void IopKernel::rearmNativeCaller(const NativeWaitToken &token, int eventId)
+    {
+        const auto found = m_threads.find(token.threadId);
+        const auto event = m_eventFlags.find(eventId);
+        if (found == m_threads.end() || !found->second.nativeWait || event == m_eventFlags.end())
+            throw std::runtime_error("IOP native wait lost its caller or completion event");
+        IopThread &thread = found->second;
+        const bool ready = eventSatisfied(event->second, 1u, 0u);
+        if (ready && thread.state != IopThreadState::Ready)
+            makeReady(thread);
+        else if (!ready)
+            thread.state = IopThreadState::EventFlag;
+        thread.waitId = eventId;
+        thread.waitBits = 1u;
+        thread.waitMode = 0u;
+        thread.waitResultAddress = 0u;
