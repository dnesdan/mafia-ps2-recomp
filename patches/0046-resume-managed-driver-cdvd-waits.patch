+        prepare(iop); start(iop, clean); advance(iop, 10000u); returned(iop, clean);
+    }
+
+    void deletedEventCannotReleaseNativeContinuation()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(true); p.caller(); p.driverBody(0u, 1u, true);
+        p.begin(0x800u); p.cd(2u, uint32_t(-11)); p.move(4u, 2u); p.call(p.stub(0x1300u)); p.finish();
+        prepare(iop); start(iop, p);
+        rejects([&] { advance(iop, 10000u); }, "event flag was deleted");
+        require(word(iop, p.data(0xA0u)) == 0u, "deleted event let a native caller continue");
+        iop.reset();
+    }
+
+    void pinnedCallerLifecycleChangesFailBeforeMutation()
+    {
+        for (uint32_t operation : {1u, 2u, 3u, 4u, 5u})
+        {
+            DiscHost host; IopEmulator iop(host); NestedProgram p;
+            p.entry(true); p.caller(); p.driverBody(0u, 1u, true);
+            p.begin(0x800u); p.load(4u, p.data(0x70u)); p.call(p.stub(0x1900u, operation));
+            p.mark(1u, 0xD0u); p.finish();
+            prepare(iop); start(iop, p);
+            rejects([&] { advance(iop, 10000u); }, "live native-call owner");
+            require(word(iop, p.data(0xA0u)) == 0u && word(iop, p.data(0xD0u)) == 0u,
+                    "lifecycle change resumed or erased a CPU with an active native frame");
+            iop.reset();
+        }
+    }
+
+    void resetDuringNativeHostIoFailsBeforeClearingRam()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(); p.caller(); p.driverBody();
+        prepare(iop); start(iop, p); host.onRead = [&] { iop.reset(); };
+        rejects([&] { advance(iop, 10000u); }, "live native-call owner");
+        require(word(iop, buffer) == 0xCCCCCCCCu && word(iop, p.data(0xC0u)) == 1u &&
+                    word(iop, p.data(0xA0u)) == 0u, "reset partly cleared RAM before rejecting the live frame");
+        host.onRead = {}; iop.reset();
+        NestedProgram clean; clean.entry(); clean.caller(); clean.driverBody();
+        prepare(iop); start(iop, clean); advance(iop, 10000u); returned(iop, clean);
+    }
+
+    void permanentMaskCannotHangOrLeakNativeWait()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(); p.caller(); p.driverBody(0u, 1u, true);
+        prepare(iop); start(iop, p);
+        rejects([&] { advance(iop, 10000u); }, "blocking CDVD sync exhausted its invocation budget");
+        require(host.reads == 1u && word(iop, p.data(0xA0u)) == 0u && word(iop, p.data(0xC0u)) == 1u,
+                "masked wait replayed the driver or invented completion");
+        iop.reset();
+    }
+
+    void forcedWakeDoesNotRedispatchTheBorrowedCaller()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(true); p.caller(); p.driverBody(0u, 1u, true);
+        p.begin(0x800u); p.load(4u, p.data(0x70u)); p.call(p.stub(0x1900u, 6u));
+        p.delay(100u); p.mask(true); p.finish();
+        prepare(iop); start(iop, p); advance(iop, 10000u); returned(iop, p); matches(iop, host);
+        require(word(iop, p.data(0xC0u)) == 1u && host.reads == 1u,
+                "forced event wake redispatched the active native caller");
+    }
+    void nativeResumeRespectsPriorityAndRunningPeers()
+    {
+        for (uint32_t peerPriority : {10u, 20u, 60u})
+        {
+            DiscHost host; IopEmulator iop(host); NestedProgram p;
+            p.begin(); p.driver(); p.thread(0x400u, 0x2500u, 20u, 0x70u);
+            p.thread(0x800u, 0x2540u, peerPriority, 0x74u); p.finish();
+            p.begin(0x400u); p.constant(28u, 0x55667788u); p.store(29u, p.data(0x90u));
+            p.devctl(); p.store(2u, p.data(0x94u)); p.store(28u, p.data(0x98u)); p.store(29u, p.data(0x9Cu));
+            p.load(8u, p.data(0xD0u)); p.store(8u, p.data(0xD8u)); p.mark(1u, 0xA0u); p.finish();
+            p.driverBody(0u, 1u, true);
+            p.begin(0x800u); p.delay(100u); p.mask(true); p.mark(1u, 0xD0u); p.finish();
+            prepare(iop); start(iop, p); advance(iop, 12000u); returned(iop, p); matches(iop, host);
+            require(word(iop, p.data(0xD0u)) == 1u &&
+                        word(iop, p.data(0xD8u)) == (peerPriority <= 20u ? 1u : 0u),
+                    "native completion preempted equal/higher-priority work or ran a lower-priority peer past wakeup");
+            require(word(iop, p.data(0xC0u)) == 1u, "priority handoff redispatched the borrowed import");
+        }
+    }
+
+}
