+
+    bool IopKernel::nativeCallerCanResume(const NativeWaitToken &token) const noexcept
+    {
+        const auto found = m_threads.find(token.threadId);
+        if (found == m_threads.end() || !found->second.nativeWait ||
+            found->second.state != IopThreadState::Ready || m_memory.interruptControl() == 0u)
+            return false;
+        const IopThread &owner = found->second;
+        for (const auto &[id, peer] : m_threads)
+        {
+            if (peer.nativeWait)
+                continue;
+            // Same-priority running work keeps its timeslice. Ready work uses
+            // the same FIFO order as beginNextReady, not native call depth.
+            if (peer.state == IopThreadState::Running && peer.priority <= owner.priority)
+                return false;
+            if (peer.state == IopThreadState::Ready &&
+                (peer.priority < owner.priority ||
+                 (peer.priority == owner.priority && peer.readyOrder < owner.readyOrder)))
+                return false;
+        }
+        return true;
+    }
