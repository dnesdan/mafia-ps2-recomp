+                "nested sync turned a completed read error into a successful payload");
+    }
+
+    void callbackFailureUnwindsThePinnedCaller()
+    {
+        DiscHost host; IopEmulator iop(host); NestedProgram p;
+        p.entry(); p.caller(); p.driverBody();
+        p.begin(0xA00u); p.call(p.stub(0x1400u)); p.finish();
+        prepare(iop); start(iop, p);
+        rejects([&] { advance(iop, 10000u); }, "missing import absent:42");
+        const auto count = iop.instructions(); iop.runEeCycles(100000u);
+        rejects([&] { iop.checkExecutionFailure(); }, "missing import absent:42");
+        require(iop.instructions() == count && word(iop, p.data(0xA0u)) == 0u && host.reads == 1u,
+                "callback failure resumed the owner or lost the sticky failure");
