+// Input positions and XYOFFSET are both 12.4 fixed point. All input
+// values and their signed differences are exactly representable in float.
+static inline float gsOffsetCoordinate(float vertex, uint16_t offset)
+{
+    return vertex - static_cast<float>(offset) * (1.0f / 16.0f);
+}
+
+// This retains the existing floor coverage policy, including negative
+// coordinates. It does not assert hardware-accurate point/sprite coverage.
+static inline int gsOffsetPixel(float vertex, uint16_t offset)
+{
+    return static_cast<int>(std::floor(gsOffsetCoordinate(vertex, offset)));
+}
