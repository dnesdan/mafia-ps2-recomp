+    uint32_t IopTimrman::reserveKernelAlarmTimer(IopMemory &memory)
+    {
+        for (const Timer &timer : m_timers)
+            if (timer.kernelOwned)
+            {
+                memory.reserveKernelAlarmTimerRegisters(timer.address);
+                return timer.irq;
+            }
+        // PS2SDK threadman init_timer: AllocHardTimer(1,32,1). Reserve only
+        // in actual modeled-kernel startup, never in standalone timrman reset.
+        for (const size_t index : kAllocationOrder)
+        {
+            Timer &timer = m_timers[index];
