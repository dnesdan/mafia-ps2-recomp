+        require(f.call(37u, callbackAddress, 1u) == 0 && f.call(37u, callbackAddress, 1u) == -105 &&
+                    f.call(37u, 0xFFFFFFFFu, 0u) == -105,
+                "cancellation did not use the exact opaque callback/argument pair");
+        f.due(10000u); f.due(10000u); f.due(10000u);
+        require(f.executor.calls.size() == 2u && f.executor.calls[0].argument == 2u &&
+                    f.executor.calls[1].argument == 3u, "equal-deadline FIFO or cancellation was lost");
+        f.clock(10000u);
+        require(f.set(4u, 0u, 0x80000000u | callbackAddress) == 0 && f.set(4u) == 0,
+                "raw callback aliases incorrectly merged distinct primary pointer pairs");
+        require(f.call(37u, callbackAddress, 4u) == 0, "physical pair did not cancel exactly");
+        f.due(10000u);
+        require(f.executor.calls.back().function == (0x80000000u | callbackAddress),
