+            const uint32_t free = f.memory.totalFreeMemory();
+            rejects([&] { (void)f.call(35u, clock, callback, 0u, now); }, "IOP alarm");
+            require(std::equal(before.begin(), before.end(), f.memory.ram().begin()) &&
