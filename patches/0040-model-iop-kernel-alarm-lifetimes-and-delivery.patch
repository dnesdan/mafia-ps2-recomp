+    }
+
+    void kernelReservationDoesNotChangeStandaloneTimers()
+    {
+        const auto allocate = [](IopTimrman &timers)
+        {
+            IopCpuState cpu{}; cpu.gpr[4] = 1u; cpu.gpr[5] = 32u; cpu.gpr[6] = 1u;
+            require(timers.dispatchImport(4u, cpu, 0u), "timer allocation unhandled"); return cpu.gpr[2];
+        };
+        IopTimrman standalone; standalone.reset();
+        require(allocate(standalone) == 0x6BF8014Au, "standalone timer allocation order changed");
+        Fixture f;
+        require(allocate(f.timers) == 0x5BF80149u && allocate(f.timers) == 0x4BF80148u &&
+                    allocate(f.timers) == uint32_t(-150), "kernel timer was allocated a second time");
+        for (uint16_t ordinal : {6u, 7u, 9u, 11u, 20u, 22u, 23u, 24u})
+        {
+            IopCpuState cpu{}; cpu.gpr[4] = 0x6BF8014Au;
+            rejects([&] { (void)f.timers.dispatchImport(ordinal, cpu, 0u); }, "reserved by the modeled kernel");
+        }
+        IopCpuState reference{}; reference.gpr[4] = 1u; reference.gpr[5] = 32u;
+        require(f.timers.dispatchImport(5u, reference, 0u) && reference.gpr[2] == uint32_t(-150),
+                "ReferHardTimer exposed the private system clock");
+    }
+
+    void faultsUnwindScopeAndCannotResurrect()
+    {
+        Fixture f; require(f.set(1u) == 0 && f.set(2u) == 0, "fault setup failed");
+        f.executor.action = [](const Call &) -> uint32_t { throw std::runtime_error("authored callback fault"); };
+        rejects([&] { f.due(10000u); }, "authored callback fault");
+        require(!f.intrman.inInterruptContext(), "throw leaked interrupt scope");
+        f.executor.action = {};
+        f.due(10000u); f.due(20000u);
+        require(f.executor.calls.size() == 2u && f.executor.calls[1].argument == 2u,
+                "exception resurrected its callback or left the service recursively locked");
+        Fixture overflow; overflow.clock(uint64_t(INT64_MAX)); require(overflow.set() == 0, "horizon setup failed");
+        overflow.executor.action = [](const Call &) { return 1u; };
+        rejects([&] { overflow.due(uint64_t(INT64_MAX)); }, "rearm exceeds");
+        require(!overflow.intrman.inInterruptContext(), "rearm overflow leaked interrupt context");
+        Fixture clock; require(clock.set() == 0, "unsupported clock setup failed");
+        rejects([&] { clock.due(UINT64_MAX); }, "delivery exceeds");
+        require(clock.executor.calls.empty(), "unsupported clock executed a callback");
+    }
+
+    void rawTimerRegistersRespectOwnershipAndAccessSpans()
+    {
+        IopMemory standalone;
+        standalone.write32(0xBF8014A4u, 0x12345678u);
+        require(standalone.read32(0xBF8014A4u) == 0x12345678u,
+                "standalone memory gained an unrequested kernel reservation");
+        Fixture f;
+        f.memory.write32(0xBF80149Cu, 0xAABBCCDDu);
+        for (uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            const uint32_t base = alias | 0x1F8014A0u;
+            for (uint32_t offset : {0u, 4u, 8u})
+            {
+                rejects([&] { (void)f.memory.read8(base + offset); }, "reserved system-alarm timer MMIO");
+                rejects([&] { (void)f.memory.read16(base + offset); }, "reserved system-alarm timer MMIO");
+                rejects([&] { (void)f.memory.read32(base + offset); }, "reserved system-alarm timer MMIO");
+                rejects([&] { f.memory.write8(base + offset, 0u); }, "reserved system-alarm timer MMIO");
+                rejects([&] { f.memory.write16(base + offset, 0u); }, "reserved system-alarm timer MMIO");
+                rejects([&] { f.memory.write32(base + offset, 0u); }, "reserved system-alarm timer MMIO");
+            }
+            rejects([&] { f.memory.write16(base - 1u, 0u); }, "reserved system-alarm timer MMIO");
+            rejects([&] { f.memory.write32(base - 1u, 0u); }, "reserved system-alarm timer MMIO");
+            require(f.memory.read32(0xBF80149Cu) == 0xAABBCCDDu,
+                    "straddling unsupported timer access partially changed adjacent registers");
+        }
+        IopMemory staged = f.memory;
+        rejects([&] { staged.write32(0xBF8014A4u, 0u); }, "reserved system-alarm timer MMIO");
+        f.memory.reset(); f.memory.write32(0xBF8014A4u, 0xCAFEBABEu);
+        require(f.memory.read32(0xBF8014A4u) == 0xCAFEBABEu, "RAM reset retained a stale reservation");
+        f.timers.reset(); f.alarms.reset();
+        rejects([&] { f.memory.write32(0xBF8014A4u, 0u); }, "reserved system-alarm timer MMIO");
+    }
+}
+
+int main()
+{
+    const iop_test::Test tests[] = {
+        {"Minimum clock, one-shot argument, GP and interrupt context", clockClampAndOneShotContext},
+        {"Exact raw pairs, duplicate/cancel errors and deadline FIFO", exactPairErrorsAndFifo},
+        {"Normal/i alarm context errors precede all pointer reads", contextErrorsPrecedePointerReads},
+        {"Nonzero callback intervals rearm from the previous deadline", nonzeroReturnsUsePreviousDeadline},
+        {"Callbacks cancel and register successors after unlink", callbacksCanCancelAndReplaceAfterUnlink},
+        {"Self registration remains independent of nonzero automatic rearm", selfRegistrationAndNonzeroReturnStayIndependent},
+        {"Reset during a callback cannot revive an old lifetime", resetDuringCallbackCannotResurrectOldLifetime},
+        {"Guest spans, aliases and64-bit deadline preflight are atomic", guestPreflightAndClockOverflowAreAtomic},
+        {"Stale callback and record allocation identities cannot affect replacements", callbackAndRecordLeasesRejectReuse},
+        {"Kernel pool overflow consumes bounded IOP heap and returns actual errors", poolOverflowUsesRealHeapAndPreservesErrors},
+        {"Live CPU/IRQ masks preserve pending expiry without idle spin", liveInterruptGatesRetainPendingExpiry},
+        {"A supplied raw timer IRQ cannot be silently bypassed", suppliedRawTimerHandlerCannotBeBypassed},
+        {"Kernel reservation preserves standalone timer allocation", kernelReservationDoesNotChangeStandaloneTimers},
+        {"Callback faults and rearm overflow unwind independent lifetimes", faultsUnwindScopeAndCannotResurrect},
+        {"Raw timer register aliases and straddling accesses preserve ownership", rawTimerRegistersRespectOwnershipAndAccessSpans},
+    };
+    return iop_test::run(tests);
+}
