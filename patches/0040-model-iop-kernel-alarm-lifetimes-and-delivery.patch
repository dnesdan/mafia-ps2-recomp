+    void clockClampAndOneShotContext()
+    {
+        Fixture f; f.clock(1u);
+        require(f.set(0xDEADBEEFu, 100u) == 0 && f.memory.read32(clockAddress) == 3686u &&
+                    f.memory.read32(clockAddress + 4u) == 0u,
+                "SetAlarm did not publish the100us minimum clock");
+        f.due(3785u); require(f.executor.calls.empty(), "alarm fired before its deadline");
+        f.due(3786u); f.due(100000u);
+        require(f.executor.calls.size() == 1u && f.executor.calls[0].function == callbackAddress &&
+                    f.executor.calls[0].argument == 0xDEADBEEFu && f.executor.calls[0].gp == 0x12345678u &&
+                    f.executor.calls[0].interrupt && !f.intrman.inInterruptContext(),
+                "one-shot argument, GP, interrupt scope or removal was lost");
+        require(f.alarms.nextEventCycle(100000u, 120000u) == 120000u, "one-shot retained a deadline");
+    }
