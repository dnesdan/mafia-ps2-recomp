+        explicit AlarmProgram(uint32_t address = 0x10000u) : Program(address)
+        {
+            imports(0x1000u, "thbase", {35u, 36u, 37u, 38u, 34u});
+            imports(0x1300u, "timrman", {4u, 16u});
+            image.words(0x2020u, {1u, 0u});
+        }
+        void set(uint32_t callback = 0x800u, uint32_t argument = 7u, bool irq = false,
+                 uint32_t gp = 0x1337ABCDu)
+        {
+            constant(4u, data(0x20u)); constant(5u, base + callback);
+            constant(6u, argument); constant(28u, gp); call(stub(0x1000u, irq ? 1u : 0u));
+        }
+        void cancel(uint32_t callback, uint32_t argument, bool irq)
+        {
+            constant(4u, base + callback); constant(5u, argument);
+            call(stub(0x1000u, irq ? 3u : 2u));
+        }
+        void marker(uint32_t value, uint32_t address)
+        { constant(8u, value); store(8u, address); }
+    };
+
+    void oneShotRunsOriginalCodeInInterruptContext()
+    {
+        Host host; IopEmulator iop(host); AlarmProgram p;
+        p.begin(); p.set(); p.store(2u, p.data(0x40u)); p.store(28u, p.data(0x44u)); p.finish();
+        p.recordingHandler(0x800u, 0u); start(iop, p);
+        require(word(iop, p.data(0x20u)) == 3686u && word(iop, p.data(0x40u)) == 0u &&
+                    word(iop, p.data(0x44u)) == 0x1337ABCDu && word(iop, p.data()) == 0u,
+                "alarm registration failed to clamp or altered the suspended CPU");
+        advance(iop, 5000u); advance(iop, 10000u);
+        require(word(iop, p.data()) == 1u && word(iop, p.data(0x100u)) == 7u &&
+                    word(iop, p.data(0x104u)) == 0x1337ABCDu && word(iop, p.data(0x108u)) == 1u &&
+                    host.guestWrites == 0u,
+                "the scheduled MIPS callback did not run once with argument, GP and interrupt context");
+    }
+
+    void busyManagedThreadStillReceivesAlarm()
+    {
+        Host host; IopEmulator iop(host); AlarmProgram p;
+        p.image.words(0x2500u, {0x02000000u, 0u, p.base + 0x600u, 0x800u, 40u});
+        p.begin(); p.constant(4u, p.data(0x500u)); p.call(p.stub(0x1200u));
+        p.move(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1200u, 1u)); p.finish();
+        p.begin(0x600u); p.set(0x900u, 0x42u);
+        const uint32_t loop = p.cursor;
+        p.load(8u, p.data(0x60u)); p.emit(0x25080001u); p.store(8u, p.data(0x60u));
+        p.load(9u, p.data(0x64u));
+        const int32_t relative = (static_cast<int32_t>(loop) - static_cast<int32_t>(p.cursor + 4u)) / 4;
+        p.emit(0x11200000u | static_cast<uint16_t>(relative)); p.emit(0u);
+        p.marker(0xC001CAFEu, p.data(0x68u)); p.finish();
+        p.begin(0x900u); p.marker(1u, p.data(0x64u)); p.finish(0u);
+        start(iop, p); advance(iop, 10000u);
+        require(word(iop, p.data(0x60u)) > 100u && word(iop, p.data(0x64u)) == 1u &&
+                    word(iop, p.data(0x68u)) == 0xC001CAFEu,
+                "alarm was serviced only while idle or damaged a suspended running thread");
+    }
+
+    void callbackUsesIAlarmsAndExactErrors()
+    {
+        Host host; IopEmulator iop(host); AlarmProgram p;
+        p.begin();
+        p.constant(4u, 0xFFFFFFFFu); p.constant(5u, 0u); p.call(p.stub(0x1000u, 1u)); p.store(2u, p.data(0x40u));
+        p.constant(4u, 0u); p.constant(5u, 0u); p.call(p.stub(0x1000u, 3u)); p.store(2u, p.data(0x44u));
+        p.set(); p.finish();
+        p.begin(0x800u);
+        p.set(0xC00u, 8u, false); p.store(2u, p.data(0x48u));
+        p.set(0xC00u, 8u, true); p.store(2u, p.data(0x4Cu));
+        p.set(0xC00u, 8u, true); p.store(2u, p.data(0x50u));
+        p.cancel(0xC00u, 8u, false); p.store(2u, p.data(0x54u));
+        p.cancel(0xC00u, 8u, true); p.store(2u, p.data(0x58u));
+        p.cancel(0xC00u, 8u, true); p.store(2u, p.data(0x5Cu));
+        p.marker(1u, p.data(0x60u)); p.finish(0u);
+        p.recordingHandler(0xC00u, 0u);
+        require(p.cursor < 0x1000u, "authored callback overlapped imports");
+        start(iop, p); advance(iop, 15000u);
+        const uint32_t expected[] = {uint32_t(-100), uint32_t(-100), uint32_t(-100), 0u,
+                                     uint32_t(-104), uint32_t(-100), 0u, uint32_t(-105)};
+        for (size_t index = 0u; index < std::size(expected); ++index)
+            require(word(iop, p.data(0x40u + static_cast<uint32_t>(index) * 4u)) == expected[index],
+                    "normal/i context, duplicate or cancellation return did not follow the primary ABI");
+        require(word(iop, p.data(0x60u)) == 1u && word(iop, p.data()) == 0u,
+                "iCancelAlarm did not prevent its real MIPS callback");
+    }
+
+    void hardwareMaskResumeAndReset()
+    {
+        for (bool reset : {false, true})
+        {
+            Host host; IopEmulator iop(host); AlarmProgram p;
+            p.begin();
+            p.constant(4u, p.data(0x40u)); p.call(p.stub(0x1100u));
+            p.constant(4u, 16u); p.constant(5u, 0u); p.call(p.stub(0x1100u, 4u));
+            p.set(); p.finish(); p.recordingHandler(0x800u, 0u);
+            start(iop, p); advance(iop, 15000u);
+            require(word(iop, p.data()) == 0u, "masked alarm ran before resume");
+            if (reset)
+            {
+                iop.reset(); AlarmProgram empty; empty.begin(); empty.finish(); start(iop, empty);
+                advance(iop, 15000u); require(word(iop, empty.data()) == 0u, "reset retained a stale pending alarm");
+            }
+            else
+            {
+                AlarmProgram resume(0x20000u); resume.begin();
+                resume.load(8u, 0xBF801074u); resume.constant(9u, 1u << 16u);
+                resume.emit(0x01094025u); resume.store(8u, 0xBF801074u);
+                resume.constant(4u, 1u); resume.call(resume.stub(0x1100u, 1u)); resume.finish();
+                start(iop, resume); advance(iop, 2000u);
+                require(word(iop, p.data()) == 1u,
+                        "direct I_MASK/CpuResumeIntr did not deliver the real pending alarm exactly once");
+            }
+        }
+    }
+
+    void suppliedExportsAndMajorVersions()
+    {
+        for (uint32_t ordinal = 35u; ordinal <= 38u; ++ordinal)
+        {
+            for (const auto [provided, requested] : {std::pair<uint32_t, uint32_t>{0x0101u, 0x0101u},
+                                                     {0x0106u, 0x0101u}, {0x0201u, 0x0201u}})
+            {
+                Host host; IopEmulator iop(host); AlarmProgram p;
+                p.image.words(0x1008u, {requested});
+                p.image.words(0x1800u, {0x41C00000u, 0u, provided, 0x61626874u, 0x00006573u});
+                for (uint32_t slot = 0u; slot <= 38u; ++slot) p.image.words(0x1814u + slot * 4u, {p.base + 0x900u});
+                p.begin(); p.constant(4u, p.base + 0x1800u); p.call(p.stub(0x1500u));
+                p.constant(4u, 0xFFFFFFFFu); p.constant(5u, 0u); p.constant(6u, 0xDEADBEEFu);
+                p.call(p.stub(0x1000u, ordinal - 35u)); p.store(2u, p.data(0x40u)); p.finish();
+                p.begin(0x900u); p.marker(0xABCDEF01u, p.data()); p.finish(0x5A3u);
+                start(iop, p);
