+        require(f.memory.freeAllocation(blocker) && f.set(31u) == 0 &&
+                    f.memory.totalFreeMemory() == available - 32u,
+                "overflow alarm did not consume a real bounded IOP record");
+        require(f.call(37u, callbackAddress, 31u) == 0 && f.memory.totalFreeMemory() == available,
+                "cancellation leaked the dynamic alarm record");
+        require(f.set(31u) == 0, "dynamic reallocation failed"); f.alarms.reset();
+        require(f.memory.totalFreeMemory() == available, "reset leaked a dynamic alarm record");
+    }
