+            case 1u: clock += 1u; break;
+            case 2u: clock = 0x20002000u; break;
+            case 3u: clock = 0x1F801074u; break;
+            case 4u: clock = IopMemory::RamSize - 4u; f.memory.write32(clock, 1u); break;
+            case 5u: callback = 0u; break;
+            case 6u: callback += 1u; break;
+            case 7u: callback = 0x20003000u; break;
+            case 8u: callback = 0x4000u; break;
