diff --git a/ps2xIOP/src/emulator/imports/iop_alarm.cpp b/ps2xIOP/src/emulator/imports/iop_alarm.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_alarm.cpp
@@ -0,0 +1,243 @@
+#include "iop_alarm.h"
+#include "iop_intrman.h"
+#include "iop_timrman.h"
+
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+#include "../services/iop_rpc.h"
+
+#include <algorithm>
+#include <limits>
+#include <new>
+#include <stdexcept>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // PS2SDK iop/system/threadman/src/{thbase,thcommon}.c:
+        // 100us, converted with floor(usec *4608 /125) at normal IOP clock.
+        constexpr uint64_t kMinimumTicks = 3686u;
+        constexpr uint64_t kMaximumClock = std::numeric_limits<int64_t>::max();
+        constexpr int32_t kIllegalContext = -100;
+        constexpr int32_t kFoundHandler = -104;
+        constexpr int32_t kNotFoundHandler = -105;
+        constexpr int32_t kNoMemory = -400;
+        // The O32 kernel alarm record occupies32 bytes. The built-in pool is
+        // private modeled kernel state; overflow records consume IOP heap.
+        constexpr uint32_t kRecordBytes = 32u;
+    }
+
+    IopAlarms::IopAlarms(IopMemory &memory, IopTimrman &timrman) noexcept
+        : m_memory(memory), m_timrman(timrman)
+    {
+    }
+
+    IopAlarms::~IopAlarms()
+    {
+        for (const Alarm &alarm : m_alarms)
+            releaseRecord(alarm);
+    }
+
+    void IopAlarms::reset()
+    {
+        if (m_generation == std::numeric_limits<uint64_t>::max())
+            throw std::runtime_error("IOP alarm lifetime identity exhausted");
+        for (const Alarm &alarm : m_alarms)
+            releaseRecord(alarm);
+        m_alarms.clear();
+        m_pool.fill(false);
+        ++m_generation;
+        m_servicing = false;
+        m_irq = m_timrman.reserveKernelAlarmTimer(m_memory);
+        // Kernel startup installs/enables this dispatcher once. Subsequent
+        // DisableIntr, I_MASK and CpuSuspendIntr changes remain authoritative.
+        m_memory.setInterruptMask(m_memory.interruptMask() | (1u << m_irq));
+    }
+
+    bool IopAlarms::ownedSpan(uint32_t address, size_t bytes) const
+    {
+        const uint32_t segment = address & 0xE0000000u;
+        const uint32_t physical = IopMemory::physicalAddress(address);
+        return address != 0u && (segment == 0u || segment == 0x80000000u || segment == 0xA0000000u) &&
+            physical < IopMemory::RamSize && bytes <= IopMemory::RamSize - physical &&
+            m_memory.ownsRamRange(address, bytes);
+    }
+
+    void IopAlarms::validateCallback(const Alarm &alarm) const
+    {
+        if ((alarm.callback & 3u) != 0u || !ownedSpan(alarm.callback, 4u))
+            throw std::runtime_error("IOP alarm callback is outside aligned complete owned RAM");
+        if (alarm.codeAllocationIdentity != 0u)
+        {
+            const auto allocation = m_memory.allocationContaining(IopMemory::physicalAddress(alarm.callback));
+            if (!allocation || allocation->identity != alarm.codeAllocationIdentity)
+                throw std::runtime_error("IOP alarm callback allocation lifetime has ended");
+        }
+    }
+
+    bool IopAlarms::acquireRecord(Alarm &alarm)
+    {
+        const auto slot = std::find(m_pool.begin(), m_pool.end(), false);
+        if (slot != m_pool.end())
+        {
+            alarm.poolSlot = static_cast<size_t>(slot - m_pool.begin());
+            *slot = true;
+            return true;
+        }
+        alarm.allocation = m_memory.allocate(kRecordBytes);
+        if (alarm.allocation == 0u)
+            return false;
+        const auto allocation = m_memory.allocationContaining(alarm.allocation);
+        if (!allocation)
+            throw std::logic_error("IOP alarm record allocation has no lifetime");
+        alarm.allocationIdentity = allocation->identity;
+        return true;
+    }
+
+    void IopAlarms::releaseRecord(const Alarm &alarm) noexcept
+    {
+        if (alarm.generation == m_generation && alarm.poolSlot < PoolSize)
+            m_pool[alarm.poolSlot] = false;
+        if (alarm.allocation != 0u)
+            (void)m_memory.freeAllocation(alarm.allocation, alarm.allocationIdentity);
+    }
+
+    std::list<IopAlarms::Alarm>::iterator IopAlarms::insertionPoint(uint64_t deadline)
+    {
+        // Equal deadlines remain FIFO, including a callback's reinserted node.
+        return std::find_if(m_alarms.begin(), m_alarms.end(),
+                           [&](const Alarm &alarm) { return alarm.deadline > deadline; });
+    }
+
+    bool IopAlarms::dispatchImport(uint16_t ordinal, IopCpuState &cpu, uint64_t currentCycle,
+                                   const IopIntrman &intrman)
+    {
+        if (ordinal < 35u || ordinal > 38u)
+            return false;
+        const auto result = [&](int32_t value) { cpu.gpr[2] = static_cast<uint32_t>(value); };
+        const bool interruptOnly = ordinal == 36u || ordinal == 38u;
+        if (intrman.inInterruptContext() != interruptOnly)
+        {
+            result(kIllegalContext);
+            return true;
+        }
+        const bool setting = ordinal == 35u || ordinal == 36u;
+        const uint32_t callback = cpu.gpr[setting ? 5u : 4u];
+        const uint32_t argument = cpu.gpr[setting ? 6u : 5u];
+        const auto existing = std::find_if(m_alarms.begin(), m_alarms.end(), [&](const Alarm &alarm)
+        { return alarm.callback == callback && alarm.argument == argument; });
+        if (!setting)
+        {
+            if (existing == m_alarms.end())
+                result(kNotFoundHandler);
+            else
+            {
+                releaseRecord(*existing);
+                m_alarms.erase(existing);
+                result(0);
+            }
+            return true;
+        }
+        if (existing != m_alarms.end())
+        {
+            result(kFoundHandler);
+            return true;
+        }
+
+        const uint32_t clock = cpu.gpr[4];
+        if ((clock & 3u) != 0u || !ownedSpan(clock, 8u))
+            throw std::runtime_error("IOP alarm clock is outside aligned complete owned RAM");
+        Alarm alarm;
+        alarm.generation = m_generation;
+        alarm.callback = callback;
+        alarm.argument = argument; // Opaque value: the API does not dereference it.
+        alarm.gp = cpu.gpr[28];
+        validateCallback(alarm);
+        if (const auto allocation = m_memory.allocationContaining(IopMemory::physicalAddress(callback)))
+            alarm.codeAllocationIdentity = allocation->identity;
+        const uint64_t requested = uint64_t(m_memory.read32(clock)) |
+                                   (uint64_t(m_memory.read32(clock + 4u)) << 32u);
+        const uint64_t delay = std::max(requested, kMinimumTicks);
+        // The primary queue compares signed64 clocks. Values outside that
+        // monotonic horizon, and overflowing additions, have no modeled time.
+        if (currentCycle > kMaximumClock || delay > kMaximumClock - currentCycle)
+            throw std::runtime_error("IOP alarm deadline exceeds the supported clock horizon");
+        alarm.deadline = currentCycle + delay;
+        try
+        {
+            if (!acquireRecord(alarm))
+            {
+                result(kNoMemory);
+                return true;
+            }
+            m_alarms.insert(insertionPoint(alarm.deadline), alarm);
+        }
+        catch (const std::bad_alloc &)
+        {
+            releaseRecord(alarm);
+            result(kNoMemory);
+            return true;
+        }
+        // Publish the documented clamp only once the complete registration
+        // has succeeded. Errors and duplicates never alter the caller's clock.
+        if (requested < kMinimumTicks)
+            m_memory.write32(clock, static_cast<uint32_t>(kMinimumTicks));
+        result(0);
+        return true;
+    }
+
+    void IopAlarms::serviceDue(uint64_t currentCycle, IopGuestExecutor &executor, const IopIntrman &intrman)
+    {
+        if (m_servicing || intrman.inInterruptContext() || m_alarms.empty() ||
+            m_alarms.front().deadline > currentCycle || m_memory.interruptControl() == 0u ||
+            (m_memory.interruptMask() & (1u << m_irq)) == 0u)
+            return;
+        if (currentCycle > kMaximumClock)
+            throw std::runtime_error("IOP alarm delivery exceeds the supported clock horizon");
+        if (intrman.hasRegisteredInterrupt(static_cast<int>(m_irq)))
+            throw std::runtime_error("IOP alarm delivery cannot bypass a supplied raw system-timer IRQ handler");
+
+        // Unlink before calling guest code, exactly as threadman's timer IRQ.
+        // The callback may cancel/register other alarms, or reset the owner.
+        // Keep this node independently alive and reinsert without allocation.
+        std::list<Alarm> active;
+        active.splice(active.begin(), m_alarms, m_alarms.begin());
+        Alarm &alarm = active.front();
+        m_servicing = true;
+        struct Guard
+        {
+            IopAlarms &owner;
+            Alarm &alarm;
+            bool ownsRecord = true;
+            ~Guard()
+            {
+                if (ownsRecord) owner.releaseRecord(alarm);
+                owner.m_servicing = false;
+            }
+        } guard{*this, alarm};
+        validateCallback(alarm);
+        const uint32_t next = intrman.executeInterruptCallback(alarm.callback, alarm.argument, alarm.gp, executor);
+        if (alarm.generation != m_generation || next == 0u)
+            return;
+        const uint64_t interval = std::max<uint64_t>(next, kMinimumTicks);
+        if (interval > kMaximumClock - alarm.deadline)
+            throw std::runtime_error("IOP alarm rearm exceeds the supported clock horizon");
+        alarm.deadline += interval; // Relative to its previous scheduled expiry.
+        m_alarms.splice(insertionPoint(alarm.deadline), active, active.begin());
+        guard.ownsRecord = false;
+    }
+
+    uint64_t IopAlarms::nextEventCycle(uint64_t currentCycle, uint64_t fallback) const noexcept
+    {
+        if (m_alarms.empty())
+            return fallback;
+        const uint64_t deadline = m_alarms.front().deadline;
+        // An already pending masked alarm cannot wake an idle CPU every tick.
+        // It remains queued and is checked again at the next real event/pump.
+        if (deadline <= currentCycle && (m_memory.interruptControl() == 0u ||
+                                        (m_memory.interruptMask() & (1u << m_irq)) == 0u))
+            return fallback;
+        return std::min(fallback, deadline);
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_alarm.h b/ps2xIOP/src/emulator/imports/iop_alarm.h
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_alarm.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <list>
+
+namespace ps2x::iop::detail
+{
+    struct IopCpuState;
+    class IopGuestExecutor;
+    class IopIntrman;
+    class IopMemory;
+    class IopTimrman;
+
+    // The modeled thread manager owns the system timer and its alarm queue.
+    // No guest-visible alarm handle or record layout is invented by this API.
+    class IopAlarms
+    {
+    public:
+        IopAlarms(IopMemory &memory, IopTimrman &timrman) noexcept;
+        ~IopAlarms();
+        IopAlarms(const IopAlarms &) = delete;
+        IopAlarms &operator=(const IopAlarms &) = delete;
+
+        void reset();
+        [[nodiscard]] bool dispatchImport(uint16_t ordinal, IopCpuState &cpu, uint64_t currentCycle,
+                                          const IopIntrman &intrman);
+        void serviceDue(uint64_t currentCycle, IopGuestExecutor &executor, const IopIntrman &intrman);
+        [[nodiscard]] uint64_t nextEventCycle(uint64_t currentCycle, uint64_t fallback) const noexcept;
+
+    private:
+        // PS2SDK thcommon.c initializes ids2..33 after the internal id1 clock
+        // alarm; alarm_free retains only ids<33, leaving31 reusable records.
+        static constexpr size_t PoolSize = 31u;
+        struct Alarm
+        {
+            uint64_t deadline = 0u;
+            uint64_t generation = 0u;
+            uint32_t callback = 0u;
+            uint32_t argument = 0u;
+            uint32_t gp = 0u;
+            uint64_t codeAllocationIdentity = 0u;
+            size_t poolSlot = PoolSize;
+            uint32_t allocation = 0u;
+            uint64_t allocationIdentity = 0u;
+        };
+
+        [[nodiscard]] bool ownedSpan(uint32_t address, size_t bytes) const;
+        void validateCallback(const Alarm &alarm) const;
+        [[nodiscard]] bool acquireRecord(Alarm &alarm);
+        void releaseRecord(const Alarm &alarm) noexcept;
+        [[nodiscard]] std::list<Alarm>::iterator insertionPoint(uint64_t deadline);
+
+        IopMemory &m_memory;
+        IopTimrman &m_timrman;
+        std::list<Alarm> m_alarms;
+        std::array<bool, PoolSize> m_pool{};
+        uint64_t m_generation = 0u;
+        uint32_t m_irq = 16u;
+        bool m_servicing = false;
+    };
+}
