+    struct Call { uint32_t function, argument, gp; bool interrupt; };
+    struct Executor final : IopGuestExecutor
+    {
+        IopIntrman &intrman;
+        std::vector<Call> calls;
+        std::function<uint32_t(const Call &)> action;
+        explicit Executor(IopIntrman &value) : intrman(value) {}
+        uint32_t executeGuestFunction(uint32_t function, uint32_t a0, uint32_t, uint32_t,
+                                       uint32_t, uint32_t gp) override
+        {
+            const Call call{function, a0, gp, intrman.inInterruptContext()};
+            calls.push_back(call);
+            return action ? action(call) : 0u;
+        }
+    };
+    struct Fixture
+    {
+        IopMemory memory;
+        IopTimrman timers;
+        IopIntrman intrman{memory};
+        IopAlarms alarms{memory, timers};
+        Executor executor{intrman};
+        Fixture()
+        {
+            timers.reset(); alarms.reset();
+            memory.write32(callbackAddress, 0x03E00008u);
+            clock(10000u);
+        }
+        void clock(uint64_t value, uint32_t address = clockAddress)
+        {
+            memory.write32(address, static_cast<uint32_t>(value));
+            memory.write32(address + 4u, static_cast<uint32_t>(value >> 32u));
+        }
+        int32_t call(uint16_t ordinal, uint32_t a0, uint32_t a1, uint32_t a2 = 0u,
+                     uint64_t now = 0u, uint32_t gp = 0x12345678u)
+        {
+            IopCpuState cpu{}; cpu.gpr[4] = a0; cpu.gpr[5] = a1; cpu.gpr[6] = a2; cpu.gpr[28] = gp;
+            require(alarms.dispatchImport(ordinal, cpu, now, intrman), "alarm ordinal unresolved");
+            return static_cast<int32_t>(cpu.gpr[2]);
+        }
+        int32_t set(uint32_t argument = 0u, uint64_t now = 0u, uint32_t callback = callbackAddress)
+        { return call(35u, clockAddress, callback, argument, now); }
+        void irq(const std::function<void()> &body)
+        {
+            Executor scope(intrman);
+            scope.action = [&](const Call &) { body(); return 0u; };
+            (void)intrman.executeInterruptCallback(callbackAddress, 0u, 0u, scope);
+        }
+        void due(uint64_t now) { alarms.serviceDue(now, executor, intrman); }
+    };
+    void rejects(const std::function<void()> &body, std::string_view expected)
+    {
+        try { body(); }
+        catch (const std::runtime_error &error)
+        {
+            require(std::string_view(error.what()).find(expected) != std::string_view::npos,
+                    "alarm fault lost its concrete cause");
+            return;
+        }
+        throw std::runtime_error("unsupported alarm operation silently succeeded");
+    }
