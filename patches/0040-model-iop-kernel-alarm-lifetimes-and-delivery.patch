+    void guestPreflightAndClockOverflowAreAtomic()
+    {
+        for (unsigned variant = 0u; variant < 11u; ++variant)
+        {
+            Fixture f; uint32_t clock = clockAddress, callback = callbackAddress; uint64_t now = 0u;
+            switch (variant)
