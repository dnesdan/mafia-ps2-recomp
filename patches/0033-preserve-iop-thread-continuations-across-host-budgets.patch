diff --git a/ps2xIOP/tests/iop_scheduler_fixtures.h b/ps2xIOP/tests/iop_scheduler_fixtures.h
new file mode 100644
index 0000000..58b6200
--- /dev/null
+++ b/ps2xIOP/tests/iop_scheduler_fixtures.h
@@ -0,0 +1,286 @@
+#pragma once
+
+#include "iop_compat_test_support.h"
+#include "iop_vblank_fixtures.h"
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+
+namespace iop_scheduler_test
+{
+    using namespace ps2x::iop::detail;
+    using iop_test::require;
+    using iop_vblank_test::Program;
+
+    // Entirely authored kernel and MIPS programs. No original driver bytes.
+    struct Fixture
+    {
+        IopMemory memory;
+        IopKernel kernel{memory};
+        static constexpr uint32_t sentinel = 0xFFFF0000u;
+
+        int call(uint16_t ordinal, uint32_t a0 = 0u, uint32_t a1 = 0u, IopCpuState *active = nullptr)
+        {
+            IopCpuState local{};
+            IopCpuState &cpu = active == nullptr ? local : *active;
+            cpu.gpr[4] = a0;
+            cpu.gpr[5] = a1;
+            require(kernel.dispatchThreadImport(ordinal, cpu, 0u), "authored thread import absent");
+            return static_cast<int>(cpu.gpr[2]);
+        }
+        int create(uint32_t priority = 40u)
+        {
+            memory.write32(0x10000u, 0u);
+            memory.write32(0x10004u, 0u);
+            memory.write32(0x10008u, 0x10400u);
+            memory.write32(0x1000Cu, 0x1000u);
+            memory.write32(0x10010u, priority);
+            const int id = call(4u, 0x10000u);
+            require(id > 0, "authored thread allocation failed");
+            return id;
+        }
+        int start(uint32_t priority = 40u)
+        {
+            const int id = create(priority);
+            require(call(6u, id) == 0, "authored thread start failed");
+            return id;
+        }
+        IopThread &next(int id)
+        {
+            IopThread *thread = kernel.beginNextReady(0u);
+            require(thread != nullptr && thread->id == id, "wrong guest scheduling order");
+            return *thread;
+        }
+        void end(IopThread &thread) { kernel.endTimeslice(thread, sentinel); }
+        void sleep(IopThread &thread)
+        {
+            require(call(24u, 0u, 0u, &thread.cpu) == 0, "authored SleepThread failed");
+            end(thread);
+        }
+        void finish(IopThread &thread)
+        {
+            thread.cpu.pc = sentinel;
+            end(thread);
+        }
+    };
+
+    inline void equalPriorityContinuation()
+    {
+        Fixture f;
+        const int older = f.start(), newer = f.start();
+        f.sleep(f.next(older));
+        IopThread &running = f.next(newer);
+        require(f.call(25u, older) == 0, "could not wake the equal-priority peer");
+        f.end(running); // The host budget expires; the guest has not yielded.
+        f.next(newer);
+        f.finish(running);
+        f.next(older);
+    }
+
+    inline void fifoReadinessAndPreemptedFront()
+    {
+        Fixture f;
+        const int a = f.create(), b = f.create(), c = f.create();
+        require(f.call(6u, c) == 0 && f.call(6u, a) == 0 && f.call(6u, b) == 0, "FIFO starts failed");
+        f.finish(f.next(c));
+        f.finish(f.next(a));
+        f.finish(f.next(b));
+
+        const int older = f.start(), runningId = f.start();
+        f.sleep(f.next(older));
+        IopThread &running = f.next(runningId);
+        require(f.call(25u, older) == 0, "peer wake failed");
+        const int high = f.start(10u);
+        f.end(running);
+        f.sleep(f.next(high));
+        // A higher-priority preemption does not move its victim behind peers.
+        f.finish(f.next(runningId));
+        f.next(older);
+    }
+
+    inline void criticalSectionAcrossBudgets()
+    {
+        Fixture f;
+        const int low = f.start(60u);
+        IopThread &running = f.next(low);
+        f.memory.setInterruptControl(0u);
+        const int high = f.start(10u);
+        f.end(running);
+        f.next(low);
+        f.memory.setInterruptControl(1u);
+        f.end(running);
+        f.next(high);
+    }
+
+    inline void explicitRotationAndPriority()
+    {
+        Fixture f;
+        const int a = f.start(), b = f.start(), c = f.start();
+        IopThread &first = f.next(a);
+        require(f.call(16u, 0u, 0u, &first.cpu) == 0, "explicit rotation failed");
+        f.end(first);
+        IopThread &second = f.next(b);
+        require(f.call(14u, 0u, 60u, &second.cpu) == 0, "current priority change failed");
+        f.end(second);
+        f.finish(f.next(c));
+        f.finish(f.next(a));
+        f.finish(f.next(b));
+
+        const int active = f.start(10u), q1 = f.start(50u), q2 = f.start(50u);
+        IopThread &high = f.next(active);
+        require(f.call(16u, 50u, 0u, &high.cpu) == 0 && !high.cpu.yielded,
+                "rotating another priority spuriously yielded the current thread");
+        f.end(high);
+        f.finish(f.next(active));
+        f.finish(f.next(q2));
+        f.next(q1);
+    }
+
+    inline void continuationLifetime()
+    {
+        Fixture f;
+        int id = f.start();
+        IopThread &running = f.next(id);
+        f.end(running);
+        require(f.call(29u, id) == 0 && f.kernel.beginNextReady(0u) == nullptr,
+                "suspended continuation remained runnable");
+        require(f.call(31u, id) == 0, "resume failed");
+        f.next(id);
+        require(f.call(9u, 0u, 0u, &running.cpu) == 0, "ExitDeleteThread failed");
+        f.end(running); // Do not use the deleted reference again.
+        require(f.kernel.threadCount() == 0u && f.kernel.beginNextReady(0u) == nullptr,
+                "ExitDeleteThread left a dead continuation or stack owner");
+        id = f.start();
+        f.end(f.next(id));
+        require(f.call(10u, id) == 0 && f.call(5u, id) == 0 && f.kernel.beginNextReady(0u) == nullptr,
+                "terminated/deleted continuation was reused");
+        id = f.start();
+        f.end(f.next(id));
+        f.kernel.reset();
+        f.memory.reset();
+        require(f.kernel.beginNextReady(0u) == nullptr && f.kernel.threadCount() == 0u,
+                "reset retained a running or ready thread");
+        require(f.start() == 1, "reset did not restore thread identity state");
+        f.next(1);
+    }
+
+    inline void createThread(Program &p, uint32_t descriptor, uint32_t offset, uint32_t priority)
+    {
+        p.image.words(descriptor - p.base, {0u, 0u, p.base + offset, 0x1000u, priority});
+        p.constant(4u, descriptor);
+        p.call(p.stub(0x1200u));
+        p.move(4u, 2u);
+        p.constant(5u, 0u);
+        p.call(p.stub(0x1200u, 1u));
+    }
+
+    inline Program handshake(uint32_t waiterPriority)
+    {
+        Program p;
+        p.imports(0x1300u, "thevent", {4u, 6u, 10u});
+        p.image.words(0x2000u, {2u, 0u, 0u});
+        p.begin();
+        p.constant(4u, p.data());
+        p.call(p.stub(0x1300u));
+        p.store(2u, p.data(0x40u));
+        createThread(p, p.data(0x100u), 0x400u, waiterPriority);
+        createThread(p, p.data(0x120u), 0x600u, 40u);
+        p.finish();
+
+        // The older peer waits, then observes the publishing thread's marker.
+        p.begin(0x400u);
+        p.load(4u, p.data(0x40u));
+        p.constant(5u, 1u); p.constant(6u, 0x10u); p.constant(7u, 0u);
+        p.call(p.stub(0x1300u, 2u));
+        p.load(8u, p.data(0x50u));
+        p.store(8u, p.data(0x54u));
+        p.constant(8u, 1u); p.store(8u, p.data(0x58u));
+        p.finish();
+
+        p.begin(0x600u);
+        p.load(4u, p.data(0x40u)); p.constant(5u, 1u);
+        p.call(p.stub(0x1300u, 1u));
+        for (size_t i = 0u; i < 32u; ++i) p.emit(0u);
+        p.constant(8u, 0xC0DEC0DEu); p.store(8u, p.data(0x50u));
+        p.finish();
+        return p;
+    }
+
+    inline void runHandshake(uint32_t waiterPriority, uint32_t quantum, uint32_t expected)
+    {
+        iop_test::Host host;
+        IopEmulator iop(host);
+        const Program p = handshake(waiterPriority);
+        iop_vblank_test::start(iop, p);
+        for (uint32_t left = 8000u; left != 0u;)
+        {
+            const uint32_t step = std::min(left, quantum);
+            iop.runEeCycles(step);
+            left -= step;
+        }
+        iop.checkExecutionFailure();
+        require(iop_vblank_test::word(iop, p.data(0x50u)) == 0xC0DEC0DEu &&
+                iop_vblank_test::word(iop, p.data(0x58u)) == 1u,
+                "authored handshake did not finish within its cycle bound");
+        require(iop_vblank_test::word(iop, p.data(0x54u)) == expected,
+                "host chunk size changed the guest event handshake order");
+    }
+
+    inline void authoredEqualPriorityHandshake()
+    {
+        for (const uint32_t quantum : {8000u, 32u, 8u})
+            runHandshake(40u, quantum, 0xC0DEC0DEu);
+    }
+
+    inline void authoredHigherPriorityPreemption()
+    {
+        for (const uint32_t quantum : {8000u, 32u, 8u})
+            runHandshake(20u, quantum, 0u);
+    }
+
