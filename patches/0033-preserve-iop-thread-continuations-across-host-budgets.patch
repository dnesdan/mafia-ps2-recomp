+        p.begin();
+        createThread(p, p.data(0x100u), 0x400u, 40u);
+        p.constant(4u, 1u); p.constant(5u, 32u); p.constant(6u, 1u);
+        p.call(p.stub(0x1600u));
+        p.store(2u, p.data(0x60u));
+        p.move(4u, 2u); p.constant(5u, 1000u); p.constant(6u, p.base + 0x800u); p.constant(7u, 0u);
+        p.call(p.stub(0x1600u, 1u));
+        p.load(4u, p.data(0x60u)); p.constant(5u, 1u); p.constant(6u, 0u); p.constant(7u, 1u);
+        p.call(p.stub(0x1600u, 2u));
+        p.load(4u, p.data(0x60u)); p.call(p.stub(0x1600u, 3u));
+        p.finish();
+
+        p.cursor = 0x400u;
+        p.constant(8u, 0u); p.constant(9u, p.data(0x84u));
+        const uint32_t loop = p.base + p.cursor;
+        p.emit(0x25080001u); p.emit(0xAD280000u);
+        p.emit(0x08000000u | (loop >> 2u)); p.emit(0u);
+        p.begin(0x800u);
+        for (size_t i = 0u; i < 128u; ++i) p.emit(0u);
+        p.constant(8u, 1u); p.store(8u, p.data(0x80u));
+        p.finish(0u); // One-shot timer.
+
+        iop_test::Host host;
+        IopEmulator iop(host);
+        iop_vblank_test::start(iop, p);
+        bool observed = false;
+        for (size_t attempt = 0u; attempt < 3000u; ++attempt)
+        {
+            const uint32_t before = iop_vblank_test::word(iop, p.data(0x84u));
+            iop.runEeCycles(8u); // One IOP cycle, much shorter than the callback.
+            iop.checkExecutionFailure();
+            if (iop_vblank_test::word(iop, p.data(0x80u)) != 0u)
+            {
+                const uint32_t after = iop_vblank_test::word(iop, p.data(0x84u));
+                require(after - before <= 1u,
+                        "callback overrun underflowed the remaining budget and ran an extra thread slice");
+                observed = true;
+                break;
+            }
+        }
+        require(observed, "authored timer callback did not run within its cycle bound");
+    }
+}
