+        IopEmulator iop(host);
+        Program p;
+        p.begin(); p.registerHandler(0u, 16u, 0x600u, 0u); p.finish();
+        p.begin(0x600u);
+        p.release(0u, 0x600u); p.store(2u, p.data(0x40u));
+        p.registerHandler(0u, 16u, 0x800u, 0u); p.store(2u, p.data(0x44u));
+        p.load(8u, p.data()); p.emit(0x25080001u); p.store(8u, p.data());
+        p.finish(0u);
+        p.recordingHandler(0x800u);
+        start(iop, p);
+        advance(iop, 4u * kVblankPeriodCycles);
+        require(word(iop, p.data()) == 1u && word(iop, p.data(0x40u)) == uint32_t(-100) &&
+                    word(iop, p.data(0x44u)) == uint32_t(-100),
+                "return-zero handler remained installed or callback mutated the handler list");
