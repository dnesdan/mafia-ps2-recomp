+    inline void suppliedPhaseInterruptOwnsDelivery()
+    {
+        for (const uint32_t phase : {0u, 1u})
+        {
+            Host host;
+            IopEmulator iop(host);
+            Program p;
+            const uint32_t irq = phase == 0u ? 0u : 11u;
+            p.begin();
+            p.registerHandler(phase, 16u, 0x600u, 1u, 0xA001u);
+            p.constant(4u, irq); p.constant(5u, 0u);
+            p.constant(6u, p.base + 0x700u); p.constant(7u, 2u); p.constant(28u, 0xA002u);
+            p.call(p.stub(0x1100u, 5u)); // Register the actual phase IRQ owner.
+            p.constant(4u, irq); p.call(p.stub(0x1100u, 3u));
+            p.finish(); p.recordingHandler(0x600u); p.recordingHandler(0x700u);
+            start(iop, p);
+            advance(iop, kVblankPeriodCycles);
+            require(word(iop, p.data()) == 1u && word(iop, p.data(0x100u)) == 2u &&
+                        word(iop, p.data(0x104u)) == 0xA002u && word(iop, p.data(0x108u)) == 1u,
+                    "modeled VBlank chain bypassed or duplicated the supplied phase IRQ handler");
+            Program unmask(0x20000u);
+            unmask.begin(); unmask.constant(4u, irq); unmask.constant(5u, 0u);
+            unmask.call(unmask.stub(0x1100u, 4u)); // DisableIntr records a disabled convenience entry.
+            unmask.load(8u, 0xBF801074u); unmask.constant(9u, 1u << irq);
+            unmask.emit(0x01094025u); unmask.store(8u, 0xBF801074u); unmask.finish();
+            start(iop, unmask); advance(iop, kVblankPeriodCycles);
+            require(word(iop, p.data()) == 2u && word(iop, p.data(0x110u)) == 2u,
+                    "stale EnableIntr bookkeeping shadowed the supplied handler after a direct I_MASK re-enable");
+            Program release(0x30000u);
+            release.begin(); release.constant(4u, irq); release.call(release.stub(0x1100u, 6u)); release.finish();
+            start(iop, release);
+            advance(iop, kVblankPeriodCycles);
+            require(word(iop, p.data()) == 3u && word(iop, p.data(0x120u)) == 1u &&
+                        word(iop, p.data(0x124u)) == 0xA001u && word(iop, p.data(0x128u)) == 1u,
+                    "releasing the supplied phase IRQ failed to restore the modeled dispatcher");
+
+            Host onlyHost;
+            IopEmulator onlyIop(onlyHost);
+            Program only;
+            only.begin();
+            only.constant(4u, irq); only.constant(5u, 0u);
+            only.constant(6u, only.base + 0x700u); only.constant(7u, 3u);
+            only.call(only.stub(0x1100u, 5u));
+            only.constant(4u, irq); only.call(only.stub(0x1100u, 3u)); only.finish();
+            only.recordingHandler(0x700u);
+            start(onlyIop, only); advance(onlyIop, 3u * kVblankPeriodCycles);
+            require(word(onlyIop, only.data()) == 3u,
+                    "idle scheduling skipped supplied phase IRQs without modeled VBlank registrations");
+        }
+    }
