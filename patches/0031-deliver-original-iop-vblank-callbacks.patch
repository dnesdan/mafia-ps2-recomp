+    inline void suppliedExportKeepsPrecedence()
+    {
+        Host host;
+        IopEmulator iop(host);
+        Program provider(0x20000u);
+        provider.begin(); provider.constant(4u, provider.base + 0x1600u);
+        provider.call(provider.stub(0x1500u)); provider.finish();
+        provider.image.words(0x800u, {0x03E00008u, 0x24021234u});
+        provider.image.words(0x1600u, {0x41C00000u, 0u, 0x0101u, 0x616C6276u, 0x00006B6Eu,
+            0x20800u, 0x20800u, 0x20800u, 0x20800u, 0x20800u,
+            0x20800u, 0x20800u, 0x20800u, 0x20800u, 0x20800u, 0u});
+        start(iop, provider);
+        Program consumer;
+        consumer.begin();
+        consumer.registerHandler(0u, 16u, 0x600u, 0u); consumer.store(2u, consumer.data());
+        consumer.release(0u, 0x600u); consumer.store(2u, consumer.data(4u)); consumer.finish();
+        start(iop, consumer);
+        require(word(iop, consumer.data()) == 0x1234u && word(iop, consumer.data(4u)) == 0x1234u,
+                "modeled VBlank imports shadowed a compatible supplied guest export");
+    }
