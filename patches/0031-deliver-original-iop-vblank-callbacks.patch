+    inline void maskedEdgesCoalesceUntilResume()
+    {
+        for (const uint32_t mask : {1u, 2u, 3u})
+        {
+            Host host;
+            IopEmulator iop(host);
+            Program p;
+            p.begin();
+            p.registerHandler(0u, 16u, 0x600u, 7u);
+            if (mask & 1u)
+            {
+                p.constant(4u, p.data(0x40u)); p.call(p.stub(0x1100u));
+            }
+            if (mask & 2u)
+            {
+                p.constant(4u, 0u); p.constant(5u, 0u); p.call(p.stub(0x1100u, 4u));
+            }
+            p.finish(); p.recordingHandler(0x600u);
+            start(iop, p);
+            advance(iop, 3u * kVblankPeriodCycles + 10000u);
+            require(word(iop, p.data()) == 0u, "masked VBlank callback ran before CPU/line resume");
+            Program resume(0x20000u);
+            resume.begin();
+            // Direct mask writes are authoritative, independently of the
+            // intrman's convenience EnableIntr bookkeeping.
+            resume.load(8u, 0xBF801074u); resume.emit(0x35080001u); resume.store(8u, 0xBF801074u);
+            resume.constant(4u, 1u); resume.call(resume.stub(0x1100u, 1u));
+            resume.load(8u, 0xBF801070u); resume.store(8u, resume.data());
+            resume.finish();
+            start(iop, resume);
+            require(word(iop, p.data()) == 1u && word(iop, resume.data()) == 0u,
+                    "resume lost/replayed masked edges or also asserted an unprovided raw interrupt vector");
+            advance(iop, kVblankPeriodCycles);
+            require(word(iop, p.data()) == 2u, "VBlank cadence did not resume after the coalesced edge");
+        }
+    }
+
+    inline void resetDropsRegistrationsAndPendingEdges()
+    {
+        Host host;
+        IopEmulator iop(host);
+        Program p;
+        p.begin(); p.registerHandler(0u, 16u, 0x600u, 1u);
+        p.constant(4u, p.data(0x40u)); p.call(p.stub(0x1100u)); p.finish();
+        p.recordingHandler(0x600u);
+        start(iop, p); advance(iop, 3u * kVblankPeriodCycles);
+        iop.reset();
+        Program empty;
+        empty.begin(); empty.finish();
+        start(iop, empty); advance(iop, 2u * kVblankPeriodCycles);
+        require(word(iop, empty.data()) == 0u, "reset retained a stale VBlank callback or pending phase");
+        Program fresh(0x20000u);
+        fresh.begin(); fresh.registerHandler(0u, 16u, 0x600u, 2u); fresh.finish();
+        fresh.recordingHandler(0x600u);
+        start(iop, fresh); advance(iop, kVblankPeriodCycles);
+        require(word(iop, fresh.data()) == 1u, "fresh VBlank registration did not work after reset");
+    }
+
+    inline void strictCallbacksAndRetirement()
+    {
+        for (const bool retired : {false, true})
+        {
+            Host host;
+            IopEmulator iop(host);
+            Program p;
+            p.begin(); p.registerHandler(0u, 16u, 0x600u, 0u); p.finish();
+            p.begin(0x600u); p.call(p.stub(0x1400u)); p.finish(1u);
+            const int module = start(iop, p);
+            if (retired)
+                require(iop.stopModule(module, nullptr), "could not retire the authored callback owner");
+            rejects([&]() { advance(iop, kVblankPeriodCycles); },
+                    retired ? "unloaded strict module" : "missing import absent:42");
+            rejects([&]() { iop.checkExecutionFailure(); },
+                    retired ? "unloaded strict module" : "missing import absent:42");
+            iop.reset();
+            iop.checkExecutionFailure();
+        }
+    }
