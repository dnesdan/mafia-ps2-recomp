+        f.ioman.reset();
+        require(f.host.handles.empty() && f.host.closes == 19u,
+                "IOMAN destruction did not close its remaining owned host handles");
+    }
+
+    void pendingOpenReservationsAreNotOverwritten()
+    {
+        for (const bool duringSize : {false, true})
+        {
+            Fixture f;
+            bool entered = false;
+            int32_t nested = -1;
+            const auto callback = [&]
+            {
+                if (entered)
+                    return;
+                entered = true;
+                require(static_cast<int32_t>(f.call(5u, 0u)) == -9 &&
+                            static_cast<int32_t>(f.call(6u, 0u, 0u, 0u)) == -9,
+                        "pending descriptor exposed an uncommitted host handle");
+                nested = f.open("host:TEST.BIN");
+            };
+            if (duringSize) f.host.sizeHook = callback;
+            else f.host.openHook = callback;
+            const int32_t outer = f.open();
+            require(outer >= 0 && nested >= 0 && outer != nested &&
+                        f.host.handles.size() == 2u && f.host.opens == 2u && f.host.sizes == 2u,
+                    "nested host callback open replaced an outer descriptor reservation");
+            require(f.call(5u, static_cast<uint32_t>(outer)) == 0u &&
+                        f.call(5u, static_cast<uint32_t>(nested)) == 0u &&
+                        f.host.handles.empty() && f.host.closes == 2u,
+                    "nested open leaked or aliased a committed host handle");
+        }
+        for (const bool duringSize : {false, true})
+        {
+            Fixture f;
+            bool entered = false;
+            int32_t replacement = -1;
+            const auto callback = [&]
+            {
+                if (entered)
+                    return;
+                entered = true;
+                f.ioman->reset();
+                replacement = f.open("host:TEST.BIN");
+            };
+            if (duringSize) f.host.sizeHook = callback;
+            else f.host.openHook = callback;
+            bool rejected = false;
+            try { (void)f.open(); }
+            catch (const std::runtime_error &) { rejected = true; }
+            require(rejected && replacement >= 0 && f.host.handles.size() == 1u &&
+                        f.host.closes == 1u &&
+                        f.position(static_cast<uint32_t>(replacement)) == 0u,
+                    "reset during open committed an old reservation or removed its replacement");
+            require(f.call(5u, static_cast<uint32_t>(replacement)) == 0u &&
+                        f.host.handles.empty() && f.host.closes == 2u,
+                    "reset/reopen failed to preserve exactly the replacement handle");
+        }
+    }
+
+    void failedOpenAndThrowingCleanupDoNotLeak()
+    {
+        {
+            Fixture f;
+            f.host.failSize = true;
+            f.host.throwClose = true;
+            require(f.open() == -5 && f.host.handles.empty() && f.host.closes == 1u,
+                    "failed size query leaked its opened handle or propagated cleanup failure");
+            f.host.failSize = false;
+            f.host.throwSize = true;
+            bool rejected = false;
+            try { (void)f.open(); }
+            catch (const std::runtime_error &error)
+            { rejected = std::string_view(error.what()) == "authored size exception"; }
+            require(rejected && f.host.handles.empty() && f.host.closes == 2u,
+                    "throwing open cleanup hid the original exception or leaked its handle");
+        }
+        {
+            Fixture f;
+            const auto first = static_cast<uint32_t>(f.open());
+            const auto second = static_cast<uint32_t>(f.open());
+            const auto third = static_cast<uint32_t>(f.open());
+            f.host.throwClose = true;
+            try { f.ioman->reset(); }
+            catch (const std::runtime_error &) {}
+            require(f.host.handles.empty() && f.host.closes == 3u &&
+                        static_cast<int32_t>(f.call(5u, first)) == -9 &&
+                        static_cast<int32_t>(f.call(5u, second)) == -9 &&
+                        static_cast<int32_t>(f.call(5u, third)) == -9,
+                    "one throwing close prevented reset from clearing every descriptor");
+            require(f.open() >= 0 && f.open() >= 0, "could not open destruction cleanup fixtures");
+            f.ioman.reset();
+            require(f.host.handles.empty() && f.host.closes == 5u,
+                    "throwing destructor cleanup skipped remaining handles");
+        }
+    }
+
+    iop_test::Irx authoredFileImports(uint32_t flags = 1u)
+    {
+        iop_test::Irx image(0x10000u, 0x600u);
+        // Authored MIPS executes the import stubs, consumes bytes in IOP RAM,
+        // seeks relative to the actual read position and closes the descriptor.
+        image.words(0u, {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFB00018u, 0xAFB10014u,
+            0x3C100001u, 0x26040400u, 0x34050000u | flags, 0x00003021u,
+            0x0C004085u, 0u, 0x00408821u, 0xAE020480u,
+            0x02202021u, 0x26050440u, 0x24060005u, 0x0C004089u, 0u,
+            0xAE020484u, 0x02202021u, 0x2405FFFEu, 0x24060001u,
+            0x0C00408Bu, 0u, 0xAE020488u,
+            0x02202021u, 0x26050448u, 0x24060004u, 0x0C004089u, 0u,
+            0xAE02048Cu, 0x02202021u, 0x0C004087u, 0u, 0xAE020490u,
+            0x8E080440u, 0u, 0xAE080498u, 0x92080444u, 0u, 0xAE08049Cu,
+            0x8FB10014u, 0x8FB00018u, 0x8FBF001Cu, 0x27BD0020u,
+            0x03E00008u, 0x00001021u,
+        });
+        image.words(0x200u, {
+            0x41E00000u, 0u, 0x0104u, 0x616D6F69u, 0x0000006Eu,
+            0x03E00008u, 0x24000004u,
+            0x03E00008u, 0x24000005u,
+            0x03E00008u, 0x24000006u,
+            0x03E00008u, 0x24000008u, 0u, 0u,
+        });
+        const std::string path = "cdrom0:\\DATA\\TEST.BIN;1";
+        std::memcpy(image.bytes.data() + 0x100u + 0x400u, path.c_str(), path.size() + 1u);
+        return image;
+    }
+
+    void authoredMipsImportsConsumeActualIopBytes()
+    {
+        TemporaryTree tree;
+        FileHost host(tree);
+        IopEmulator iop(host);
+        const auto image = authoredFileImports();
+        const auto loaded = iop.loadModuleImage("authored-file-imports", image.bytes, nullptr, 0u);
+        std::array<uint32_t, 8u> results{};
+        std::array<uint8_t, 12u> data{};
+        require(loaded.moduleId > 0 && loaded.startResult == 0 &&
+                    iop.readMemory(0x10480u, results.data(), sizeof(results)) &&
+                    iop.readMemory(0x10440u, data.data(), data.size()) &&
+                    results[0] < 16u && results[1] == 5u && results[2] == 3u &&
+                    results[3] == 4u && results[4] == 0u &&
+                    results[6] == 0xFF807F00u && results[7] == 0x31u &&
+                    std::equal(content.begin(), content.begin() + 5, data.begin()) &&
+                    std::equal(content.begin() + 3, content.begin() + 7, data.begin() + 8),
+                "actual IOP imports did not preserve open/read/seek/close ABI and binary bytes");
+        require(host.opens == 1u && host.reads == 2u && host.closes == 1u &&
+                    host.handles.empty() && host.guestWrites == 0u && host.guestReads == 0u,
+                "authored imported file path leaked a handle or directly touched EE RAM");
+
+        FileHost unsupportedHost(tree);
+        IopEmulator unsupported(unsupportedHost);
+        const auto writeMode = authoredFileImports(2u);
+        bool rejected = false;
+        try { (void)unsupported.loadModuleImage("authored-write-mode", writeMode.bytes, nullptr, 0u); }
+        catch (const std::runtime_error &error)
+        { rejected = std::string_view(error.what()).find("missing import ioman:4") != std::string_view::npos; }
+        require(rejected && unsupportedHost.opens == 0u && unsupportedHost.guestWrites == 0u,
+                "unsupported imported write-open did not remain a strict missing operation");
+    }
+}
+
+int main()
+{
+    const iop_test::Test tests[] = {
+        {"Mounted files return exact bytes with independent offsets and EOF", sequentialBytesAndIndependentPositions},
+        {"Read accepts complete RAM aliases and live allocation interiors", aliasesAndLiveHeapBuffers},
+        {"Bad descriptors and signed seek errors preserve file position", descriptorAndSeekErrorsPreservePosition},
+        {"Explicit mounts distinguish absent devices from absent files", supportedMountsAndAbsentRoutes},
+        {"Canonical paths remain contained and original drivers take precedence", canonicalContainmentAndDriverPrecedence},
+        {"Unsupported file modes and operations remain strict", unsupportedOperationsStayStrict},
+        {"Malformed paths fail before host or guest side effects", malformedPathsFailBeforeHostActivity},
+        {"Malformed complete read spans fail before host or guest mutation", malformedReadSpansFailBeforeMutation},
+        {"Partial reads and backend failures preserve exact commit semantics", partialAndFailedHostReadsAreTransactional},
+        {"Read cannot commit across allocation or descriptor replacement", readLifetimeChangesCannotCommit},
+        {"Descriptor capacity, reset and destruction preserve host ownership", tableCapacityResetAndDestructionCloseOwnedHandles},
+        {"Pending open reservations survive nested calls and reject reset", pendingOpenReservationsAreNotOverwritten},
+        {"Failed open and throwing cleanup cannot leak remaining handles", failedOpenAndThrowingCleanupDoNotLeak},
+        {"Authored MIPS file imports consume real IOP bytes without EE writes", authoredMipsImportsConsumeActualIopBytes},
+    };
+    return iop_test::run(tests);
+}
