+        uint64_t fileBufferOwner(const IopMemory &memory, uint32_t address, size_t size)
+        {
+            const uint32_t segment = address & 0xE0000000u;
+            const uint32_t physical = IopMemory::physicalAddress(address);
+            if (address == 0u ||
+                (segment != 0u && segment != 0x80000000u && segment != 0xA0000000u) ||
+                physical >= IopMemory::RamSize || size > IopMemory::RamSize - physical ||
+                !memory.ownsRamRange(address, size))
+                throw std::runtime_error("IOP IOMAN file buffer is outside complete owned RAM");
+            const auto allocation = memory.allocationContaining(physical);
+            if (allocation)
+            {
+                if (size > allocation->size - (physical - allocation->address))
+                    throw std::runtime_error("IOP IOMAN file buffer crosses a live allocation boundary");
+                return allocation->identity;
+            }
+            if (physical < IopMemory::HeapLimit && uint64_t(physical) + size > IopMemory::HeapBase)
+                throw std::runtime_error("IOP IOMAN file buffer has no live heap allocation");
+            return 0u;
+        }
+
+        std::string filePath(const IopMemory &memory, uint32_t address)
+        {
+            const uint64_t owner = fileBufferOwner(memory, address, 1u);
+            std::string path;
+            for (uint32_t i = 0u; i < 1024u; ++i)
+            {
+                if (fileBufferOwner(memory, address + i, 1u) != owner)
+                    throw std::runtime_error("IOP IOMAN path crosses an allocation boundary");
+                const char value = static_cast<char>(memory.read8(address + i));
+                if (value == '\0')
+                    return path;
+                path.push_back(value);
+            }
+            throw std::runtime_error("IOP IOMAN path is not terminated within 1024 bytes");
+        }
+
+        std::string deviceName(std::string_view path)
+        {
+            const size_t colon = path.find(':');
+            if (colon == std::string_view::npos)
+                return {};
+            std::string name(path.substr(0u, colon));
+            while (!name.empty() && name.back() >= '0' && name.back() <= '9')
+                name.pop_back();
+            std::transform(name.begin(), name.end(), name.begin(), [](unsigned char value)
+                { return static_cast<char>(value >= 'A' && value <= 'Z' ? value + ('a' - 'A') : value); });
+            return name;
+        }
+
+        std::string mountedFilePath(const IopHost &host, std::string_view path)
+        {
+            const ParsedPs2Path parsed = parsePs2Path(path);
+            HostPathKind kind;
+            switch (parsed.device)
+            {
+            case Ps2PathDevice::Cdrom: kind = HostPathKind::CdRoot; break;
+            case Ps2PathDevice::Host: kind = HostPathKind::HostRoot; break;
+            case Ps2PathDevice::MemoryCard0: kind = HostPathKind::MemoryCardRoot; break;
+            default: return {};
+            }
+            if (path.find(':') == std::string_view::npos || parsed.path.empty() ||
+                parsed.path.find(':') != std::string::npos || parsed.path.find(';') != std::string::npos ||
+                std::any_of(path.begin(), path.end(), [](unsigned char value)
+                    { return value < 0x20u || value == 0x7Fu; }))
+                return {};
+            const std::filesystem::path relative(parsed.path);
+            if (relative.is_absolute() || relative.has_root_name() ||
+                std::any_of(relative.begin(), relative.end(), [](const auto &part) { return part == ".."; }))
+                return {};
+            const std::string root = host.hostPath(kind);
+            if (root.empty() || root.find('\0') != std::string::npos)
+                return {};
+            const std::string translated = host.translateGuestPath(path);
+            if (translated.empty() || translated.find('\0') != std::string::npos)
+                return {};
+
+            // Translation may apply host-specific case rules. Check the actual
+            // target after resolving existing symlinks, before opening it.
+            std::error_code error;
+            const auto canonicalRoot = std::filesystem::weakly_canonical(root, error);
+            if (error || canonicalRoot.empty())
+                return {};
+            const auto canonicalTarget = std::filesystem::weakly_canonical(translated, error);
+            if (error || canonicalTarget.empty())
+                return {};
+            const auto contained = canonicalTarget.lexically_relative(canonicalRoot);
+            if (contained.empty() || contained == "." || contained.is_absolute() ||
+                std::any_of(contained.begin(), contained.end(), [](const auto &part) { return part == ".."; }))
+                return {};
+            return canonicalTarget.string();
+        }
