@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+
+class PS2Runtime;
+
+namespace ps2x::iop
+{
+    // Attach persistent serial storage before starting the guest worker.
+    // The original guest drivers own card formatting and filesystem operations.
+    void mountMemoryCard(PS2Runtime &runtime, uint32_t port,
+                         const std::filesystem::path &path, bool create);
+}
diff --git a/ps2xRuntime/src/lib/ps2_memory_card.cpp b/ps2xRuntime/src/lib/ps2_memory_card.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5da05534f9c5b88dd0311b82551d59171aa0691c
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_memory_card.cpp
@@ -0,0 +1,16 @@
+#include "runtime/ps2_memory_card.h"
+#include "ps2_iop_transport.h"
+
+#include <stdexcept>
+
+namespace ps2x::iop
+{
+    void mountMemoryCard(PS2Runtime &runtime, uint32_t port,
+                         const std::filesystem::path &path, bool create)
+    {
+        auto *const subsystem = PS2IopTransport::subsystem(&runtime);
+        if (!subsystem)
+            throw std::logic_error("Memory-card storage requires a live IOP subsystem");
+        subsystem->mountMemoryCard(port, path, create);
+    }
+}
