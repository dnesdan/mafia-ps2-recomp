+                memory.read32(result) == 1u && memory.read8(result - 1u) == 0xA5u,
+                "valid write-only EventFlag result required preinitialized host input or damaged its neighbor");
+        }
+        for (uint32_t result : {0x2001u, 0x001FFFFFu, 0xC0002000u, 0x20002000u, 0xBF801074u, 0xFFFFFFFCu})
+        {
+            IopMemory memory; IopKernel kernel(memory); IopCpuState cpu;
+            const int event = kernel.createInternalEventFlag(0u, 0u, 1u);
+            const std::vector<uint8_t> before(memory.ram().begin(), memory.ram().end());
+            cpu.gpr[4] = event; cpu.gpr[5] = 1u; cpu.gpr[6] = 0x10u; cpu.gpr[7] = result;
+            rejects([&] { (void)kernel.dispatchEventImport(11u, cpu, false); }, "invalid pattern, mode or result range");
+            require(std::equal(before.begin(), before.end(), memory.ram().begin()) && memory.interruptMask() == 0u,
+                "invalid EventFlag output changed RAM or MMIO before rejection");
+            cpu.gpr[6] = 0u; cpu.gpr[7] = 0u;
+            require(kernel.dispatchEventImport(11u, cpu, false) && cpu.gpr[2] == 0u,
+                "invalid write-only output consumed the event's clear-on-read state");
+        }
+    }
