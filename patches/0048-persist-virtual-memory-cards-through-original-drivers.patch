+    void bootStatusPreservesTerminatorAndStagedWrite()
+    {
+        Temporary temporary;
+        IopMemoryCard card;
+        card.mount(temporary.image(), true);
+        auto setTerminator = packet(0x27u, 5u);
+        setTerminator[2u] = 0x6Bu;
+        (void)exchange(card, setTerminator);
+        (void)exchange(card, address(0x22u, 17u));
+        const Bytes data{0x13u, 0x57u, 0x9Bu, 0xDFu};
+        (void)exchange(card, writePacket(data));
+        const auto before = disk(temporary.image());
+        auto status = packet(0xBFu, 5u);
+        status[2u] = 0x55u; // Original MCMAN supplies this byte; it is not a reset.
+        rejected([&] { (void)card.exchange(status, 4u); }, "boot/status accepted a short response frame");
+        require(exchange(card, status) == Bytes({0u, 0u, 0u, 0x2Bu, 0x6Bu}),
+                "boot/status changed the terminator or returned the wrong ACK layout");
+        require(exchange(card, packet(0x28u, 5u))[3u] == 0x6Bu && disk(temporary.image()) == before,
+                "boot/status reset protocol or committed unfinished storage");
+        rejected([&] { (void)exchange(card, packet(0xF0u, 5u)); }, "boot/status admitted unsupported authentication");
+        (void)exchange(card, packet(0x81u, 4u));
+        const auto after = disk(temporary.image());
+        const size_t offset = 17u * IopMemoryCard::PageBytes;
+        require(std::equal(data.begin(), data.end(), after.begin() + offset) && after[offset + data.size()] == 0xFFu,
+                "boot/status discarded or changed a staged write");
+    }
+
+    void pageSpareCommitAndReopen()
+    {
+        Temporary temporary;
+        Bytes expected(IopMemoryCard::PageBytes);
+        for (size_t i = 0; i < expected.size(); ++i) expected[i] = static_cast<uint8_t>(i * 37u + 5u);
+        const size_t offset = (IopMemoryCard::PageCount - 1u) * IopMemoryCard::PageBytes;
+        {
+            IopMemoryCard card; card.mount(temporary.image(), true);
+            (void)exchange(card, address(0x22u, IopMemoryCard::PageCount - 1u));
+            for (size_t i = 0; i < expected.size(); i += 128u)
+            {
+                Bytes chunk(expected.begin() + i, expected.begin() + std::min(i + 128u, expected.size()));
+                const auto rx = exchange(card, writePacket(chunk));
+                require(rx[3u] == 0x2Bu && rx[chunk.size() + 4u] == xorBytes(chunk), "write ACK/XOR is wrong");
+            }
+            const auto uncommitted = disk(temporary.image());
+            require(std::all_of(uncommitted.begin() + offset, uncommitted.end(), [](uint8_t b) { return b == 0xFFu; }),
+                    "write chunks persisted before end command");
+            auto overrun = writePacket(Bytes{0u});
+            rejected([&] { (void)exchange(card, overrun); }, "card-end write exceeded storage");
+            (void)exchange(card, packet(0x81u, 4u));
+            const auto committed = disk(temporary.image());
+            require(std::equal(expected.begin(), expected.end(), committed.begin() + offset),
+                    "committed page or authored spare/ECC bytes were lost");
+            require(committed[offset - 1u] == 0xFFu, "page commit damaged a neighboring page");
+        }
+        IopMemoryCard reopened; reopened.mount(temporary.image(), false);
+        (void)exchange(reopened, address(0x23u, IopMemoryCard::PageCount - 1u));
+        Bytes observed;
+        for (size_t i = 0; i < expected.size(); i += 128u)
+        {
+            auto chunk = read(reopened, std::min(size_t{128u}, expected.size() - i));
+            observed.insert(observed.end(), chunk.begin(), chunk.end());
+        }
+        require(observed == expected, "reopened card differs from committed page and spare");
+        rejected([&] { (void)read(reopened, 1u); }, "card-end read exceeded storage");
+    }
+
+    void checksumsBoundsAndPreflight()
+    {
+        Temporary temporary;
+        IopMemoryCard card; card.mount(temporary.image(), true);
+        (void)exchange(card, address(0x22u, 7u));
+        auto wrongAddress = address(0x22u, 8u); wrongAddress[6u] ^= 1u;
+        rejected([&] { (void)exchange(card, wrongAddress); }, "bad address XOR accepted");
+        rejected([&] { (void)exchange(card, address(0x22u, 0xFFFFFFFFu)); }, "out-of-range page accepted");
+        auto badWrite = writePacket(Bytes{1u, 2u, 3u}); badWrite[6u] ^= 1u;
+        rejected([&] { (void)exchange(card, badWrite); }, "bad data XOR accepted");
+        auto valid = writePacket(Bytes{0x31u, 0x42u, 0x53u});
+        rejected([&] { (void)card.exchange(valid, valid.size() - 1u); }, "truncated receive packet accepted");
+        auto shortTx = valid; shortTx.pop_back();
+        rejected([&] { (void)card.exchange(shortTx, valid.size()); }, "truncated transmit packet accepted");
+        auto large = packet(0x43u, 135u); large[2u] = 129u;
+        rejected([&] { (void)exchange(card, large); }, "oversized data transaction accepted");
+        (void)exchange(card, valid);
+        (void)exchange(card, packet(0x81u, 4u));
+        const auto raw = disk(temporary.image());
+        require(raw[7u * IopMemoryCard::PageBytes] == 0x31u && raw[7u * IopMemoryCard::PageBytes + 3u] == 0xFFu &&
+            raw[8u * IopMemoryCard::PageBytes] == 0xFFu, "rejected packet mutated cursor or pending data");
+
+        auto setTerminator = packet(0x27u, 5u); setTerminator[2u] = 0x5Au;
+        const auto setAddress = address(0x22u, 12u);
+        const auto goodWrite = writePacket(Bytes(128u, 0x42u));
+        const auto end = packet(0x81u, 4u);
+        const std::array<IopMemoryCard::Packet, 5u> queue{{{setTerminator, setTerminator.size()},
+            {setAddress, setAddress.size()}, {goodWrite, goodWrite.size()}, {end, end.size()},
+            {badWrite, badWrite.size()}}};
+        rejected([&] { card.validateExchanges(queue); }, "queue with a later invalid packet accepted");
+        require(disk(temporary.image()) == raw && exchange(card, packet(0x28u, 5u))[3u] == 0x55u,
+                "queue preflight changed persistent data or terminator");
+        card.validateExchanges(std::span(queue).first(4u));
+        require(disk(temporary.image()) == raw, "successful preflight committed storage");
+    }
+
+    void eraseAndReset()
+    {
+        Temporary temporary;
+        IopMemoryCard card; card.mount(temporary.image(), true);
+        for (uint32_t page : {15u, 16u, 31u, 32u})
+        {
+            (void)exchange(card, address(0x22u, page));
+            (void)exchange(card, writePacket(Bytes(128u, 0u)));
+            (void)exchange(card, packet(0x81u, 4u));
+        }
+        (void)exchange(card, address(0x22u, 15u));
+        (void)exchange(card, writePacket(Bytes(128u, 0xFFu)));
+        (void)exchange(card, packet(0x81u, 4u));
+        require(disk(temporary.image())[15u * IopMemoryCard::PageBytes] == 0u,
+                "NAND programming incorrectly restored zero bits before erase");
+        (void)exchange(card, address(0x21u, 23u));
+        (void)exchange(card, packet(0x82u, 4u));
+        auto raw = disk(temporary.image());
+        require(raw[15u * IopMemoryCard::PageBytes] == 0u && raw[32u * IopMemoryCard::PageBytes] == 0u,
+                "erase damaged adjacent blocks");
+        require(std::all_of(raw.begin() + 16u * IopMemoryCard::PageBytes,
+            raw.begin() + 32u * IopMemoryCard::PageBytes, [](uint8_t b) { return b == 0xFFu; }),
+                "erase did not clear the whole selected block and spare bytes");
+        (void)exchange(card, address(0x22u, 17u));
+        (void)exchange(card, writePacket(Bytes(128u, 0u)));
+        card.resetProtocol();
+        (void)exchange(card, packet(0x81u, 4u));
+        require(disk(temporary.image()) == raw, "reset retained an unfinished write");
+        require(card.attached(), "reset detached storage");
+    }
+
+    void rejectedMountsAndStorageFailure()
+    {
+        Temporary temporary;
+        {
+            std::ofstream file(temporary.image(), std::ios::binary); file << "owned data";
+        }
+        const auto wrong = disk(temporary.image());
+        IopMemoryCard card;
+        rejected([&] { card.mount(temporary.image(), true); }, "wrong-sized image was replaced");
+        require(disk(temporary.image()) == wrong && !card.attached(), "rejected mount changed image or attached state");
+        const auto link = temporary.directory / "link.ps2";
+        std::filesystem::create_symlink(temporary.image(), link);
+        rejected([&] { card.mount(link, true); }, "symlink image mounted");
+        require(disk(temporary.image()) == wrong, "symlink mount changed target");
+        std::filesystem::remove(temporary.image());
+        card.mount(temporary.image(), true);
+        (void)exchange(card, address(0x22u, 0u));
+        (void)exchange(card, writePacket(Bytes(128u, 0x42u)));
+        const auto moved = temporary.directory / "preserved.ps2";
+        std::filesystem::rename(temporary.image(), moved);
+        rejected([&] { (void)exchange(card, packet(0x81u, 4u)); }, "missing mounted path reported committed success");
+        const auto preserved = disk(moved);
+        require(std::all_of(preserved.begin(), preserved.end(), [](uint8_t b) { return b == 0xFFu; }),
+                "failed commit modified preserved image");
+        card.resetProtocol();
+        rejected([&] { (void)exchange(card, packet(0x11u, 4u)); }, "storage error was cleared into successful probe");
+    }
+}
+
+int main()
+{
+    try
+    {
+        blankImageAndWireGeometry();
+        bootStatusPreservesTerminatorAndStagedWrite();
+        pageSpareCommitAndReopen();
+        checksumsBoundsAndPreflight();
+        eraseAndReset();
+        rejectedMountsAndStorageFailure();
+        std::cout << "PASS raw PS2 card geometry, durable page/spare roundtrip, validation, erase, reset and storage failure\n";
+        return 0;
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "FAIL " << error.what() << '\n';
+        return 1;
+    }
+}
