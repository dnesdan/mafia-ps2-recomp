+    bool testPacketSequentialDmaSnapshotsAreBounded()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopRpcBridge bridge(host, memory, kernel);
+        constexpr uint32_t sid = 0x80000400u, server = 0x1000u, callback = 0x2000u;
+        constexpr uint32_t stack = 0x3000u, result = 0x4000u, descriptor = 0x5000u, source = 0x7000u;
+        for (uint32_t address : {server, callback, stack, result})
+            (void)memory.zeroRam(address, 64u);
+        (void)memory.zeroRam(descriptor, 33u * 16u);
+        (void)memory.zeroRam(source, 0xFFFF0u);
+        IopCpuState registration{};
+        registration.gpr[4] = server; registration.gpr[5] = sid;
+        registration.gpr[6] = callback; registration.gpr[29] = stack;
+        if (!bridge.dispatchSifCmdImport(17u, registration)) return false;
+        const auto submit = [&](uint32_t destination, uint32_t bytes, uint32_t count = 1u)
+        {
+            const std::array<uint32_t, 4u> dma{source, destination, bytes, 0u};
+            (void)memory.writeRam(descriptor, dma.data(), sizeof(dma));
+            IopCpuState cpu{};
+            cpu.gpr[4] = descriptor; cpu.gpr[5] = count;
+            return bridge.dispatchSifManImport(7u, cpu);
+        };
+        RecordingExecutor executor;
+        executor.callbackResult = result;
+        executor.onCall = [&]
+        {
+            for (uint32_t i = 0u; i < 65u; ++i)
+            {
+                memory.write32(source, i + 1u);
+                if (!submit(0x10000u + i * 16u, 16u))
+                    throw std::runtime_error("sequential DMA submission failed");
+            }
+            memory.write32(source, 0xFFFFFFFFu);
+        };
+        std::vector<SifEeTransfer> transfers;
+        (void)bridge.executePacketCall(sid, server, 5u, {}, 4u, executor, &transfers);
+        if (!expect(transfers.size() == 65u, "completed SIF submissions shared a 32-descriptor lifetime"))
+            return false;
+        for (uint32_t i = 0u; i < transfers.size(); ++i)
+            if (!expect(transfers[i].address == 0x10000u + i * 16u && transfers[i].data.size() == 16u &&
+                        transfers[i].data[0] == i + 1u && transfers[i].data[1] == 0u,
+                        "sequential SIF payload snapshots lost submission order or buffer lifetime"))
+                return false;
+        for (uint32_t variant = 0u; variant < 3u; ++variant)
+        {
+            executor.onCall = [&]
+            {
+                if (variant == 0u) (void)submit(0x10000u, 16u, 33u);
+                else if (variant == 1u)
+                    for (uint32_t i = 0u; i < 513u; ++i) (void)submit(0x10000u + i * 16u, 16u);
+                else
+                {
+                    (void)submit(0x100000u, 0xFFFF0u);
+                    (void)submit(0x200000u, 0xFFFF0u);
+                    (void)submit(0x300000u, 48u);
+                }
+            };
+            bool failed = false;
+            try { (void)bridge.executePacketCall(sid, server, 5u, {}, 4u, executor, &transfers); }
+            catch (const std::runtime_error &error)
+            {
+                const std::string_view cause(error.what());
+                failed = cause.find(variant == 0u ? "descriptor array" : variant == 1u ?
+                                    "descriptor queue" : "byte queue") != std::string_view::npos;
+            }
+            if (!expect(failed && transfers.size() == 65u && transfers.front().data[0] == 1u &&
+                        transfers.back().data[0] == 65u,
+                        "SIF submission, capture-count or byte bound partially published callback DMA"))
+                return false;
+        }
+        executor.onCall = {};
+        (void)bridge.executePacketCall(sid, server, 5u, {}, 4u, executor, &transfers);
+        return expect(transfers.empty(), "failed sequential DMA leaked into the next packet callback");
+    }
