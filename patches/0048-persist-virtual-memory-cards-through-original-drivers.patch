+    inline void eventResultsAcceptUninitializedWritableRam()
+    {
+        using ps2x::iop::detail::IopMemory;
+        using ps2x::iop::detail::IopKernel;
+        using ps2x::iop::detail::IopCpuState;
+        for (uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        for (uint32_t offset : {0x2000u, IopMemory::RamSize - 4u})
+        {
+            IopMemory memory; IopKernel kernel(memory); IopCpuState cpu;
+            const int event = kernel.createInternalEventFlag(0u, 0u, 1u);
