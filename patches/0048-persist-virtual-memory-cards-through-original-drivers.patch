+    bool testPacketCardFormatBudgetIsScoped()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopRpcBridge bridge(host, memory, kernel);
+        RecordingExecutor executor;
+        constexpr uint32_t server = 0x1000u, callback = 0x2000u;
+        constexpr uint32_t buffer = 0x3000u, stack = 0x4000u, result = 0x5000u;
+        if (!memory.zeroRam(server, 0x30u) || !memory.zeroRam(callback, 4u) ||
+            !memory.zeroRam(buffer, 48u) || !memory.zeroRam(stack, 32u) ||
+            !memory.zeroRam(result, 4u))
+            return false;
+        executor.callbackResult = result;
+        const auto registerServer = [&](uint32_t sid)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = server;
+            cpu.gpr[5] = sid;
+            cpu.gpr[6] = callback;
+            cpu.gpr[7] = buffer;
+            cpu.gpr[29] = stack;
+            return bridge.dispatchSifCmdImport(17u, cpu);
+        };
+        std::array<uint8_t, 48u> request{};
+        if (!expect(registerServer(0x80000400u), "card RPC registration failed"))
+            return false;
+        (void)bridge.executePacketCall(0x80000400u, server, 0x10u, request, 4u, executor);
+        if (!expect(executor.calls == 1u && executor.budgetedCalls == 1u &&
+                    executor.lastBudget == 64'000'000u,
+                    "full-card format did not receive its finite service budget"))
+            return false;
+        for (uint32_t command : {0x0Au, 3u})
+            (void)bridge.executePacketCall(0x80000400u, server, command, request, 4u, executor);
+        if (!expect(executor.calls == 3u && executor.budgetedCalls == 3u &&
+                    executor.lastBudget == 64'000'000u,
+                    "flush/close did not receive the finite dirty-cache budget"))
+            return false;
+        for (uint32_t command : {1u, 0x11u, 2u, 5u, 6u})
+            (void)bridge.executePacketCall(0x80000400u, server, command, request, 4u, executor);
+        if (!expect(registerServer(0x12345678u), "other RPC registration failed"))
+            return false;
+        for (uint32_t command : {0x10u, 0x0Au, 3u})
+            (void)bridge.executePacketCall(0x12345678u, server, command, request, 4u, executor);
+        if (!expect(executor.calls == 11u && executor.budgetedCalls == 3u,
+                    "storage service budget escaped to another command or SID"))
+            return false;
+        std::vector<SifEeTransfer> transfers{{0x6000u, {0x5au}}};
+        executor.throwCall = true;
+        bool failed = false;
+        try
+        {
+            (void)bridge.executePacketCall(0x80000400u, server, 0x10u, request, 4u, executor, &transfers);
+        }
+        catch (const std::runtime_error &)
+        {
+            failed = true;
+        }
+        if (!expect(failed && transfers.size() == 1u && transfers[0].address == 0x6000u &&
+                    transfers[0].data == std::vector<uint8_t>{0x5au},
+                    "failed format published or replaced pending EE transfers"))
+            return false;
+        executor.throwCall = false;
+        (void)bridge.executePacketCall(0x80000400u, server, 1u, request, 4u, executor, &transfers);
+        if (!expect(executor.calls == 13u && executor.budgetedCalls == 4u && transfers.empty(),
+                    "failed format leaked packet ownership into the next callback"))
+            return false;
+        for (const auto [size, expectedBudget] : std::array<std::pair<uint32_t, uint32_t>, 7u>{{
+                 {1u, 4'000'000u}, {8192u, 4'000'000u}, {8193u, 6'000'000u},
+                 {524288u, 130'000'000u}, {0x7FFFFFFFu, 256'000'000u}, {0u, 0u}, {0xFFFFFFFFu, 0u}}})
+        {
+            for (uint32_t i = 0u; i < 4u; ++i) request[12u + i] = static_cast<uint8_t>(size >> (i * 8u));
+            for (uint32_t command : {5u, 6u})
+            {
+                const uint32_t previous = executor.budgetedCalls;
+                (void)bridge.executePacketCall(0x80000400u, server, command, request, 4u, executor);
+                if (!expect(executor.budgetedCalls == previous + (expectedBudget != 0u) &&
+                            (expectedBudget == 0u || executor.lastBudget == expectedBudget),
+                            "bulk read/write work did not receive its finite size-dependent budget"))
+                    return false;
+            }
+        }
+        request[12] = 1u; request[13] = request[14] = request[15] = 0u;
+        const uint32_t previous = executor.budgetedCalls;
+        (void)bridge.executePacketCall(0x80000400u, server, 4u, request, 4u, executor);
+        for (uint32_t command : {5u, 6u})
+        {
+            (void)bridge.executePacketCall(0x12345678u, server, command, request, 4u, executor);
+            (void)bridge.executePacketCall(0x80000400u, server, command, std::span(request).first(47u), 4u, executor);
+        }
+        return expect(executor.budgetedCalls == previous,
+                      "bulk work budget escaped to seek, another SID or a different descriptor ABI");
+    }
