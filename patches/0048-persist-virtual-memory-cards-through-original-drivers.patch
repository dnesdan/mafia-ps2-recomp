+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <span>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // Raw PS2 serial card storage. Formatting and ECC belong to the guest driver.
+    class IopMemoryCard
+    {
+    public:
+        static constexpr size_t PageDataBytes = 512u;
+        static constexpr size_t PageSpareBytes = 16u;
+        static constexpr size_t PageBytes = PageDataBytes + PageSpareBytes;
+        static constexpr size_t PageCount = 16384u;
+        static constexpr size_t PagesPerBlock = 16u;
+        static constexpr size_t ImageBytes = PageBytes * PageCount;
+
+        struct Packet
+        {
+            std::span<const uint8_t> transmit;
+            size_t receiveSize;
+        };
+
+        IopMemoryCard();
+        ~IopMemoryCard();
+        IopMemoryCard(const IopMemoryCard &) = delete;
+        IopMemoryCard &operator=(const IopMemoryCard &) = delete;
+
+        // Mount before guest execution. Existing storage is never truncated.
+        void mount(const std::filesystem::path &path, bool create);
+        [[nodiscard]] bool attached() const noexcept;
+        [[nodiscard]] std::vector<uint8_t> exchange(std::span<const uint8_t> transmit,
+                                                    size_t receiveSize);
+        // Whole SIO2 queue preflight, including address/cursor changes, without
+        // changing protocol state, staged writes, or persistent storage.
+        void validateExchanges(std::span<const Packet> packets) const;
+        // Discard unfinished writes; retain the mounted image and storage errors.
+        void resetProtocol();
+
+    private:
+        class Impl;
+        std::unique_ptr<Impl> m_impl;
+    };
+}
