+    bool testPacketResetRetiresPendingTransfers()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopRpcBridge bridge(host, memory, kernel);
+        constexpr uint32_t sid = 0x80000400u, server = 0x1000u, callback = 0x2000u;
+        constexpr uint32_t stack = 0x3000u, result = 0x4000u, descriptor = 0x5000u, source = 0x6000u;
+        for (uint32_t address : {server, callback, stack, result, descriptor, source})
+            (void)memory.zeroRam(address, 64u);
+        const std::array<uint32_t, 4u> dma{source, 0x10000u, 16u, 0u};
+        (void)memory.writeRam(descriptor, dma.data(), sizeof(dma));
+        const auto registerServer = [&]
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = server; cpu.gpr[5] = sid; cpu.gpr[6] = callback; cpu.gpr[29] = stack;
+            return bridge.dispatchSifCmdImport(17u, cpu);
+        };
+        if (!registerServer()) return false;
+        RecordingExecutor executor;
+        executor.callbackResult = result;
+        bool dmaQueued = false, nestedRejected = false;
+        executor.onCall = [&]
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = descriptor; cpu.gpr[5] = 1u;
+            dmaQueued = bridge.dispatchSifManImport(7u, cpu) && cpu.gpr[2] != 0u;
+            bridge.reset();
+            if (!registerServer()) throw std::runtime_error("post-reset registration failed");
+            try { (void)bridge.executePacketCall(sid, server, 0u, {}, 4u, executor); }
+            catch (const std::runtime_error &error)
+            {
+                nestedRejected = std::string_view(error.what()).find("reentrant packet") != std::string_view::npos;
+            }
+            memory.write32(result, 5u);
+        };
+        std::vector<SifEeTransfer> transfers{{0x7000u, {0x5au}}};
+        bool resetRejected = false;
+        try { (void)bridge.executePacketCall(sid, server, 0u, {}, 4u, executor, &transfers); }
+        catch (const std::runtime_error &error)
+        {
+            resetRejected = std::string_view(error.what()).find("retired reset lifetime") != std::string_view::npos;
+        }
+        if (!expect(dmaQueued && nestedRejected && resetRejected && transfers.size() == 1u &&
+                    transfers[0].address == 0x7000u && transfers[0].data == std::vector<uint8_t>{0x5au},
+                    "reset callback published stale DMA/result or let a nested packet borrow its guard"))
+            return false;
+        executor.onCall = {};
+        const auto output = bridge.executePacketCall(sid, server, 0u, {}, 4u, executor, &transfers);
+        return expect(output == std::vector<uint8_t>({5u, 0u, 0u, 0u}) && transfers.empty(),
+                      "retired packet prevented a fresh post-unwind callback");
+    }
