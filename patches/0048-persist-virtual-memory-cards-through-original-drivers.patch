index 0000000000000000000000000000000000000000..ab7b9d60b27764898ca4a0c954249342f2f6361e
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_memory_card.cpp
@@ -0,0 +1,338 @@
+#include "iop_memory_card.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <stdexcept>
+#include <string>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        [[noreturn]] void storageError(const char *operation)
+        {
+            const int error = errno;
+            throw std::runtime_error(std::string("IOP memory-card ") + operation + ": " + std::strerror(error));
+        }
+
+        class File
+        {
+        public:
+            explicit File(int descriptor = -1) : fd(descriptor) {}
+            ~File() { if (fd >= 0) (void)::close(fd); }
+            File(const File &) = delete;
+            File &operator=(const File &) = delete;
+            int release() noexcept { const int result = fd; fd = -1; return result; }
+            int fd;
+        };
+
+        void writeAll(int fd, std::span<const uint8_t> bytes)
+        {
+            size_t offset = 0u;
+            while (offset < bytes.size())
+            {
+                const ssize_t written = ::write(fd, bytes.data() + offset, bytes.size() - offset);
+                if (written < 0 && errno == EINTR) continue;
+                if (written < 0) storageError("write failed");
+                if (written == 0) throw std::runtime_error("IOP memory-card write made no progress");
+                offset += static_cast<size_t>(written);
+            }
+        }
+
+        void syncDirectory(const std::filesystem::path &directory)
+        {
+            File fd(::open(directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+            if (fd.fd < 0) storageError("directory open failed");
+            if (::fsync(fd.fd) < 0) storageError("directory sync failed");
+        }
+
+        uint8_t xorBytes(std::span<const uint8_t> bytes)
+        {
+            uint8_t value = 0u;
+            for (const uint8_t byte : bytes) value ^= byte;
+            return value;
+        }
+    }
+
+    class IopMemoryCard::Impl
+    {
+    public:
+        enum class Address { None, Erase, Write, Read };
+        struct Change { size_t offset; std::vector<uint8_t> bytes; bool erase = false; };
+        struct State
+        {
+            uint8_t terminator = 0x55u;
+            Address address = Address::None;
+            size_t cursor = 0u;
+            size_t pendingBytes = 0u;
+            std::vector<Change> pending;
+        };
+        struct Result { std::vector<uint8_t> response; std::vector<Change> changes; };
+
+        ~Impl() { if (fd >= 0) (void)::close(fd); }
+
+        void requireMounted() const
+        {
+            if (fd < 0) throw std::runtime_error("IOP memory card is not mounted");
+            if (failed) throw std::runtime_error("IOP memory-card storage has a previous failure; reopen the card");
+        }
+
+        Result process(std::span<const uint8_t> tx, size_t receiveSize, State &next) const
+        {
+            requireMounted();
+            if (tx.size() < 2u || tx[0] != 0x81u)
+                throw std::runtime_error("IOP memory-card packet requires its complete 0x81 prefix and command");
+            const uint8_t command = tx[1];
+            size_t expected = 0u;
+            switch (command)
+            {
+            case 0x11u: case 0x12u: case 0x81u: case 0x82u: expected = 4u; break;
+            case 0x21u: case 0x22u: case 0x23u: expected = 9u; break;
+            case 0x26u: expected = 13u; break;
+            case 0x27u: case 0x28u: case 0xBFu: case 0xF3u: expected = 5u; break;
+            case 0x42u: case 0x43u:
+                if (tx.size() < 3u || tx[2] == 0u || tx[2] > 128u)
+                    throw std::runtime_error("IOP memory-card data length must be 1..128 bytes");
+                expected = size_t{tx[2]} + 6u;
+                break;
+            case 0xF0u: case 0xF1u: case 0xF2u: case 0xF7u:
+                throw std::runtime_error("IOP memory-card cryptographic authentication is unsupported");
+            default:
+                throw std::runtime_error("IOP memory-card serial command is unsupported: " + std::to_string(command));
+            }
+            if (tx.size() != expected || receiveSize != expected)
+                throw std::runtime_error("IOP memory-card packet has an invalid transmit/receive size");
+
+            Result result{std::vector<uint8_t>(expected, 0u), {}};
+            auto &rx = result.response;
+            rx[expected - 2u] = 0x2Bu;
+            rx[expected - 1u] = next.terminator;
+            switch (command)
+            {
+            case 0x11u: // Presence and erase/write status, without fake formatting.
+            case 0x12u:
+            case 0xBFu: // Boot/status ACK: current terminator; no auth or storage effect.
+                break;
+            case 0x21u: case 0x22u: case 0x23u:
+            {
+                if (!next.pending.empty())
+                    throw std::runtime_error("IOP memory-card write requires an end command before changing address");
+                if (xorBytes(tx.subspan(2u, 4u)) != tx[6u])
+                    throw std::runtime_error("IOP memory-card address XOR is invalid");
+                const uint32_t page = uint32_t{tx[2]} | (uint32_t{tx[3]} << 8u) |
+                    (uint32_t{tx[4]} << 16u) | (uint32_t{tx[5]} << 24u);
+                if (page >= PageCount) throw std::runtime_error("IOP memory-card page is out of range");
+                next.cursor = size_t{page} * PageBytes;
+                next.address = command == 0x21u ? Address::Erase :
+                    (command == 0x22u ? Address::Write : Address::Read);
+                break;
+            }
+            case 0x26u:
+            {
+                rx[2u] = 0x2Bu; // Standard PS2 flags, including guest-supplied ECC.
+                const std::array<uint8_t, 8u> geometry{0x00u, 0x02u, 0x10u, 0x00u,
+                                                     0x00u, 0x40u, 0x00u, 0x00u};
+                std::copy(geometry.begin(), geometry.end(), rx.begin() + 3u);
+                rx[11u] = xorBytes(geometry);
+                break;
+            }
+            case 0x27u:
+                next.terminator = tx[2u];
+                rx[4u] = next.terminator;
+                break;
+            case 0x28u:
+                rx[2u] = 0x2Bu;
+                rx[3u] = next.terminator;
+                break;
+            case 0x42u: case 0x43u:
+            {
+                const size_t count = tx[2u];
+                const Address wanted = command == 0x42u ? Address::Write : Address::Read;
+                if (next.address != wanted || next.cursor > ImageBytes || count > ImageBytes - next.cursor)
+                    throw std::runtime_error("IOP memory-card data transfer has no matching address or exceeds storage");
+                rx[3u] = 0x2Bu;
+                if (command == 0x42u)
+                {
+                    const auto bytes = tx.subspan(3u, count);
+                    if (xorBytes(bytes) != tx[3u + count])
+                        throw std::runtime_error("IOP memory-card write XOR is invalid");
+                    if (next.pendingBytes > ImageBytes - count)
+                        throw std::runtime_error("IOP memory-card unfinished write exceeds storage");
+                    next.pending.push_back({next.cursor, {bytes.begin(), bytes.end()}});
+                    next.pendingBytes += count;
+                    rx[count + 4u] = xorBytes(bytes);
+                }
+                else
+                {
+                    std::copy_n(image.begin() + next.cursor, count, rx.begin() + 4u);
+                    rx[count + 4u] = xorBytes(std::span<const uint8_t>(rx).subspan(4u, count));
+                }
+                next.cursor += count;
+                break;
+            }
+            case 0x81u:
+                result.changes = std::move(next.pending);
+                next.pending.clear();
+                next.pendingBytes = 0u;
+                next.address = Address::None;
+                break;
+            case 0x82u:
+                if (next.address != Address::Erase || !next.pending.empty())
+                    throw std::runtime_error("IOP memory-card erase requires an erase address");
+                result.changes.push_back({(next.cursor / (PageBytes * PagesPerBlock)) *
+                    PageBytes * PagesPerBlock, std::vector<uint8_t>(PageBytes * PagesPerBlock, 0xFFu), true});
+                next.address = Address::None;
+                break;
+            case 0xF3u:
+                // Reset transport authentication state only. No challenge or
+                // cryptographic authentication is claimed by this command.
+                next = {};
+                rx[4u] = next.terminator;
+                break;
+            }
+            return result;
+        }
+
+        void commit(const std::vector<Change> &changes)
+        {
+            if (changes.empty()) return;
+            std::vector<uint8_t> candidate = image;
+            for (const auto &change : changes)
+            {
+                if (change.erase)
+                    std::fill_n(candidate.begin() + change.offset, change.bytes.size(), 0xFFu);
+                else
+                    for (size_t index = 0u; index < change.bytes.size(); ++index)
+                        candidate[change.offset + index] &= change.bytes[index];
+            }
+
+            // A complete replacement leaves the old exact-sized raw image
+            // intact on failures before rename. It also persists spare/ECC
+            // bytes exactly as authored by the guest. Unchanged erases do no I/O.
+            static std::atomic<uint64_t> sequence{0u};
+            const auto temporary = path.parent_path() /
+                (path.filename().string() + ".tmp." + std::to_string(::getpid()) + "." +
+                 std::to_string(sequence.fetch_add(1u)));
+            bool renamed = false;
+            bool created = false;
+            try
+            {
+                struct stat mounted{}, named{};
+                if (::fstat(fd, &mounted) < 0) storageError("mounted image stat failed");
+                if (::lstat(path.c_str(), &named) < 0) storageError("image path stat failed");
+                if (!S_ISREG(named.st_mode) || named.st_dev != mounted.st_dev ||
+                    named.st_ino != mounted.st_ino || named.st_size != static_cast<off_t>(ImageBytes))
+                    throw std::runtime_error("IOP memory-card mounted image identity or size changed");
+                if (candidate == image) return;
+                File replacement(::open(temporary.c_str(), O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+                if (replacement.fd < 0) storageError("replacement create failed");
+                created = true;
+                if (::flock(replacement.fd, LOCK_EX | LOCK_NB) < 0) storageError("replacement lock failed");
+                writeAll(replacement.fd, candidate);
+                if (::fsync(replacement.fd) < 0) storageError("replacement sync failed");
+                if (::rename(temporary.c_str(), path.c_str()) < 0) storageError("replacement rename failed");
+                renamed = true;
+                (void)::close(fd);
+                fd = replacement.release();
+                image.swap(candidate);
+                syncDirectory(path.parent_path());
+            }
+            catch (...)
+            {
+                if (created && !renamed) (void)::unlink(temporary.c_str());
+                failed = true; // A post-rename sync error must never become success on retry.
+                throw;
+            }
+        }
+
+        int fd = -1;
+        bool failed = false;
+        std::filesystem::path path;
+        std::vector<uint8_t> image;
+        State state;
+    };
+
+    IopMemoryCard::IopMemoryCard() : m_impl(std::make_unique<Impl>()) {}
+    IopMemoryCard::~IopMemoryCard() = default;
+
+    void IopMemoryCard::mount(const std::filesystem::path &input, bool create)
+    {
+        if (attached()) throw std::runtime_error("IOP memory card is already mounted");
+        const auto path = std::filesystem::absolute(input).lexically_normal();
+        if (path.filename().empty()) throw std::runtime_error("IOP memory-card image path is empty");
+        bool created = false;
+        int descriptor = ::open(path.c_str(), O_RDWR | O_NOFOLLOW | O_CLOEXEC);
+        if (descriptor < 0 && errno == ENOENT && create)
+        {
+            descriptor = ::open(path.c_str(), O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+            created = descriptor >= 0;
+        }
+        if (descriptor < 0) storageError("image open failed");
+        File file(descriptor);
+        try
+        {
+            if (::flock(file.fd, LOCK_EX | LOCK_NB) < 0) storageError("image is already in use");
+            struct stat info{};
+            if (::fstat(file.fd, &info) < 0) storageError("image stat failed");
+            if (!S_ISREG(info.st_mode) || (!created && info.st_size != static_cast<off_t>(ImageBytes)))
+                throw std::runtime_error("IOP memory-card image must be a regular 8 MiB raw PS2 image with 16-byte page spares");
+            std::vector<uint8_t> image(ImageBytes, 0xFFu);
+            if (created)
+            {
+                writeAll(file.fd, image);
+                if (::fsync(file.fd) < 0) storageError("new image sync failed");
+                syncDirectory(path.parent_path());
+            }
+            else
+            {
+                size_t offset = 0u;
+                while (offset < image.size())
+                {
+                    const ssize_t count = ::read(file.fd, image.data() + offset, image.size() - offset);
+                    if (count < 0 && errno == EINTR) continue;
+                    if (count < 0) storageError("image read failed");
+                    if (count == 0) throw std::runtime_error("IOP memory-card image shortened during mount");
+                    offset += static_cast<size_t>(count);
+                }
+            }
+            m_impl->path = path;
+            m_impl->image.swap(image);
+            m_impl->state = {};
+            m_impl->failed = false;
+            m_impl->fd = file.release();
+        }
+        catch (...)
+        {
+            if (created) (void)::unlink(path.c_str());
+            throw;
+        }
+    }
+
+    bool IopMemoryCard::attached() const noexcept { return m_impl->fd >= 0; }
+
+    std::vector<uint8_t> IopMemoryCard::exchange(std::span<const uint8_t> transmit, size_t receiveSize)
+    {
+        auto next = m_impl->state;
+        auto result = m_impl->process(transmit, receiveSize, next);
+        m_impl->commit(result.changes);
+        m_impl->state = std::move(next);
+        return result.response;
+    }
+
+    void IopMemoryCard::validateExchanges(std::span<const Packet> packets) const
+    {
+        auto next = m_impl->state;
+        for (const auto &packet : packets)
+            (void)m_impl->process(packet.transmit, packet.receiveSize, next);
+    }
+
+    void IopMemoryCard::resetProtocol() { m_impl->state = {}; }
+}
