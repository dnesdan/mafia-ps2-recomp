+    using ps2x::iop::detail::IopMemoryCard;
+    using Bytes = std::vector<uint8_t>;
+
+    void require(bool condition, const char *message)
+    {
+        if (!condition) throw std::runtime_error(message);
+    }
+
+    template<typename F> void rejected(F &&call, const char *message)
+    {
+        bool failed = false;
+        try { call(); } catch (const std::runtime_error &) { failed = true; }
+        require(failed, message);
+    }
+
+    struct Temporary
+    {
+        Temporary()
+        {
+            auto text = (std::filesystem::temp_directory_path() / "ps2-card-tests-XXXXXX").string();
+            text.push_back('\0');
+            const char *created = ::mkdtemp(text.data());
+            if (!created) throw std::runtime_error("cannot create card test directory");
+            directory = created;
+        }
+        ~Temporary() { std::error_code error; std::filesystem::remove_all(directory, error); }
+        std::filesystem::path directory;
+        std::filesystem::path image() const { return directory / "card.ps2"; }
+    };
+
+    Bytes packet(uint8_t command, size_t size)
+    {
+        Bytes tx(size, 0u);
+        tx[0u] = 0x81u;
+        tx[1u] = command;
+        return tx;
+    }
+
+    Bytes address(uint8_t command, uint32_t page)
+    {
+        auto tx = packet(command, 9u);
+        for (size_t i = 0; i < 4u; ++i)
+        {
+            tx[2u + i] = static_cast<uint8_t>(page >> (i * 8u));
+            tx[6u] ^= tx[2u + i];
+        }
+        return tx;
+    }
+
+    uint8_t xorBytes(const Bytes &bytes)
+    {
+        uint8_t result = 0u;
+        for (auto byte : bytes) result ^= byte;
+        return result;
+    }
+
+    Bytes writePacket(const Bytes &bytes)
+    {
+        auto tx = packet(0x42u, bytes.size() + 6u);
+        tx[2u] = static_cast<uint8_t>(bytes.size());
+        std::copy(bytes.begin(), bytes.end(), tx.begin() + 3u);
+        tx[3u + bytes.size()] = xorBytes(bytes);
+        return tx;
+    }
+
+    Bytes exchange(IopMemoryCard &card, const Bytes &tx) { return card.exchange(tx, tx.size()); }
+
+    Bytes read(IopMemoryCard &card, size_t count)
+    {
+        auto tx = packet(0x43u, count + 6u);
+        tx[2u] = static_cast<uint8_t>(count);
+        const auto rx = exchange(card, tx);
+        Bytes data(rx.begin() + 4u, rx.begin() + 4u + count);
+        require(rx[0u] == 0u && rx[1u] == 0u && rx[2u] == 0u && rx[3u] == 0x2Bu,
+                "read data ACK layout is wrong");
+        require(rx[count + 4u] == xorBytes(data), "read data XOR is wrong");
+        return data;
+    }
+
+    Bytes disk(const std::filesystem::path &path)
+    {
+        std::ifstream file(path, std::ios::binary);
+        require(file.is_open(), "cannot read authored raw image");
+        return Bytes(std::istreambuf_iterator<char>(file), {});
+    }
+
+    void blankImageAndWireGeometry()
+    {
+        Temporary temporary;
+        {
+            IopMemoryCard card;
+            require(!card.attached(), "empty backend is attached");
+            rejected([&] { card.mount(temporary.image(), false); }, "missing image mounted without create");
+            card.mount(temporary.image(), true);
+            require(card.attached(), "created card is detached");
+            const auto raw = disk(temporary.image());
+            require(raw.size() == IopMemoryCard::ImageBytes &&
+                std::all_of(raw.begin(), raw.end(), [](uint8_t b) { return b == 0xFFu; }),
+                "new raw card is sized incorrectly or falsely formatted");
+            require(exchange(card, packet(0x11u, 4u)) == Bytes({0u, 0u, 0x2Bu, 0x55u}),
+                    "probe ACK or initial terminator is wrong");
+            auto set = packet(0x27u, 5u); set[2u] = 0x5Au;
+            require(exchange(card, set) == Bytes({0u, 0u, 0u, 0x2Bu, 0x5Au}), "set terminator failed");
+            require(exchange(card, packet(0x28u, 5u)) == Bytes({0u, 0u, 0x2Bu, 0x5Au, 0x5Au}),
+                    "get terminator compatibility bytes are wrong");
+            require(exchange(card, packet(0x26u, 13u)) ==
+                Bytes({0u, 0u, 0x2Bu, 0u, 2u, 16u, 0u, 0u, 64u, 0u, 0u, 0x52u, 0x5Au}),
+                "geometry, flags or geometry XOR is wrong");
+            require(exchange(card, packet(0xF3u, 5u)).back() == 0x55u, "auth reset did not reset terminator");
+            for (uint8_t command : {0xF0u, 0xF1u, 0xF2u, 0xF7u})
+                rejected([&] { (void)exchange(card, packet(command, 5u)); }, "unsupported authentication reported success");
+            IopMemoryCard conflicting;
+            rejected([&] { conflicting.mount(temporary.image(), true); }, "concurrent image mount succeeded");
+        }
+        IopMemoryCard reopened;
+        reopened.mount(temporary.image(), false);
+        require(reopened.attached(), "valid exact-sized raw card did not reopen");
+    }
