+        (void)bridge.executePacketCall(0x80000400u, server, 6u, {}, 4u, executor, &transfers);
+        return expect(failed && transfers.empty() && executor.calls == 3u,
+                      "GetOtherData packet callback failure leaked ownership or invented EE output");
+    }
