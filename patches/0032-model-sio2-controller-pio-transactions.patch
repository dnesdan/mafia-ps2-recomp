+    void pressureOrderAndResponseMask()
+    {
+        Fixture f;
+        ControllerState state; state.connected = true; state.buttons = 0xBFFFu;
+        state.rightX = 0x12u; state.rightY = 0x34u; state.leftX = 0x56u; state.leftY = 0x78u;
+        for (size_t i = 0u; i < state.pressures.size(); ++i) state.pressures[i] = static_cast<uint8_t>(0x90u + i);
