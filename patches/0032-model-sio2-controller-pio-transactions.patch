diff --git a/ps2xIOP/src/emulator/core/iop_sio2.cpp b/ps2xIOP/src/emulator/core/iop_sio2.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_sio2.cpp
@@ -0,0 +1,432 @@
+#include "iop_sio2.h"
+#include "iop_memory.h"
+#include "../imports/iop_intrman.h"
+
+#include <algorithm>
+#include <array>
+#include <mutex>
+#include <span>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kQueue = 0x1F808200u;
+        constexpr uint32_t kPortControl = 0x1F808240u;
+        constexpr uint32_t kTx = 0x1F808260u;
+        constexpr uint32_t kRx = 0x1F808264u;
+        constexpr uint32_t kControl = 0x1F808268u;
+        constexpr uint32_t kStatus = 0x1F80826Cu;
+        constexpr uint32_t kConnections = 0x1F808270u;
+        constexpr uint32_t kFifoStatus = 0x1F808274u;
+        constexpr uint32_t kTxPointer = 0x1F808278u;
+        constexpr uint32_t kRxPointer = 0x1F80827Cu;
+        constexpr uint32_t kIrqStatus = 0x1F808280u;
+        constexpr size_t kFifoCapacity = 256u;
+        constexpr uint32_t kIrq = 17u;
+
+        [[noreturn]] void unsupported(const char *operation, uint32_t value)
+        {
+            std::ostringstream message;
+            message << "Unsupported IOP SIO2 " << operation << " 0x" << std::hex << value;
+            throw std::runtime_error(message.str());
+        }
+
+        struct InputSample
+        {
+            ControllerState state;
+            uint64_t connectionSerial = 1u;
+        };
+
+        struct PadProtocol
+        {
+            uint64_t connectionSerial = 0u;
+            uint8_t mode = 0x41u;
+            bool configuration = false;
+            bool analogLocked = false;
+            std::array<uint8_t, 6u> actuatorMap{0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu};
+            std::array<uint8_t, 6u> vref{};
+        };
+
+        // These bytes describe the DS2 serial protocol, independently of guest
+        // module names, RPC functions, or EE pad buffers.
+        std::vector<uint8_t> controllerReply(PadProtocol &pad, const InputSample &input,
+                                              std::span<const uint8_t> tx, size_t receiveSize)
+        {
+            if (pad.connectionSerial != input.connectionSerial)
+            {
+                pad = {};
+                pad.connectionSerial = input.connectionSerial;
+            }
+            if (tx.size() < 3u)
+                unsupported("short controller packet", static_cast<uint32_t>(tx.size()));
+            const uint8_t command = tx[1];
+            const bool configurationAtStart = pad.configuration;
+            if (command != 0x42u && command != 0x43u && !configurationAtStart)
+                unsupported("controller configuration command outside configuration mode", command);
+            std::array<uint8_t, 21u> response{};
+            response[0] = 0xFFu;
+            response[1] = configurationAtStart ? 0xF3u : pad.mode;
+            response[2] = 0x5Au;
+            const size_t responseSize = configurationAtStart ? 9u :
+                (pad.mode == 0x79u ? 21u : pad.mode == 0x73u ? 9u : 5u);
+            const auto requireSize = [&](size_t size)
+            {
+                if (tx.size() < size)
+                    unsupported("truncated controller command", command);
+            };
+            switch (command)
+            {
+            case 0x42u:
+                response[3] = static_cast<uint8_t>(input.state.buttons);
+                response[4] = static_cast<uint8_t>(input.state.buttons >> 8u);
+                response[5] = input.state.rightX;
+                response[6] = input.state.rightY;
+                response[7] = input.state.leftX;
+                response[8] = input.state.leftY;
+                std::copy(input.state.pressures.begin(), input.state.pressures.end(), response.begin() + 9u);
+                break;
+            case 0x43u:
+                requireSize(4u);
+                pad.configuration = tx[3] != 0u;
+                break;
+            case 0x40u:
+                requireSize(9u);
+                std::copy_n(tx.begin() + 3u, pad.vref.size(), pad.vref.begin());
+                response[5] = 2u;
+                response[8] = 0x5Au;
+                break;
+            case 0x41u:
+                requireSize(9u);
+                if (pad.mode != 0x41u)
+                {
+                    response[3] = response[4] = 0xFFu;
+                    response[5] = 3u;
+                    response[8] = 0x5Au;
+                }
+                break;
+            case 0x44u:
+                requireSize(9u);
+                pad.mode = tx[3] != 0u ? 0x73u : 0x41u;
+                pad.analogLocked = tx[4] == 3u;
+                break;
+            case 0x45u:
+                requireSize(9u);
+                response[3] = 3u;
+                response[4] = 2u;
+                response[5] = pad.mode == 0x41u ? 0u : 1u;
+                response[6] = 2u;
+                response[7] = 1u;
+                break;
+            case 0x46u:
+                requireSize(9u);
+                if (tx[3] > 1u)
+                    unsupported("actuator query selector", tx[3]);
+                response[5] = 1u;
+                response[6] = tx[3] == 0u ? 2u : 1u;
+                response[7] = tx[3] == 0u ? 0u : 1u;
+                response[8] = tx[3] == 0u ? 0x0Au : 0x14u;
+                break;
+            case 0x47u:
+                requireSize(9u);
+                response[5] = 2u;
+                response[7] = 1u;
+                break;
+            case 0x4Cu:
+                requireSize(9u);
+                if (tx[3] > 1u)
+                    unsupported("mode query selector", tx[3]);
+                response[6] = tx[3] == 0u ? 4u : 7u;
+                break;
+            case 0x4Du:
+                requireSize(9u);
+                std::copy(pad.actuatorMap.begin(), pad.actuatorMap.end(), response.begin() + 3u);
+                std::copy_n(tx.begin() + 3u, pad.actuatorMap.size(), pad.actuatorMap.begin());
+                break;
+            case 0x4Fu:
+            {
+                requireSize(9u);
+                const uint32_t mask = uint32_t(tx[3]) | (uint32_t(tx[4]) << 8u) | (uint32_t(tx[5]) << 16u);
+                if (mask == 0u)
+                    pad.mode = 0x41u;
+                else if (mask == 0x3Fu)
+                    pad.mode = 0x73u;
+                else if (mask == 0x3FFFFu)
+                    pad.mode = 0x79u;
+                else
+                    unsupported("controller response mask", mask);
+                response[8] = 0x5Au;
+                break;
+            }
+            default:
+                unsupported("controller command", command);
+            }
+            std::vector<uint8_t> result(receiveSize, 0xFFu);
+            std::copy_n(response.begin(), std::min(responseSize, receiveSize), result.begin());
+            return result;
+        }
+    }
+
+    class IopSio2::Impl final : public IopSio2Registers
+    {
+    public:
+        explicit Impl(IopMemory &owner) : memory(owner) {}
+
+        void clearTransfer()
+        {
+            tx.clear();
+            rx.clear();
+            rxPosition = 0u;
+            status = 0x1000u;
+            irqStatus = 0u;
+            irqDelivered = false;
+        }
+
+        void reset()
+        {
+            // Host setters only access inputs under inputMutex. Neither the
+            // mutex, the samples, nor their connection lifetimes are replaced.
+            descriptors = {};
+            portControls = {};
+            protocols = {};
+            control = 0u;
+            servicing = false;
+            clearTransfer();
+            transfers = irqCallbacks = controllerPackets = memoryCardPackets = missingDevices = 0u;
+            lastPort = lastCommand = 0u;
+            lastButtons = 0xFFFFu;
+        }
+
+        void setControllerState(uint32_t port, const ControllerState &state)
+        {
+            if (port >= inputs.size())
+                throw std::out_of_range("SIO2 controller port must be 0 or 1");
+            const std::lock_guard lock(inputMutex);
+            auto &input = inputs[port];
+            if (input.state.connected != state.connected && ++input.connectionSerial == 0u)
+                input.connectionSerial = 1u;
+            input.state = state;
+        }
+
+        uint32_t readSio2Register(uint32_t physical, uint32_t width) override
+        {
+            if (physical == kRx && (width == 1u || width == 2u || width == 4u))
+            {
+                if (width > rx.size() - rxPosition)
+                    unsupported("RX FIFO underflow", width);
+                uint32_t value = 0u;
+                for (uint32_t i = 0u; i < width; ++i)
+                    value |= uint32_t(rx[rxPosition++]) << (i * 8u);
+                return value;
+            }
+            if (width != 4u || (physical & 3u) != 0u)
+                unsupported("register read width/alignment", physical);
+            if (physical >= kQueue && physical < kPortControl)
+                return descriptors[(physical - kQueue) / 4u];
+            if (physical >= kPortControl && physical < kTx)
+                return portControls[(physical - kPortControl) / 4u];
+            switch (physical)
+            {
+            case kControl: return control;
+            case kStatus: return status;
+            case kConnections: return 0xFu; // The fixed, ordinary two-port/no-multitap profile.
+            case kFifoStatus: return static_cast<uint32_t>(tx.size()) |
+                (static_cast<uint32_t>(rx.size() - rxPosition) << 16u);
+            case kTxPointer:
+            case kRxPointer: return 0u;
+            case kIrqStatus: return irqStatus;
+            default: unsupported("register read", physical);
+            }
+        }
+
+        void writeSio2Register(uint32_t physical, uint32_t width, uint32_t value) override
+        {
+            if (physical == kTx && width == 1u)
+            {
+                if (tx.size() == kFifoCapacity)
+                    unsupported("TX FIFO overflow", static_cast<uint32_t>(tx.size()));
+                tx.push_back(static_cast<uint8_t>(value));
+                return;
+            }
+            if (width != 4u || (physical & 3u) != 0u)
+                unsupported("register write width/alignment", physical);
+            if (physical >= kQueue && physical < kPortControl)
+            {
+                descriptors[(physical - kQueue) / 4u] = value;
+                return;
+            }
+            if (physical >= kPortControl && physical < kTx)
+            {
+                portControls[(physical - kPortControl) / 4u] = value;
+                return;
+            }
+            if (physical == kTxPointer || physical == kRxPointer)
+            {
+                if (value != 0u)
+                    unsupported("FIFO pointer write", value);
+                return;
+            }
+            if (physical == kIrqStatus)
+            {
+                irqStatus &= ~value; // Hardware interrupt status is write-one-to-clear.
+                if (irqStatus == 0u)
+                    irqDelivered = false;
+                return;
+            }
+            if (physical != kControl)
+                unsupported("register write", physical);
+            if ((value & ~0xFBFu) != 0u || (value & 2u) != 0u)
+                unsupported("control mode", value);
+            if ((value & 1u) != 0u)
+                transfer();
+            else if ((value & 0xCu) != 0u)
+                clearTransfer();
+            // START/reset are strobes. A driver's read|START must not reset TX.
+            control = value & ~0xFu;
+        }
+
+        void transfer()
+        {
+            size_t transmitSize = 0u, receiveSize = 0u, count = 0u;
+            for (; count < descriptors.size() && descriptors[count] != 0u; ++count)
+            {
+                const uint32_t descriptor = descriptors[count];
+                if ((descriptor & 0xFCu) != 0x40u || (descriptor & 0x38020000u) != 0u)
+                    unsupported("transfer descriptor (only normal PIO is modeled)", descriptor);
+                const size_t send = (descriptor >> 8u) & 0x1FFu;
+                const size_t receive = (descriptor >> 18u) & 0x1FFu;
+                if (send == 0u || receive == 0u || send > kFifoCapacity || receive > kFifoCapacity ||
+                    send > kFifoCapacity - transmitSize || receive > kFifoCapacity - receiveSize)
+                    unsupported("transfer size", descriptor);
+                transmitSize += send;
+                receiveSize += receive;
+            }
+            if (count == 0u || transmitSize != tx.size())
+                unsupported("TX count does not match descriptor queue", static_cast<uint32_t>(tx.size()));
+            if (rxPosition != rx.size())
+                unsupported("unread RX data before next transfer", static_cast<uint32_t>(rx.size() - rxPosition));
+
+            std::array<InputSample, 2u> samples;
+            {
+                const std::lock_guard lock(inputMutex);
+                samples = inputs;
+            }
+            // Queue and protocol preflight is transactional: even a later
+            // unsupported packet cannot partially change negotiation or RX.
+            auto nextProtocols = protocols;
+            std::vector<uint8_t> result;
+            result.reserve(receiveSize);
+            size_t txPosition = 0u;
+            uint64_t nextControllerPackets = 0u, nextCardPackets = 0u, nextMissingDevices = 0u;
+            uint32_t nextPort = 0u, nextCommand = 0u, nextButtons = lastButtons;
+            uint32_t nextStatus = 0x1000u | (static_cast<uint32_t>(count & 0xFu) << 8u);
+            for (size_t index = 0u; index < count; ++index)
+            {
+                const uint32_t descriptor = descriptors[index];
+                const uint32_t port = descriptor & 3u;
+                const size_t send = (descriptor >> 8u) & 0x1FFu;
+                const size_t receive = (descriptor >> 18u) & 0x1FFu;
+                const std::span packet(tx.data() + txPosition, send);
+                txPosition += send;
+                nextPort = port;
+                nextCommand = packet.size() > 1u ? packet[1] : 0u;
+                nextControllerPackets += packet[0] == 0x01u;
+                nextCardPackets += packet[0] == 0x81u;
+                if (packet[0] == 0x01u && port < samples.size() && samples[port].state.connected)
+                {
+                    const auto reply = controllerReply(nextProtocols[port], samples[port], packet, receive);
+                    result.insert(result.end(), reply.begin(), reply.end());
+                    nextButtons = samples[port].state.buttons;
+                }
+                else
+                {
+                    // No physical card or multitap is attached. Address 0x81
+                    // never receives pad bytes or a fabricated HLE card image.
+                    result.insert(result.end(), receive, 0xFFu);
+                    // PS2SDK STAT_ERR_QUEUE_SLOT identifies descriptor position,
+                    // not port number; several slots can address the same port.
+                    nextStatus |= 0xC000u | (1u << (16u + index));
+                    ++nextMissingDevices;
+                }
+            }
+            protocols = nextProtocols;
+            ++transfers;
+            controllerPackets += nextControllerPackets;
+            memoryCardPackets += nextCardPackets;
+            missingDevices += nextMissingDevices;
+            lastPort = nextPort;
+            lastCommand = nextCommand;
+            lastButtons = nextButtons;
+            tx.clear();
+            rx = std::move(result);
+            rxPosition = 0u;
+            status = nextStatus;
+            if (irqStatus == 0u)
+                irqDelivered = false;
+            irqStatus |= 1u | ((status & 0xC000u) != 0u ? 2u : 0u);
+        }
+
+        void serviceInterrupt(const IopIntrman &intrman, IopGuestExecutor &executor)
+        {
+            const bool enabled = ((irqStatus & 1u) != 0u && (control & 0x200u) != 0u) ||
+                                 ((irqStatus & 2u) != 0u && (control & 0x100u) != 0u);
+            if (!enabled || irqDelivered || servicing || intrman.inInterruptContext() ||
+                memory.interruptControl() == 0u || (memory.interruptMask() & (1u << kIrq)) == 0u)
+                return;
+            struct Scope
+            {
+                bool &value;
+                explicit Scope(bool &flag) : value(flag) { value = true; }
+                ~Scope() { value = false; }
+            } scope(servicing);
+            irqDelivered = true;
+            if (!intrman.dispatchRegisteredInterrupt(static_cast<int>(kIrq), executor))
+                irqDelivered = false;
+            else
+                ++irqCallbacks;
+            // Original guest ISR acknowledges W1C. Do not also assert raw
+            // I_STAT and invoke the same handler through a COP0 exception.
+        }
+
+        DebugService debugSnapshot() const
+        {
+            DebugService row;
+            row.name = "sio2_device";
+            row.metrics = {{"pio_transfers", transfers}, {"irq_callbacks", irqCallbacks},
+                {"controller_packets", controllerPackets}, {"memory_card_packets", memoryCardPackets},
+                {"missing_devices", missingDevices}, {"last_port", lastPort},
+                {"last_command", lastCommand, true}, {"last_buttons", lastButtons, true},
+                {"irq_status", irqStatus, true}, {"rx_remaining", rx.size() - rxPosition}};
+            return row;
+        }
+
+        IopMemory &memory;
+        std::mutex inputMutex;
+        std::array<InputSample, 2u> inputs{};
+        std::array<PadProtocol, 2u> protocols{};
+        std::array<uint32_t, 16u> descriptors{};
+        std::array<uint32_t, 8u> portControls{};
+        std::vector<uint8_t> tx, rx;
+        size_t rxPosition = 0u;
+        uint32_t control = 0u, status = 0x1000u, irqStatus = 0u;
+        bool irqDelivered = false, servicing = false;
+        uint64_t transfers = 0u, irqCallbacks = 0u, controllerPackets = 0u;
+        uint64_t memoryCardPackets = 0u, missingDevices = 0u;
+        uint32_t lastPort = 0u, lastCommand = 0u, lastButtons = 0xFFFFu;
+    };
+
+    IopSio2::IopSio2(IopMemory &memory) : m_impl(std::make_shared<Impl>(memory))
+    {
+        memory.bindSio2Registers(m_impl);
+        reset();
+    }
+
+    IopSio2::~IopSio2() = default;
+    void IopSio2::reset() { m_impl->reset(); }
+    void IopSio2::setControllerState(uint32_t port, const ControllerState &state) { m_impl->setControllerState(port, state); }
+    void IopSio2::serviceInterrupt(const IopIntrman &intrman, IopGuestExecutor &executor) { m_impl->serviceInterrupt(intrman, executor); }
+    DebugService IopSio2::debugSnapshot() const { return m_impl->debugSnapshot(); }
+}
