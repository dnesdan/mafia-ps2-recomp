+
+    void configurationQueriesAndMapping()
+    {
+        Fixture f; f.set(0u); (void)f.command(0x43u, 1u);
+        require(f.command(0x45u) == std::vector<uint8_t>({0xFFu,0xF3u,0x5Au,3u,2u,0u,2u,1u,0u}), "DS2 model query differs");
+        require(f.command(0x46u, 0u) == std::vector<uint8_t>({0xFFu,0xF3u,0x5Au,0u,0u,1u,2u,0u,10u}), "first actuator query differs");
+        require(f.command(0x46u, 1u)[8] == 20u && f.command(0x47u)[5] == 2u &&
+                    f.command(0x4Cu, 0u)[6] == 4u && f.command(0x4Cu, 1u)[6] == 7u, "capability query differs");
+        require(f.command(0x40u)[8] == 0x5Au, "pressure-reference response differs");
+        require(f.command(0x41u)[3] == 0u, "digital mode advertises an analog pressure mask");
+        (void)f.command(0x44u, 1u);
+        const auto mask = f.command(0x41u);
+        require(mask[3] == 0xFFu && mask[4] == 0xFFu && mask[5] == 3u && mask[8] == 0x5Au, "analog button mask differs");
+        const std::array<uint8_t, 9u> mapping{1u,0x4Du,0u,0u,1u,0xFFu,0xFFu,0xFFu,0xFFu};
+        const auto before = f.exchange(mapping);
+        require(std::all_of(before.begin() + 3, before.end(), [](auto x) { return x == 0xFFu; }), "initial actuator map differs");
+        const auto after = f.exchange(mapping);
+        require(after[3] == 0u && after[4] == 1u && after[8] == 0xFFu, "actuator-map response did not report previous mapping");
+    }
+
+    void portsAreIndependent()
+    {
+        Fixture f; f.set(0u, 0xFFF7u); f.set(1u, 0xBFFFu); f.pressure(1u);
+        require(f.exchange(poll, 5u, 0u)[1] == 0x41u, "port1 mode changed port0");
+        const std::array<uint8_t, 21u> bytes{1u,0x42u};
+        const auto second = f.exchange(bytes, 21u, 1u);
+        require(second[1] == 0x79u && second[4] == 0xBFu, "port1 input/mode was not retained");
+    }
+
+    void resetPreservesSamples()
+    {
+        Fixture f; f.set(0u, 0xFFF7u); f.pressure(); f.device.reset();
+        const auto response = f.exchange(poll, 5u);
+        require(response[1] == 0x41u && response[3] == 0xF7u, "reset lost host input or retained pressure negotiation");
+        f.memory.reset(); // Weak route survives loader RAM copies/reset as CDVD does.
+        require(f.exchange(poll, 5u)[3] == 0xF7u, "RAM reset disconnected the live device route");
+    }
+
+    void reconnectResetsOnlyThatPad()
+    {
+        Fixture f; f.set(0u); f.set(1u); f.pressure(0u); f.pressure(1u);
+        ControllerState unplugged; f.device.setControllerState(0u, unplugged); f.set(0u, 0xFFF7u);
+        const auto response = f.exchange(poll, 5u);
+        require(response[1] == 0x41u && response[3] == 0xF7u, "reconnect reused previous hardware negotiation");
+        const std::array<uint8_t,21u> bytes{1u,0x42u};
+        require(f.exchange(bytes,21u,1u)[1] == 0x79u, "port0 reconnect reset port1");
+    }
+
+    void absentDevicesAndCardAreDistinct()
+    {
+        Fixture f;
+        require(f.exchange(poll,5u) == std::vector<uint8_t>(5u,0xFFu), "absent pad returned controller bytes");
+        require(f.memory.read32(STAT) == 0x1D100u && f.memory.read32(IRQ) == 3u, "missing-pad ACK/error status differs");
+        f.set(0u);
+        const std::array<uint8_t,5u> card{0x81u,0x11u};
+        require(f.exchange(card,5u) == std::vector<uint8_t>(5u,0xFFu), "card selection received an attached pad response");
+        const auto row = f.device.debugSnapshot();
+        require(row.name == "sio2_device", "missing bus diagnostic row");
+        const auto metric = [&](const char *name)
+        {
+            for (const auto &value : row.metrics) if (value.name == name) return value.value;
+            throw std::runtime_error("missing metric");
+        };
+        require(metric("controller_packets") == 1u && metric("memory_card_packets") == 1u && metric("missing_devices") == 2u,
+                "device selection diagnostic counts differ");
+    }
+
+    void descriptorErrorsUseQueueIndex()
+    {
+        Fixture f; f.set(0u);
+        for (const bool missingFirst : {false,true})
+        {
+            f.memory.write32(CTRL,0x3BCu);
+            f.memory.write32(Q,descriptor(missingFirst ? 1u : 0u,5u,5u));
+            f.memory.write32(Q+4u,descriptor(missingFirst ? 0u : 1u,5u,5u));
+            f.memory.write32(Q+8u,0u);
+            for (unsigned i=0u;i<2u;++i) for (auto b:poll) f.memory.write8(TX,b);
+            f.memory.write32(CTRL,0x201u);
+            require((f.memory.read32(STAT)>>16u) == (missingFirst ? 1u : 2u), "ACK error indexed connector instead of descriptor position");
+            (void)f.drain(10u);
+        }
+        f.memory.write32(CTRL,0x3BCu);
+        for (uint32_t i=0u;i<16u;++i)
+        {
+            f.memory.write32(Q+i*4u,descriptor(1u,5u,5u));
+            for (auto b:poll) f.memory.write8(TX,b);
+        }
+        f.memory.write32(CTRL,0x201u);
+        require(f.memory.read32(STAT)==0xFFFFD000u, "sixteen queue-slot ACK flags or queue wrap differs");
+        (void)f.drain(80u);
+    }
+
+    void queuePreflightRollsBackProtocol()
+    {
+        Fixture f; f.set(0u);
+        const std::array<uint8_t,5u> enter{1u,0x43u,0u,1u,0u};
+        const std::array<uint8_t,5u> bad{1u,0x99u,0u,0u,0u};
+        f.memory.write32(Q,descriptor(0u,5u,5u)); f.memory.write32(Q+4u,descriptor(0u,5u,5u));
+        for (auto b:enter) f.memory.write8(TX,b);
+        for (auto b:bad) f.memory.write8(TX,b);
+        throws([&] { f.memory.write32(CTRL,0x201u); });
+        require(f.memory.read32(FIFO)==10u && f.memory.read32(IRQ)==0u, "failed queue partially consumed TX or committed IRQ");
+        require(f.exchange(poll,5u)[1]==0x41u, "failed queue partially entered config mode");
+    }
+
+    void unsupportedModesStayStrict()
+    {
+        Fixture f; f.set(0u);
+        throws([&] { (void)f.command(0x45u); });
+        throws([&] { f.memory.write32(CTRL,0x40000000u); });
+        throws([&] { f.memory.write32(CTRL,2u); });
+        f.memory.write32(CTRL,0x3BCu); f.memory.write32(Q,descriptor(0u,5u,5u)|0x10u);
+        for (auto b:poll) f.memory.write8(TX,b);
+        throws([&] { f.memory.write32(CTRL,0x201u); });
+        require((f.memory.read32(FIFO)&0x1FFu)==5u, "unsupported DMA consumed PIO bytes");
+        (void)f.command(0x43u,1u);
+        throws([&] { (void)f.command(0x46u,2u); });
+        const std::array<uint8_t,9u> unknownMask{1u,0x4Fu,0u,3u};
+        throws([&] { (void)f.exchange(unknownMask); });
+        (void)f.command(0x43u);
+        require(f.exchange(poll,5u)[1]==0x41u, "unsupported response mask changed mode");
+    }
+
+    void fifoWidthsBoundsAndAliases()
+    {
+        Fixture f; f.set(0u,0xFFF7u); f.begin(poll,5u);
+        require(f.memory.read16(0x1F808264u)==0x41FFu && f.memory.read16(0x9F808264u)==0xF75Au &&
+                    f.memory.read8(RX)==0xFFu, "FIFO widths/physical aliases do not consume little-endian bytes");
+        throws([&] { (void)f.memory.read8(RX); });
+        throws([&] { f.memory.write16(TX,1u); });
+        f.memory.write32(Q-4u,0x12345678u);
+        throws([&] { f.memory.write16(Q-1u,0u); });
+        require(f.memory.read32(Q-4u)==0x12345678u, "unaligned device-boundary store partially wrote neighboring register");
+        std::array<uint8_t,256u> bytes{}; bytes[0]=1u; bytes[1]=0x42u;
+        f.begin(bytes,256u);
+        require(f.memory.read32(FIFO)==0x01000000u, "full FIFO size lost its ninth bit");
+        (void)f.drain(256u);
+        f.memory.write32(CTRL,0x3BCu);
+        for (size_t i=0u;i<256u;++i) f.memory.write8(TX,0u);
+        throws([&] { f.memory.write8(TX,0u); });
+        require(f.memory.read32(FIFO)==256u, "TX overflow changed queue size");
+    }
+
+    void invalidCountsAndUnreadRx()
+    {
+        Fixture f; f.set(0u);
+        f.memory.write32(Q,descriptor(0u,6u,5u));
+        for (auto b:poll) f.memory.write8(TX,b);
+        throws([&] { f.memory.write32(CTRL,0x201u); });
+        require(f.memory.read32(FIFO)==5u, "TX mismatch consumed data");
+        f.begin(poll,5u);
+        for (auto b:poll) f.memory.write8(TX,b);
+        throws([&] { f.memory.write32(CTRL,0x201u); });
+        require(f.memory.read32(FIFO)==0x00050005u, "unread RX was overwritten by another transaction");
+        (void)f.drain(5u);
+    }
+
+    void weakMemoryRouteLifetime()
+    {
+        IopMemory memory;
+        auto device=std::make_unique<IopSio2>(memory);
+        IopMemory staged=memory;
+        memory=staged;
+        memory.reset();
+        require(memory.read32(CTRL)==0u && staged.read32(STAT)==0x1000u, "staged RAM copy lost live device route");
+        device.reset();
+        throws([&] { (void)memory.read32(CTRL); });
+        throws([&] { (void)staged.read32(CTRL); });
+    }
+
+    void irqMasksPendingAndW1c()
+    {
+        Fixture f; f.set(0u); f.install(); f.begin(poll,5u,0u,1u);
+        require(f.executor.calls==0u, "guest handler ran inside a register store");
+        f.service(); require(f.executor.calls==0u, "device completion-enable gate ignored");
+        f.memory.write32(CTRL,0x200u); f.memory.setInterruptControl(0u);
+        f.service(); require(f.executor.calls==0u, "CPU interrupt suspend ignored");
+        f.memory.setInterruptControl(1u); f.memory.setInterruptMask(0u);
+        f.service(); require(f.executor.calls==0u, "live I_MASK ignored");
+        f.memory.setInterruptMask(1u<<17u); f.service();
+        require(f.executor.calls==1u && f.memory.read32(IRQ)==1u && f.memory.interruptStatus()==0u,
+                "pending IRQ was lost or duplicated through raw I_STAT");
+        f.service(); f.memory.write32(IRQ,0u); f.service();
+        require(f.executor.calls==1u && f.memory.read32(IRQ)==1u, "unacknowledged latch was redelivered or zero-write cleared it");
+        f.memory.write32(IRQ,1u); require(f.memory.read32(IRQ)==0u, "W1C did not acknowledge completion");
+        f.executor.ack=true; f.begin(poll,5u); f.service();
+        require(f.executor.calls==2u && f.memory.read32(IRQ)==0u, "next transfer failed to deliver after W1C");
+    }
+
+    void liveMaskOverridesStaleIntrmanBookkeeping()
+    {
+        Fixture f; f.set(0u); f.install(); f.import(7u); f.begin(poll,5u); f.service();
+        require(f.executor.calls==0u, "DisableIntr gate ignored");
+        f.memory.write32(0xBF801074u,1u<<17u); f.executor.ack=true; f.service();
+        require(f.executor.calls==1u, "stale EnableIntr bookkeeping shadowed direct hardware reenable");
+    }
+
+    void irqReentryAndFaultUnwind()
+    {
+        Fixture f; f.set(0u); f.install(); f.begin(poll,5u);
+        f.executor.callback=[&] { f.service(); }; f.executor.fail=true;
+        throws([&] { f.service(); });
+        require(f.executor.calls==1u && !f.intrman.inInterruptContext(), "nested IRQ or exception leaked interrupt context");
+        f.device.reset(); f.executor.fail=false; f.executor.ack=true;
+        f.begin(poll,5u); f.service();
+        require(f.executor.calls==2u && !f.intrman.inInterruptContext(), "reset did not restore post-failure interrupt delivery");
+    }
+
+    void concurrentHostSamplesAndReset()
+    {
+        Fixture f; f.set(0u); f.pressure();
+        ControllerState a; a.connected=true; a.buttons=0xFFF7u; a.rightX=0x11u; a.pressures.fill(0x22u);
+        ControllerState b=a; b.buttons=0xBFFFu; b.rightX=0x33u; b.pressures.fill(0x44u);
+        std::atomic<bool> stop=false;
+        std::jthread writer([&] { while (!stop.load()) { f.device.setControllerState(0u,a); f.device.setControllerState(0u,b); } });
+        try
+        {
+            const std::array<uint8_t,21u> bytes{1u,0x42u};
+            for (size_t i=0u;i<200u;++i)
+            {
+                const auto response=f.exchange(bytes,21u);
+                require((response[3]==0xF7u && response[4]==0xFFu && response[5]==0x11u &&
+                             std::all_of(response.begin()+9, response.end(), [](auto x) { return x==0x22u; })) ||
+                            (response[3]==0xFFu && response[4]==0xBFu && response[5]==0x33u &&
+                             std::all_of(response.begin()+9, response.end(), [](auto x) { return x==0x44u; })) ||
+                            (response[3]==0xFFu && response[4]==0xFFu && response[5]==0x80u &&
+                             std::all_of(response.begin()+9, response.end(), [](auto x) { return x==0u; })),
+                        "transaction contains fields from different host samples");
+            }
+            for (size_t i=0u;i<200u;++i) f.device.reset();
+        }
+        catch (...) { stop=true; writer.join(); throw; }
+        stop=true; writer.join(); f.device.setControllerState(0u,a);
+        require(f.exchange(poll,5u)[3]==0xF7u, "host sample channel failed after concurrent resets");
+    }
+
+    void publicApiResetAndRuntimeIsolation()
+    {
+        iop_test::Host firstHost,secondHost;
+        IopSubsystem first(firstHost),second(secondHost);
+        ControllerState firstState; firstState.connected=true; firstState.buttons=0xFFF7u;
+        ControllerState secondState; secondState.connected=true;
+        first.setControllerState(0u,firstState); second.setControllerState(0u,secondState);
+        first.reset();
+        require(executeTransfer(first,1u)[1]==0xF75A41FFu, "public host input disappeared on IOP reset");
+        require(executeTransfer(second,1u)[1]==0xFF5A41FFu, "one runtime's input leaked into another");
+        throws([&] { first.setControllerState(2u,firstState); });
+        require(iop_test::metric(first,"sio2_device","pio_transfers")==1u &&
+                    iop_test::metric(first,"sio2_device","irq_callbacks")==1u,
+                "public debug service does not report genuine bus/IRQ work");
+    }
+#endif
+}
+
+int main()
+{
+    const iop_test::Test tests[]{
+        {"authored MIPS Start through physical FIFO and original-style IRQ17", originalInstructionPathStart},
+        {"authored MIPS physical card selection returns no ACK without HLE", originalInstructionPathAbsentCard},
+#ifndef PS2X_SIO2_BASELINE_ONLY
+        {"digital press and release wire masks",digitalPressAndRelease},
+        {"one immutable host sample per transaction",transactionSamplesOnce},
+        {"configuration transaction IDs and analog mode",configurationIdsAndAnalog},
+        {"pressure mode masks and byte ordering",pressureOrderAndResponseMask},
+        {"controller capability queries and actuator mapping",configurationQueriesAndMapping},
+        {"port input and mode isolation",portsAreIndependent},
+        {"device and RAM reset preserve host samples",resetPreservesSamples},
+        {"reconnection resets only one protocol lifetime",reconnectResetsOnlyThatPad},
+        {"absent controller and physical card remain distinct",absentDevicesAndCardAreDistinct},
+        {"ACK error bits identify descriptor slots including slot15",descriptorErrorsUseQueueIndex},
+        {"failed queue preflight rolls back negotiation",queuePreflightRollsBackProtocol},
+        {"unsupported DMA/control/protocol modes stay strict",unsupportedModesStayStrict},
+        {"FIFO widths capacity and memory aliases",fifoWidthsBoundsAndAliases},
+        {"invalid TX counts and unread RX are preserved",invalidCountsAndUnreadRx},
+        {"weak device routing survives RAM staging but not device destruction",weakMemoryRouteLifetime},
+        {"IRQ live gates pending latch W1C and no duplicate COP0 path",irqMasksPendingAndW1c},
+        {"direct I_MASK reenabling owns IRQ delivery",liveMaskOverridesStaleIntrmanBookkeeping},
+        {"IRQ reentry and exception unwind",irqReentryAndFaultUnwind},
+        {"concurrent input samples and reset lifetime",concurrentHostSamplesAndReset},
+        {"public per-runtime API reset and diagnostics",publicApiResetAndRuntimeIsolation},
+#endif
+    };
+    return iop_test::run(tests);
+}
