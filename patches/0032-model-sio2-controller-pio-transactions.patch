+        for (size_t i = 0u; i < state.pressures.size(); ++i) require(response[9u + i] == 0x90u + i, "pressure order differs");
+        (void)f.command(0x43u, 1u);
+        const std::array<uint8_t, 9u> analog{1u, 0x4Fu, 0u, 0x3Fu};
