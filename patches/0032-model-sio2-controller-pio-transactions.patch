--- /dev/null
+++ b/ps2xIOP/tests/iop_sio2_tests.cpp
@@ -0,0 +1,533 @@
+#include "iop_compat_test_support.h"
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/imports/iop_intrman.h"
+#include "emulator/services/iop_rpc.h"
+#ifndef PS2X_SIO2_BASELINE_ONLY
+#include "emulator/core/iop_sio2.h"
+#endif
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <thread>
+
+namespace
+{
+    using namespace ps2x::iop;
+    using namespace ps2x::iop::detail;
+    using iop_test::require;
+    constexpr uint32_t Q = 0xBF808200u, TX = Q + 0x60u, RX = Q + 0x64u;
+    constexpr uint32_t CTRL = Q + 0x68u, STAT = Q + 0x6Cu, FIFO = Q + 0x74u, IRQ = Q + 0x80u;
+
+    template <typename Function> void throws(Function function)
+    {
+        bool failed = false;
+        try { function(); } catch (const std::exception &) { failed = true; }
+        require(failed, "unsupported or invalid transaction was silently accepted");
+    }
+
+    uint32_t descriptor(uint32_t port, size_t send, size_t receive)
+    {
+        return port | 0x40u | (static_cast<uint32_t>(send) << 8u) |
+            (static_cast<uint32_t>(receive) << 18u);
+    }
+
+    // Authored MIPS startup and ISR. No original IRX bytes or EE-pad-buffer
+    // shortcut: the module registers IRQ17, writes real MMIO, and its ISR reads
+    // the RX FIFO and W1C status into its own ordinary IOP data segment.
+    iop_test::Irx guestTransfer(uint8_t address)
+    {
+        iop_test::Irx image(0x10000u, 0x500u);
+        std::vector<uint32_t> code;
+        const auto emit = [&](uint32_t word) { code.push_back(word); };
+        const auto li = [&](uint32_t reg, uint32_t value)
+        {
+            emit(0x3C000000u | (reg << 16u) | (value >> 16u));
+            emit(0x34000000u | (reg << 21u) | (reg << 16u) | (value & 0xFFFFu));
+        };
+        const auto call = [&](uint32_t function)
+        {
+            emit(0x0C000000u | (function >> 2u)); emit(0u);
+        };
+        emit(0x27BDFFE0u); emit(0xAFBF001Cu);
+        li(4u, 17u); li(5u, 1u); li(6u, 0x10200u); li(7u, 0x10400u);
+        call(0x10314u); // intrman RegisterIntrHandler
+        li(4u, 17u); call(0x1031Cu); // EnableIntr
+        li(17u, Q); li(8u, 0x3BCu); emit(0xAE280068u);
+        li(8u, descriptor(0u, 5u, 5u)); emit(0xAE280000u); emit(0xAE200004u);
+        for (const uint8_t byte : {address, uint8_t{0x42u}, uint8_t{0u}, uint8_t{0u}, uint8_t{0u}})
+        {
+            li(8u, byte); emit(0xA2280060u);
+        }
+        emit(0x8E280068u); emit(0u); emit(0x35080001u); emit(0xAE280068u);
+        emit(0x8FBF001Cu); emit(0x27BD0020u); emit(0x03E00008u); emit(0x00001021u);
+        require(code.size() * 4u < 0x200u, "authored entry overlaps ISR");
+        uint32_t offset = 0u;
+        for (const uint32_t word : code) { image.words(offset, {word}); offset += 4u; }
+        image.words(0x200u, {
+            0x3C08BF80u, 0x35088200u, 0x8C890000u, 0u, 0x25290001u, 0xAC890000u,
+            0x8D0A0064u, 0u, 0xAC8A0004u, 0x910B0064u, 0u, 0xAC8B0008u,
+            0x8D0A006Cu, 0u, 0xAC8A000Cu, 0x8D0A0080u, 0u, 0xAC8A0010u,
+            0x240A0003u, 0xAD0A0080u, 0x03E00008u, 0x24020001u,
+        });
+        image.words(0x300u, {0x41E00000u, 0u, 0x0101u, 0x72746E69u, 0x006E616Du,
+            0x03E00008u, 0x24000004u, 0x03E00008u, 0x24000006u, 0u, 0u});
+        return image;
+    }
+
+    std::array<uint32_t, 5u> executeTransfer(IopSubsystem &iop, uint8_t address)
+    {
+        const auto image = guestTransfer(address);
+        const auto loaded = iop.loadModuleImage("authored-sio2.irx", image.bytes, nullptr, 0u);
+        require(loaded.handled && loaded.moduleId > 0 && loaded.startResult == 0,
+                "authored SIO2 MIPS entry did not return resident");
+        std::array<uint32_t, 5u> result{};
+        require(iop.readMemory(0x10400u, result.data(), sizeof(result)), "cannot read authored ISR result");
+        return result;
+    }
+
+    void originalInstructionPathStart()
+    {
+        iop_test::Host host;
+        IopSubsystem iop(host);
+#ifndef PS2X_SIO2_BASELINE_ONLY
+        ControllerState state;
+        state.connected = true;
+        state.buttons = 0xFFF7u;
+        iop.setControllerState(0u, state);
+#endif
+        const auto result = executeTransfer(iop, 0x01u);
+        require(result[0] == 1u && result[1] == 0xF75A41FFu && result[2] == 0xFFu &&
+                    result[3] == 0x1100u && result[4] == 1u,
+                "MIPS FIFO/IRQ path did not deliver the physical Start sample exactly once");
+        require(host.guestWrites == 0u && host.cardCalls.empty(), "controller fabricated an EE packet or HLE card call");
+    }
+
+    void originalInstructionPathAbsentCard()
+    {
+        iop_test::Host host;
+        IopSubsystem iop(host);
+        const auto result = executeTransfer(iop, 0x81u);
+        require(result[0] == 1u && result[1] == 0xFFFFFFFFu && result[2] == 0xFFu &&
+                    result[3] == 0x1D100u && result[4] == 3u,
+                "MIPS memory-card selection did not receive no-ACK bytes and device IRQ status");
+        require(host.cardCalls.empty() && host.guestWrites == 0u, "physical no-card transfer reached HLE/EE buffer substitution");
+    }
+
+#ifndef PS2X_SIO2_BASELINE_ONLY
+    class Executor final : public IopGuestExecutor
+    {
+    public:
+        Executor(IopMemory &memory, IopIntrman &intrman) : memory(memory), intrman(intrman) {}
+        uint32_t executeGuestFunction(uint32_t address, uint32_t a0, uint32_t,
+                                     uint32_t, uint32_t, uint32_t gp) override
+        {
+            ++calls;
+            require(address == 0x1234u && a0 == 0x5678u && gp == 0x9ABCu, "IRQ registration ABI changed");
+            require(intrman.inInterruptContext(), "SIO2 ISR lacks interrupt context");
+            if (callback) callback();
+            if (fail) throw std::runtime_error("authored ISR failure");
+            if (ack) memory.write32(IRQ, 3u);
+            return 1u;
+        }
+        IopMemory &memory;
+        IopIntrman &intrman;
+        size_t calls = 0u;
+        bool ack = false, fail = false;
+        std::function<void()> callback;
+    };
+
+    struct Fixture
+    {
+        IopMemory memory;
+        IopSio2 device{memory};
+        IopIntrman intrman{memory};
+        Executor executor{memory, intrman};
+        Fixture() { intrman.reset(); }
+        void set(uint32_t port, uint16_t buttons = 0xFFFFu)
+        {
+            ControllerState state;
+            state.connected = true;
+            state.buttons = buttons;
+            device.setControllerState(port, state);
+        }
+        void import(uint16_t ordinal, uint32_t a0 = 17u)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = a0; cpu.gpr[5] = 1u; cpu.gpr[6] = 0x1234u;
+            cpu.gpr[7] = 0x5678u; cpu.gpr[28] = 0x9ABCu;
+            if (ordinal == 7u) cpu.gpr[5] = 0u;
+            require(intrman.dispatchImport(ordinal, cpu, executor), "missing authored intrman import");
+        }
+        void install() { import(4u); import(6u); }
+        void begin(std::span<const uint8_t> bytes, size_t receive, uint32_t port = 0u, uint32_t control = 0x201u)
+        {
+            memory.write32(CTRL, 0x3BCu);
+            memory.write32(Q, descriptor(port, bytes.size(), receive));
+            memory.write32(Q + 4u, 0u);
+            for (const uint8_t byte : bytes) memory.write8(TX, byte);
+            memory.write32(CTRL, control);
+        }
+        std::vector<uint8_t> drain(size_t size)
+        {
+            std::vector<uint8_t> result(size);
+            for (auto &byte : result) byte = memory.read8(RX);
+            return result;
+        }
+        std::vector<uint8_t> exchange(std::span<const uint8_t> bytes, size_t receive = 9u, uint32_t port = 0u)
+        {
+            begin(bytes, receive, port);
+            return drain(receive);
+        }
+        std::vector<uint8_t> command(uint8_t command, uint8_t argument = 0u, uint32_t port = 0u)
+        {
+            const std::array<uint8_t, 9u> bytes{1u, command, 0u, argument};
+            return exchange(bytes, 9u, port);
+        }
+        void pressure(uint32_t port = 0u)
+        {
+            (void)command(0x43u, 1u, port);
+            const std::array<uint8_t, 9u> bytes{1u, 0x4Fu, 0u, 0xFFu, 0xFFu, 3u};
+            (void)exchange(bytes, 9u, port);
+            (void)command(0x43u, 0u, port);
+        }
+        void service() { device.serviceInterrupt(intrman, executor); }
+    };
+
+    constexpr std::array<uint8_t, 5u> poll{1u, 0x42u, 0u, 0u, 0u};
+
+    void digitalPressAndRelease()
+    {
+        Fixture f; f.set(0u);
+        require(f.exchange(poll, 5u) == std::vector<uint8_t>({0xFFu, 0x41u, 0x5Au, 0xFFu, 0xFFu}), "neutral digital packet differs");
+        f.set(0u, 0xFFF7u);
