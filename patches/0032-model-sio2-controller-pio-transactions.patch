@@ -0,0 +1,12 @@
+#pragma once
+
+#include "ps2x/iop/iop_controller.h"
+
+class PS2Runtime;
+
+namespace ps2x::iop
+{
+    // Safe to update from the host input thread while the IOP runs or resets.
+    // Device negotiation is owned by the IOP; this never writes guest pad RAM.
+    void setControllerState(PS2Runtime &runtime, uint32_t port, const ControllerState &state);
+}
diff --git a/ps2xRuntime/src/lib/ps2_controller.cpp b/ps2xRuntime/src/lib/ps2_controller.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_controller.cpp
@@ -0,0 +1,15 @@
+#include "runtime/ps2_controller.h"
+#include "ps2_iop_transport.h"
+
+#include <stdexcept>
+
+namespace ps2x::iop
+{
+    void setControllerState(PS2Runtime &runtime, uint32_t port, const ControllerState &state)
+    {
+        auto *const subsystem = PS2IopTransport::subsystem(&runtime);
+        if (!subsystem)
+            throw std::logic_error("Controller input requires a live IOP subsystem");
+        subsystem->setControllerState(port, state);
+    }
+}
