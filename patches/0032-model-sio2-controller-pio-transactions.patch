@@ -0,0 +1,22 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // One host sample, consumed by the physical SIO2 controller endpoint.
+    // Buttons use the PS2 active-low mask: Start=0x0008, Cross=0x4000.
+    // Pressure order: Right, Left, Up, Down, Triangle, Circle, Cross, Square,
+    // L1, R1, L2, R2. An absent host does not attach an imaginary controller.
+    struct ControllerState
+    {
+        bool connected = false;
+        uint16_t buttons = 0xFFFFu;
+        uint8_t rightX = 0x80u;
+        uint8_t rightY = 0x80u;
+        uint8_t leftX = 0x80u;
+        uint8_t leftY = 0x80u;
+        std::array<uint8_t, 12u> pressures{};
+    };
+}
