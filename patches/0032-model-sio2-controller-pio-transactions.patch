+    void configurationIdsAndAnalog()
+    {
+        Fixture f; f.set(0u);
+        const auto enter = f.command(0x43u, 1u);
+        require(enter[1] == 0x41u && enter[3] == 0u && enter[4] == 0u && enter[5] == 0xFFu,
