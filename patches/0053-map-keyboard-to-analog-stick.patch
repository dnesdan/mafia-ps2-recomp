+        const auto keyboardAxis = [](int direction) -> uint8_t
+        {
+            return static_cast<uint8_t>(direction < 0 ? 0u : direction > 0 ? 0xFFu : kPadStickCenter);
+        };
+        data[6] = keyboardAxis(horizontal);
+        data[7] = keyboardAxis(vertical);
     }
 
     data[2] = static_cast<uint8_t>(btns & 0xFF);
