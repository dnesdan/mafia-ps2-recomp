+            clearBit(PAD_R3);
+
+        // Arrows are the D-pad; WASD controls the left analog stick. Opposing
+        // keys cancel so a released key cannot leave an axis stuck to one side.
+        const int horizontal = int(IsKeyDown(KEY_D)) - int(IsKeyDown(KEY_A));
