diff --git a/ps2xIOP/tests/iop_cdvd_clock_tests.cpp b/ps2xIOP/tests/iop_cdvd_clock_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d2c68352d13dc0dd4bb62827ed838f52d888e757
--- /dev/null
+++ b/ps2xIOP/tests/iop_cdvd_clock_tests.cpp
@@ -0,0 +1,228 @@
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/imports/iop_cdvd.h"
+#include "emulator/iop_emulator.h"
+#include "iop_compat_test_support.h"
+
+#include <chrono>
+#include <limits>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+    using namespace std::chrono;
+    using iop_test::require;
+    using ClockBytes = std::array<uint8_t, 8u>;
+
+    sys_seconds utc(int y, unsigned m, unsigned d, int h = 0, int minute = 0, int second = 0)
+    {
+        return sys_days{year{y}/month{m}/day{d}} + hours{h} + minutes{minute} + seconds{second};
+    }
+
+    ClockBytes readClockBytes(IopMemory &memory, uint32_t address)
+    {
+        ClockBytes bytes{};
+        require(memory.readRam(address, bytes.data(), bytes.size()), "clock result is not in RAM");
+        return bytes;
+    }
+
+    uint32_t invoke(IopCdvd &cdvd, uint32_t address)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4u] = address;
+        cpu.gpr[2u] = 0xDEADBEEFu;
+        require(cdvd.dispatchImport(24u, cpu), "ReadClock import is absent");
+        return cpu.gpr[2u];
+    }
+
+    void calendarEncodingAndRollover()
+    {
+        struct Example { sys_seconds time; ClockBytes expected; };
+        const Example examples[] = {
+            {utc(1999, 12u, 31u, 15), {0u, 0u, 0u, 0u, 0u, 0x01u, 0x01u, 0u}},
+            {utc(2024, 2u, 28u, 15), {0u, 0u, 0u, 0u, 0u, 0x29u, 0x02u, 0x24u}},
+            {utc(2024, 2u, 29u, 14, 59, 58), {0u, 0x58u, 0x59u, 0x23u, 0u, 0x29u, 0x02u, 0x24u}},
+            {utc(2024, 2u, 29u, 15), {0u, 0u, 0u, 0u, 0u, 0x01u, 0x03u, 0x24u}},
+            {utc(2025, 12u, 31u, 15), {0u, 0u, 0u, 0u, 0u, 0x01u, 0x01u, 0x26u}},
+            {utc(2026, 11u, 27u, 1, 23, 45), {0u, 0x45u, 0x23u, 0x10u, 0u, 0x27u, 0x11u, 0x26u}},
+            {utc(2099, 12u, 31u, 14, 59, 59), {0u, 0x59u, 0x59u, 0x23u, 0u, 0x31u, 0x12u, 0x99u}},
+        };
+        for (const auto &example : examples)
+        {
+            iop_test::Host host;
+            IopMemory memory;
+            IopKernel kernel(memory);
+            unsigned samples = 0u;
+            IopCdvd cdvd(host, memory, kernel, [&]() -> std::optional<sys_seconds>
+                { ++samples; return example.time; });
+            std::array<uint8_t, 16u> canaries{};
+            canaries.fill(0xCAu);
+            require(memory.writeRam(0x10000u, canaries.data(), canaries.size()), "could not install clock canaries");
+            // The ABI is a byte struct and permits an unaligned complete range.
+            require(invoke(cdvd, 0x10001u) == 1u && samples == 1u &&
+                        readClockBytes(memory, 0x10001u) == example.expected,
+                    "UTC/JST calendar or BCD byte layout is wrong");
+            require(memory.read8(0x10000u) == 0xCAu && memory.read8(0x10009u) == 0xCAu,
+                    "ReadClock wrote beyond its eight-byte result");
+        }
+    }
+
+    void completeAliasesAndInvalidDestinations()
+    {
+        const ClockBytes expected{0u, 0x03u, 0x02u, 0x10u, 0u, 0x04u, 0x05u, 0x26u};
+        for (const uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            iop_test::Host host;
+            IopMemory memory;
+            IopKernel kernel(memory);
+            IopCdvd cdvd(host, memory, kernel, [] { return utc(2026, 5u, 4u, 1, 2, 3); });
+            std::array<uint8_t, 16u> tail{};
+            tail.fill(0xA5u);
+            require(memory.writeRam(IopMemory::RamSize - tail.size(), tail.data(), tail.size()),
+                    "could not install final RAM canaries");
+            const uint32_t address = IopMemory::RamSize - 8u;
+            require(invoke(cdvd, alias | address) == 1u && readClockBytes(memory, address) == expected,
+                    "complete exact-end RAM alias was rejected or corrupted");
+            require(memory.read8(address - 1u) == 0xA5u, "exact-end write damaged preceding storage");
+        }
+        for (const uint32_t address : {0u, 0x8000u, 0x200000u, 0x1FFFF9u, 0xA01FFFFFu,
+                                      0x20010000u, 0xC0010000u, 0xFFFFFFFFu,
+                                      0xBF800000u, 0xBF402005u, 0xBF801000u, 0x10009u})
+        {
+            iop_test::Host host;
+            IopMemory memory;
+            IopKernel kernel(memory);
+            unsigned samples = 0u;
+            IopCdvd cdvd(host, memory, kernel, [&]() -> std::optional<sys_seconds>
+                { ++samples; return utc(2026, 1u, 1u); });
+            std::array<uint8_t, 16u> data{};
+            data.fill(0x5Au);
+            require(memory.writeRam(0x10000u, data.data(), data.size()), "could not install owned range");
+            require(memory.writeRam(IopMemory::RamSize - data.size(), data.data(), data.size()),
+                    "could not install RAM-end range");
+            const std::vector<uint8_t> before(memory.ram().begin(), memory.ram().end());
+            IopCpuState cpu{};
+            cpu.gpr[4u] = address;
+            cpu.gpr[2u] = 0xDEADBEEFu;
+            bool rejected = false;
+            try { (void)cdvd.dispatchImport(24u, cpu); }
+            catch (const std::runtime_error &error)
+            {
+                rejected = std::string_view(error.what()).find("clock destination") != std::string_view::npos;
+            }
+            require(rejected && samples == 0u && cpu.gpr[2u] == 0xDEADBEEFu &&
+                        std::equal(before.begin(), before.end(), memory.ram().begin()),
+                    "invalid clock destination sampled time, partially wrote RAM, or reported success");
+        }
+    }
+
+    void unavailableClockPreservesOutput()
+    {
+        const std::optional<sys_seconds> samples[] = {
+            std::nullopt, utc(1999, 12u, 31u, 14, 59, 59), utc(2099, 12u, 31u, 15),
+            sys_seconds::min(), sys_seconds::max(),
+        };
+        for (const auto &sample : samples)
+        {
+            iop_test::Host host;
+            IopMemory memory;
+            IopKernel kernel(memory);
+            IopCdvd cdvd(host, memory, kernel, [&] { return sample; });
+            ClockBytes before{};
+            before.fill(0xABu);
+            require(memory.writeRam(0x10000u, before.data(), before.size()), "could not initialize clock result");
+            require(invoke(cdvd, 0x10000u) == 0u && readClockBytes(memory, 0x10000u) == before,
+                    "unavailable/unrepresentable time fabricated a successful fallback date");
+        }
+        iop_test::Host host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopCdvd cdvd(host, memory, kernel, []() -> std::optional<sys_seconds>
+            { throw std::runtime_error("authored clock failure"); });
+        ClockBytes before{};
+        before.fill(0xBDu);
+        require(memory.writeRam(0x10000u, before.data(), before.size()), "could not initialize throwing clock result");
+        bool rejected = false;
+        try { (void)invoke(cdvd, 0x10000u); }
+        catch (const std::runtime_error &error)
+        {
+            rejected = std::string_view(error.what()) == "authored clock failure";
+        }
+        require(rejected && readClockBytes(memory, 0x10000u) == before,
+                "clock provider failure produced a partial output or success");
+    }
+
+    void clockHasIndependentDeviceState()
+    {
+        iop_test::Host host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        sys_seconds value = utc(2026, 7u, 1u, 1, 2, 3);
+        IopCdvd cdvd(host, memory, kernel, [&] { return value; });
+        require(memory.zeroRam(0x10000u, 8u), "could not initialize independent clock result");
+        std::array<uint8_t, 3u> before{}, after{};
+        const std::array<uint32_t, 3u> ports{0x1F402005u, 0x1F40200Au, 0x1F40200Fu};
+        for (size_t i = 0u; i < ports.size(); ++i)
+            require(cdvd.readRegisterByte(ports[i], before[i]), "supported controller port is unavailable");
+        require(invoke(cdvd, 0x10000u) == 1u, "RTC incorrectly required an initialized disc or media");
+        for (size_t i = 0u; i < ports.size(); ++i)
+            require(cdvd.readRegisterByte(ports[i], after[i]), "controller port disappeared after RTC read");
+        require(before == after && !cdvd.takeCompletionCallback() && !memory.takeDmaStart() &&
+                    memory.interruptStatus() == 0u && host.guestWrites == 0u,
+                "RTC changed disc state or generated DMA/interrupt/EE effects");
+        cdvd.reset();
+        value += seconds{1};
+        require(invoke(cdvd, 0x10000u) == 1u && memory.read8(0x10001u) == 0x04u,
+                "IOP reset froze or reset the external wall-clock source");
+    }
+
+    void authoredImportReadsActualHostClock()
+    {
+        iop_test::Host host;
+        IopEmulator iop(host);
+        iop_test::Irx image;
+        image.words(0u, {
+            0x27BDFFE0u, 0xAFBF001Cu, 0x3C040001u, 0x34840400u,
+            0x0C004045u, 0u, 0x3C080001u, 0xAD020408u,
+            0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x24020000u,
+        });
+        image.words(0x100u, {
+            0x41E00000u, 0u, 0x0101u, 0x64766463u, 0x006E616Du,
+            0x03E00008u, 0x24000018u, 0u, 0u,
+        });
+        const auto before = floor<seconds>(system_clock::now());
+        const auto loaded = iop.loadModuleImage("authored-clock-import", image.bytes, nullptr, 0u);
+        const auto after = floor<seconds>(system_clock::now());
+        std::array<uint8_t, 12u> bytes{};
+        require(loaded.moduleId > 0 && loaded.startResult == 0 &&
+                    iop.readMemory(0x10400u, bytes.data(), bytes.size()),
+                "authored RTC import did not complete its real entry");
+        require(bytes[0u] == 0u && bytes[4u] == 0u && bytes[8u] == 1u &&
+                    bytes[9u] == 0u && bytes[10u] == 0u && bytes[11u] == 0u,
+                "live RTC import did not return successful normalized clock data");
+        const auto decimal = [](uint8_t bcd)
+        {
+            require((bcd & 15u) < 10u && (bcd >> 4u) < 10u, "live RTC byte is not BCD");
+            return unsigned(bcd >> 4u) * 10u + unsigned(bcd & 15u);
+        };
+        const auto actual = utc(2000 + static_cast<int>(decimal(bytes[7u])), decimal(bytes[6u]),
+                                decimal(bytes[5u]), static_cast<int>(decimal(bytes[3u])),
+                                static_cast<int>(decimal(bytes[2u])), static_cast<int>(decimal(bytes[1u]))) - hours{9};
+        require(actual >= std::min(before, after) && actual <= std::max(before, after),
+                "live RTC result does not correspond to the observed host wall clock");
+        require(host.guestWrites == 0u, "IOP clock import wrote unrelated EE RAM");
+    }
+}
+
+int main()
+{
+    const iop_test::Test tests[] = {
+        {"RTC encodes real UTC as JST BCD across calendar boundaries", calendarEncodingAndRollover},
+        {"RTC validates complete owned RAM aliases before sampling", completeAliasesAndInvalidDestinations},
+        {"RTC source failures preserve output and report no success", unavailableClockPreservesOutput},
+        {"RTC reads preserve independent disc and interrupt state", clockHasIndependentDeviceState},
+        {"Authored IOP import reads the actual host wall clock", authoredImportReadsActualHostClock},
+    };
+    return iop_test::run(tests);
+}
