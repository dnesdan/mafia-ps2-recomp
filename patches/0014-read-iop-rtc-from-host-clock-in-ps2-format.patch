     private:
+        bool readClock(uint32_t destination)
+        {
+            constexpr size_t clockBytes = 8u;
+            const uint32_t segment = destination & 0xE0000000u;
+            const uint32_t physical = IopMemory::physicalAddress(destination);
+            if (destination == 0u ||
+                (segment != 0u && segment != 0x80000000u && segment != 0xA0000000u) ||
+                physical >= IopMemory::RamSize || clockBytes > IopMemory::RamSize - physical ||
+                !memory.ownsRamRange(destination, clockBytes))
+                throw std::runtime_error("IOP CDVD clock destination is outside complete owned RAM");
+
+            using namespace std::chrono;
+            const std::optional<sys_seconds> utc = clockSource ? clockSource() :
+                std::optional<sys_seconds>{floor<seconds>(system_clock::now())};
+            // The PS2 RTC uses JST and a two-digit year based at 2000. Check
+            // bounds before adding the offset, including extreme host samples.
+            // https://ps2dev.github.io/ps2sdk/osd__config_8h.html
+            // https://ps2dev.github.io/ps2sdk/scmd_8c_source.html
+            constexpr sys_seconds first = sys_days{year{2000}/January/1} - hours{9};
+            constexpr sys_seconds end = sys_days{year{2100}/January/1} - hours{9};
+            if (!utc || *utc < first || *utc >= end)
+                return false;
+            const sys_seconds jst = *utc + hours{9};
+            const sys_days datePart = floor<days>(jst);
+            const year_month_day date{datePart};
+            const hh_mm_ss time{jst - datePart};
+            const auto bcd = [](unsigned value)
+                { return static_cast<uint8_t>(((value / 10u) << 4u) | (value % 10u)); };
+            // sceCdCLOCK is eight byte fields: stat, second, minute, hour, pad,
+            // day, month, year. ReadClock normalizes pad and the month high bit.
+            // https://ps2dev.github.io/ps2sdk/libcdvd-common_8h_source.html
+            const std::array<uint8_t, clockBytes> bytes{
+                0u, bcd(static_cast<unsigned>(time.seconds().count())),
+                bcd(static_cast<unsigned>(time.minutes().count())),
+                bcd(static_cast<unsigned>(time.hours().count())), 0u,
+                bcd(static_cast<unsigned>(date.day())), bcd(static_cast<unsigned>(date.month())),
+                bcd(static_cast<unsigned>(int(date.year()) - 2000)),
+            };
+            return memory.writeRam(destination, bytes.data(), bytes.size());
+        }
