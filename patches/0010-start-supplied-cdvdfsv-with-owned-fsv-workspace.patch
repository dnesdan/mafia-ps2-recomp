+        constexpr uint32_t bytes = 42128u;
+        const uint32_t prefix = memory.allocate(16u);
+        memory.write32(prefix, 0x12345678u);
+        IopCpuState cpu{};
+        if (!expect(cdvd.dispatchImport(47u, cpu), "cdvdman:47 was not handled"))
+            return false;
+        const uint32_t address = cpu.gpr[2];
+        if (!expect(address != 0u && (address & 63u) == 0u, "FSV workspace is not a real aligned IOP address") ||
+            !expect(memory.ownsRamRange(address, bytes), "FSV workspace lacks its complete owned backing") ||
+            !expect(!memory.ownsRamRange(address, bytes + 1u), "FSV workspace exposes unallocated trailing bytes") ||
+            !expect(memory.read32(address) == 0u && memory.read8(address + bytes - 1u) == 0u,
+                    "new FSV workspace did not have BSS-like zero contents"))
+            return false;
+        const uint32_t suffix = memory.allocate(16u);
+        memory.write32(suffix, 0x87654321u);
