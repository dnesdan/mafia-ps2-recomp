+            !expect(memory.maxFreeMemory() == freeBefore && memory.read32(address) == 0xAABBCCDDu &&
+                    memory.read8(address + bytes - 1u) == 0xEFu, "repeated FSV lookup reallocated or erased guest data") ||
+            !expect(memory.read32(prefix) == 0x12345678u && memory.read32(suffix) == 0x87654321u,
+                    "FSV lookup overwrote neighboring allocations"))
+            return false;
+        cpu = {};
+        if (!expect(cdvd.dispatchImport(13u, cpu) && cpu.gpr[2] == 6u,
+                    "allocating workspace falsely initialized the disc or reported media readiness"))
+            return false;
+        cdvd.reset();
+        if (!expect(!memory.ownsRamRange(address, bytes), "component reset retained old FSV backing") ||
+            !expect(memory.read32(prefix) == 0x12345678u && memory.read32(suffix) == 0x87654321u,
