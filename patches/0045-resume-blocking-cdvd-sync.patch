+                    word(iop, p.data(0x44u)) == 0x87654321u &&
+                    word(iop, p.data(0x4Cu)) == word(iop, p.data(0x50u)) &&
+                    word(iop, p.data(0x54u)) == 0xCAFEBABEu && word(iop, p.data(0x58u)) == 0xABCDEF01u &&
