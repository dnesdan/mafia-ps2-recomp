+    void externalDriverWaitRetainsNestedStack()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.begin(); p.driver(); p.store(29u, p.data(0x90u)); p.devctl();
+        p.store(2u, p.data(0x94u)); p.store(28u, p.data(0x98u)); p.store(29u, p.data(0x9Cu)); p.finish();
+        p.begin(0x600u); p.store(29u, p.data(0xA0u)); p.store(28u, p.data(0xA4u));
+        p.stream(); p.read(); p.sync(); p.finish(0x456u); p.recordingHandler(0xA00u, 0u);
+        prepare(iop); start(iop, p); continued(iop, p); matches(iop, host);
+        require(word(iop, p.data(0x94u)) == 0x456u && word(iop, p.data(0x98u)) == 0x55667788u &&
+                    word(iop, p.data(0x90u)) == word(iop, p.data(0x9Cu)) &&
+                    word(iop, p.data(0xA0u)) < word(iop, p.data(0x90u)) &&
+                    word(iop, p.data(0xA4u)) == 0x11223344u && host.eeAccesses == 0u,
+                "external Devctl wait lost the original driver GP, return value or independent stack");
+    }
+
+    void externalWaitRunsTheThreadThatReenablesItsIrq()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.begin(); p.thread(0x800u, 0x2500u, 40u, 0x70u);
+        p.stream(); p.mask(false); p.read(); p.sync(); p.finish();
+        p.begin(0x800u); p.mark(1u, 0x60u); p.delay(100u); p.mask(true); p.finish();
+        p.recordingHandler(0xA00u, 0u);
+        prepare(iop); start(iop, p); continued(iop, p); matches(iop, host);
+        require(word(iop, p.data(0x60u)) == 1u && host.reads == 1u,
+                "external synchronous invocation starved the ready IOP thread needed for progress");
+    }
+
+    void tinyHostBudgetsKeepTheSameWaitContinuation()
+    {
+        for (uint64_t chunk : {1u, 17u, 10000u})
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin(); p.thread(0x400u, 0x2500u, 40u, 0x70u); p.finish();
+            p.begin(0x400u); p.stream(); p.read(); p.sync(); p.finish(); p.recordingHandler(0xA00u, 0u);
+            prepare(iop); start(iop, p);
+            for (uint64_t elapsed = 0u; elapsed < 2000u; elapsed += chunk) advance(iop, chunk);
+            continued(iop, p); matches(iop, host);
+            require(host.reads == 1u && word(iop, p.data()) == 1u, "host slices replayed an import or lost its pending wait");
+        }
+    }
+
+    void deletionCannotMasqueradeAsCompletion()
+    {
+        for (bool managed : {false, true})
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin();
+            if (managed) p.thread(0x400u, 0x2500u, 20u, 0x70u);
+            p.thread(0x800u, 0x2540u, 60u, 0x74u);
+            if (managed) { p.finish(); p.begin(0x400u); }
+            p.stream(); p.mask(false); p.read(); p.sync(); p.finish();
+            p.begin(0x800u); p.delay(100u); p.cd(2u, uint32_t(-11));
+            p.move(4u, 2u); p.call(p.stub(0x1300u)); p.finish(); p.recordingHandler(0xA00u, 0u);
+            prepare(iop);
+            rejects([&] { start(iop, p); advance(iop, 10000u); }, "event flag was deleted");
+            require(word(iop, p.data(0x84u)) == 0u && word(iop, p.data()) == 0u,
+                    "deleted completion event resumed guest code or invoked a masked callback");
+        }
+    }
+
+    void fullResetDiscardsSleepingSyncCallers()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.begin(); p.thread(0x400u, 0x2500u, 40u, 0x70u); p.finish();
+        p.begin(0x400u); p.stream(); p.mask(false); p.read(); p.sync(); p.finish(); p.recordingHandler(0xA00u, 0u);
+        prepare(iop); start(iop, p); advance(iop, 1000u);
+        require(word(iop, p.data(0x84u)) == 0u && host.reads == 1u, "reset control did not stop at a masked driver wait");
+        iop.reset(); SyncProgram clean; clean.begin(); clean.finish(); start(iop, clean); advance(iop, 10000u);
+        require(host.reads == 1u && word(iop, clean.data(0x84u)) == 0u && word(iop, clean.data()) == 0u,
+                "reset resurrected an old sync continuation or callback");
+    }
+
+    void suppliedExportsKeepTheirOwnSyncSemantics()
+    {
+        for (const auto [provided, requested] : {std::pair<uint16_t, uint16_t>{0x0101u, 0x0101u},
+                                                {0x0106u, 0x0101u}, {0x0201u, 0x0201u}})
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.image.words(0x1008u, {requested});
+            p.image.words(0x1800u, {0x41C00000u, 0u, provided, 0x64766463u, 0x006E616Du});
+            for (uint32_t slot = 0u; slot <= 11u; ++slot) p.image.words(0x1814u + slot * 4u, {p.base + 0x900u});
+            p.begin(); p.constant(4u, p.base + 0x1800u); p.call(p.stub(0x1500u));
+            p.cd(3u, 0xFFFFFFFFu); p.store(2u, p.data(0x40u)); p.finish();
+            p.begin(0x900u); p.store(4u, p.data(0x44u)); p.finish(0x5A3u);
+            start(iop, p);
+            require(word(iop, p.data(0x40u)) == 0x5A3u && word(iop, p.data(0x44u)) == 0xFFFFFFFFu,
+                    "modeled sync shadowed a compatible supplied export");
+        }
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.image.words(0x1008u, {0x0201u}); p.begin(); p.cd(3u, 0u); p.finish();
+        rejects([&] { start(iop, p); }, "missing import cdvdman:11");
+    }
+
+    void interruptAndNestedManagedWaitsStayExplicit()
+    {
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin(); p.stream(); p.cd(0u); p.finish();
+            p.begin(0xA00u); p.read(); p.sync(); p.finish(); prepare(iop); start(iop, p);
+            rejects([&] { advance(iop, 10000u); }, "blocking CDVD sync requires interruptible thread context");
+            require(word(iop, p.data(0x84u)) == 0u && host.reads == 0u, "IRQ wait ran beyond its strict boundary");
+        }
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin(); p.driver(); p.thread(0x400u, 0x2500u, 40u, 0x70u); p.finish();
+            p.begin(0x400u); p.devctl(); p.mark(1u, 0x88u); p.finish();
+            p.begin(0x600u); p.stream(); p.read(); p.sync(); p.finish(); p.recordingHandler(0xA00u, 0u);
+            prepare(iop); start(iop, p);
+            rejects([&] { advance(iop, 10000u); }, "nested managed-thread invocation is unsupported");
+            require(word(iop, p.data(0x88u)) == 0u && host.reads == 0u,
+                    "nested blocking invocation parked or resumed the wrong managed CPU");
+        }
+    }
+
+    void callbackFailureDuringExternalWaitStaysSticky()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.begin(); p.stream(); p.read(); p.sync(); p.finish();
+        p.begin(0xA00u); p.call(p.stub(0x1400u)); p.mark(1u, 0u); p.finish();
+        prepare(iop);
+        rejects([&] { start(iop, p); }, "missing import absent:42");
+        const auto instructions = iop.instructions(); iop.runEeCycles(100000u);
+        rejects([&] { iop.checkExecutionFailure(); }, "missing import absent:42");
+        require(host.reads == 1u && iop.instructions() == instructions &&
+                    word(iop, p.data(0x84u)) == 0u && word(iop, p.data()) == 0u,
+                "external wait swallowed a callback failure or resumed a failed caller");
+        iop.reset(); SyncProgram clean;
+        clean.begin(); clean.stream(); clean.read(); clean.sync(); clean.finish();
+        clean.recordingHandler(0xA00u, 0u); prepare(iop); start(iop, clean); continued(iop, clean);
+        require(host.reads == 2u, "post-failure reset retained a stale invocation budget or callback scope");
+    }
+
+    void disabledCpuWaitCannotInventInterruptProgress()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
