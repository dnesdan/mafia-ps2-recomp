+
+    void directWaitsPreserveTheCaller()
+    {
+        for (uint32_t mode : {0u, 5u})
+        for (unsigned command = 0u; command < 3u; ++command)
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin(); p.stream();
+            if (command == 0u) p.cd(0u); else p.read();
+            if (command == 2u) p.cd(5u);
+            p.sync(mode); p.finish(); p.recordingHandler(0xA00u, 0u);
+            prepare(iop); start(iop, p); continued(iop, p); advance(iop, 10000u);
+            require(host.reads == (command == 1u ? 1u : 0u) && word(iop, p.data()) == 1u,
