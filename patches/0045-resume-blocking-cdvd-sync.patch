+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin(); p.thread(0x400u, 0x2500u, 20u, 0x70u);
+            p.thread(0x800u, 0x2540u, 60u, 0x74u); p.finish();
+            p.begin(0x400u); p.stream(); p.mask(false); p.read(); p.sync(mode); p.finish();
+            p.begin(0x800u);
+            p.load(4u, p.data(0x70u)); p.constant(5u, p.data(0x600u)); p.call(p.stub(0x1600u, 1u));
+            p.mark(1u, 0x60u); p.delay(100u); p.load(8u, p.data(0x84u)); p.store(8u, p.data(0x64u));
+            p.mask(true); p.finish(); p.recordingHandler(0xA00u, 0u);
+            prepare(iop); start(iop, p); advance(iop, 10000u); continued(iop, p); matches(iop, host);
+            require(word(iop, p.data(0x60u)) == 1u && word(iop, p.data(0x64u)) == 0u &&
+                        word(iop, p.data(0x608u)) == 4u && word(iop, p.data(0x624u)) == 4u && host.reads == 1u,
+                    "Sync failed to park its managed caller on the event or bypassed the masked IRQ");
+        }
+    }
+
+    void successorCommandsRequireAnotherCompletion()
+    {
+        for (bool managed : {false, true})
+        {
+            DiscHost host; IopEmulator iop(host); SyncProgram p;
+            p.begin();
+            if (managed) { p.thread(0x400u, 0x2500u, 20u, 0x70u); p.finish(); p.begin(0x400u); }
+            p.stream(); p.read(); p.sync(); p.finish();
+            p.begin(0xA00u); p.load(8u, p.data()); p.emit(0x25080001u); p.store(8u, p.data());
+            p.constant(9u, 1u);
+            const uint32_t branch = p.cursor; p.emit(0u); p.emit(0u);
+            p.read(3u, buffer + 0x2000u);
+            const uint32_t done = p.cursor;
+            p.image.words(branch, {0x15090000u | static_cast<uint16_t>((done - branch - 4u) / 4u)});
+            p.finish();
+            prepare(iop); start(iop, p); advance(iop, 10000u);
+            continued(iop, p, 2u); matches(iop, host); matches(iop, host, 3u, buffer + 0x2000u);
+            require(host.reads == 2u, "successor read was skipped or duplicated by a stale wakeup");
+        }
+    }
