+    constexpr uint32_t buffer = 0x30000u;
+
+    // Authored MIPS only. These fixtures use the pre-existing emulator API and
+    // compile unchanged against patch 0044 for failing-baseline verification.
+    struct SyncProgram : Program
+    {
+        SyncProgram()
+        {
+            imports(0x1000u, "cdvdman", {46u, 49u, 50u, 11u, 114u, 39u, 8u});
+            imports(0x1300u, "thevent", {5u, 6u});
+            imports(0x1600u, "thbase", {33u, 22u});
+            imports(0x1700u, "ioman", {20u, 31u});
+            image.words(0x2020u, {0u});
+        }
+        void cd(uint32_t index, uint32_t a0 = 0u, uint32_t a1 = 0u,
+                uint32_t a2 = 0u, uint32_t a3 = 0u)
+        {
+            constant(4u, a0); constant(5u, a1); constant(6u, a2); constant(7u, a3);
+            call(stub(0x1000u, index));
+        }
+        void stream(uint32_t handler = 0xA00u)
+        {
+            constant(28u, 0x12345678u); cd(1u, base + handler); cd(2u, 2u);
+            constant(28u, 0x87654321u);
+        }
+        void read(uint32_t lsn = 1u, uint32_t destination = buffer)
+        { cd(4u, lsn, 2u, destination, data(0x20u)); }
+        void mark(uint32_t value, uint32_t offset)
+        { constant(8u, value); store(8u, data(offset)); }
+        void mask(bool enabled)
+        {
+            load(8u, 0xBF801074u);
+            constant(9u, enabled ? 4u : ~4u);
+            emit(enabled ? 0x01094025u : 0x01094024u);
+            store(8u, 0xBF801074u);
+        }
+        void thread(uint32_t code, uint32_t descriptor, uint32_t priority, uint32_t idOffset)
+        {
+            image.words(descriptor, {0x02000000u, 0u, base + code, 0x800u, priority});
+            constant(4u, base + descriptor); call(stub(0x1200u)); store(2u, data(idOffset));
+            move(4u, 2u); constant(5u, 0u); call(stub(0x1200u, 1u));
+        }
+        void sync(uint32_t mode = 0u)
+        {
+            store(29u, data(0x4Cu));
+            cd(3u, mode, 0xCAFEBABEu, 0xABCDEF01u, 0x12344321u);
+            store(2u, data(0x40u)); store(28u, data(0x44u)); store(29u, data(0x50u));
+            store(5u, data(0x54u)); store(6u, data(0x58u)); store(7u, data(0x5Cu));
+            load(8u, data()); store(8u, data(0x80u)); mark(1u, 0x84u);
+        }
+        void delay(uint32_t usec)
+        { constant(4u, usec); call(stub(0x1600u)); }
+        void driver()
+        {
+            const char name[] = "authored";
+            const char path[] = "authored0:";
+            std::memcpy(image.bytes.data() + 0x100u + 0x2300u, name, sizeof(name));
+            std::memcpy(image.bytes.data() + 0x100u + 0x2320u, path, sizeof(path));
+            image.words(0x2380u, {base + 0x2300u, 0x10000010u, 1u, 0u, base + 0x2400u});
+            image.words(0x2400u + 92u, {base + 0x600u});
+            constant(28u, 0x11223344u); constant(4u, base + 0x2380u); call(stub(0x1700u));
+            constant(28u, 0x55667788u);
+        }
+        void devctl()
+        {
+            constant(4u, base + 0x2320u); constant(5u, 0x4393u);
+            constant(6u, 0u); constant(7u, 0u);
+            emit(0xAFA00010u); emit(0xAFA00014u); // Empty O32 output/length.
+            call(stub(0x1700u, 1u));
+        }
+    };
+
+    void prepare(IopEmulator &iop)
+    {
+        const std::vector<uint8_t> canary(0x4000u, 0xCCu);
+        require(iop.writeMemory(buffer, canary.data(), canary.size()), "sync fixture buffer setup failed");
+    }
+    void matches(IopEmulator &iop, const DiscHost &host, uint32_t lsn = 1u, uint32_t address = buffer)
+    {
+        std::vector<uint8_t> bytes(4096u);
