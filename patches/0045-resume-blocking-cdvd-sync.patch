+    void permanentlyMaskedExternalWaitIsBoundedAndSticky()
+    {
+        DiscHost host; IopEmulator iop(host); SyncProgram p;
+        p.begin(); p.stream(); p.mask(false); p.read(); p.sync(); p.finish(); p.recordingHandler(0xA00u, 0u);
