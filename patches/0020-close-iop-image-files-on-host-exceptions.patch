+    void strictInitialHostReadCleanup()
+    {
+        constexpr std::string_view path = "cdrom0:\\MODULES\\read-failure.IRX;1";
+        for (bool sizeFailure : {true, false})
+        for (bool closeFailure : {false, true})
+        {
+            ModuleHost host;
+            host.file(std::string(path), returns());
+            host.throwOnSize = sizeFailure;
+            host.throwOnRead = !sizeFailure;
+            host.throwOnClose = closeFailure;
+            IopEmulator iop(host);
+            rejects([&] { (void)iop.loadModuleStrict(path, nullptr, 0u); },
+                    sizeFailure ? "authored host size failure" : "authored host read failure");
+            require(host.opened.size() == 1u && host.closed == 1u && host.active.empty(),
+                    "strict source exception leaked the open host file");
+            require(iop.loadedModuleCount() == 0u && word(iop, 0x10000u) == 0u && host.ee.guestWrites == 0u,
+                    "failed source read partially executed or loaded the module");
+        }
+        ModuleHost host;
+        host.file(std::string(path), returns());
+        host.throwOnClose = true;
+        IopEmulator iop(host);
+        require(iop.loadModuleStrict(path, nullptr, 0u).moduleId > 0 &&
+                    host.closed == 1u && host.active.empty(),
+                "a cleanup callback replaced the successful complete module read");
+    }
+
+    void rebootImageHostReadCleanup()
+    {
+        constexpr std::string_view path = "cdrom0:\\MODULES\\IOPRP.IMG;1";
+        const Irx module = returns();
+        constexpr uint32_t directoryBytes = 80u;
+        std::vector<uint8_t> image(directoryBytes + ((module.bytes.size() + 15u) & ~size_t{15u}), 0u);
+        const std::array<std::string_view, 4u> names{"RESET", "ROMDIR", "EXTINFO", "LOADFILE"};
+        for (size_t index = 0u; index < names.size(); ++index)
+            std::copy(names[index].begin(), names[index].end(), image.begin() + index * 16u);
+        put32(image, 28u, directoryBytes);
+        put32(image, 60u, static_cast<uint32_t>(module.bytes.size()));
+        std::copy(module.bytes.begin(), module.bytes.end(), image.begin() + directoryBytes);
+
+        for (unsigned variant = 0u; variant < 4u; ++variant)
+        {
+            ModuleHost host;
+            host.file(std::string(path), module);
+            host.files.at(host.translations.at(std::string(path))) =
+                variant == 2u ? std::vector<uint8_t>(80u, 0u) : image;
+            host.throwOnSize = variant == 0u;
+            host.throwOnRead = variant == 1u;
+            host.throwOnClose = true;
+            IopSubsystem iop(host);
+            if (variant < 3u)
+                rejects([&] { (void)iop.readRebootImage(path); },
+                        variant == 0u ? "authored host size failure" :
+                        variant == 1u ? "authored host read failure" : "Invalid IOP boot image:");
+            else
+                require(iop.readRebootImage(path) == image,
+                        "cleanup changed a completely read and validated reboot image");
+            require(host.opened.size() == 1u && host.closed == 1u && host.active.empty() &&
+                        host.ee.guestWrites == 0u,
+                    "reboot image cleanup leaked, duplicated close or mutated guest bytes");
+        }
+    }
