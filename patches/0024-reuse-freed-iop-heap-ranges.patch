     uint32_t IopMemory::maxFreeMemory() const
     {
-        return m_heapCursor < HeapLimit ? HeapLimit - m_heapCursor : 0u;
+        // Fixed allocations can be inserted in any order. Account for every
+        // live range, including holes, without changing allocation identities.
+        auto blocks = m_allocations;
+        std::sort(blocks.begin(), blocks.end(), [](const Allocation &left, const Allocation &right)
+                  { return left.address < right.address; });
+        uint32_t cursor = HeapBase;
+        uint32_t maximum = 0u;
+        const auto considerGap = [&](uint32_t end)
+        {
+            const uint32_t start = alignUp(cursor, 16u);
+            if (start < end)
+                maximum = std::max(maximum, (end - start) & ~15u);
+        };
+        for (const auto &block : blocks)
+        {
+            considerGap(block.address);
+            cursor = block.address + block.size;
+        }
+        considerGap(HeapLimit);
+        return maximum;
+    }
