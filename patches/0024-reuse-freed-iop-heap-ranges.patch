+    bool testIopHeapReusesFreedStorage()
+    {
+        IopMemory memory;
+        const uint32_t live = memory.allocate(32u);
+        memory.write32(live, 0x13579BDFu);
+        uint32_t reusable = 0u;
+        uint64_t previousIdentity = 0u;
+        for (unsigned iteration = 0u; iteration < 8u; ++iteration)
+        {
+            // Cumulative traffic exceeds the heap; only this block and the
+            // sentinel remain live. Freeing must restore allocatable capacity.
+            const uint32_t address = memory.allocate(256u * 1024u);
+            if (!expect(address != 0u, "temporary allocation history exhausted an otherwise free heap"))
+                return false;
+            const auto allocation = memory.allocationContaining(address);
+            if (!expect(allocation && allocation->identity != previousIdentity,
+                        "reused heap storage kept its old lifetime identity") ||
+                !expect(reusable == 0u || address == reusable, "first-fit allocation skipped freed storage") ||
+                !expect(previousIdentity == 0u || !memory.freeAllocation(address, previousIdentity),
+                        "stale lifetime released a replacement allocation") ||
+                !expect(memory.ownsRamRange(address, 256u * 1024u), "replacement storage is not owned"))
+                return false;
+            reusable = address;
+            previousIdentity = allocation->identity;
+            if (!expect(memory.freeAllocation(address, allocation->identity) &&
+                        !memory.ownsRamRange(address, 256u * 1024u),
+                        "free did not release the complete temporary range"))
+                return false;
+        }
+        return expect(memory.read32(live) == 0x13579BDFu && memory.ownsRamRange(live, 32u),
+                      "temporary allocation reuse changed a live neighbor");
+    }
+
+    bool testIopHeapCoalescesFreeGaps()
+    {
+        IopMemory memory;
+        const uint32_t base = IopMemory::HeapBase;
+        constexpr uint32_t blockSize = 0x100u;
+        const uint32_t first = memory.allocate(blockSize);
+        const uint32_t second = memory.allocate(blockSize);
+        const uint32_t live = memory.allocate(blockSize);
+        const uint32_t remaining = IopMemory::HeapLimit - base - 3u * blockSize;
+        const uint32_t tail = memory.allocate(remaining);
+        if (!expect(first == base && second == base + blockSize && live == base + 2u * blockSize &&
+                    tail == base + 3u * blockSize && memory.allocate(1u) == 0u,
+                    "authored full-heap layout was not allocated"))
+            return false;
+        memory.write32(live, 0x2468ACE0u);
+        if (!expect(memory.freeAllocation(first) && memory.freeAllocation(second), "could not free adjacent ranges") ||
+            !expect(memory.maxFreeMemory() == 2u * blockSize, "adjacent free ranges were not counted together"))
+            return false;
+        const uint32_t combined = memory.allocate(2u * blockSize);
+        return expect(combined == base && memory.read32(live) == 0x2468ACE0u &&
+                      memory.ownsRamRange(tail, remaining) && memory.allocate(1u) == 0u,
+                      "coalesced allocation missed the free gap or overlapped live storage");
+    }
+
+    bool testIopHeapRespectsFixedRangesAndAlignment()
+    {
+        IopMemory memory;
+        const uint32_t base = IopMemory::HeapBase;
+        // Insert reservations out of address order, including a four-byte
+        // aligned allocation. Automatic allocations remain sixteen-byte based.
+        const uint32_t high = memory.allocate(0x100u, 16u, base + 0x200u);
+        const uint32_t low = memory.allocate(16u, 4u, base + 4u);
+        const uint32_t tail = memory.allocate(IopMemory::HeapLimit - base - 0x300u, 16u, base + 0x300u);
+        if (!expect(high != 0u && low != 0u && tail != 0u, "fixed reservation fixture failed"))
+            return false;
+        memory.write32(high, 0x10203040u);
+        memory.write32(low, 0x50607080u);
+        const uint32_t beforeMax = memory.maxFreeMemory();
+        const uint32_t tooLarge = memory.allocate(0x200u, 64u);
+        const uint32_t aligned = memory.allocate(0x100u, 64u);
+        if (!expect(beforeMax == 0x1E0u && tooLarge == 0u && aligned == base + 0x40u,
+                    "aligned allocation ignored a reservation or failed to reuse an available gap") ||
+            !expect(memory.read32(high) == 0x10203040u && memory.read32(low) == 0x50607080u,
+                    "failed or aligned allocation modified fixed storage"))
+            return false;
+        if (!expect(memory.freeAllocation(aligned), "could not release aligned allocation"))
+            return false;
+        const uint32_t maximum = memory.maxFreeMemory();
+        const uint32_t entireGap = memory.allocate(maximum);
+        return expect(maximum == 0x1E0u && entireGap == base + 0x20u && memory.maxFreeMemory() == 0u,
+                      "maximum-free query did not describe an allocatable aligned range");
+    }
+
+    bool testIopHeapFreeMemoryQueries()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopSysmem sysmem(host, memory);
+        const uint32_t base = IopMemory::HeapBase;
+        // Two free holes have different sizes; total capacity is not the
+        // largest request that can be satisfied without moving live blocks.
+        const uint32_t boundary = memory.allocate(0x100u, 16u, base + 0x200u);
+        const uint32_t tail = memory.allocate(IopMemory::HeapLimit - base - 0x600u, 16u, base + 0x600u);
+        if (!expect(boundary != 0u && tail != 0u, "fragmented query fixture failed"))
+            return false;
+        IopCpuState cpu{};
+        if (!expect(sysmem.dispatchImport(7u, cpu) && cpu.gpr[2] == 0x300u,
+                    "QueryMaxFreeMemSize ignored fixed allocations or interior gaps") ||
+            !expect(sysmem.dispatchImport(8u, cpu) && cpu.gpr[2] == 0x500u,
+                    "QueryTotalFreeMemSize returned a contiguous maximum instead of all free bytes"))
+            return false;
+        if (!expect(memory.freeAllocation(boundary) && memory.freeAllocation(tail), "query cleanup failed"))
+            return false;
+        const uint32_t capacity = IopMemory::HeapLimit - IopMemory::HeapBase;
+        return expect(sysmem.dispatchImport(7u, cpu) && cpu.gpr[2] == capacity &&
+                      sysmem.dispatchImport(8u, cpu) && cpu.gpr[2] == capacity,
+                      "free queries did not restore full capacity after all allocations were freed");
+    }
