@@ -315,6 +315,60 @@ void register_ps2_runtime_expansion_tests()
 {
     MiniTest::Case("PS2RuntimeExpansion", [](TestCase &tc)
     {
+        tc.Run("arithmetic overflow helpers preserve wrapped results and signed traps", [](TestCase &t)
+        {
+            const uint32_t values[] = {0u, 1u, 0x7FFFFFFFu, 0x80000000u, 0xFFFFFFFFu};
+            for (uint32_t a : values)
+            {
+                for (uint32_t b : values)
+                {
+                    uint32_t result = 0;
+                    bool overflow = false;
+                    const int64_t sa = static_cast<int32_t>(a);
+                    const int64_t sb = static_cast<int32_t>(b);
+                    ADD32_OV(a, b, result, overflow);
+                    t.Equals(result, static_cast<uint32_t>(sa + sb), "ADD32 must retain the low result bits");
+                    t.Equals(overflow, sa + sb > INT32_MAX || sa + sb < INT32_MIN, "ADD32 signed overflow");
+                    SUB32_OV(a, b, result, overflow);
+                    t.Equals(result, static_cast<uint32_t>(sa - sb), "SUB32 must retain the low result bits");
+                    t.Equals(overflow, sa - sb > INT32_MAX || sa - sb < INT32_MIN, "SUB32 signed overflow");
+                }
+            }
+        });
+
+        tc.Run("strict runtime rejects unknown syscalls and repeated unsupported stubs", [](TestCase &t)
+        {
+            PS2Runtime runtime;
