+    void schedulerPeriodicTimer1Handler(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (g_periodicTimer1Ticks++ == 0u)
+            g_periodicTimer1FirstVSyncTick = runtime->eeScheduler().currentVSyncTick();
+        auto &memory = runtime->memory();
+        // An ordinary read-modify-write acknowledges the observed EQUF bit.
+        memory.writeIORegister(kPeriodicTimer1Mode, memory.readIORegister(kPeriodicTimer1Mode) | 0x200u);
+        ctx->pc = 0u;
+        if (g_periodicTimer1Ticks == kPeriodicTimer1Ticks)
+            runtime->requestStop();
+    }
