+    void checkPeriodicTimer1(TestCase &t, bool idle, bool delayHost)
+    {
+        TestEnv env;
+        t.IsTrue(env.runtime.memory().initialize(), "runtime memory initialize should succeed");
+        env.runtime.registerFunction(kPeriodicTimer1RunPc, schedulerPeriodicTimer1Run);
+        env.runtime.registerFunction(kPeriodicTimer1HandlerPc, schedulerPeriodicTimer1Handler);
+        g_periodicTimer1Ticks = 0u;
+        g_periodicTimer1FirstVSyncTick = 0u;
+        g_periodicTimer1Idle = idle;
+        g_periodicTimer1DelayHost = delayHost;
+        std::atomic<bool> done{false};
+        std::atomic<bool> threw{false};
+        const auto start = std::chrono::steady_clock::now();
+        std::thread gameThread([&]()
+        {
+            try
+            {
+                R5900Context initial{};
+                initial.pc = kPeriodicTimer1RunPc;
+                auto &scheduler = env.runtime.eeScheduler();
+                scheduler.reset(env.rdram.data(), initial);
+                scheduler.addIrqHandler(false, 10u, kPeriodicTimer1HandlerPc, true, 0u, 0u, 0u);
+                scheduler.setIrqCauseEnabled(false, 10u, true);
+                auto &memory = env.runtime.memory();
+                memory.writeIORegister(0x10000800u, 0u);
+                memory.writeIORegister(0x10000820u, 576u);
+                memory.writeIORegister(kPeriodicTimer1Mode, 0x1C2u);
+                scheduler.run();
+            }
+            catch (...)
+            {
+                threw.store(true, std::memory_order_release);
+            }
+            done.store(true, std::memory_order_release);
+        });
+        const bool completed = waitUntil([&]() { return done.load(std::memory_order_acquire); },
+                                         std::chrono::milliseconds(3000));
+        if (!completed)
+            env.runtime.requestStop();
+        gameThread.join();
+        const auto elapsed = std::chrono::steady_clock::now() - start;
+        const uint64_t cycles = env.runtime.eeScheduler().snapshot().eeCycle;
+        const uint64_t expected = kPeriodicTimer1Ticks * kPeriodicTimer1CyclesPerTick;
+        t.IsTrue(completed, "periodic timer must finish before the bounded watchdog");
+        t.IsFalse(threw.load(std::memory_order_acquire), "periodic timer should not throw");
+        t.Equals(g_periodicTimer1Ticks, kPeriodicTimer1Ticks, "every millisecond compare should reach the guest ISR");
+        t.IsTrue(cycles >= expected && cycles - expected < 64u,
+                 "the scheduler must not skip guest timer deadlines while choosing an idle wake");
+        t.Equals(g_periodicTimer1FirstVSyncTick, 0ull,
+                 "the first 1 ms timer deadline must precede the first VBlank guest deadline");
+        // Runnable work is paced at VBlank boundaries: its 100 ms guest
+        // interval can end before the sixth rounded VBlank deadline.
+        // An idle executor instead waits for each 1 ms timer deadline.
+        const uint32_t minimumWallMilliseconds = idle ? kPeriodicTimer1Ticks - 1u : 83u;
+        t.IsTrue(elapsed >= std::chrono::milliseconds(minimumWallMilliseconds),
+                 "preserving guest deadline order must retain host wall-clock pacing");
     }
 
