+    void streamCallbackCanUseTheRealAlarmService()
+    {
+        iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+        p.begin(); p.stream(); p.cd(0u); p.store(2u, p.data(0x40u));
+        p.constant(4u, p.data(0x20u)); p.constant(5u, p.base + 0xB00u); p.constant(6u, 7u);
+        p.call(p.stub(0x1300u)); p.store(2u, p.data(0x44u)); p.finish();
+        p.begin(0x800u);
+        p.constant(4u, p.base + 0xB00u); p.constant(5u, 7u); p.call(p.stub(0x1300u, 3u));
+        p.store(2u, p.data(0x48u));
+        p.constant(4u, p.data(0x20u)); p.constant(5u, p.base + 0xC00u); p.constant(6u, 8u);
+        p.call(p.stub(0x1300u, 1u)); p.store(2u, p.data(0x4Cu));
+        p.marker(1u, p.data(0x50u)); p.finish();
+        p.begin(0xB00u); p.marker(1u, p.data(0x54u)); p.finish();
+        p.begin(0xC00u); p.marker(1u, p.data(0x58u)); p.finish();
+        start(iop, p); advance(iop, 15000u);
+        require(word(iop, p.data(0x40u)) == 1u && word(iop, p.data(0x44u)) == 0u &&
+                    word(iop, p.data(0x48u)) == 0u && word(iop, p.data(0x4Cu)) == 0u &&
+                    word(iop, p.data(0x50u)) == 1u && word(iop, p.data(0x54u)) == 0u &&
+                    word(iop, p.data(0x58u)) == 1u,
+                "deferred original stream code could not cancel its post-Nop timeout and set an interrupt-context alarm");
+    }
+
+    void suppliedNopExportsAndVersionRulesRemainAuthoritative()
+    {
+        for (const auto [provided, requested] : {std::pair<uint32_t, uint32_t>{0x0101u, 0x0101u},
+                                                {0x0106u, 0x0101u}, {0x0201u, 0x0201u}})
+        {
+            iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+            p.image.words(0x1008u, {requested});
+            p.image.words(0x1800u, {0x41C00000u, 0u, provided, 0x64766463u, 0x006E616Du});
+            for (uint32_t slot = 0u; slot <= 46u; ++slot) p.image.words(0x1814u + slot * 4u, {p.base + 0x900u});
+            p.begin(); p.constant(4u, p.base + 0x1800u); p.call(p.stub(0x1500u));
+            p.cd(0u, 0xFFFFFFFFu, 0x1F808260u, 0xFFFFFFFFu); p.store(2u, p.data(0x40u)); p.finish();
+            p.begin(0x900u); p.marker(0xABCDEF01u, p.data()); p.finish(0x5A3u);
+            start(iop, p); advance(iop, 10000u);
+            require(word(iop, p.data()) == 0xABCDEF01u && word(iop, p.data(0x40u)) == 0x5A3u,
+                    "modeled Nop shadowed the actual compatible provider");
+        }
+        iop_test::Host host; IopEmulator iop(host); NcmdProgram missing;
+        missing.image.words(0x1008u, {0x0201u}); missing.begin(); missing.cd(0u); missing.finish();
+        rejects([&] { start(iop, missing); }, "missing import cdvdman:46");
+    }
+
+    void originalStreamReadFaultRemainsStickyAfterNop()
+    {
+        iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+        p.begin(); p.stream(); p.cd(0u); p.store(2u, p.data(0x40u)); p.finish();
+        p.begin(0x800u); p.cd(5u, 0u, 1u, p.data(0x500u)); p.marker(1u, p.data()); p.finish();
+        start(iop, p);
+        rejects([&] { advance(iop, 10000u); }, "missing import cdvdman:114");
+        const uint64_t instructions = iop.instructions(); iop.runEeCycles(80000u);
+        rejects([&] { iop.checkExecutionFailure(); }, "missing import cdvdman:114");
+        require(word(iop, p.data(0x40u)) == 1u && word(iop, p.data()) == 0u &&
+                    iop.instructions() == instructions && host.guestWrites == 0u,
+                "Nop fabricated stream data, swallowed the next strict gap or continued after callback failure");
+        iop.reset(); NcmdProgram clean; clean.begin(); clean.finish(); start(iop, clean); advance(iop, 10000u);
+    }
+}
