+int main()
+{
+    const iop_test::Test tests[] = {
+        {"Nop has no payload or user reason and completes only at a later IOP deadline", acceptanceHasNoPayloadAndCompletionIsDeferred},
+        {"Busy commands and unimplemented blocking waits preserve the pending command", busyAndBlockingQueriesCannotFabricateCompletion},
+        {"Completion resolves the current stream callback, GP and SC mode", completionUsesCurrentStreamSlotAndMode},
+        {"CPU and live IRQ masks retain driver wait without spinning idle deadlines", maskedCompletionRetainsDriverWaitButNotHardwareBusy},
+        {"Original stream callback can submit a successor without recursive completion", callbackCanSubmitNextCommandWithoutRecursiveDelivery},
+        {"Reset, per-device lifetime and callback exceptions preserve command ownership", resetAndCallbackExceptionsDoNotRetainOldCommands},
+        {"Raw IRQ replacement and deleted completion events fail before dispatch", rawIrqOwnerAndDeletedEventFailBeforeEitherCallback},
+        {"Unsupported stream reads, stream0 and overflowing deadlines remain strict", unsupportedReadsAndClockOverflowRemainStrict},
+        {"Authored original imports and callback observe asynchronous IRQ context", originalInstructionsObserveDeferredInterruptCompletion},
+        {"A running IOP thread receives Nop completion and resumes its own code", runningThreadReceivesNcmdAndKeepsItsContinuation},
+        {"Authored mask/resume and full IOP reset control the pending completion", realMaskResumeAndResetControlPendingNcmd},
+        {"Original stream callback cancels timeout and registers an interrupt alarm", streamCallbackCanUseTheRealAlarmService},
+        {"Supplied Nop exports retain compatible-provider and major-version precedence", suppliedNopExportsAndVersionRulesRemainAuthoritative},
+        {"Original later stream read reaches its own sticky strict boundary", originalStreamReadFaultRemainsStickyAfterNop},
+    };
+    return iop_test::run(tests);
+}
