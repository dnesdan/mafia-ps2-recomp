+    template <typename Device> bool dispatch(Device &device, uint16_t ordinal, IopCpuState &cpu, uint64_t now)
+    {
+        if constexpr (requires { device.dispatchImport(ordinal, cpu, now); })
+            return device.dispatchImport(ordinal, cpu, now);
