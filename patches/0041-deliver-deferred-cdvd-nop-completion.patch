+                    f.executor.calls.empty() && !f.cdvd.takeCompletionCallback(),
+                "Nop reported completion or queued the ordinary user callback at acceptance");
+        f.due(due - 1u); require(f.call(11u, 1u) == 1u, "Nop completed before its IOP deadline");
+        f.due(due); f.due(due + 1000u);
+        require(f.poll(0x29u) == 0 && f.call(11u, 1u) == 0u && f.call(11u, 17u) == 0u &&
+                    (f.call(13u, 8u) & 0xC0u) == 0x40u && f.executor.calls.empty() &&
+                    !f.cdvd.takeCompletionCallback() && f.call(37u, 0u) == 0x18000u,
+                "NCMD0 completion fabricated a user reason or failed to restore driver/controller readiness");
+        require(f.host.accesses == 0u && f.memory.interruptStatus() == 0u && !f.memory.takeDmaStart() &&
+                    std::equal(ram.begin(), ram.end(), f.memory.ram().begin()),
+                "Nop performed payload I/O, raw IRQ assertion, DMA or a guest-memory write");
+        require(f.call(37u, 0x19000u, 0u, 0u, 0x11223344u) == 0u && f.call(7u, 5u) == 1u &&
+                    f.call(46u) == 1u, "pending normal-completion control failed");
+        const auto ordinary = f.cdvd.takeCompletionCallback();
+        require(ordinary && ordinary->address == 0x19000u && ordinary->gp == 0x11223344u && ordinary->reason == 4u,
+                "Nop acceptance consumed or replaced an already pending ordinary seek completion");
+        f.due(f.deadline());
+        require(!f.cdvd.takeCompletionCallback() && f.executor.calls.empty(),
+                "finishing Nop duplicated the preceding ordinary completion");
+    }
+
+    void busyAndBlockingQueriesCannotFabricateCompletion()
+    {
+        Fixture f; require(f.call(37u, 0x18000u) == 0u && f.call(46u) == 1u, "busy setup failed");
+        const uint64_t due = f.deadline();
+        require(f.call(46u) == 0u && next(f.cdvd, due + 100u) == due &&
+                    f.call(37u, 0x19000u) == 0u && f.call(6u, 0u, 1u, 0xFFFFFFFFu) == 0u &&
+                    f.call(7u, 0x123u) == 0u,
+                "busy commands replaced the active deadline, user callback or issued a read");
+        for (const auto [ordinal, a0] : {std::pair<uint16_t, uint32_t>{11u, 0u}, {11u, 16u}, {4u, 1u}, {5u, 0u}})
+        {
+            IopCpuState cpu{}; cpu.gpr[2] = 0xDEADBEEFu; cpu.gpr[4] = a0;
+            require(!dispatch(f.cdvd, ordinal, cpu, f.now) && cpu.gpr[2] == 0xDEADBEEFu,
+                    "unimplemented blocking wait/reinitialization claimed success while NCMD remained pending");
+        }
+        require(f.poll(1u) == -418 && f.host.accesses == 0u, "busy refusal signaled the event or touched the host");
+        f.due(due);
+        require(f.call(37u, 0u) == 0x18000u && f.call(11u, 0u) == 0u && f.call(46u) == 1u,
+                "completion did not release the next command or preserve the old user callback");
+    }
+
+    void completionUsesCurrentStreamSlotAndMode()
+    {
+        for (unsigned change = 0u; change < 4u; ++change)
+        {
+            Fixture f; f.stream(); require(f.call(46u) == 1u, "live-slot setup failed");
+            const uint64_t due = f.deadline();
+            if (change == 0u) require(f.call(49u, 0x12000u, 0u, 0u, 0xAABBCCDDu) == 0u, "replace failed");
+            if (change == 1u) require(f.call(49u, 0u) == 0u, "unregister failed");
+            if (change == 2u) require(f.call(50u, 0u) == 0u, "stream stop failed");
+            if (change == 3u)
+            {
+                require(f.call(50u, 1u) == 1u, "unsupported stream0 setup failed");
+                rejects([&] { f.due(due); }, "unsupported stream0 delivery");
+                require(f.executor.calls.empty() && f.call(11u, 1u) == 1u && f.poll(1u) == -418,
+                        "unsupported live mode was silently completed");
+                require(f.call(50u, 2u) == 2u, "restore live mode failed");
+            }
+            f.due(due); f.due(due + 1000u);
+            const size_t expected = change == 0u || change == 3u ? 1u : 0u;
+            require(f.executor.calls.size() == expected && f.call(11u, 1u) == 0u,
+                    "replacement/null/SC0 did not control the current completion");
+            if (expected)
+                require(f.executor.calls[0].function == (change == 0u ? 0x12000u : 0x10000u) &&
+                            f.executor.calls[0].gp == (change == 0u ? 0xAABBCCDDu : 0x12345678u) &&
+                            f.executor.calls[0].argument == 1u && f.executor.calls[0].interrupt &&
+                            !f.intrman.inInterruptContext(), "stream callback lost its argument, saved GP or interrupt scope");
+            require(f.call(11u, 17u) == (change == 2u ? 0u : 1u), "Sync17 ignored the still-selected stream mode");
+        }
+    }
+
+    void maskedCompletionRetainsDriverWaitButNotHardwareBusy()
+    {
+        for (unsigned gates = 1u; gates < 4u; ++gates)
+        {
+            Fixture f; f.stream();
+            if (gates & 1u) f.intr(8u);
+            if (gates & 2u) f.intr(7u, 2u);
+            require(f.call(46u) == 1u, "masked acceptance failed");
+            const uint64_t due = f.deadline(); f.due(due + 1000u);
+            require(f.executor.calls.empty() && f.call(11u, 1u) == 1u && f.poll(1u) == -418 &&
+                        (f.call(13u, 8u) & 0xC0u) == 0x40u && next(f.cdvd, due + 2000u) == due + 2000u,
+                    "masked pending completion was lost, reported as driver-ready or retained a past idle deadline");
+            f.memory.write32(0xBF801074u, f.memory.interruptMask() | 4u); // No EnableIntr bookkeeping.
+            if (gates & 1u)
+            {
+                f.due(due + 1001u); require(f.executor.calls.empty(), "I_MASK bypassed suspended CPU interrupts");
+                f.intr(18u, 1u);
+            }
+            f.due(due + 1002u); f.due(due + 1003u);
+            require(f.executor.calls.size() == 1u && f.call(11u, 1u) == 0u && f.memory.interruptStatus() == 0u,
+                    "live direct-mask/resume gates did not deliver exactly one private completion");
+        }
+    }
+
+    void callbackCanSubmitNextCommandWithoutRecursiveDelivery()
+    {
+        Fixture f; f.stream(); require(f.call(46u) == 1u, "resubmission setup failed");
+        const uint64_t first = f.deadline(); uint64_t second = 0u;
+        f.executor.action = [&](const Call &)
+        {
+            require(f.call(11u, 1u) == 0u && f.poll(0x29u) == 0,
+                    "driver wait/event were not completed before original stream code ran");
+            if (f.executor.calls.size() == 1u)
+            {
+                require(f.call(49u, 0x12000u, 0u, 0u, 0x55556666u) == 0u && f.call(46u) == 1u,
+                        "original stream callback could not submit its successor");
+                second = f.deadline(); f.due(second + 1000u);
+                require(f.executor.calls.size() == 1u && f.call(11u, 1u) == 1u,
+                        "a nested executor checkpoint recursively dispatched the next completion");
+            }
+        };
+        f.due(first); f.due(second + 1001u);
+        require(f.executor.calls.size() == 2u && f.executor.calls[1].function == 0x12000u &&
+                    f.executor.calls[1].gp == 0x55556666u && f.call(11u, 1u) == 0u,
+                "deferred successor lost its current registration or completed more than once");
+    }
+
+    void resetAndCallbackExceptionsDoNotRetainOldCommands()
+    {
+        Fixture f, other; f.stream(); other.stream(0x13000u, 0xBEEFu);
+        require(f.call(46u) == 1u && other.call(46u) == 1u, "per-instance setup failed");
+        const uint64_t due = f.deadline();
+        f.memory.setInterruptMask(f.memory.interruptMask() & ~4u);
+        f.due(due); f.cdvd.reset(); f.due(due + 100u); other.due(due);
+        require(f.executor.calls.empty() && other.executor.calls.size() == 1u &&
+                    f.cdvd.registeredStream1Callback().address == 0u && f.call(11u, 1u) == 0u &&
+                    (f.memory.interruptMask() & 4u) != 0u,
+                "reset retained a masked pending callback or affected another device instance");
+        f.stream(); require(f.call(46u) == 1u, "post-reset setup failed");
+        f.executor.action = [](const Call &) { throw std::runtime_error("authored NCMD callback fault"); };
+        rejects([&] { f.due(f.deadline()); }, "authored NCMD callback fault");
+        require(!f.intrman.inInterruptContext(), "callback exception leaked interrupt scope");
+        f.executor.action = {}; require(f.call(46u) == 1u, "callback exception leaked reentrancy state");
+        f.due(f.deadline()); require(f.executor.calls.size() == 2u, "a later valid direct-device command was lost");
+    }
+
+    void rawIrqOwnerAndDeletedEventFailBeforeEitherCallback()
+    {
+        for (const bool masked : {false, true})
+        {
+            Fixture f; f.stream(); f.intr(4u, 2u, 1u, 0x14000u);
+            if (masked) f.intr(7u, 2u);
+            require(f.call(46u) == 1u, "raw-owner setup failed"); const uint64_t due = f.deadline();
+            if (masked)
+            {
+                f.due(due); require(f.executor.calls.empty(), "disabled raw owner was invoked");
+                f.memory.setInterruptMask(f.memory.interruptMask() | 4u);
+            }
+            rejects([&] { f.due(due); }, "supplied raw IRQ2 owner");
+            require(f.executor.calls.empty() && f.poll(1u) == -418 && f.call(11u, 1u) == 1u,
+                    "ownership failure executed one path or silently released driver wait");
+        }
+        Fixture f; f.stream(); require(f.call(46u) == 1u, "deleted-event setup failed");
+        const uint64_t due = f.deadline();
+        IopCpuState erased{}; erased.gpr[4] = static_cast<uint32_t>(f.cdvd.interruptEventFlag());
+        require(f.kernel.dispatchEventImport(5u, erased) && erased.gpr[2] == 0u, "could not delete authored event");
+        rejects([&] { f.due(due); }, "event flag was deleted");
+        require(f.executor.calls.empty() && f.call(11u, 1u) == 1u, "deleted event allowed stale completion");
+    }
+
+    void unsupportedReadsAndClockOverflowRemainStrict()
+    {
+        Fixture f; f.stream();
+        for (uint16_t ordinal : {6u, 7u, 48u, 62u, 63u, 114u})
+        {
+            IopCpuState cpu{}; cpu.gpr[2] = 0xDEADBEEFu; cpu.gpr[4] = 0xFFFFFFFFu;
+            require(!dispatch(f.cdvd, ordinal, cpu, f.now) && cpu.gpr[2] == 0xDEADBEEFu,
+                    "Nop support accidentally modeled an unsupported stream operation");
+        }
+        require(f.call(50u, 1u) == 1u, "stream0 selection failed");
+        IopCpuState cpu{}; cpu.gpr[2] = 0xDEADBEEFu;
+        require(!dispatch(f.cdvd, 46u, cpu, f.now) && cpu.gpr[2] == 0xDEADBEEFu,
+                "unsupported stream0 Nop lost its strict boundary");
+        require(f.call(50u, 0u) == 0u && f.poll(0x29u) == 0, "overflow fixture setup failed");
+        f.now = std::numeric_limits<uint64_t>::max();
+        rejects([&] { (void)f.call(46u); }, "deadline exceeds the execution clock");
+        require(f.poll(0x29u) == 0 && f.call(11u, 1u) == 0u && f.host.accesses == 0u,
+                "overflow changed driver/event state or performed I/O");
+    }
+
+    struct NcmdProgram : iop_vblank_test::Program
+    {
+        explicit NcmdProgram(uint32_t address = 0x10000u) : Program(address)
+        {
+            imports(0x1000u, "cdvdman", {46u, 49u, 50u, 11u, 37u, 114u});
+            imports(0x1300u, "thbase", {35u, 36u, 37u, 38u});
+            image.words(0x2020u, {5000u, 0u});
+        }
+        void cd(uint32_t index, uint32_t a0 = 0u, uint32_t a1 = 0u, uint32_t a2 = 0u)
+        { constant(4u, a0); constant(5u, a1); constant(6u, a2); call(stub(0x1000u, index)); }
+        void stream(uint32_t callback = 0x800u, uint32_t gp = 0x12345678u)
+        { constant(28u, gp); cd(1u, base + callback); cd(2u, 2u); }
+        void marker(uint32_t value, uint32_t address) { constant(8u, value); store(8u, address); }
+    };
+    using iop_vblank_test::advance;
+    using iop_vblank_test::start;
+    using iop_vblank_test::word;
+
+    void originalInstructionsObserveDeferredInterruptCompletion()
+    {
+        iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+        p.begin(); p.cd(4u, p.base + 0xA00u); p.stream(); p.constant(28u, 0x87654321u);
+        p.cd(0u, 0xFFFFFFFFu, 0x1F808260u, 0xFFFFFFFFu); p.store(2u, p.data(0x40u));
+        p.cd(3u, 1u); p.store(2u, p.data(0x44u)); p.store(28u, p.data(0x48u)); p.finish();
+        p.recordingHandler(0x800u, 0u);
+        p.begin(0xA00u); p.marker(1u, p.data(0x60u)); p.finish();
+        start(iop, p);
+        require(word(iop, p.data()) == 0u && word(iop, p.data(0x40u)) == 1u &&
+                    word(iop, p.data(0x44u)) == 1u && word(iop, p.data(0x48u)) == 0x87654321u,
+                "original Nop/Sync imports completed synchronously or changed caller GP");
+        advance(iop, 10000u); advance(iop, 10000u);
+        require(word(iop, p.data()) == 1u && word(iop, p.data(0x100u)) == 1u &&
+                    word(iop, p.data(0x104u)) == 0x12345678u && word(iop, p.data(0x108u)) == 1u &&
+                    word(iop, p.data(0x60u)) == 0u && host.guestWrites == 0u,
+                "original stream callback did not receive one IRQ-scoped call or Nop fabricated a user callback");
+    }
+
+    void runningThreadReceivesNcmdAndKeepsItsContinuation()
+    {
+        iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+        p.image.words(0x2500u, {0x02000000u, 0u, p.base + 0x600u, 0x800u, 40u});
+        p.begin(); p.constant(4u, p.data(0x500u)); p.call(p.stub(0x1200u));
+        p.move(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1200u, 1u)); p.finish();
+        p.begin(0x600u); p.stream(0x900u); p.cd(0u);
+        const uint32_t loop = p.cursor;
+        p.load(8u, p.data(0x60u)); p.emit(0x25080001u); p.store(8u, p.data(0x60u));
+        p.load(9u, p.data(0x64u));
+        const int32_t relative = (static_cast<int32_t>(loop) - static_cast<int32_t>(p.cursor + 4u)) / 4;
+        p.emit(0x11200000u | static_cast<uint16_t>(relative)); p.emit(0u);
+        p.marker(0xC001CAFEu, p.data(0x68u)); p.finish();
+        p.begin(0x900u); p.marker(1u, p.data(0x64u)); p.finish();
+        start(iop, p); advance(iop, 10000u);
+        require(word(iop, p.data(0x60u)) > 0u && word(iop, p.data(0x64u)) == 1u &&
+                    word(iop, p.data(0x68u)) == 0xC001CAFEu,
+                "NCMD was only serviced while idle or lost the suspended worker continuation");
+    }
+
+    void realMaskResumeAndResetControlPendingNcmd()
+    {
+        for (const bool reset : {false, true})
+        {
+            iop_test::Host host; IopEmulator iop(host); NcmdProgram p;
+            p.begin(); p.constant(4u, p.data(0x70u)); p.call(p.stub(0x1100u));
+            p.constant(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1100u, 4u));
+            p.stream(); p.cd(0u); p.finish(); p.recordingHandler(0x800u, 0u);
+            start(iop, p); advance(iop, 10000u);
+            require(word(iop, p.data()) == 0u, "masked original callback ran before resume");
+            if (reset)
+            {
+                iop.reset(); NcmdProgram empty; empty.begin(); empty.finish(); start(iop, empty);
+                advance(iop, 10000u); require(word(iop, empty.data()) == 0u, "full IOP reset retained old NCMD/registration");
+            }
+            else
+            {
+                NcmdProgram resume(0x20000u); resume.begin();
+                resume.load(8u, 0xBF801074u); resume.emit(0x35080004u); resume.store(8u, 0xBF801074u);
+                resume.constant(4u, 1u); resume.call(resume.stub(0x1100u, 1u)); resume.finish();
+                start(iop, resume); advance(iop, 1000u);
+                require(word(iop, p.data()) == 1u, "real direct I_MASK/CpuResumeIntr did not deliver retained completion");
+            }
+        }
+    }
