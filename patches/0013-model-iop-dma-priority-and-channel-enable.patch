diff --git a/ps2xIOP/src/emulator/imports/iop_dmacman.cpp b/ps2xIOP/src/emulator/imports/iop_dmacman.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4c2611dc41488a5e19853cd3c1e80df10b0a511b
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_dmacman.cpp
@@ -0,0 +1,67 @@
+#include "iop_dmacman.h"
+
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_memory.h"
+
+#include <optional>
+#include <stdexcept>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        struct PriorityField
+        {
+            uint32_t address;
+            uint32_t shift;
+            bool hasEnable;
+        };
+
+        std::optional<PriorityField> priorityField(uint32_t channel)
+        {
+            // Channel numbers, DPCR bank addresses and four-bit field layout:
+            // https://ps2dev.github.io/ps2sdk/dmacman_8h_source.html
+            // https://ps2dev.github.io/ps2sdk/dmacman_8c_source.html
+            if (channel <= 6u)
+                return PriorityField{0x1F8010F0u, channel * 4u, true};
+            if (channel <= 12u)
+                return PriorityField{0x1F801570u, (channel - 7u) * 4u, true};
+            if (channel <= 15u)
+                return PriorityField{0x1F8015F0u, (channel - 13u) * 4u, true};
+            if (channel == 67u) // CPU has a priority field but no DMA-enable API.
+                return PriorityField{0x1F8010F0u, 28u, false};
+            if (channel == 85u) // USB
+                return PriorityField{0x1F801570u, 24u, true};
+            return std::nullopt;
+        }
+    }
+
+    bool dispatchDmacmanPriority(IopMemory &memory, uint16_t ordinal, IopCpuState &cpu)
+    {
+        if (ordinal < 33u || ordinal > 35u)
+            return false;
+        const uint32_t channel = cpu.gpr[4u];
+        const auto field = priorityField(channel);
+        if (!field || (ordinal != 33u && !field->hasEnable))
+            throw std::runtime_error("Unsupported IOP DMACMAN channel " + std::to_string(channel) +
+                                     " for ordinal " + std::to_string(ordinal));
+
+        const uint32_t before = memory.read32(field->address);
+        uint32_t after = before;
+        if (ordinal == 33u)
+        {
+            const uint32_t mask = 7u << field->shift;
+            after = (before & ~mask) | ((cpu.gpr[5u] & 7u) << field->shift);
+        }
+        else
+        {
+            const uint32_t enable = 8u << field->shift;
+            after = ordinal == 34u ? before | enable : before & ~enable;
+        }
+        memory.write32(field->address, after);
+        // All three public operations return void; preserve the caller's
+        // registers. The modeled IOP executes this register update atomically.
+        return true;
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_dmacman.h b/ps2xIOP/src/emulator/imports/iop_dmacman.h
