+    void actualWaitOrderAndPriority()
+    {
+        for (const uint32_t attr : {0u, 1u})
+        {
+            Fixture f;
+            const int box = f.create(attr);
+            const int firstId = f.thread(60u), secondId = f.thread(20u);
+            IopThread *first = f.block(box, 0x10800u);
+            IopThread *second = f.block(box, 0x10810u);
+            require(first->id == secondId && second->id == firstId, "fixture did not reverse creation/enqueue order");
+            // Priority ordering uses live thread priority; FIFO keeps enqueue order.
+            second->priority = 10u;
+            f.message(0x10200u);
+            require(f.call(6u, box, 0x10200u) == 0, "waiting send failed");
+            IopThread *delivered = attr == 0u ? first : second;
+            IopThread *waitingThread = attr == 0u ? second : first;
+            const uint32_t output = attr == 0u ? 0x10800u : 0x10810u;
+            require(delivered->state == IopThreadState::Ready && delivered->cpu.gpr[2] == 0u &&
+                        waitingThread->state == IopThreadState::Mailbox && f.memory.read32(output) == 0x10200u &&
+                        f.memory.read32(0x10200u) == 0xDEADC0DEu,
+                    "direct delivery picked wrong waiter or changed message links");
+            require(f.call(5u, box) == 0 && waitingThread->state == IopThreadState::Ready &&
+                        static_cast<int32_t>(waitingThread->cpu.gpr[2]) == -425,
+                    "delete did not wake pending receiver with KE_WAIT_DELETE");
+            require(f.call(5u, box) == -410, "deleted mailbox remained live");
+        }
+    }
