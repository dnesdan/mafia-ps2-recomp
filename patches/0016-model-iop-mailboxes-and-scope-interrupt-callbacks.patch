+    void queuedFifoAndPriority()
+    {
+        for (const uint32_t attr : {0u, 4u})
+        {
+            Fixture f;
+            const int box = f.create(attr);
+            const uint32_t a = 0x10200u, b = 0x80010220u, c = 0xA0010240u;
+            f.message(a, 4u); f.message(b, 1u); f.message(c, 4u);
+            for (uint32_t message : {a, b, c})
+                require(f.call(6u, box, message) == 0, "queued send failed");
+            const std::array<uint32_t, 3u> order = attr == 0u ?
+                std::array<uint32_t, 3u>{a, b, c} : std::array<uint32_t, 3u>{b, a, c};
+            for (size_t i = 0u; i < order.size(); ++i)
+                require(f.memory.read32(order[i]) == order[(i + 1u) % order.size()], "message links are not circular");
+            require(f.memory.read32(a + 4u) == 0xCACACA04u && f.memory.read32(a + 8u) == 0x12345678u,
+                    "send changed message priority/payload");
+            require(f.memory.zeroRam(0x10800u, 28u), "status fixture");
+            f.memory.write32(0x10814u, 0xA5A5A5A5u); f.memory.write32(0x10818u, 0x5A5A5A5Au);
+            require(f.call(11u, box, 0x10800u) == 0 && f.memory.read32(0x10800u) == attr &&
+                        f.memory.read32(0x10804u) == 255u && f.memory.read32(0x10808u) == 0u &&
+                        f.memory.read32(0x1080Cu) == 3u && f.memory.read32(0x10810u) == order[0] &&
+                        f.memory.read32(0x10814u) == 0xA5A5A5A5u && f.memory.read32(0x10818u) == 0x5A5A5A5Au,
+                    "mailbox status layout or reserved bytes are wrong");
+            for (uint32_t expected : order)
+                require(f.call(9u, 0x10900u, box) == 0 && f.memory.read32(0x10900u) == expected,
+                        "poll order or ABI is wrong");
+            f.memory.write32(0x10900u, 0xBAD0BAD0u);
+            require(f.call(9u, 0x10900u, box) == -424 && f.memory.read32(0x10900u) == 0xBAD0BAD0u,
+                    "empty poll fabricated a message");
+            // Dequeued next pointers remain nonzero and must not prevent reuse.
+            require(f.call(6u, box, a) == 0 && f.call(9u, 0x10900u, box) == 0 &&
+                        f.memory.read32(0x10900u) == a, "a received packet could not be sent again");
+        }
+    }
