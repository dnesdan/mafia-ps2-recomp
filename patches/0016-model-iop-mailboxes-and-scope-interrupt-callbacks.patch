+    void malformedRangesAndLifetime()
+    {
+        for (const uint32_t invalid : {0u, 0x10201u, 0xC0010200u, 0x20010200u, 0xBFFFFFFCu,
+                                       0xA01FFFFCu, 0x8000u})
+        {
+            Fixture f;
+            const int box = f.create();
+            f.message(0x10200u);
+            require(f.call(6u, box, 0x10200u) == 0, "prepare queued message");
+            const std::vector<uint8_t> before(f.memory.ram().begin(), f.memory.ram().end());
+            bool rejected = false;
+            try { (void)f.call(6u, box, invalid); } catch (const std::runtime_error &) { rejected = true; }
+            require(rejected && std::equal(before.begin(), before.end(), f.memory.ram().begin()),
+                    "bad message mutated queue/RAM");
+            require(f.call(9u, 0x10900u, box) == 0 && f.memory.read32(0x10900u) == 0x10200u,
+                    "bad message consumed the valid queue");
+        }
+        Fixture f;
+        const int box = f.create();
+        const uint32_t owned = f.memory.allocate(16u);
+        f.message(owned);
+        require(f.call(6u, box, owned) == 0, "owned message send");
+        bool duplicate = false;
+        try { (void)f.call(6u, box, 0x80000000u | owned); } catch (const std::runtime_error &) { duplicate = true; }
+        require(duplicate, "aliased duplicate packet entered the queue twice");
+        require(f.memory.freeAllocation(owned) && f.memory.allocate(16u, 16u, owned) == owned, "reuse message allocation");
+        const std::vector<uint8_t> before(f.memory.ram().begin(), f.memory.ram().end());
+        bool stale = false;
+        try { (void)f.call(9u, 0x10900u, box); } catch (const std::runtime_error &) { stale = true; }
+        require(stale && std::equal(before.begin(), before.end(), f.memory.ram().begin()),
+                "queued pointer wrote a replacement allocation");
+        require(f.call(5u, box) == 0 && f.memory.allocationContaining(owned).has_value(),
+                "mailbox deletion freed caller memory");
+
+        const int waitingBox = f.create();
+        const uint32_t output = f.memory.allocate(16u);
+        (void)f.thread(20u);
+        IopThread *receiver = f.block(waitingBox, output);
+        require(f.memory.freeAllocation(output) && f.memory.allocate(16u, 16u, output) == output, "reuse output allocation");
+        f.memory.write32(output, 0xAABBCCDDu);
+        f.message(0x10200u);
+        bool invalidOutput = false;
+        try { (void)f.call(6u, waitingBox, 0x10200u); } catch (const std::runtime_error &) { invalidOutput = true; }
+        require(invalidOutput && receiver->state == IopThreadState::Mailbox && f.memory.read32(output) == 0xAABBCCDDu,
+                "delayed delivery wrote to a replacement output allocation");
+        require(f.call(5u, waitingBox) == 0 && static_cast<int32_t>(receiver->cpu.gpr[2]) == -425,
+                "invalid output prevented mailbox deletion cleanup");
+    }
