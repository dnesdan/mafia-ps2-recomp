+        require(timrman.dispatchImport(22u, timer, 0u) && timer.gpr[2] == 0u, "hard timer setup failed");
+        timer.gpr[4] = timerId;
+        require(timrman.dispatchImport(23u, timer, 0u) && timer.gpr[2] == 0u, "hard timer start failed");
+        executor.fail = false;
+        timrman.serviceDue(10u, executor, intrman);
+        require(!intrman.inInterruptContext() && f.call(9u, 0x10900u, box) == 0 &&
+                    f.memory.read32(0x10900u) == 0x10200u, "timer interrupt context or message was lost");
