+    void authoredImportExecution()
+    {
+        iop_test::Irx image;
+        image.words(0u, {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFB00018u,
+            0x3C040001u, 0x34840400u, 0x0C004045u, 0u, 0x00408021u,
+            0x02002021u, 0x3C050001u, 0x34A50420u, 0x0C004047u, 0u,
+            0x3C040001u, 0x34840440u, 0x02002821u, 0x0C004049u, 0u,
+            0x3C080001u, 0xAD020444u, 0x8FBF001Cu, 0x8FB00018u,
+            0x27BD0020u, 0x03E00008u, 0x00001021u,
