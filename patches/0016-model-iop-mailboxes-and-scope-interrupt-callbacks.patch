+            0x03E00008u, 0x24000004u, 0x03E00008u, 0x24000006u,
+            0x03E00008u, 0x24000009u, 0u, 0u});
+        image.words(0x400u, {0u, 255u});
+        image.words(0x420u, {0xDEADC0DEu, 5u, 0x12345678u, 0u});
+        iop_test::Host host;
