+                    emulator.readMemory(0x10440u, result.data(), sizeof(result)) &&
+                    result[0] == 0x10420u && result[1] == 0u && host.guestWrites == 0u,
+                "authored mailbox imports did not preserve actual message identity");
+        image.words(0x118u, {0x2400000Au});
+        IopEmulator unsupported(host);
+        bool rejected = false;
+        try { (void)unsupported.loadModuleImage("authored-unknown-mailbox", image.bytes, nullptr, 0u); }
+        catch (const std::runtime_error &error)
+        { rejected = std::string_view(error.what()).find("missing import thmsgbx:10") != std::string_view::npos; }
+        require(rejected, "unknown mailbox import silently succeeded");
+    }
+}
+
+int main()
+{
+    const iop_test::Test tests[] = {
+        {"FIFO and stable message priorities retain circular guest links", queuedFifoAndPriority},
+        {"Real blocked receivers obey enqueue order and thread priority", actualWaitOrderAndPriority},
+        {"Release, suspend and thread deletion preserve mailbox wait lifetime", releaseSuspendAndDeletedThreads},
+        {"Malformed and replaced message/output storage fails before mutation", malformedRangesAndLifetime},
+        {"Exact-end aliases, contexts, direct callbacks and reset are bounded", exactEndsContextAndReset},
+        {"Interrupt mailbox variants use actual exception-safe context", interruptScopeIsRealAndExceptionSafe},
+        {"Actual IOP workers block and resume ReceiveMbx with original packet identity", authoredBlockedMailboxThreads},
+        {"Authored guest imports send and receive actual message pointers", authoredImportExecution},
+    };
+    return iop_test::run(tests);
+}
