diff --git a/ps2xIOP/src/emulator/core/iop_mailbox.cpp b/ps2xIOP/src/emulator/core/iop_mailbox.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c322a583092c3ad00d264133a87b70632558a6fc
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_mailbox.cpp
@@ -0,0 +1,242 @@
+#include "iop_kernel.h"
+#include "iop_memory.h"
+
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // ABI, queue ordering and errors are documented by PS2SDK thmsgbx.h,
+        // thmsgbx.c and kerr.h. Guest messages remain caller-owned memory.
+        // https://ps2dev.github.io/ps2sdk/thmsgbx_8h_source.html
+        // https://ps2dev.github.io/ps2sdk/thmsgbx_8c_source.html
+        // https://ps2dev.github.io/ps2sdk/kerr_8h_source.html
+        constexpr uint32_t kThreadPriority = 0x1u;
+        constexpr uint32_t kMessagePriority = 0x4u;
+
+        bool waiting(const IopThread &thread, int id)
+        {
+            return thread.waitId == id && (thread.state == IopThreadState::Mailbox ||
+                                            thread.state == IopThreadState::MailboxSuspended);
+        }
+
+        uint64_t checkedMemory(const IopMemory &memory, uint32_t address, size_t size,
+                               const char *purpose)
+        {
+            const uint32_t segment = address & 0xE0000000u;
+            const uint32_t physical = IopMemory::physicalAddress(address);
+            if (address == 0u || (address & 3u) != 0u ||
+                (segment != 0u && segment != 0x80000000u && segment != 0xA0000000u) ||
+                physical >= IopMemory::RamSize || size > IopMemory::RamSize - physical ||
+                !memory.ownsRamRange(address, size))
+                throw std::runtime_error(std::string("IOP mailbox ") + purpose + " is outside aligned owned RAM");
+            const auto owner = memory.allocationContaining(physical);
+            if (owner)
+            {
+                if (size > owner->size - (physical - owner->address))
+                    throw std::runtime_error(std::string("IOP mailbox ") + purpose + " crosses an allocation boundary");
+                return owner->identity;
+            }
+            if (physical >= IopMemory::HeapBase && physical < IopMemory::HeapLimit)
+                throw std::runtime_error(std::string("IOP mailbox ") + purpose + " has no live heap allocation");
+            return 0u;
+        }
+
+        void checkLifetime(const IopMemory &memory, uint32_t address, size_t size,
+                           uint64_t identity, const char *purpose)
+        {
+            if (checkedMemory(memory, address, size, purpose) != identity)
+                throw std::runtime_error(std::string("IOP mailbox ") + purpose + " allocation was replaced while queued");
+        }
+
+        void release(IopThread &thread, int32_t result)
+        {
+            thread.state = thread.state == IopThreadState::MailboxSuspended ?
+                IopThreadState::Suspended : IopThreadState::Ready;
+            thread.cpu.gpr[2] = static_cast<uint32_t>(result);
+            thread.waitId = 0;
+            thread.waitResultAddress = 0u;
+            thread.mailboxWaitOrder = 0u;
+            thread.mailboxWaitOwner = 0u;
+        }
+    }
+
+    bool IopKernel::dispatchMailboxImport(uint16_t ordinal, IopCpuState &cpu, bool interruptContext)
+    {
+        if (ordinal != 4u && ordinal != 5u && ordinal != 6u && ordinal != 7u &&
+            ordinal != 8u && ordinal != 9u && ordinal != 11u && ordinal != 12u)
+            return false;
+        const auto result = [&](int32_t value) { cpu.gpr[2] = static_cast<uint32_t>(value); };
+        const bool interruptCall = ordinal == 7u || ordinal == 12u;
+        if (interruptCall != interruptContext)
+        {
+            result(-100); // KE_ILLEGAL_CONTEXT.
+            return true;
+        }
+
+        if (ordinal == 4u)
+        {
+            const uint32_t descriptor = cpu.gpr[4];
+            (void)checkedMemory(m_memory, descriptor, 8u, "descriptor");
+            const uint32_t attr = m_memory.read32(descriptor);
+            if ((attr & ~(kThreadPriority | kMessagePriority)) != 0u)
+            {
+                result(-401); // KE_ILLEGAL_ATTR.
+                return true;
+            }
+            if (m_nextMailboxId > static_cast<uint32_t>(std::numeric_limits<int>::max()))
+            {
+                result(-400); // KE_NO_MEMORY; handle space exhausted.
+                return true;
+            }
+            const int id = static_cast<int>(m_nextMailboxId);
+            Mailbox mailbox;
+            mailbox.attr = attr;
+            mailbox.option = m_memory.read32(descriptor + 4u);
+            m_mailboxes.emplace(id, std::move(mailbox));
+            ++m_nextMailboxId;
+            result(id);
+            return true;
+        }
+
+        // Receive/Poll use (void **out, int id), unlike Send(id, message).
+        const bool receive = ordinal == 8u || ordinal == 9u;
+        const int id = static_cast<int>(cpu.gpr[receive ? 5u : 4u]);
+        const auto found = m_mailboxes.find(id);
+        if (found == m_mailboxes.end())
+        {
+            result(-410); // KE_UNKNOWN_MBXID.
+            return true;
+        }
+        Mailbox &mailbox = found->second;
+        const auto checkQueue = [&]
+        {
+            for (size_t i = 0u; i < mailbox.messages.size(); ++i)
+            {
+                const MailboxMessage &message = mailbox.messages[i];
+                checkLifetime(m_memory, message.address, 8u, message.ownerIdentity, "queued message");
+                const uint32_t expectedNext = mailbox.messages[(i + 1u) % mailbox.messages.size()].address;
+                if (m_memory.read32(message.address) != expectedNext)
+                    throw std::runtime_error("IOP mailbox circular message links changed while queued");
+            }
+        };
+
+        if (ordinal == 5u)
+        {
+            // Deletion never dereferences or frees the caller's messages.
+            for (auto &[threadId, thread] : m_threads)
+                if (waiting(thread, id))
+                    release(thread, -425); // KE_WAIT_DELETE.
+            m_mailboxes.erase(found);
+            result(0);
+            return true;
+        }
+
+        if (ordinal == 6u || ordinal == 7u)
+        {
+            const uint32_t address = cpu.gpr[5];
+            const uint64_t owner = checkedMemory(m_memory, address, 8u, "message");
+            const uint32_t physical = IopMemory::physicalAddress(address);
+            for (const auto &[boxId, box] : m_mailboxes)
+                for (const auto &queued : box.messages)
+                    if (IopMemory::physicalAddress(queued.address) == physical)
+                        throw std::runtime_error("IOP mailbox message is already queued");
+
+            IopThread *selected = nullptr;
+            for (auto &[threadId, thread] : m_threads)
+            {
+                if (!waiting(thread, id))
+                    continue;
+                const bool byPriority = (mailbox.attr & kThreadPriority) != 0u;
+                if (selected == nullptr ||
+                    (byPriority && thread.priority < selected->priority) ||
+                    ((!byPriority || thread.priority == selected->priority) &&
+                     thread.mailboxWaitOrder < selected->mailboxWaitOrder))
+                    selected = &thread;
+            }
+            if (selected != nullptr)
+            {
+                checkLifetime(m_memory, selected->waitResultAddress, 4u,
+                              selected->mailboxWaitOwner, "waiting result");
+                m_memory.write32(selected->waitResultAddress, address);
+                release(*selected, 0);
+                // Direct delivery does not write the caller's message header.
+                result(0);
+                return true;
+            }
+
+            checkQueue();
+            auto updated = mailbox.messages; // Allocate before changing guest links.
+            auto position = updated.end();
+            if ((mailbox.attr & kMessagePriority) != 0u)
+            {
+                const uint8_t priority = m_memory.read8(address + 4u);
+                position = std::find_if(updated.begin(), updated.end(), [&](const MailboxMessage &message)
+                    { return m_memory.read8(message.address + 4u) > priority; });
+            }
+            updated.insert(position, {address, owner});
+            for (size_t i = 0u; i < updated.size(); ++i)
+                m_memory.write32(updated[i].address, updated[(i + 1u) % updated.size()].address);
+            mailbox.messages.swap(updated);
+            result(0);
+            return true;
+        }
+
+        if (receive)
+        {
+            const uint32_t output = cpu.gpr[4];
+            const uint64_t owner = checkedMemory(m_memory, output, 4u, "receive output");
+            if (mailbox.messages.empty())
+            {
+                if (ordinal == 9u)
+                    result(-424); // KE_MBOX_NOMSG; leave output untouched.
+                else
+                {
+                    if (m_currentThread == nullptr || &cpu != &m_currentThread->cpu)
+                        throw std::runtime_error("IOP mailbox ReceiveMbx cannot suspend a direct guest callback");
+                    if (m_nextMailboxWaitOrder == std::numeric_limits<uint64_t>::max())
+                        throw std::runtime_error("IOP mailbox wait ordering exhausted");
+                    m_currentThread->state = IopThreadState::Mailbox;
+                    m_currentThread->waitId = id;
+                    m_currentThread->waitResultAddress = output;
+                    m_currentThread->mailboxWaitOwner = owner;
+                    m_currentThread->mailboxWaitOrder = m_nextMailboxWaitOrder++;
+                    cpu.yielded = true;
+                    // The result becomes valid only when Send/Delete/Release
+                    // actually wakes the thread. No message is fabricated.
+                }
+                return true;
+            }
+
+            checkQueue();
+            const uint32_t message = mailbox.messages.front().address;
+            if (mailbox.messages.size() > 1u)
+                m_memory.write32(mailbox.messages.back().address, mailbox.messages[1u].address);
+            mailbox.messages.erase(mailbox.messages.begin());
+            m_memory.write32(output, message);
+            result(0);
+            return true;
+        }
+
+        // ReferMbxStatus writes the five documented fields. The final two
+        // reserved words in the 28-byte public structure remain untouched.
+        const uint32_t output = cpu.gpr[5];
+        (void)checkedMemory(m_memory, output, 20u, "status output");
+        checkQueue();
+        uint32_t waiters = 0u;
+        for (const auto &[threadId, thread] : m_threads)
+            if (waiting(thread, id))
+                ++waiters;
+        m_memory.write32(output, mailbox.attr);
+        m_memory.write32(output + 4u, mailbox.option);
+        m_memory.write32(output + 8u, waiters);
+        m_memory.write32(output + 12u, static_cast<uint32_t>(mailbox.messages.size()));
+        m_memory.write32(output + 16u, mailbox.messages.empty() ? 0u : mailbox.messages.front().address);
+        result(0);
+        return true;
+    }
+}
