+    void interruptScopeIsRealAndExceptionSafe()
+    {
+        struct Executor : IopGuestExecutor
+        {
+            Fixture &fixture;
+            IopIntrman &intrman;
+            int box;
+            bool fail = false;
+            Executor(Fixture &f, IopIntrman &i, int b) : fixture(f), intrman(i), box(b) {}
+            uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override
+            {
+                IopCpuState query{};
+                require(intrman.dispatchImport(23u, query, *this) && query.gpr[2] == 1u,
+                        "QueryIntrContext does not reflect actual interrupt dispatch");
+                require(fixture.call(6u, box, 0xFFFFFFFFu, intrman.inInterruptContext()) == -100,
+                        "ordinary send was accepted inside an interrupt");
+                if (fail) throw std::runtime_error("authored interrupt failure");
+                require(fixture.call(7u, box, 0x10200u, intrman.inInterruptContext()) == 0,
+                        "interrupt mailbox send failed");
+                return 1u;
+            }
+        };
+        Fixture f;
+        const int box = f.create(); f.message(0x10200u);
+        IopIntrman intrman(f.memory);
+        Executor executor(f, intrman, box);
+        IopCpuState registration{};
+        registration.gpr[4] = 2u; registration.gpr[6] = 0x10400u;
+        require(intrman.dispatchImport(4u, registration, executor) && intrman.dispatchImport(6u, registration, executor),
+                "interrupt registration failed");
+        require(intrman.dispatchInterrupt(2, executor) && !intrman.inInterruptContext(), "interrupt scope leaked");
+        require(f.call(9u, 0x10900u, box) == 0, "interrupt message was not queued");
+        executor.fail = true;
+        bool failed = false;
+        try { (void)intrman.dispatchInterrupt(2, executor); } catch (const std::runtime_error &) { failed = true; }
+        require(failed && !intrman.inInterruptContext(), "exception leaked interrupt context");
+
+        // timrman invokes hard-timer handlers directly rather than through the
+        // registered IRQ map, but those handlers still run in interrupt context.
+        IopTimrman timrman;
+        timrman.reset();
+        IopCpuState timer{};
+        timer.gpr[4] = 1u; timer.gpr[5] = 32u; timer.gpr[6] = 1u;
+        require(timrman.dispatchImport(4u, timer, 0u) && static_cast<int32_t>(timer.gpr[2]) > 0,
