@@ -0,0 +1,385 @@
+#pragma once
+
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/imports/iop_cdvd.h"
+#include "emulator/imports/iop_intrman.h"
+#include "emulator/services/iop_rpc.h"
+#include "iop_vblank_fixtures.h"
+
+#include <functional>
+#include <limits>
+
+namespace iop_stream_read_test
+{
+    using namespace ps2x::iop;
+    using namespace ps2x::iop::detail;
+    using iop_test::require;
+    constexpr uint32_t modeAddress = 0x2000u, bufferAddress = 0x4000u;
+
+    class DiscHost final : public IopHost
+    {
+    public:
+        std::vector<uint8_t> image = std::vector<uint8_t>(8u * 2048u);
+        bool failOpen = false, failRead = false, shortRead = false;
+        size_t reads = 0u, opens = 0u, closes = 0u, eeAccesses = 0u;
+        mutable size_t rootRequests = 0u;
+        std::function<void()> onRead;
+        DiscHost() { for (size_t i = 0; i < image.size(); ++i) image[i] = static_cast<uint8_t>(i * 13u + i / 2048u + 7u); }
+        bool readGuest(uint32_t, void *, size_t) const override { return false; }
+        bool writeGuest(uint32_t, const void *, size_t) override { ++eeAccesses; return false; }
+        bool zeroGuest(uint32_t, size_t) override { ++eeAccesses; return false; }
+        bool normalizeGuestAddress(uint32_t, uint32_t &) const override { return false; }
+        uint32_t allocateIopHandle(IopHandleKind) override { return 1u; }
+        uint32_t allocateGuest(uint32_t, uint32_t) override { return 0u; }
+        void freeGuest(uint32_t) override {}
+        void audioCommand(uint32_t, uint32_t, GuestBuffer, GuestBuffer) override {}
+        std::string hostPath(HostPathKind kind) const override
+        {
+            if (kind == HostPathKind::CdImage) return "authored-stream.iso";
+            if (kind == HostPathKind::CdRoot) ++rootRequests;
+            return {};
+        }
+        std::string translateGuestPath(std::string_view) const override { return {}; }
+        uint64_t openHostFile(std::string_view name) override
+        { ++opens; return !failOpen && name == "authored-stream.iso" ? 1u : 0u; }
+        bool hostFileSize(uint64_t handle, uint64_t &size) const override { size = image.size(); return handle == 1u; }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *out, size_t size, size_t &actual) override
+        {
+            ++reads; actual = 0u;
+            if (onRead) onRead();
+            if (failRead || handle != 1u || offset > image.size() || size > image.size() - offset) return false;
+            actual = shortRead && size ? size - 1u : size;
+            std::memcpy(out, image.data() + offset, actual);
+            return true;
+        }
+        void closeHostFile(uint64_t) override { ++closes; }
+        int32_t memoryCard(const MemoryCardRequest &) override { return 0; }
+        bool hasGuestFunction(uint32_t) const override { return false; }
+        bool invokeGuestFunction(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t *) override { return false; }
+        void log(LogLevel, std::string_view) override {}
+    };
+
+    struct Call { uint32_t function, argument, gp; bool interrupt; };
+    struct Executor final : IopGuestExecutor
+    {
+        IopIntrman &intrman;
+        std::vector<Call> calls;
+        std::function<void(const Call &)> action;
+        explicit Executor(IopIntrman &value) : intrman(value) {}
+        uint32_t executeGuestFunction(uint32_t function, uint32_t a0, uint32_t, uint32_t, uint32_t, uint32_t gp) override
+        {
+            const Call call{function, a0, gp, intrman.inInterruptContext()};
+            calls.push_back(call);
+            if (action) action(call);
+            return 0u;
+        }
+    };
+    struct Fixture
+    {
+        DiscHost host;
+        IopMemory memory;
+        IopKernel kernel{memory};
+        IopIntrman intrman{memory};
+        IopCdvd cdvd{host, memory, kernel};
+        Executor executor{intrman};
+        uint64_t now = 100u;
+        Fixture()
