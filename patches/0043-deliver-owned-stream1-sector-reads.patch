+            f.matches();
+            require(call.interrupt && call.argument == 1u && f.call(11u, 1u) == 0u &&
+                        f.call(50u, uint32_t(-3)) == 0u, "callback ran before payload/driver completion");
+        };
+        f.due(deadline); f.due(deadline + 5000u);
+        require(f.executor.calls.size() == 2u && f.executor.calls[0].function == 0x3000u &&
+                    f.executor.calls[0].gp == 0x12345678u && f.executor.calls[1].function == 0x3100u &&
+                    f.executor.calls[1].gp == 0xABCDEF01u && f.host.reads == 1u && f.host.eeAccesses == 0u &&
+                    f.memory.read32(bufferAddress - 4u) == 0xCCCCCCCCu &&
+                    f.memory.read32(bufferAddress + 4096u) == 0xCCCCCCCCu && !f.cdvd.takeCompletionCallback(),
+                "stream/user ordering, exact bounds or single completion was lost");
+    }
+
+    void aliasesAndOverlappingMode()
+    {
+        for (uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            Fixture f; f.memory.write32(bufferAddress, 0u);
+            require(f.read(1u, 2u, alias | bufferAddress, alias | bufferAddress) == 1u,
+                    "legal alias or overlapping mode/buffer rejected");
+            f.due(f.deadline()); f.matches();
+            require(f.executor.calls.size() == 1u, "alias acquired extra completion");
+        }
+    }
+
+    void invalidSpansAndCountsAreAtomic()
+    {
+        for (unsigned variant = 0u; variant < 10u; ++variant)
+        {
+            Fixture f; uint32_t destination = bufferAddress, mode = modeAddress, sectors = 2u, lsn = 1u;
+            switch (variant)
+            {
+            case 0: destination = 0u; break;
+            case 1: destination = 0x20004000u; break;
+            case 2: destination = 0x1F402005u; break;
+            case 3: destination = 0x1FFFF0u; break;
+            case 4: destination = 0x8000u; break;
+            case 5: mode = 0x1F402005u; break;
+            case 6: mode = 0x20002000u; break;
+            case 7: mode = 0x2FFDu; f.memory.write16(mode, 0u); break;
+            case 8: sectors = UINT32_MAX; break;
+            case 9: lsn = UINT32_MAX; break;
+            }
