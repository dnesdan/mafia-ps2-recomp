+            memory.write32(modeAddress, 0u);
+            std::vector<uint8_t> bytes(4104u, 0xCCu);
+            require(memory.writeRam(bufferAddress - 4u, bytes.data(), bytes.size()), "buffer fixture failed");
+            require(call(49u, 0x3000u, 0u, 0u, 0u, 0x12345678u) == 0u && call(50u, 2u) == 2u, "stream fixture failed");
+        }
+        uint32_t call(uint16_t ordinal, uint32_t a0 = 0u, uint32_t a1 = 0u, uint32_t a2 = 0u,
+                      uint32_t a3 = 0u, uint32_t gp = 0u)
+        {
+            IopCpuState cpu{}; cpu.gpr[2] = 0xDEADBEEFu;
+            cpu.gpr[4] = a0; cpu.gpr[5] = a1; cpu.gpr[6] = a2; cpu.gpr[7] = a3; cpu.gpr[28] = gp;
+            require(cdvd.dispatchImport(ordinal, cpu, now), "stream read import unresolved");
+            return cpu.gpr[2];
+        }
+        uint32_t read(uint32_t lsn = 1u, uint32_t sectors = 2u, uint32_t buffer = bufferAddress, uint32_t mode = modeAddress)
+        { return call(114u, lsn, sectors, buffer, mode); }
+        uint64_t deadline()
+        {
+            const auto value = cdvd.nextEventCycle(UINT64_MAX);
+            require(value > now && value != UINT64_MAX, "read has no future device deadline");
+            return value;
+        }
+        void due(uint64_t time) { now = time; cdvd.serviceDue(time, executor, intrman); }
+        void matches(uint32_t lsn = 1u, uint32_t buffer = bufferAddress, size_t size = 4096u)
+        {
+            require(std::equal(host.image.begin() + lsn * 2048u, host.image.begin() + lsn * 2048u + size,
+                               memory.ram().begin() + IopMemory::physicalAddress(buffer)), "read bytes differ from actual selected sectors");
+        }
+    };
+    template <typename Body> void rejects(Body body)
+    {
+        try { body(); }
