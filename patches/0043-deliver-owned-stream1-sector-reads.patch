+        f.host.onRead = [&] { f.due(deadline); }; // Must not recursively enter the in-flight host read.
+        f.due(deadline - 1u);
+        require(f.host.reads == 0u && f.executor.calls.empty(), "read completed before its deadline");
+        f.executor.action = [&](const Call &call)
