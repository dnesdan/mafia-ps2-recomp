+        require(f.host.opens == 0u && f.host.reads == 0u && f.memory.read32(bufferAddress) == 0xCCCCCCCCu &&
+                    f.call(11u, 1u) == 1u && f.call(50u, uint32_t(-3)) == 1u &&
+                    (f.call(13u, 8u) & 0xC0u) == 0x80u, "read published data or completion during acceptance");
