+        }
+        Fixture f;
+        require(f.read() == 1u && f.read(0u, 1u, 0xFFFFFFFFu, 0xFFFFFFFFu) == 0u,
+                "busy read dereferenced replacement arguments or replaced its accepted request");
+        f.due(f.deadline()); f.matches();
+    }
+
+    void bufferLeaseCannotWriteReplacement()
+    {
+        for (bool duringRead : {false, true})
+        {
+            Fixture f; const auto buffer = f.memory.allocate(4096u);
+            require(buffer != 0u && f.memory.zeroRam(buffer, 4096u) && f.read(1u, 2u, buffer) == 1u, "leased read setup failed");
+            const auto replace = [&]
+            {
+                require(f.memory.freeAllocation(buffer) && f.memory.allocate(4096u) == buffer, "lease replacement failed");
+                f.memory.write32(buffer, 0x12345678u);
+            };
+            if (duringRead) f.host.onRead = replace; else replace();
+            rejects([&] { f.due(f.deadline()); });
+            require(f.memory.read32(buffer) == 0x12345678u && f.executor.calls.empty() &&
+                        f.host.reads == (duringRead ? 1u : 0u), "deferred read wrote into a new allocation lifetime");
+        }
+        Fixture f;
+        const auto first = f.memory.allocate(2048u), second = f.memory.allocate(2048u);
+        require(second == first + 2048u && f.memory.zeroRam(first, 4096u), "adjacent allocation setup failed");
+        rejects([&] { (void)f.read(1u, 2u, first); });
+        require(f.host.reads == 0u, "read crossed allocation owners before failing");
+        Fixture reset;
+        require(reset.read() == 1u, "host-reset setup failed");
+        reset.host.onRead = [&] { reset.cdvd.reset(); };
+        rejects([&] { reset.due(reset.deadline()); });
+        require(reset.memory.read32(bufferAddress) == 0xCCCCCCCCu && reset.executor.calls.empty(),
+                "reset during host I/O allowed the retired command to publish bytes");
+    }
+
+    void failedMediaNeverFabricatesPayload()
+    {
+        for (unsigned failure = 0u; failure < 4u; ++failure)
+        {
+            Fixture f;
+            f.host.failOpen = failure == 0u; f.host.failRead = failure == 1u; f.host.shortRead = failure == 2u;
+            require(f.read(failure == 3u ? 8u : 1u) == 1u, "valid read request was not accepted");
+            f.executor.action = [&](const Call &) { require(f.call(8u) == 0x30u, "callback did not observe read error"); };
+            f.due(f.deadline());
+            require(f.memory.read32(bufferAddress) == 0xCCCCCCCCu &&
+                        f.memory.read32(bufferAddress + 4092u) == 0xCCCCCCCCu &&
+                        f.executor.calls.size() == 1u && f.host.rootRequests == 0u &&
+                        f.call(11u, 1u) == 0u && (f.call(13u, 8u) & 0x41u) == 0x41u,
+                    "failed/short image read invented data, fell back to another disc or lost completion");
+        }
+    }
+
+    void maskedReadCopiesOnceAndUsesLiveSlot()
+    {
+        Fixture f; f.memory.setInterruptControl(0u); f.memory.setInterruptMask(0u);
+        require(f.read() == 1u, "masked read acceptance failed");
+        const auto due = f.deadline(); f.due(due); f.matches(); f.due(due + 1000u);
+        require(f.host.reads == 1u && f.executor.calls.empty() && f.call(11u, 1u) == 1u &&
+                    f.call(50u, uint32_t(-3)) == 1u && (f.call(13u, 8u) & 0xC0u) == 0x40u &&
+                    f.cdvd.nextEventCycle(due + 2000u) == due + 2000u, "masked hardware and driver progress were conflated");
+        require(f.call(49u, 0x3300u, 0u, 0u, 0u, 0x55667788u) == 0u, "live replacement failed");
+        f.memory.setInterruptMask(4u); f.due(due + 1001u);
+        require(f.executor.calls.empty(), "mask bypassed CPU interrupt suspension");
+        f.memory.setInterruptControl(1u); f.due(due + 1002u); f.due(due + 1003u);
+        require(f.host.reads == 1u && f.executor.calls.size() == 1u && f.executor.calls[0].function == 0x3300u &&
+                    f.executor.calls[0].gp == 0x55667788u, "masked read reread media or retained a stale callback");
+    }
+
+    void resetAndSuccessorRequestsKeepSeparateLifetimes()
+    {
+        for (bool afterPayload : {false, true})
+        {
+            Fixture f; require(f.read() == 1u, "reset fixture failed");
+            const auto due = f.deadline(); f.memory.setInterruptMask(0u);
+            if (afterPayload) f.due(due);
+            f.cdvd.reset(); f.due(due + 1000u);
+            require(f.host.reads == (afterPayload ? 1u : 0u) && f.executor.calls.empty() &&
+                        f.call(50u, uint32_t(-3)) == 0u, "reset retained an old payload write or callback");
+        }
+        Fixture f; require(f.memory.zeroRam(0x8000u, 4096u) && f.read() == 1u, "successor setup failed");
+        uint64_t next = 0u;
+        f.executor.action = [&](const Call &)
+        {
+            if (f.executor.calls.size() == 1u)
+            {
+                require(f.read(3u, 2u, 0x8000u) == 1u, "completed read blocked its successor");
+                next = f.deadline(); f.due(next);
+                require(f.executor.calls.size() == 1u, "nested checkpoint recursively delivered the next callback");
+            }
+        };
+        f.due(f.deadline()); f.due(next + 1u);
+        f.matches(); f.matches(3u, 0x8000u);
+        require(f.host.reads == 2u && f.executor.calls.size() == 2u, "successor request was lost or overwritten");
+        Fixture reset;
+        require(reset.call(37u, 0x3100u) == 0u && reset.read() == 1u, "callback-reset setup failed");
+        reset.executor.action = [&](const Call &) { reset.cdvd.reset(); (void)reset.call(37u, 0x3500u); };
+        reset.due(reset.deadline());
+        require(reset.executor.calls.size() == 1u, "old read delivered its user callback after device reset");
+    }
+
+    void unsupportedContractsStayStrict()
+    {
+        for (unsigned variant = 0u; variant < 5u; ++variant)
+        {
+            Fixture f; IopCpuState cpu{}; cpu.gpr[2] = 0xDEADBEEFu;
+            cpu.gpr[4] = 1u; cpu.gpr[5] = 2u; cpu.gpr[6] = bufferAddress; cpu.gpr[7] = modeAddress;
+            if (variant < 2u) (void)f.call(50u, variant);
+            if (variant == 2u) f.memory.write8(modeAddress + 2u, 1u);
+            if (variant == 3u) cpu.gpr[7] = 0u;
+            if (variant == 4u) cpu.gpr[5] = 0u;
+            require(!f.cdvd.dispatchImport(114u, cpu, f.now) && cpu.gpr[2] == 0xDEADBEEFu &&
+                        f.host.reads == 0u && f.host.opens == 0u && f.executor.calls.empty(),
+                    "unsupported stream mode/shape acquired fabricated success");
+        }
+    }
+
+    iop_vblank_test::Program readProgram(uint16_t requested = 0x0101u, uint16_t provided = 0u)
+    {
+        using iop_vblank_test::Program;
+        Program p; p.imports(0x1000u, "cdvdman", {114u, 49u, 50u}); p.image.words(0x1008u, {requested});
+        p.image.words(0x2020u, {0u});
+        p.begin();
+        if (provided)
+        {
+            p.image.words(0x1800u, {0x41C00000u, 0u, provided, 0x64766463u, 0x006E616Du});
+            for (uint32_t i = 0u; i <= 114u; ++i) p.image.words(0x1814u + 4u * i, {p.base + 0x900u});
+            p.constant(4u, p.base + 0x1800u); p.call(p.stub(0x1500u));
+        }
+        else
+        {
+            p.constant(28u, 0x12345678u); p.constant(4u, p.base + 0x800u); p.call(p.stub(0x1000u, 1u));
+            p.constant(4u, 2u); p.constant(5u, 0u); p.call(p.stub(0x1000u, 2u));
+        }
+        p.constant(28u, 0x55667788u); p.constant(4u, 1u); p.constant(5u, 2u);
+        p.constant(6u, provided ? 0x1F402005u : 0x30000u); p.constant(7u, provided ? 0xFFFFFFFFu : p.data(0x20u));
+        p.call(p.stub(0x1000u)); p.store(2u, p.data(0x40u)); p.store(28u, p.data(0x44u)); p.finish();
+        p.recordingHandler(0x800u, 0u);
+        p.begin(0x900u); p.constant(8u, 0xABCDEF01u); p.store(8u, p.data()); p.finish(0x5A3u);
+        return p;
+    }
+
+    void authoredMipsReadAndProviderPrecedence()
+    {
+        DiscHost host; IopEmulator iop(host); const auto p = readProgram();
+        std::vector<uint8_t> canary(4096u, 0xCCu);
+        require(iop.writeMemory(0x30000u, canary.data(), canary.size()), "authored MIPS buffer setup failed");
+        iop_vblank_test::start(iop, p); iop_vblank_test::advance(iop, 5000u);
+        std::vector<uint8_t> bytes(4096u);
+        require(iop.readMemory(0x30000u, bytes.data(), bytes.size()) &&
+                    std::equal(bytes.begin(), bytes.end(), host.image.begin() + 2048u) &&
+                    iop_vblank_test::word(iop, p.data(0x40u)) == 1u &&
+                    iop_vblank_test::word(iop, p.data(0x44u)) == 0x55667788u &&
+                    iop_vblank_test::word(iop, p.data()) == 1u &&
+                    iop_vblank_test::word(iop, p.data(0x100u)) == 1u &&
+                    iop_vblank_test::word(iop, p.data(0x104u)) == 0x12345678u &&
+                    iop_vblank_test::word(iop, p.data(0x108u)) == 1u && host.eeAccesses == 0u,
+                "real import/callback did not preserve payload, GP, IRQ context or original continuation");
+        for (const auto [provided, requested] : {std::pair<uint16_t, uint16_t>{0x0101u, 0x0101u},
+                                                {0x0106u, 0x0101u}, {0x0201u, 0x0201u}})
+        {
+            DiscHost providerHost; IopEmulator provider(providerHost); const auto program = readProgram(requested, provided);
+            iop_vblank_test::start(provider, program);
+            require(iop_vblank_test::word(provider, program.data()) == 0xABCDEF01u &&
+                        iop_vblank_test::word(provider, program.data(0x40u)) == 0x5A3u && providerHost.reads == 0u,
+                    "modeled read prevalidated pointers or shadowed a compatible original export");
+        }
+        DiscHost missingHost; IopEmulator missing(missingHost); const auto unsupported = readProgram(0x0201u, 0x0101u);
+        iop_vblank_test::rejects([&] { iop_vblank_test::start(missing, unsupported); }, "missing import cdvdman:114");
+    }
+
+    void authoredResetAndCallbackFailureStayStrict()
+    {
+        DiscHost resetHost; IopEmulator reset(resetHost); const auto program = readProgram();
+        const std::vector<uint8_t> canary(4096u, 0xCCu);
+        require(reset.writeMemory(0x30000u, canary.data(), canary.size()), "reset buffer setup failed");
+        iop_vblank_test::start(reset, program);
+        require(resetHost.reads == 0u, "authored reset control did not stop before the read deadline");
+        reset.reset(); iop_vblank_test::advance(reset, 10000u);
+        require(resetHost.reads == 0u, "full IOP reset retained a deferred original read");
+
+        DiscHost host; IopEmulator iop(host); auto fault = readProgram();
+        fault.begin(0x800u); fault.call(fault.stub(0x1400u));
+        fault.constant(8u, 1u); fault.store(8u, fault.data()); fault.finish();
+        require(iop.writeMemory(0x30000u, canary.data(), canary.size()), "fault buffer setup failed");
+        iop_vblank_test::start(iop, fault);
+        iop_vblank_test::rejects([&] { iop_vblank_test::advance(iop, 10000u); }, "missing import absent:42");
+        const auto instructions = iop.instructions(); iop.runEeCycles(80000u);
+        iop_vblank_test::rejects([&] { iop.checkExecutionFailure(); }, "missing import absent:42");
+        require(host.reads == 1u && iop.instructions() == instructions && iop_vblank_test::word(iop, fault.data()) == 0u,
+                "stream callback fault was swallowed or repeated its completed read");
+    }
