diff --git a/ps2xTest/src/ps2_sif_packet_tests.cpp b/ps2xTest/src/ps2_sif_packet_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f6b5c86a79c84eaefbb60ed4156a61b9cf00d2a7
--- /dev/null
+++ b/ps2xTest/src/ps2_sif_packet_tests.cpp
@@ -0,0 +1,606 @@
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_iop_transport.h"
+#include "ps2_runtime_macros.h"
+#include "Kernel/Stubs/SIF.h"
+#include "runtime/ee_scheduler.h"
+#include "iop_strict_fixtures.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kMain = 0x00110000u, kHandler = 0x00110010u;
+    constexpr uint32_t kDescriptors = 0x00020000u, kSource = 0x00020100u;
+    constexpr uint32_t kReceive = 0x00022000u, kSregs = 0x00023000u;
+    constexpr uint32_t kClient = 0x00024000u, kRequest = 0x00025000u, kResult = 0x00026000u;
+    std::vector<uint32_t> receivedValues;
+    std::vector<uint32_t> receivedRpcResults;
+
+    void put(std::vector<uint8_t> &bytes, size_t offset, uint32_t value)
+    {
+        for (size_t i = 0; i < 4u; ++i)
+            bytes.at(offset + i) = static_cast<uint8_t>(value >> (8u * i));
+    }
+
+    uint32_t word(const uint8_t *bytes, size_t offset)
+    {
+        return uint32_t(bytes[offset]) | (uint32_t(bytes[offset + 1]) << 8u) |
+               (uint32_t(bytes[offset + 2]) << 16u) | (uint32_t(bytes[offset + 3]) << 24u);
+    }
+
+    uint32_t word(const std::vector<uint8_t> &bytes, size_t offset)
+    {
+        if (offset > bytes.size() || bytes.size() - offset < 4u)
+            throw std::runtime_error("synthetic test received a truncated reply word");
+        return word(bytes.data(), offset);
+    }
+
+    std::vector<uint8_t> packet(uint32_t command, uint32_t size = 64u, uint32_t option = 0u)
+    {
+        std::vector<uint8_t> bytes(size, 0u);
+        put(bytes, 0u, size);
+        put(bytes, 8u, command);
+        put(bytes, 12u, option);
+        if (size >= 64u)
+        {
+            put(bytes, 16u, 0x00010005u);
+            put(bytes, 20u, kRequest);
+            put(bytes, 24u, 0x1234u);
+            put(bytes, 28u, kClient);
+        }
+        return bytes;
+    }
+
+    void mainStop(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void guestCommandHandler(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        // Model the original guest handler's observable ordering: copy packet,
+        // clear receive slot, rearm SIF0, then dispatch SET_SREG in guest code.
+        std::array<uint8_t, 112> local{};
+        const uint32_t size = rdram[kReceive];
+        if (size < 16u || size > local.size())
+            throw std::runtime_error("synthetic guest handler received malformed packet");
+        std::memcpy(local.data(), rdram + kReceive, size);
+        rdram[kReceive] = 0u;
+        ps2_stubs::sceSifSetDChain(rdram, ctx, runtime);
+        if (word(local.data(), 8u) == 0x80000001u)
+        {
+            const uint32_t index = word(local.data(), 16u);
+            const uint32_t value = word(local.data(), 20u);
+            std::memcpy(rdram + kSregs + index * 4u, &value, sizeof(value));
+            receivedValues.push_back(value);
+        }
+        else if (word(local.data(), 8u) == 0x80000008u)
+        {
+            const uint32_t client = word(local.data(), 28u);
+            if (word(local.data(), 32u) == 0x8000000Au)
+            {
+                // A guest END callback observes DMA result bytes before its
+                // completion semaphore is signaled, as in the original SDK.
+                receivedRpcResults.push_back(word(rdram, word(local.data(), 4u)));
+                const int32_t semaphore = static_cast<int32_t>(word(rdram, client + 8u));
+                if (semaphore >= 0)
+                    (void)runtime->eeScheduler().signalSemaphore(semaphore, true);
+                const uint32_t zero = 0u;
+                std::memcpy(rdram + client, &zero, sizeof(zero));
+            }
+        }
+        ctx->pc = 0u;
+    }
+
+    struct PacketEnv
+    {
+        PS2Runtime runtime;
+        std::vector<uint8_t> rdram = std::vector<uint8_t>(PS2_RAM_SIZE, 0u);
+        R5900Context context{};
+        uint32_t endpoint = 0u;
+
+        PacketEnv()
+        {
+            ps2_stubs::resetSifState();
+            receivedValues.clear();
+            receivedRpcResults.clear();
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(kMain, mainStop);
+            runtime.registerFunction(kHandler, guestCommandHandler);
+            context.pc = kMain;
+            runtime.eeScheduler().bindMainContextForSyscall(context, rdram.data());
+            endpoint = iop().getSifRegister(2u);
+            (void)iop().setSifRegister(0x80000000u, endpoint);
+            (void)iop().setSifRegister(0x80000001u, 0x00021000u);
+        }
+
+        ps2x::iop::IopSubsystem &iop() { return *PS2IopTransport::subsystem(&runtime); }
+
+        void installHandler(bool enabled = true)
+        {
+            runtime.eeScheduler().addIrqHandler(true, 5u, kHandler, true, 0u, 0u, 0u);
+            runtime.eeScheduler().setIrqCauseEnabled(true, 5u, enabled);
+        }
+
+        void arm() { ps2_stubs::sceSifSetDChain(rdram.data(), &context, &runtime); }
+
+        void submit(const std::vector<uint8_t> &bytes)
+        {
+            std::memcpy(rdram.data() + kSource, bytes.data(), bytes.size());
+            const std::array<uint32_t, 4> descriptor{kSource, endpoint, static_cast<uint32_t>(bytes.size()), 0x44u};
+            std::memcpy(rdram.data() + kDescriptors, descriptor.data(), sizeof(descriptor));
+            SET_GPR_U32(&context, 4, kDescriptors);
+            SET_GPR_U32(&context, 5, 1u);
+            ps2_stubs::sceSifSetDma(rdram.data(), &context, &runtime);
+        }
+
+        void init()
+        {
+            auto init = packet(0x80000002u, 20u);
+            put(init, 16u, kReceive);
+            submit(init);
+        }
+
+        uint32_t bindService(uint32_t sid)
+        {
+            init();
+            iop().consumeSifReply(); // This unit inspects framing independently of the IRQ integration test.
+            submit(packet(0x80000002u, 16u, 1u));
+            auto bind = packet(0x80000009u);
+            put(bind, 32u, sid);
+            submit(bind);
+            ps2x::iop::SifEeReply reply;
+            if (!iop().peekSifReply(reply))
+                throw std::runtime_error("synthetic BIND produced no reply");
+            const uint32_t server = word(reply.packet, 36u);
+            const uint32_t buffer = word(reply.packet, 40u);
+            std::memcpy(rdram.data() + kClient + 20u, &buffer, sizeof(buffer));
+            iop().consumeSifReply();
+            return server;
+        }
+
+        uint32_t bindHeap() { return bindService(0x80000003u); }
+
+        void submitRpc(uint32_t server, uint32_t function, const std::vector<uint8_t> &input,
+                       uint32_t receiveSize, uint32_t replyMode = 1u)
+        {
+            const uint32_t buffer = word(rdram.data(), kClient + 20u);
+            auto call = packet(0x8000000Au);
+            put(call, 0u, 64u | (static_cast<uint32_t>(input.size()) << 8u));
+            put(call, 4u, buffer);
+            put(call, 32u, function);
+            put(call, 36u, static_cast<uint32_t>(input.size()));
+            put(call, 40u, kResult);
+            put(call, 44u, receiveSize);
+            put(call, 48u, replyMode);
+            put(call, 52u, server);
+            std::memcpy(rdram.data() + kSource, call.data(), call.size());
+            std::copy(input.begin(), input.end(), rdram.begin() + kSource + 128u);
+            const std::array<uint32_t, 8> descriptors{
+                kSource + 128u, buffer, static_cast<uint32_t>(input.size()), 0u,
+                kSource, endpoint, 64u, 0x44u};
+            std::memcpy(rdram.data() + kDescriptors, descriptors.data(), sizeof(descriptors));
+            SET_GPR_U32(&context, 4, kDescriptors);
+            SET_GPR_U32(&context, 5, 2u);
+            ps2_stubs::sceSifSetDma(rdram.data(), &context, &runtime);
+        }
+
+        bool fails(const std::vector<uint8_t> &bytes)
+        {
+            try { submit(bytes); }
+            catch (const std::runtime_error &) { return true; }
+            return false;
+        }
+    };
+}
+
+void register_ps2_sif_packet_tests()
+{
+    MiniTest::Case("PS2SifPackets", [](TestCase &tc)
+    {
+        tc.Run("negotiated INIT readiness reaches EE only through its guest DMAC handler", [](TestCase &t)
+        {
+            PacketEnv env;
+            t.IsTrue(env.endpoint != 0u && env.runtime.isIopMemoryRange(env.endpoint, 128u),
+                     "advertised IOP endpoint must be a real allocated memory range");
+            env.init();
+            t.Equals(word(env.rdram.data(), kSregs), 0u, "INIT must not patch guest SREG memory");
+            env.installHandler(false);
+            env.arm();
+            t.IsTrue((env.runtime.memory().readIORegister(0x1000C000u) & 0x100u) != 0u,
+                     "guest CHCR poll must preserve the armed SIF0 receive chain");
+            t.Equals(env.rdram[kReceive], uint8_t{0}, "disabled DMAC handler retains queued reply");
+            env.runtime.eeScheduler().setIrqCauseEnabled(true, 5u, true);
+            ps2_stubs::pumpSifCommands(env.rdram.data(), &env.runtime);
+            t.Equals(env.rdram[kReceive], uint8_t{24}, "armed SIF0 must receive a real SET_SREG packet");
+            t.Equals(word(env.rdram.data(), kSregs), 0u, "DMA completion alone must not mutate guest SREG");
+            env.runtime.eeScheduler().run();
+            t.Equals(word(env.rdram.data(), kSregs), 1u, "guest handler must interpret SET_SREG and write readiness");
+            t.Equals(receivedValues.size(), size_t{1}, "exactly one guest interrupt delivery");
+        });
+
+        tc.Run("queued command replies respect guest buffer ownership and receive-chain rearming", [](TestCase &t)
+        {
+            PacketEnv env;
+            env.init();
+            auto next = packet(0x80000001u, 24u);
+            put(next, 16u, 1u);
+            put(next, 20u, 77u);
+            t.IsTrue(env.iop().queueSifCommand(0x80000001u, next.data(), next.size()), "queue second real reply");
+            env.arm();
+            t.Equals(env.rdram[kReceive], uint8_t{0}, "unregistered DMAC handler retains both packets");
+            env.installHandler();
+            ps2_stubs::pumpSifCommands(env.rdram.data(), &env.runtime);
+            t.Equals(word(env.rdram.data(), kReceive + 20u), 1u, "first packet occupies receive buffer");
+            ps2_stubs::pumpSifCommands(env.rdram.data(), &env.runtime);
+            t.Equals(word(env.rdram.data(), kReceive + 20u), 1u, "second reply cannot overwrite an unconsumed packet");
+            env.runtime.eeScheduler().run();
+            t.IsTrue(receivedValues == std::vector<uint32_t>({1u, 77u}), "original handler ordering must be retained");
+            t.Equals(word(env.rdram.data(), kSregs + 4u), 77u, "second guest dispatch consumes the second packet");
+        });
+
+        tc.Run("RPC BIND echoes identities and exposes an allocated bootstrap buffer", [](TestCase &t)
+        {
+            PacketEnv env;
+            env.init();
+            env.iop().consumeSifReply();
+            env.submit(packet(0x80000002u, 16u, 1u));
+            auto bind = packet(0x80000009u);
+            put(bind, 32u, 0x80000003u);
+            env.submit(bind);
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(env.iop().peekSifReply(reply), "BIND must produce RPC_END");
+            t.Equals(word(reply.packet, 8u), 0x80000008u, "reply command is RPC_END");
+            for (size_t offset : {16u, 20u, 24u, 28u})
+                t.Equals(word(reply.packet, offset), word(bind.data(), offset), "request identity is echoed exactly");
+            t.Equals(word(reply.packet, 32u), 0x80000009u, "END identifies original BIND command");
+            t.IsTrue(word(reply.packet, 36u) != 0u && word(reply.packet, 40u) != 0u &&
+                         word(reply.packet, 36u) != word(reply.packet, 40u) &&
+                         env.runtime.isIopMemoryRange(word(reply.packet, 36u), 64u) &&
+                         env.runtime.isIopMemoryRange(word(reply.packet, 40u), 4096u),
+                     "server descriptor and input buffer refer to real distinct IOP allocations");
+        });
+
+        tc.Run("rmode zero copies the real heap result then completes the original request without END", [](TestCase &t)
+        {
+            PacketEnv env;
+            const uint32_t server = env.bindHeap();
+            const uint32_t buffer = word(env.rdram.data(), kClient + 20u);
+            const uint32_t requestedSize = 128u;
+            t.IsTrue(env.runtime.writeIopMemory(buffer, &requestedSize, sizeof(requestedSize)), "prepare real heap request");
+            auto call = packet(0x8000000Au);
+            put(call, 32u, 1u);
+            put(call, 36u, 4u);
+            put(call, 40u, kResult);
+            put(call, 44u, 4u);
+            put(call, 48u, 0u);
+            put(call, 52u, server);
+            std::memset(env.rdram.data() + kRequest, 0xA5, 64u);
+            env.submit(call);
+            t.Equals(word(env.rdram.data(), kRequest + 24u), 0xA5A5A5A5u, "unarmed receive DMA retains completion");
+            env.arm();
+            const uint32_t allocation = word(env.rdram.data(), kResult);
+            t.IsTrue(allocation != 0u && env.runtime.isIopMemoryRange(allocation, requestedSize), "heap reply is an actual allocated IOP range");
+            t.Equals(word(env.rdram.data(), kRequest + 16u), 0u, "direct completion clears rec_id");
+            t.Equals(word(env.rdram.data(), kRequest + 24u), 0u, "direct completion clears rpc_id");
+            t.IsTrue(receivedValues.empty() && env.rdram[kReceive] == 0u, "rmode zero must not synthesize an END interrupt");
+            t.IsTrue(env.runtime.freeIopMemory(allocation), "reported allocation must be owned by real IOP allocator");
+        });
+
+        tc.Run("RPC result DMA precedes the guest END callback and semaphore completion", [](TestCase &t)
+        {
+            PacketEnv env;
+            const uint32_t server = env.bindHeap();
+            const uint32_t buffer = word(env.rdram.data(), kClient + 20u);
+            const uint32_t requestedSize = 128u;
+            t.IsTrue(env.runtime.writeIopMemory(buffer, &requestedSize, sizeof(requestedSize)), "prepare heap CALL");
+            const int semaphore = env.runtime.eeScheduler().createSemaphore(0, 1, 0u, 0u);
+            std::memcpy(env.rdram.data() + kClient + 8u, &semaphore, sizeof(semaphore));
+            auto call = packet(0x8000000Au);
+            put(call, 32u, 1u);
+            put(call, 36u, 4u);
+            put(call, 40u, kResult);
+            put(call, 44u, 4u);
+            put(call, 48u, 1u);
+            put(call, 52u, server);
+            env.submit(call);
+            env.installHandler();
+            env.arm();
+            const uint32_t allocation = word(env.rdram.data(), kResult);
+            t.IsTrue(allocation != 0u && receivedRpcResults.empty(), "result bytes arrive before guest interrupt execution");
+            t.IsTrue(env.runtime.eeScheduler().pollSemaphore(semaphore) < 0, "DMA alone cannot complete the guest semaphore");
+            env.runtime.eeScheduler().run();
+            t.IsTrue(receivedRpcResults == std::vector<uint32_t>{allocation}, "guest END callback sees exact service output");
+            t.Equals(env.runtime.eeScheduler().pollSemaphore(semaphore), semaphore, "guest END handler signals completion");
+            t.IsTrue(env.runtime.freeIopMemory(allocation), "completed result remains a real allocator-owned block");
+        });
+
+        tc.Run("malformed INIT and RPC ranges fail before readiness or allocator mutation", [](TestCase &t)
+        {
+            PacketEnv env;
+            t.IsTrue(env.fails(packet(0x80000002u, 16u, 1u)), "option 1 before option 0 is invalid");
+            auto init = packet(0x80000002u, 20u);
+            put(init, 16u, 0x21FFFFC0u);
+            t.IsTrue(env.fails(init), "uncached receive range cannot wrap beyond physical RAM");
+            const uint32_t server = env.bindHeap();
+            const uint32_t buffer = word(env.rdram.data(), kClient + 20u);
+            const uint32_t allocation = env.runtime.allocateIopMemory(128u, 16u);
+            t.IsTrue(env.runtime.writeIopMemory(buffer, &allocation, sizeof(allocation)), "prepare real free request");
+            auto call = packet(0x8000000Au);
+            put(call, 32u, 2u);
+            put(call, 36u, 4u);
+            put(call, 40u, 0x81FFFFFEu);
+            put(call, 44u, 4u);
+            put(call, 48u, 1u);
+            put(call, 52u, server);
+            t.IsTrue(env.fails(call), "cross-boundary result storage must fail during packet preflight");
+            t.IsTrue(env.runtime.freeIopMemory(allocation), "rejected CALL must not execute the free service");
+            t.Equals(word(env.rdram.data(), kSregs), 0u, "invalid messages cannot create readiness");
+        });
+
+        tc.Run("RDATA validates its exact receive descriptor and copies real IOP bytes", [](TestCase &t)
+        {
+            PacketEnv env;
+            (void)env.bindHeap();
+            const uint32_t source = env.runtime.allocateIopMemory(4u, 16u);
+            const uint32_t value = 0xDEADBEEFu;
+            t.IsTrue(env.runtime.writeIopMemory(source, &value, sizeof(value)), "prepare RDATA source");
+            auto request = packet(0x8000000Cu);
+            put(request, 28u, PS2_RAM_SIZE - 28u);
+            put(request, 32u, source);
+            put(request, 36u, kResult);
+            put(request, 40u, 4u);
+            env.submit(request);
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(env.iop().peekSifReply(reply) && reply.data.size() == 4u &&
+                         word(reply.data, 0u) == value,
+                     "28-byte RDATA descriptor ending at RAM boundary is valid");
+            env.iop().consumeSifReply();
+            put(request, 28u, PS2_RAM_SIZE - 27u);
+            t.IsTrue(env.fails(request), "RDATA descriptor must not cross the physical RAM boundary");
+        });
+
+        tc.Run("modeled endpoint framing is validated even under compatibility policy", [](TestCase &t)
+        {
+            PacketEnv env;
+            env.runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::ContinueToTarget);
+            auto malformed = packet(0x80000002u, 16u);
+            put(malformed, 0u, 64u);
+            t.IsTrue(env.fails(malformed), "advertised packet size cannot exceed copied bytes in any policy");
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(!env.iop().peekSifReply(reply), "malformed compatibility packet creates no reply");
+        });
+
+        tc.Run("provider payload preflight rejects malformed requests before the preceding DMA commits", [](TestCase &t)
+        {
+            PacketEnv env;
+            const uint32_t server = env.bindService(0x80000006u);
+            const uint32_t buffer = word(env.rdram.data(), kClient + 20u);
+            std::array<uint8_t, 512u> sentinel{};
+            sentinel.fill(0xA5u);
+            t.IsTrue(env.runtime.writeIopMemory(buffer, sentinel.data(), sentinel.size()), "prepare provider input sentinel");
+            std::vector<uint8_t> malformed(512u, 0u);
+            std::fill(malformed.begin() + 8u, malformed.begin() + 260u, uint8_t{'x'});
+            bool failed = false;
+            try { env.submitRpc(server, 0u, malformed, 8u); }
+            catch (const std::runtime_error &) { failed = true; }
+            t.IsTrue(failed, "unterminated loadfile path must fail preflight");
+            std::array<uint8_t, 512u> readback{};
+            t.IsTrue(env.runtime.readIopMemory(buffer, readback.data(), readback.size()) && readback == sentinel,
+                     "invalid provider payload cannot partially copy into its server buffer");
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(!env.iop().peekSifReply(reply), "invalid provider request must create no completion");
+        });
+
+        tc.Run("staged RPC input executes real heap allocation and rejects undersized output before mutation", [](TestCase &t)
+        {
+            PacketEnv env;
+            const uint32_t server = env.bindHeap();
+            const uint32_t buffer = word(env.rdram.data(), kClient + 20u);
+            const uint32_t sentinel = 0xAABBCCDDu;
+            t.IsTrue(env.runtime.writeIopMemory(buffer, &sentinel, sizeof(sentinel)), "prepare input sentinel");
+            std::vector<uint8_t> input(4u);
+            put(input, 0u, 128u);
+            bool failed = false;
+            try { env.submitRpc(server, 1u, input, 0u); }
+            catch (const std::runtime_error &) { failed = true; }
+            t.IsTrue(failed, "short result range must fail before a heap request executes");
+            uint32_t readback = 0u;
+            t.IsTrue(env.runtime.readIopMemory(buffer, &readback, sizeof(readback)) && readback == sentinel,
+                     "undersized output must not commit preceding input DMA");
+            env.submitRpc(server, 1u, input, 4u);
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(env.iop().peekSifReply(reply) && reply.data.size() == 4u &&
+                         env.runtime.freeIopMemory(word(reply.data, 0u)),
+                     "validated staged payload produces an actual allocator-owned block");
+            env.iop().consumeSifReply();
+            put(input, 0u, 0xFFFFFFFFu);
+            env.submitRpc(server, 1u, input, 4u);
+            t.IsTrue(env.iop().peekSifReply(reply) && word(reply.data, 0u) == 0u,
+                     "oversized signed heap request cannot wrap into a successful zero-sized allocation");
+        });
+
+        tc.Run("CDVD readiness depends on initialization and real mounted media", [](TestCase &t)
+        {
+            struct PathsGuard
+            {
+                PS2Runtime::IoPaths saved = PS2Runtime::getIoPaths();
+                std::filesystem::path directory;
+                ~PathsGuard()
+                {
+                    PS2Runtime::setIoPaths(saved);
+                    std::error_code error;
+                    if (!directory.empty()) std::filesystem::remove_all(directory, error);
+                }
+            } guard;
+            PS2Runtime::setIoPaths({});
+            {
+                PacketEnv env;
+                t.Equals(env.iop().callCdvdImport(13u, 0u), 6u, "uninitialized drive is not ready");
+                const uint32_t server = env.bindService(0x80000592u);
+                std::vector<uint8_t> mode(4u, 0u);
+                env.submitRpc(server, 0u, mode, 16u);
+                ps2x::iop::SifEeReply reply;
+                t.IsTrue(env.iop().peekSifReply(reply) && word(reply.data, 0u) == 1u,
+                         "init RPC initializes the same owned CDVD model");
+                t.Equals(env.iop().callCdvdImport(13u, 0u), 6u, "initialization cannot fabricate mounted media");
+            }
+            const auto suffix = std::chrono::steady_clock::now().time_since_epoch().count();
+            guard.directory = std::filesystem::temp_directory_path() / ("ps2-sif-media-" + std::to_string(suffix));
+            if (!std::filesystem::create_directory(guard.directory))
+                throw std::runtime_error("cannot create unique synthetic media fixture");
+            std::ofstream(guard.directory / "TEST.BIN", std::ios::binary).write("fixture", 7);
+            PS2Runtime::IoPaths paths{};
+            paths.cdRoot = guard.directory.string();
+            PS2Runtime::setIoPaths(paths);
+            PacketEnv env;
+            (void)env.iop().callCdvdImport(4u, 0u);
+            t.Equals(env.iop().callCdvdImport(13u, 0u), 2u, "a readable mounted volume can become ready");
+            (void)env.iop().callCdvdImport(4u, 5u);
+            t.Equals(env.iop().callCdvdImport(13u, 0u), 6u, "deinitialization clears drive readiness");
+        });
+
+        tc.Run("nonresident strict modules do not activate an alias-backed service", [](TestCase &t)
+        {
+            for (const uint32_t disposition : {0u, 1u, 2u, 3u})
+            {
+                PacketEnv env;
+                iop_test::Irx image;
+                image.words(0u, {0x03E00008u, 0x24020000u | disposition});
+                const auto loaded = env.iop().loadModuleImage("mcserv.irx", image.bytes, nullptr, 0u);
+                const bool resident = disposition == 0u || disposition == 2u;
+                t.Equals(env.iop().canBindRpc(0x80000400u), resident,
+                         "service routing must follow the original entry's resident disposition");
+                t.Equals(env.iop().debugSnapshot().emulatorLoadedModules, resident ? size_t{1u} : size_t{0u},
+                         "service routing and actual loaded-module state must agree");
+                if (resident)
+                    t.IsTrue(env.iop().stopModule(loaded.moduleId) && !env.iop().canBindRpc(0x80000400u),
+                             "stopping the resident module removes its alias route");
+            }
+        });
+
+        tc.Run("idle SIF polling propagates a strict IOP background-thread failure", [](TestCase &t)
+        {
+            PacketEnv env;
+            const auto image = iop_test::backgroundMissingImport();
+            const auto loaded = env.iop().loadModuleImage("thread", image.bytes, nullptr, 0u);
+            t.IsTrue(loaded.moduleId > 0, "actual synthetic entry must create its guest thread and return");
+            env.iop().runEeCycles(4096u);
