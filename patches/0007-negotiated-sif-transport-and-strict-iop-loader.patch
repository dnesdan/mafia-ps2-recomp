diff --git a/ps2xIOP/tests/iop_strict_loader_tests.cpp b/ps2xIOP/tests/iop_strict_loader_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e782bea46e16d33a047f12b31d27cd10adbe3708
--- /dev/null
+++ b/ps2xIOP/tests/iop_strict_loader_tests.cpp
@@ -0,0 +1,465 @@
+#include "iop_strict_fixtures.h"
+#include "emulator/iop_emulator.h"
+
+#include <functional>
+
+namespace
+{
+    using namespace iop_test;
+    using ps2x::iop::detail::IopEmulator;
+
+    void put16(std::vector<uint8_t> &bytes, size_t at, uint16_t value)
+    {
+        require(at <= bytes.size() && 2u <= bytes.size() - at, "fixture write out of bounds");
+        bytes[at] = static_cast<uint8_t>(value);
+        bytes[at + 1u] = static_cast<uint8_t>(value >> 8u);
+    }
+
+    void put32(std::vector<uint8_t> &bytes, size_t at, uint32_t value)
+    {
+        put16(bytes, at, static_cast<uint16_t>(value));
+        put16(bytes, at + 2u, static_cast<uint16_t>(value >> 16u));
+    }
+
+    uint32_t word(IopEmulator &iop, uint32_t address)
+    {
+        std::array<uint8_t, 4> bytes{};
+        require(iop.readMemory(address, bytes.data(), bytes.size()), "IOP snapshot read failed");
+        return uint32_t(bytes[0]) | (uint32_t(bytes[1]) << 8u) |
+               (uint32_t(bytes[2]) << 16u) | (uint32_t(bytes[3]) << 24u);
+    }
+
+    std::string rejects(const std::function<void()> &operation, std::string_view text)
+    {
+        try { operation(); }
+        catch (const std::runtime_error &error)
+        {
+            require(std::string_view(error.what()).find(text) != std::string_view::npos,
+                    "failure did not identify the concrete cause");
+            return error.what();
+        }
+        throw std::runtime_error("operation unexpectedly succeeded");
+    }
+
+    Irx returns(uint16_t result = 0u)
+    {
+        Irx image;
+        image.words(0u, {0x03E00008u, 0x24020000u | result});
+        return image;
+    }
+
+    constexpr uint32_t jal(uint32_t target) { return 0x0C000000u | (target >> 2u); }
+
+    void emit(Irx &image, uint32_t &offset, uint32_t instruction)
+    {
+        image.words(offset, {instruction});
+        offset += 4u;
+    }
+
+    Irx snapshotArguments(std::span<const std::string> expected)
+    {
+        Irx image(0u, 0x1000u);
+        put16(image.bytes, 16u, 0xFF80u);
+        put32(image.bytes, 68u, 0xD00u);
+        put16(image.bytes, 44u, 2u);
+        put32(image.bytes, 84u, 0x70000080u);
+        put32(image.bytes, 88u, 0x80u);
+        put32(image.bytes, 100u, 34u);
+        put32(image.bytes, 0x84u, 0u); // entry relative to loaded image
+        put32(image.bytes, 0x88u, 0x2000u); // GP need not point inside text
+        put32(image.bytes, 0x8Cu, 0x500u);
+        put32(image.bytes, 0x90u, 0x800u);
+        put32(image.bytes, 0x94u, 0x300u);
+        put16(image.bytes, 0x98u, 0x0207u);
+        constexpr char name[] = "fixture";
+        std::copy(std::begin(name), std::end(name), image.bytes.begin() + 0x9Au);
+
+        // Capture arguments and descriptor while they are valid, using only
+        // ordinary guest loads/stores. No host-side parser synthesizes results.
+        uint32_t pc = 0u;
+        emit(image, pc, 0x3C080001u); // t0 = durable snapshot 0x10C00
+        emit(image, pc, 0x35080C00u);
+        for (uint32_t reg = 4u; reg <= 7u; ++reg)
+            emit(image, pc, 0xAD000000u | (reg << 16u) | ((reg - 4u) * 4u));
+        emit(image, pc, 0xAD1C0010u); // gp
+        for (uint32_t index = 0u; index <= expected.size(); ++index)
+        {
+            emit(image, pc, 0x8CA90000u | (index * 4u)); // t1 = argv[index]
+            emit(image, pc, 0u); // R3000A load delay
+            emit(image, pc, 0xAD090020u | (index * 4u));
+            if (index == expected.size())
+                continue;
+            for (uint32_t byte = 0u; byte <= expected[index].size(); ++byte)
+            {
+                emit(image, pc, 0x912A0000u | byte); // lbu t2, byte(t1)
+                emit(image, pc, 0u);
+                emit(image, pc, 0xA10A0000u | (0x40u + index * 0x40u + byte));
+            }
+        }
+        for (uint32_t offset = 0u; offset < 48u; offset += 4u)
+        {
+            emit(image, pc, 0x8CE90000u | offset);
+            emit(image, pc, 0u);
+            emit(image, pc, 0xAD090200u | offset);
+        }
+        emit(image, pc, 0x03E00008u);
+        emit(image, pc, 0x24020000u);
+        require(pc < 0xC00u, "snapshot code overwrote its results");
+        return image;
+    }
+
+    void realArgumentAbi()
+    {
+        Host host;
+        IopEmulator iop(host);
+        const std::array<std::string, 4> expected{"cdrom0:\\TEST.IRX;1", "alpha beta", "", "z"};
+        const std::array<char, 14> packed{'a','l','p','h','a',' ','b','e','t','a','\0','\0','z','\0'};
+        const Irx image = snapshotArguments(expected);
+        const auto result = iop.loadModuleImage(expected[0], image.bytes, packed.data(), packed.size());
+        require(result.moduleId > 0 && result.startResult == 0 && iop.loadedModuleCount() == 1u,
+                "valid original entry was not accepted");
+        constexpr uint32_t snapshot = 0x10C00u;
+        require(word(iop, snapshot) == expected.size(), "argc is not the number of strings plus argv[0]");
+        require(word(iop, snapshot + 8u) == 0u && word(iop, snapshot + 12u) != 0u,
+                "normal IRX a2/a3 ABI is wrong");
+        require(word(iop, snapshot + 16u) == 0x12000u, "actual relocated GP was not passed");
+        require(word(iop, snapshot + 0x20u + 4u * expected.size()) == 0u, "argv lacks its null pointer");
+        for (size_t index = 0u; index < expected.size(); ++index)
+        {
+            std::vector<char> captured(expected[index].size() + 1u);
+            require(iop.readMemory(snapshot + 0x40u + static_cast<uint32_t>(index) * 0x40u,
+                                   captured.data(), captured.size()), "argument snapshot read failed");
+            require(std::string(captured.data()) == expected[index] && captured.back() == '\0',
+                    "argv changed spaces, empty strings, path syntax or terminators");
+        }
+        require(word(iop, snapshot + 0x208u) == 0x00020207u, "ModuleInfo version/start flags are wrong");
+        require((word(iop, snapshot + 0x20Cu) & 0xFFFFu) == static_cast<uint32_t>(result.moduleId),
+                "ModuleInfo does not identify the real module");
+        require(word(iop, snapshot + 0x210u) == 0x10000u && word(iop, snapshot + 0x214u) == 0x12000u &&
+                word(iop, snapshot + 0x218u) == 0x10000u && word(iop, snapshot + 0x21Cu) == 0x500u &&
+                word(iop, snapshot + 0x220u) == 0x800u && word(iop, snapshot + 0x224u) == 0x300u,
+                "ModuleInfo text/data/bss/entry/GP do not come from the actual image");
+        iop.checkExecutionFailure();
+    }
+
+    void argumentPreflight()
+    {
+        Host host;
+        IopEmulator iop(host);
+        const Irx image = returns();
+        constexpr std::array<char, 2> unterminated{'a','b'};
+        rejects([&] { (void)iop.loadModuleImage("test", image.bytes, unterminated.data(), 2u); }, "NUL");
+        rejects([&] { (void)iop.loadModuleImage("test", image.bytes, nullptr, 1u); }, "argument buffer");
+        rejects([&] { (void)iop.loadModuleImage("", image.bytes, nullptr, 0u); }, "path");
+        rejects([&] { (void)iop.loadModuleImage(std::string(1025u, 'x'), image.bytes, nullptr, 0u); }, "path");
+        require(word(iop, 0x10000u) == 0u && iop.loadedModuleCount() == 0u,
+                "invalid argument preflight mutated module RAM");
+        require(iop.loadModuleImage("test", image.bytes, nullptr, 0u).moduleId > 0,
+                "preflight failure poisoned an unmodified runtime");
+    }
+
+    void nonReturningEntry()
+    {
+        Host host;
+        IopEmulator iop(host);
+        Irx image;
+        image.words(0u, {0x08004000u, 0u}); // j 0x10000 forever
+        const std::string cause = rejects([&] { (void)iop.loadModuleImage("loop", image.bytes, nullptr, 0u); }, "budget");
+        require(iop.instructions() >= 2'000'000u && iop.loadedModuleCount() == 0u,
+                "endless entry was falsely accepted");
+        require(rejects([&] { iop.checkExecutionFailure(); }, "budget") == cause,
+                "first execution failure was not preserved");
+        iop.runEeCycles(800u);
+        require(iop.loadedModuleCount() == 0u, "cycle scheduling cleared failed startup");
+        iop.reset();
+        image = returns();
+        require(iop.loadModuleImage("after-reset", image.bytes, nullptr, 0u).moduleId > 0,
+                "reset did not restore execution after a failed call");
+    }
+
+    Irx callsImport(std::string_view name, uint16_t ordinal)
+    {
+        require(name.size() <= 8u, "fixture import name too long");
+        Irx image;
+        image.words(0u, {0x27BDFFF0u, 0xAFBF000Cu, jal(0x10094u), 0u,
+                         0x8FBF000Cu, 0x27BD0010u, 0x03E00008u, 0x24020000u});
+        image.words(0x80u, {0x41E00000u, 0u, 0x0101u, 0u, 0u,
+                            0x03E00008u, 0x24000000u | ordinal, 0u, 0u});
+        std::copy(name.begin(), name.end(), image.bytes.begin() + 0x18Cu);
+        return image;
+    }
+
+    void missingImport()
+    {
+        for (std::string_view name : {"absent", "dmacman"})
+        {
+            Host host;
+            IopEmulator iop(host);
+            const Irx image = callsImport(name, 0x123u);
+            rejects([&] { (void)iop.loadModuleImage("missing", image.bytes, nullptr, 0u); },
+                    std::string("missing import ") + std::string(name) + ":291");
+            require(iop.loadedModuleCount() == 0u && iop.rpcServerCount() == 0u,
+                    "unimplemented import created a successful physical module");
+        }
+    }
+
+    void exceptionAndBadPc()
+    {
+        for (unsigned variant = 0u; variant < 3u; ++variant)
+        {
+            Host host;
+            IopEmulator iop(host);
+            Irx image;
+            if (variant == 0u)
+                image.words(0u, {0x0000000Cu}); // SYSCALL raises a real CPU exception
+            else
+                image.words(0u, {0x3C080000u | (variant == 1u ? 0x2000u : 0u),
+                                 0x35080001u, 0x01000008u, 0u});
+            rejects([&] { (void)iop.loadModuleImage("invalid-exec", image.bytes, nullptr, 0u); },
+                    variant == 0u ? "exception" : "instruction");
+            require(iop.loadedModuleCount() == 0u, "invalid original execution was reported as loaded");
+        }
+        Host host;
+        IopEmulator iop(host);
+        const Irx image = callsImport("thbase", 16u); // yield is not a startup return
+        rejects([&] { (void)iop.loadModuleImage("yield", image.bytes, nullptr, 0u); }, "yielded");
+    }
+
+    Irx relocationImage(uint32_t type)
+    {
+        Irx image;
+        image.words(0u, {0x03E00008u, 0x24020000u});
+        image.bytes.resize(0x680u, 0u);
+        put32(image.bytes, 32u, 0x600u);
+        put16(image.bytes, 46u, 40u);
+        put16(image.bytes, 48u, 3u);
+        put32(image.bytes, 0x62Cu, 1u); // section1 PROGBITS
+        put32(image.bytes, 0x630u, 6u);
+        put32(image.bytes, 0x634u, 0x10000u);
+        put32(image.bytes, 0x638u, 0x100u);
+        put32(image.bytes, 0x63Cu, 0x500u);
+        put32(image.bytes, 0x648u, 4u);
+        put32(image.bytes, 0x654u, 9u); // section2 REL
+        put32(image.bytes, 0x660u, 0x678u);
+        put32(image.bytes, 0x664u, 8u);
+        put32(image.bytes, 0x66Cu, 1u);
+        put32(image.bytes, 0x670u, 4u);
+        put32(image.bytes, 0x674u, 8u);
+        put32(image.bytes, 0x678u, 0x40u);
+        put32(image.bytes, 0x67Cu, type);
+        return image;
+    }
+
+    void relocationAndImagePreflight()
+    {
+        for (uint32_t type : {7u, 5u, 0x102u})
+        {
+            Host host;
+            IopEmulator iop(host);
+            const Irx image = relocationImage(type);
+            rejects([&] { (void)iop.loadModuleImage("bad-reloc", image.bytes, nullptr, 0u); }, "relocation");
+            require(word(iop, 0x10000u) == 0u && iop.loadedModuleCount() == 0u,
+                    "rejected relocation changed real RAM");
+        }
+        for (unsigned variant = 0u; variant < 5u; ++variant)
+        {
+            Host host;
+            IopEmulator iop(host);
+            Irx image = returns();
+            if (variant == 0u) put32(image.bytes, 68u, 0xFFFFFFF0u);
+            if (variant == 1u) put32(image.bytes, 60u, 0xFFFFFC00u);
+            if (variant == 2u) put32(image.bytes, 24u, 0x10500u);
+            if (variant == 3u) put32(image.bytes, 80u, 3u);
+            if (variant == 4u) put16(image.bytes, 42u, 31u);
+            rejects([&] { (void)iop.loadModuleImage("bad-elf", image.bytes, nullptr, 0u); }, "Strict IOP loader");
+            require(word(iop, 0x10000u) == 0u, "malformed ELF partially loaded");
+        }
+        Host host;
+        IopEmulator iop(host);
+        Irx good = relocationImage(2u);
+        put16(good.bytes, 16u, 0xFF80u);
+        put32(good.bytes, 24u, 0u);
+        put32(good.bytes, 60u, 0u);
+        put32(good.bytes, 0x634u, 0u);
+        put32(good.bytes, 0x140u, 0x80u);
+        require(iop.loadModuleImage("reloc", good.bytes, nullptr, 0u).moduleId > 0 &&
+                word(iop, 0x10040u) == 0x10080u, "supported relocation was not actually applied");
+    }
+
+    void fileAndIopSources()
+    {
+        for (uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            Host host;
+            IopEmulator iop(host);
+            const std::array<std::string, 1> expected{"LBbyEE"};
+            const Irx image = snapshotArguments(expected);
+            const uint32_t address = iop.allocateMemory(static_cast<uint32_t>(image.bytes.size()));
+            require(address != 0u && iop.writeMemory(address, image.bytes.data(), image.bytes.size()),
+                    "IOP fixture placement failed");
+            require(iop.loadModuleIopBuffer(address | alias, nullptr, 0u).moduleId > 0,
+                    "valid IOP RAM alias failed to load");
+            require(host.guestReads == 0u && host.guestWrites == 0u,
+                    "IOP-buffer load incorrectly used EE guest memory");
+            std::array<char, 7> captured{};
+            require(word(iop, 0x10C00u) == 1u &&
+                    iop.readMemory(0x10C40u, captured.data(), captured.size()) &&
+                    std::string(captured.data()) == "LBbyEE",
+                    "IOP-buffer argv[0] does not match LOADFILE's normal start ABI");
+        }
+        Host host;
+        IopEmulator iop(host);
+        const Irx image = returns();
+        rejects([&] { (void)iop.loadModuleIopBuffer(0x40001000u, nullptr, 0u); }, "IOP RAM");
+        require(iop.writeMemory(0x1FFFC0u, image.bytes.data(), 52u), "bounded ELF header placement failed");
+        rejects([&] { (void)iop.loadModuleIopBuffer(0xA01FFFC0u, nullptr, 0u); }, "header tables");
+        require(iop.loadModuleStrict("missing", nullptr, 0u).moduleId < 0,
+                "missing host file was successful");
+        host.file = image.bytes;
+        require(iop.loadModuleStrict("host:test", nullptr, 0u).moduleId > 0,
+                "strict host file path did not run original entry");
+    }
+
+    void overlapAndLegacyCompatibility()
+    {
+        Host host;
+        IopEmulator iop(host);
+        Irx image = returns();
+        require(iop.loadModuleImage("one", image.bytes, nullptr, 0u).moduleId > 0, "first image failed");
+        const uint32_t original = word(iop, 0x10000u);
+        image.words(0u, {0xFFFFFFFFu});
+        rejects([&] { (void)iop.loadModuleImage("two", image.bytes, nullptr, 0u); }, "overlaps");
+        require(word(iop, 0x10000u) == original && iop.loadedModuleCount() == 1u,
+                "overlap rejection overwrote the running module");
+        iop.checkExecutionFailure();
+
+        iop.reset();
+        image.words(0u, {0x03E00008u, 0x00801021u}); // returns a0
+        image.install(host);
+        constexpr std::array<char, 3> args{'x','y','\0'};
+        require(iop.loadModuleBuffer(0x1000u, args.data(), args.size()).startResult == 3,
+                "legacy direct EE-buffer argument API changed");
+        iop.reset();
+        require(iop.loadModuleImage("strict", image.bytes, args.data(), args.size()).startResult == 2,
+                "strict API still passed byte count as argc");
+    }
+
+    void callbackCompletion()
+    {
+        Host host;
+        IopEmulator iop(host);
+        constexpr uint32_t sid = 0x12345678u;
+        Irx image = rpcServer(sid, 0x76543210u);
+        image.words(0x300u, {0x0000000Cu}); // real callback fails only when invoked
+        require(iop.loadModuleImage("rpc", image.bytes, nullptr, 0u).moduleId > 0 && iop.hasRpcServer(sid),
+                "physical callback registration did not succeed");
+        const RpcRequest call = request(sid, 0u);
+        rejects([&] { (void)iop.handleRpc(call); }, "exception");
+        require(!iop.hasRpcServer(sid), "failed strict callback remained advertised");
+        rejects([&] { (void)iop.handleRpc(call); }, "exception");
+    }
+
+    void backgroundFailure()
+    {
+        Host host;
+        IopEmulator iop(host);
+        const Irx image = backgroundMissingImport();
+        require(iop.loadModuleImage("thread", image.bytes, nullptr, 0u).moduleId > 0 && iop.threadCount() == 1u,
+                "strict module did not start its actual guest thread");
+        iop.checkExecutionFailure();
+        iop.runEeCycles(4096u); // noexcept boundary must preserve the detailed error
+        rejects([&] { iop.checkExecutionFailure(); }, "missing import absent:42");
+        const uint64_t instructions = iop.instructions();
+        iop.runEeCycles(4096u);
+        require(iop.instructions() == instructions, "failed background execution kept running");
+        iop.reset();
+        iop.checkExecutionFailure();
+        require(iop.loadModuleImage("after-reset", returns().bytes, nullptr, 0u).moduleId > 0,
+                "background error survived reset or left invalid active CPU state");
+    }
+
+    void retiredCallbacks()
+    {
+        for (uint16_t disposition : std::array<uint16_t, 2>{0u, 1u})
+        {
+            Host host;
+            IopEmulator iop(host);
+            Irx image;
+            image.words(0u, {0x27BDFFE0u, 0xAFBF001Cu,
+                0x24040024u, 0x00002821u, 0x3C060001u, 0x34C60200u, 0x00003821u,
+                jal(0x10114u), 0u, 0x24040024u, jal(0x1011Cu), 0u,
+                0x3C081F80u, 0x350810C8u, 0x3C090100u, 0xAD090000u,
+                0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x24020000u | disposition});
+            image.words(0x100u, {0x41E00000u, 0u, 0x0101u, 0x72746E69u, 0x006E616Du,
+                0x03E00008u, 0x24000004u, 0x03E00008u, 0x24000006u, 0u, 0u});
+            image.words(0x200u, {0x3C080001u, 0x24090BADu, 0xAD090400u, 0x03E00008u, 0u});
+            const auto result = iop.loadModuleImage("irq-owner", image.bytes, nullptr, 0u);
+            require(result.moduleId > 0, "callback owner did not start");
+            if (disposition == 0u)
+                require(iop.stopModule(result.moduleId, nullptr), "resident owner did not unload");
+            require(iop.loadedModuleCount() == 0u, "retired owner is still loaded");
+            const Irx replacement = returns();
+            rejects([&] { (void)iop.loadModuleImage("replacement", replacement.bytes, nullptr, 0u); }, "retired");
+            iop.runEeCycles(2048u);
+            rejects([&] { iop.checkExecutionFailure(); }, "unloaded strict module");
+            require(word(iop, 0x10400u) == 0u,
+                    "a stale callback executed after its strict module was retired");
+        }
+        Host host;
+        IopEmulator iop(host);
+        Irx owner;
+        owner.words(0u, {0x3C080001u, 0x24090BADu, 0xAD090400u, 0x03E00008u, 0x00001021u});
+        const auto loaded = iop.loadModuleImage("owner", owner.bytes, nullptr, 0u);
+        require(loaded.moduleId > 0 && iop.stopModule(loaded.moduleId, nullptr), "strict owner did not retire");
+        require(iop.zeroMemory(0x10400u, 4u), "retired code canary reset failed");
+        Irx trampoline(0x11000u);
+        trampoline.words(0u, {0x08004000u, 0u}); // legacy code branches to the retired entry
+        host.file = trampoline.bytes;
+        rejects([&] { (void)iop.loadModule("legacy-trampoline", nullptr, 0u); }, "unloaded strict module");
+        require(word(iop, 0x10400u) == 0u,
+                "legacy trampoline bypassed retired strict range protection");
+    }
+
+    void returnDispositionAndCdvd()
+    {
+        for (uint16_t value : std::array<uint16_t, 5>{0u, 1u, 2u, 4u, 0xFFFFu})
+        {
+            Host host;
+            IopEmulator iop(host);
+            const Irx image = returns(value);
+            const auto result = iop.loadModuleImage("result", image.bytes, nullptr, 0u);
+            if (value == 0xFFFFu)
+                require(result.moduleId < 0 && result.startResult == -1 && iop.loadedModuleCount() == 0u,
+                        "negative original startup result was reported as a loaded module");
+            else
+                require(result.moduleId > 0 && result.startResult == value &&
+                        iop.loadedModuleCount() == (value == 1u ? 0u : 1u),
+                        "module residency did not use the original return disposition");
+        }
+        Host host;
+        IopEmulator iop(host);
+        require(iop.callCdvdImport(4u, 0u) == 1u && iop.callCdvdImport(13u, 0u) != 0u &&
+                iop.callCdvdImport(50u, static_cast<uint32_t>(-9)) != 0u,
+                "CDVD wrapper did not invoke the existing model");
+        rejects([&] { (void)iop.callCdvdImport(0xFFFFu, 0u); }, "Unsupported IOP CDVD import");
+    }
+}
+
+int main()
+{
+    const Test tests[] = {
+        {"Original entry observes normal IRX argv and actual ModuleInfo", realArgumentAbi},
+        {"Arguments fail before RAM mutation", argumentPreflight},
+        {"Endless startup cannot become module success", nonReturningEntry},
+        {"Missing imports cannot become module success", missingImport},
+        {"Exceptions, bad PCs and yielding are not startup returns", exceptionAndBadPc},
+        {"Malformed ELF/relocations fail before commit; valid relocation executes", relocationAndImagePreflight},
+        {"Strict files and real IOP buffers use their correct memory spaces", fileAndIopSources},
+        {"Overlap is atomic and legacy EE API remains compatible", overlapAndLegacyCompatibility},
+        {"Later physical RPC callback failures remain strict", callbackCompletion},
+        {"Background strict execution failure survives noexcept scheduling", backgroundFailure},
+        {"Unloaded and nonresident strict callback code cannot execute or be reused", retiredCallbacks},
+        {"Original start result controls residency and CDVD uses existing model", returnDispositionAndCdvd},
+    };
+    return run(tests);
+}
