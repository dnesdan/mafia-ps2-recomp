+
+        tc.Run("packet batch preflight stages initialization order and reserves all reply slots", [](TestCase &t)
+        {
+            PacketEnv env;
+            auto init = packet(0x80000002u, 20u);
+            put(init, 16u, kReceive);
+            const auto rpcInit = packet(0x80000002u, 16u, 1u);
+            std::memcpy(env.rdram.data() + kSource, init.data(), init.size());
+            std::memcpy(env.rdram.data() + kSource + 128u, rpcInit.data(), rpcInit.size());
+            const std::array<uint32_t, 8> initDescriptors{
+                kSource, env.endpoint, 20u, 0x44u, kSource + 128u, env.endpoint, 16u, 0x44u};
+            std::memcpy(env.rdram.data() + kDescriptors, initDescriptors.data(), sizeof(initDescriptors));
+            SET_GPR_U32(&env.context, 4, kDescriptors);
