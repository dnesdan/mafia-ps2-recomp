+        void validateWithState(std::span<const uint8_t> packet, uint32_t eeReceiveAddress,
+                               bool peerRpcInitialized, size_t queuedReplies) const;
+        void queueReady();
+        void execute(std::span<const uint8_t> packet, const std::vector<uint8_t> *rpcInput);
+        SifEeReply makeEnd(std::span<const uint8_t> request) const;
+        Server *findServer(uint32_t sid);
+        const Server *serverAt(uint32_t address) const;
+
+        IopSubsystem *m_owner;
+        IopBootstrapRpc m_bootstrap;
+        uint32_t m_endpoint = 0u;
+        uint32_t m_eeReceiveAddress = 0u;
+        uint32_t m_smFlags = 0u;
+        bool m_peerRpcInitialized = false;
+        std::unordered_map<uint32_t, uint32_t> m_registers;
+        std::array<uint32_t, 32> m_sregs{};
+        std::vector<Server> m_servers;
+        std::deque<SifEeReply> m_replies;
+    };
+}
