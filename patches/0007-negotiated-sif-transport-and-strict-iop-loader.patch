+            t.IsTrue(getRegU32(&env.context, 2) != 0u, "valid ordered INIT messages in one batch must succeed");
+
+            auto reply = packet(0x80000001u, 24u);
+            for (size_t i = 0u; i < 62u; ++i)
+                t.IsTrue(env.iop().queueSifCommand(0x80000001u, reply.data(), reply.size()), "prepare 63 pending replies");
+            auto bind = packet(0x80000009u);
+            put(bind, 32u, 0x80000003u);
+            std::memcpy(env.rdram.data() + kSource, bind.data(), bind.size());
+            constexpr uint32_t ordinaryDestination = 0x00030000u;
+            const uint32_t sentinel = 0xAABBCCDDu;
+            t.IsTrue(env.runtime.writeIopMemory(ordinaryDestination, &sentinel, sizeof(sentinel)), "prepare ordinary transfer sentinel");
+            const std::array<uint32_t, 12> descriptors{
+                kSource, ordinaryDestination, 4u, 0u,
+                kSource, env.endpoint, 64u, 0x44u,
+                kSource, env.endpoint, 64u, 0x44u};
+            std::memcpy(env.rdram.data() + kDescriptors, descriptors.data(), sizeof(descriptors));
+            SET_GPR_U32(&env.context, 4, kDescriptors);
+            SET_GPR_U32(&env.context, 5, 3u);
