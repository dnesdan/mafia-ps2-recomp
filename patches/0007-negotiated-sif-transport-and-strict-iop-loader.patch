+#pragma once
+
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ps2x::iop
+{
+    class IopSubsystem;
+}
+
+namespace ps2x::iop::detail
+{
+    // Packet services backed by the same runtime allocator, strict IRX loader,
+    // and CDVD device state used by the emulated IOP.
+    class IopBootstrapRpc
+    {
+    public:
+        explicit IopBootstrapRpc(IopSubsystem &owner) noexcept;
+        void rebindOwner(IopSubsystem &owner) noexcept;
+        void reset() noexcept;
+        [[nodiscard]] bool supports(uint32_t sid) const noexcept;
+        void validate(uint32_t sid, uint32_t function, std::span<const uint8_t> input,
+                      uint32_t receiveSize) const;
+        [[nodiscard]] std::vector<uint8_t> call(uint32_t sid, uint32_t function,
+                                               std::span<const uint8_t> input, uint32_t receiveSize);
+
+    private:
+        IopSubsystem *m_owner;
+    };
+}
diff --git a/ps2xIOP/src/iop_sif_command.cpp b/ps2xIOP/src/iop_sif_command.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cec43a32db745a5a3f6f3f1cec4aae7c17bde694
--- /dev/null
+++ b/ps2xIOP/src/iop_sif_command.cpp
@@ -0,0 +1,395 @@
+#include "iop_sif_command.h"
+
+#include <algorithm>
+#include <stdexcept>
+#include <sstream>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kSetSreg = 0x80000001u;
+        constexpr uint32_t kInit = 0x80000002u;
+        constexpr uint32_t kRpcEnd = 0x80000008u;
+        constexpr uint32_t kRpcBind = 0x80000009u;
+        constexpr uint32_t kRpcCall = 0x8000000Au;
+        constexpr uint32_t kRpcRead = 0x8000000Cu;
+        constexpr uint32_t kServerBufferSize = 4096u;
+        constexpr size_t kMaxReplies = 64u;
+
+        uint32_t word(std::span<const uint8_t> bytes, size_t offset)
+        {
+            if (offset > bytes.size() || bytes.size() - offset < 4u)
+                throw std::runtime_error("Truncated guest SIF packet word");
+            return uint32_t(bytes[offset]) | (uint32_t(bytes[offset + 1]) << 8u) |
+                   (uint32_t(bytes[offset + 2]) << 16u) | (uint32_t(bytes[offset + 3]) << 24u);
+        }
+
+        void put(std::vector<uint8_t> &bytes, size_t offset, uint32_t value)
+        {
+            for (size_t i = 0; i < 4u; ++i)
+                bytes.at(offset + i) = static_cast<uint8_t>(value >> (8u * i));
+        }
+
+        bool eeRange(uint32_t address, uint32_t size)
+        {
+            constexpr uint32_t ramSize = 0x02000000u;
+            uint32_t physical = address;
+            if ((address >= 0x20000000u && address < 0x40000000u) ||
+                (address >= 0x80000000u && address < 0xC0000000u))
+                physical &= 0x1FFFFFFFu;
+            else if (address >= ramSize)
+                return false;
+            return size <= ramSize && physical <= ramSize - size;
+        }
+
+        [[noreturn]] void unsupported(uint32_t command)
+        {
+            std::ostringstream out;
+            out << "Unsupported IOP SIF command cid=0x" << std::hex << command;
+            throw std::runtime_error(out.str());
+        }
+    }
+
+    IopSifCommand::IopSifCommand(IopSubsystem &owner)
+        : m_owner(&owner), m_bootstrap(owner)
+    {
+    }
+
+    void IopSifCommand::rebindOwner(IopSubsystem &owner) noexcept
+    {
+        m_owner = &owner;
+        m_bootstrap.rebindOwner(owner);
+    }
+
+    void IopSifCommand::reset()
+    {
+        // The owner resets the IOP allocator before this call.
+        m_endpoint = 0u;
+        m_eeReceiveAddress = 0u;
+        m_smFlags = 0u;
+        m_peerRpcInitialized = false;
+        m_registers.clear();
+        m_sregs.fill(0u);
+        m_servers.clear();
+        m_replies.clear();
+        m_bootstrap.reset();
+    }
+
+    void IopSifCommand::initialize()
+    {
+        if (m_endpoint != 0u)
+            return;
+        if (!m_bootstrap.supports(0x80000003u) || !m_bootstrap.supports(0x80000006u))
+            throw std::runtime_error("IOP SIF bootstrap providers are unavailable");
+        const uint32_t endpoint = m_owner->allocateMemory(128u, 64u);
+        if (endpoint == 0u || !m_owner->zeroMemory(endpoint, 128u))
+            throw std::runtime_error("Cannot allocate IOP SIF command endpoint");
+        m_endpoint = endpoint;
+        m_smFlags = 0x00030000u; // SIF and command receiver are now initialized.
+    }
+
+    uint32_t IopSifCommand::getRegister(uint32_t reg)
+    {
+        if (reg == 2u || reg == 4u)
+        {
+            initialize();
+            return reg == 2u ? m_endpoint : m_smFlags;
+        }
+        const auto entry = m_registers.find(reg);
+        return entry == m_registers.end() ? 0u : entry->second;
+    }
+
+    uint32_t IopSifCommand::setRegister(uint32_t reg, uint32_t value)
+    {
+        const uint32_t previous = getRegister(reg);
+        if (reg == 4u)
+            m_smFlags &= ~value; // EE writes acknowledge/clear IOP -> EE flags.
+        else if (reg == 3u)
+            m_registers[reg] = previous | value;
+        else
+            m_registers[reg] = value;
+        return previous;
+    }
+
+    bool IopSifCommand::accepts(uint32_t destination) const noexcept
+    {
+        return m_endpoint != 0u && destination == m_endpoint;
+    }
+
+    const IopSifCommand::Server *IopSifCommand::serverAt(uint32_t address) const
+    {
+        const auto found = std::find_if(m_servers.begin(), m_servers.end(),
+            [address](const Server &server) { return server.address == address; });
+        return found == m_servers.end() ? nullptr : &*found;
+    }
+
+    void IopSifCommand::validate(std::span<const uint8_t> packet) const
+    {
+        validateWithState(packet, m_eeReceiveAddress, m_peerRpcInitialized, m_replies.size());
+    }
+
+    void IopSifCommand::validateBatch(std::span<const SifCommandPacket> packets) const
+    {
+        uint32_t receiveAddress = m_eeReceiveAddress;
+        bool peerInitialized = m_peerRpcInitialized;
+        size_t replies = m_replies.size();
+        size_t rpcRequests = 0u;
+        for (const SifCommandPacket &packet : packets)
+        {
+            try
+            {
+                validateWithState(packet.bytes, receiveAddress, peerInitialized, replies);
+                const uint32_t command = word(packet.bytes, 8u);
+                if ((command == kRpcBind || command == kRpcCall || command == kRpcRead) && ++rpcRequests > 1u)
+                    throw std::runtime_error("Multiple RPC requests in one DMA batch require unsupported transactional service execution");
+                if (command == kRpcCall)
+                {
+                    std::vector<uint8_t> input;
+                    if (packet.hasRpcInput)
+                        input = packet.rpcInput;
+                    else
+                    {
+                        input.resize(word(packet.bytes, 36u));
+                        if (!m_owner->readMemory(serverAt(word(packet.bytes, 52u))->buffer, input.data(), input.size()))
+                            throw std::runtime_error("Cannot preflight SIF RPC request bytes");
+                    }
+                    if (input.size() != word(packet.bytes, 36u))
+                        throw std::runtime_error("SIF RPC input snapshot length disagrees with the CALL packet");
+                    m_bootstrap.validate(serverAt(word(packet.bytes, 52u))->sid, word(packet.bytes, 32u),
+                                         input, word(packet.bytes, 44u));
+                }
+                if (command == kInit)
+                {
+                    if (word(packet.bytes, 12u) == 0u)
+                        receiveAddress = word(packet.bytes, 16u);
+                    else
+                        peerInitialized = true;
+                }
+                if ((command == kInit && word(packet.bytes, 12u) == 0u) ||
+                    command == kRpcBind || command == kRpcCall || command == kRpcRead)
+                    ++replies;
+            }
+            catch (const std::exception &error)
+            {
+                std::ostringstream detail;
+                const uint32_t command = packet.bytes.size() >= 12u ? word(packet.bytes, 8u) : 0u;
+                detail << error.what() << "; cid=0x" << std::hex << command
+                       << " src=0x" << packet.source << " dst=0x" << packet.destination;
+                throw std::runtime_error(detail.str());
+            }
+        }
+    }
+
+    void IopSifCommand::validateWithState(std::span<const uint8_t> packet, uint32_t eeReceiveAddress,
+                                         bool peerRpcInitialized, size_t queuedReplies) const
+    {
+        if (!initialized() || packet.size() < 16u || packet.size() > 112u ||
+            (word(packet, 0u) & 0xFFu) != packet.size())
+            throw std::runtime_error("Malformed or uninitialized IOP SIF command packet");
+        const uint32_t command = word(packet, 8u);
+        const bool needsReply = (command == kInit && word(packet, 12u) == 0u) ||
+                                command == kRpcBind || command == kRpcCall || command == kRpcRead;
+        if (needsReply && queuedReplies >= kMaxReplies)
+            throw std::runtime_error("IOP SIF reply queue is full; EE receiver has not consumed pending packets");
+        if (command == kInit)
+        {
+            const uint32_t option = word(packet, 12u);
+            if (option == 0u)
+            {
+                const uint32_t address = word(packet, 16u);
+                if (address == 0u || (address & 15u) != 0u || !eeRange(address, 128u))
+                    throw std::runtime_error("Invalid EE SIF command receive buffer");
+            }
+            else if (option != 1u || eeReceiveAddress == 0u)
+                throw std::runtime_error("SIF RPC initialization requires prior INIT_CMD option 0");
+            return;
+        }
+        if (command == kSetSreg)
+        {
+            if (word(packet, 16u) >= m_sregs.size())
+                throw std::runtime_error("Invalid IOP SIF software register index");
+            (void)word(packet, 20u);
+            return;
+        }
+        if (command != kRpcBind && command != kRpcCall && command != kRpcRead)
+            unsupported(command);
+        if (!peerRpcInitialized || eeReceiveAddress == 0u)
+            throw std::runtime_error("SIF RPC request precedes the negotiated RPC initialization");
+        if (packet.size() < 64u)
+            throw std::runtime_error("Truncated 64-byte SIF RPC packet");
+        const uint32_t client = word(packet, 28u);
+        const uint32_t requestAddress = word(packet, 20u);
+        const uint32_t clientSize = command == kRpcRead ? 28u : 40u;
+        if (client == 0u || !eeRange(client, clientSize) || requestAddress == 0u || !eeRange(requestAddress, 64u))
+            throw std::runtime_error("SIF RPC packet contains an invalid EE client or request address");
+        if (command == kRpcCall)
+        {
+            const Server *server = serverAt(word(packet, 52u));
+            if (!server)
+                throw std::runtime_error("SIF RPC CALL references an unbound IOP server");
+            const uint32_t sendSize = word(packet, 36u);
+            const uint32_t receiveSize = word(packet, 44u);
+            const uint32_t receiveAddress = word(packet, 40u);
+            if (sendSize > kServerBufferSize || receiveSize > kServerBufferSize ||
+                (receiveSize != 0u && (receiveAddress == 0u || !eeRange(receiveAddress, receiveSize))) ||
+                word(packet, 48u) > 1u)
+                throw std::runtime_error("SIF RPC CALL buffer or completion mode is outside supported bounds");
+        }
+        else if (command == kRpcRead)
+        {
+            const uint32_t size = word(packet, 40u);
+            if (size > 0x00200000u || !m_owner->isMemoryRange(word(packet, 32u), size) ||
+                !eeRange(word(packet, 36u), size))
+                throw std::runtime_error("SIF RPC RDATA contains an invalid IOP/EE memory range");
+        }
+    }
+
+    void IopSifCommand::queueReady()
+    {
+        SifEeReply reply;
+        reply.packet.resize(24u, 0u);
+        put(reply.packet, 0u, 24u);
+        put(reply.packet, 8u, kSetSreg);
+        put(reply.packet, 16u, 0u);
+        put(reply.packet, 20u, 1u);
+        m_replies.push_back(std::move(reply));
+    }
+
+    SifEeReply IopSifCommand::makeEnd(std::span<const uint8_t> request) const
+    {
+        SifEeReply reply;
+        reply.packet.resize(64u, 0u);
+        put(reply.packet, 0u, 64u);
+        put(reply.packet, 8u, kRpcEnd);
+        put(reply.packet, 16u, word(request, 16u));
+        put(reply.packet, 20u, word(request, 20u));
+        put(reply.packet, 24u, word(request, 24u));
+        put(reply.packet, 28u, word(request, 28u));
+        put(reply.packet, 32u, word(request, 8u));
+        return reply;
+    }
+
+    IopSifCommand::Server *IopSifCommand::findServer(uint32_t sid)
+    {
+        for (Server &server : m_servers)
+            if (server.sid == sid)
+                return &server;
+        if (!m_bootstrap.supports(sid))
+            return nullptr;
+        const uint32_t allocation = m_owner->allocateMemory(64u + kServerBufferSize, 64u);
+        if (allocation == 0u || !m_owner->zeroMemory(allocation, 64u + kServerBufferSize))
+            throw std::runtime_error("Cannot allocate a SIF RPC server and request buffer");
+        m_servers.push_back({sid, allocation, allocation + 64u});
+        return &m_servers.back();
+    }
+
+    uint32_t IopSifCommand::rpcBuffer(uint32_t server) const noexcept
+    {
+        const Server *entry = serverAt(server);
+        return entry ? entry->buffer : 0u;
+    }
+
+    void IopSifCommand::receive(std::span<const uint8_t> packet)
+    {
+        execute(packet, nullptr);
+    }
+
+    void IopSifCommand::receive(const SifCommandPacket &packet)
+    {
+        execute(packet.bytes, packet.hasRpcInput ? &packet.rpcInput : nullptr);
+    }
+
+    void IopSifCommand::execute(std::span<const uint8_t> packet, const std::vector<uint8_t> *rpcInput)
+    {
+        validate(packet);
+        const uint32_t command = word(packet, 8u);
+        if (command == kInit)
+        {
+            if (word(packet, 12u) == 0u)
+            {
+                m_eeReceiveAddress = word(packet, 16u);
+                queueReady(); // Original EE SET_SREG handler performs the store.
+            }
+            else
+                m_peerRpcInitialized = true;
+            return;
+        }
+        if (command == kSetSreg)
+        {
+            m_sregs[word(packet, 16u)] = word(packet, 20u);
+            return;
+        }
+        SifEeReply reply = makeEnd(packet);
+        if (command == kRpcBind)
+        {
+            if (Server *server = findServer(word(packet, 32u)))
+            {
+                put(reply.packet, 36u, server->address);
+                put(reply.packet, 40u, server->buffer);
+            }
+        }
+        else if (command == kRpcCall)
+        {
+            const Server &server = *serverAt(word(packet, 52u));
+            std::vector<uint8_t> input(word(packet, 36u));
+            if (rpcInput)
+            {
+                if (rpcInput->size() != input.size())
+                    throw std::runtime_error("SIF RPC input snapshot length disagrees with the CALL packet");
+                input = *rpcInput;
+            }
+            else if (!m_owner->readMemory(server.buffer, input.data(), input.size()))
+                throw std::runtime_error("Cannot read SIF RPC request bytes from IOP RAM");
+            reply.dataAddress = word(packet, 40u);
+            reply.data = m_bootstrap.call(server.sid, word(packet, 32u), input, word(packet, 44u));
+            if (reply.data.size() > word(packet, 44u))
+                throw std::runtime_error("IOP SIF RPC service exceeded the requested reply size");
+            if (word(packet, 48u) == 0u)
+            {
+                reply.command = false;
+                reply.packetAddress = word(packet, 20u);
+                put(reply.packet, 16u, 0u);
+                put(reply.packet, 24u, 0u);
+            }
+        }
+        else if (command == kRpcRead)
+        {
+            reply.dataAddress = word(packet, 36u);
+            reply.data.resize(word(packet, 40u));
+            if (!m_owner->readMemory(word(packet, 32u), reply.data.data(), reply.data.size()))
+                throw std::runtime_error("Cannot read SIF RPC RDATA source from IOP RAM");
+        }
+        put(reply.packet, 0u, 64u | (static_cast<uint32_t>(reply.data.size()) << 8u));
+        put(reply.packet, 4u, reply.dataAddress);
+        m_replies.push_back(std::move(reply));
+    }
+
+    bool IopSifCommand::peekReply(SifEeReply &reply) const
+    {
+        if (m_replies.empty())
+            return false;
+        reply = m_replies.front();
+        return true;
+    }
+
+    void IopSifCommand::consumeReply()
+    {
+        if (m_replies.empty())
+            throw std::logic_error("Cannot consume an empty SIF reply queue");
+        m_replies.pop_front();
+    }
+
+    bool IopSifCommand::queueCommand(uint32_t command, std::span<const uint8_t> packet)
+    {
+        if (!initialized() || m_eeReceiveAddress == 0u || packet.size() < 16u ||
+            packet.size() > 112u || m_replies.size() >= kMaxReplies)
+            return false;
+        SifEeReply reply;
+        reply.packet.assign(packet.begin(), packet.end());
+        put(reply.packet, 0u, (word(packet, 0u) & 0xFFFFFF00u) | static_cast<uint32_t>(packet.size()));
+        put(reply.packet, 8u, command);
+        m_replies.push_back(std::move(reply));
+        return true;
+    }
+}
