+{
+    // Author-generated MIPS code: startup creates/starts one thread and returns
+    // resident. Only the later thread calls the unresolved absent:42 import.
+    inline Irx backgroundMissingImport()
+    {
+        Irx image;
+        image.words(0u, {0x27BDFFE0u, 0xAFBF001Cu,
+            0x3C040001u, 0x34840180u, 0x0C004045u, 0u,
+            0x00402021u, 0x00002821u, 0x0C004047u, 0u,
+            0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x00001021u});
+        image.words(0x100u, {0x41E00000u, 0u, 0x0101u, 0x61626874u, 0x00006573u,
+            0x03E00008u, 0x24000004u, 0x03E00008u, 0x24000006u, 0u, 0u});
+        image.words(0x180u, {0u, 0u, 0x10200u, 0x1000u, 20u});
+        image.words(0x200u, {0x0C0040A5u, 0u});
+        image.words(0x280u, {0x41E00000u, 0u, 0x0101u, 0x65736261u, 0x0000746Eu,
