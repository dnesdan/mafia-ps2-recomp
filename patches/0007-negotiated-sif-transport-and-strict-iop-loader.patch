diff --git a/ps2xIOP/tests/iop_boot_image_tests.cpp b/ps2xIOP/tests/iop_boot_image_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f8c04a429d329dcf413329fbd170031d6d2f30fc
--- /dev/null
+++ b/ps2xIOP/tests/iop_boot_image_tests.cpp
@@ -0,0 +1,274 @@
+#include "iop_boot_image.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+
+    void require(bool condition, const char *message)
+    {
+        if (!condition)
+            throw std::runtime_error(message);
+    }
+
+    void put16(std::vector<uint8_t> &bytes, size_t offset, uint16_t value)
+    {
+        bytes.at(offset) = static_cast<uint8_t>(value);
+        bytes.at(offset + 1u) = static_cast<uint8_t>(value >> 8u);
+    }
+
+    void put32(std::vector<uint8_t> &bytes, size_t offset, uint32_t value)
+    {
+        for (size_t i = 0u; i < 4u; ++i)
+            bytes.at(offset + i) = static_cast<uint8_t>(value >> (i * 8u));
+    }
+
+    void record(std::vector<uint8_t> &bytes, size_t offset, const char *name,
+                uint16_t extSize, uint32_t fileSize)
+    {
+        std::fill_n(bytes.begin() + offset, 16u, uint8_t{0u});
+        std::copy_n(name, std::strlen(name), bytes.begin() + offset);
+        put16(bytes, offset + 10u, extSize);
+        put32(bytes, offset + 12u, fileSize);
+    }
+
+    // Author-generated public fixture: no proprietary module or ROM bytes.
+    // Six directory slots, 12 EXTINFO bytes, then independently known payloads.
+    std::vector<uint8_t> fixture(uint32_t bootstrapSize = 0u)
+    {
+        const size_t directory = bootstrapSize == 0u ? 0u : 32u;
+        std::vector<uint8_t> bytes(directory + 147u, 0u);
+        if (bootstrapSize != 0u)
+            std::fill_n(bytes.begin(), bootstrapSize, uint8_t{0xA5u});
+        record(bytes, directory, "RESET", 4u, bootstrapSize);
+        record(bytes, directory + 16u, "ROMDIR", 0u, 96u);
+        record(bytes, directory + 32u, "EXTINFO", 0u, 12u);
+        record(bytes, directory + 48u, "ALPHA", 8u, 17u);
+        record(bytes, directory + 64u, "BETA", 0u, 3u);
+        const std::array<uint8_t, 12u> info{0x02u, 0x01u, 0u, 2u,
+                                          0u, 0u, 4u, 3u, 'a', 'b', 'c', 0u};
+        std::copy(info.begin(), info.end(), bytes.begin() + directory + 96u);
+        for (uint8_t i = 0u; i < 17u; ++i)
+            bytes[directory + 112u + i] = static_cast<uint8_t>(0x40u + i);
+        bytes[directory + 144u] = 0x11u;
+        bytes[directory + 145u] = 0x22u;
+        bytes[directory + 146u] = 0x33u;
+        return bytes;
+    }
+
+    template <typename Action>
+    void rejects(Action action, const char *message)
+    {
+        try
+        {
+            action();
+        }
+        catch (const std::runtime_error &error)
+        {
+            require(std::string(error.what()).find("Invalid IOP boot image:") == 0u,
+                    "failure lost its boot-image diagnostic");
+            return;
+        }
+        throw std::runtime_error(message);
+    }
+
+    void inventoryAndPayloads()
+    {
+        const auto bytes = fixture();
+        const auto before = bytes;
+        const auto parsed = parseBootImage(bytes);
+        require(bytes == before, "inventory mutated the original image");
+        require(parsed.directoryOffset == 0u && parsed.entries.size() == 5u,
+                "wrong image inventory");
+        const std::array<std::string, 5u> expected{"RESET", "ROMDIR", "EXTINFO", "ALPHA", "BETA"};
+        for (size_t i = 0u; i < expected.size(); ++i)
+            require(parsed.entries[i].name == expected[i], "entry order/name changed");
+        const auto &alpha = parsed.entries[3u];
+        require(alpha.offset == 112u && alpha.size == 17u &&
+                    alpha.extInfoOffset == 100u && alpha.extInfoSize == 8u,
+                "file and EXTINFO offsets are not independent");
+        const auto alphaBytes = bootImageEntryBytes(bytes, alpha);
+        require(alphaBytes.size() == 17u && alphaBytes.front() == 0x40u && alphaBytes.back() == 0x50u,
+                "entry view includes padding or wrong data");
+        const auto beta = bootImageEntryBytes(bytes, parsed.entries[4u]);
+        require(beta.size() == 3u && beta[0u] == 0x11u && beta[1u] == 0x22u && beta[2u] == 0x33u,
+                "unaligned final EOF was rejected or changed");
+        require(bootImageEntryBytes(bytes, parsed.entries[0u]).empty(), "zero-byte RESET gained payload");
+    }
+
+    void resetBootstrapPrefix()
+    {
+        const auto bytes = fixture(17u);
+        const auto parsed = parseBootImage(bytes);
+        require(parsed.directoryOffset == 32u && parsed.entries[1u].offset == 32u &&
+                    parsed.entries[3u].offset == 144u && parsed.entries[4u].offset == 176u,
+                "nonempty RESET bootstrap shifted extents incorrectly");
+        const auto reset = bootImageEntryBytes(bytes, parsed.entries[0u]);
+        require(reset.size() == 17u && std::all_of(reset.begin(), reset.end(), [](uint8_t b) { return b == 0xA5u; }),
+                "RESET payload must refer to the image prefix");
+    }
+
+    void truncatedImages()
+    {
+        const auto bytes = fixture();
+        for (size_t size : {size_t{0u}, size_t{15u}, size_t{63u}, size_t{95u}, size_t{146u}})
+            rejects([&] { (void)parseBootImage(std::span(bytes).first(size)); }, "truncated input was accepted");
+    }
+
+    void requiredEntriesAndSelfLocation()
+    {
+        auto bytes = fixture();
+        bytes[16u] = 'X';
+        rejects([&] { (void)parseBootImage(bytes); }, "missing ROMDIR was accepted");
+        bytes = fixture();
+        bytes[32u] = 'X';
+        rejects([&] { (void)parseBootImage(bytes); }, "missing EXTINFO was accepted");
+        bytes = fixture(17u);
+        put32(bytes, 44u, 33u);
+        rejects([&] { (void)parseBootImage(bytes); }, "RESET self-location mismatch was accepted");
+    }
+
+    void directoryBoundsAndTermination()
+    {
+        for (uint32_t size : {0u, 48u, 65u, 80u, 160u, 0xFFFFFFF0u})
+        {
+            auto bytes = fixture();
+            put32(bytes, 28u, size);
+            rejects([&] { (void)parseBootImage(bytes); }, "malformed ROMDIR length was accepted");
+        }
+        auto bytes = fixture();
+        bytes[95u] = 1u;
+        rejects([&] { (void)parseBootImage(bytes); }, "partial zero terminator was accepted");
+        bytes = fixture();
+        std::fill_n(bytes.begin() + 48u, 16u, uint8_t{0u});
+        rejects([&] { (void)parseBootImage(bytes); }, "records after terminator were accepted");
+    }
+
+    void fileBoundsAndIntegerOverflow()
+    {
+        for (uint32_t size : {4u, 0x7FFFFFFFu, 0xFFFFFFF1u, 0xFFFFFFFFu})
+        {
+            auto bytes = fixture();
+            put32(bytes, 76u, size);
+            rejects([&] { (void)parseBootImage(bytes); }, "out-of-image file size was accepted");
+        }
+        auto bytes = fixture();
+        put32(bytes, 60u, 0xFFFFFFFFu);
+        rejects([&] { (void)parseBootImage(bytes); }, "rounded file size overflow was accepted");
+    }
+
+    void strictNamesAndDuplicates()
+    {
+        auto bytes = fixture();
+        record(bytes, 64u, "ALPHA", 0u, 3u);
+        rejects([&] { (void)parseBootImage(bytes); }, "duplicate filename was accepted");
+        for (const char *name : {"..", "A/B", "A\\B", "A:B", "A B"})
+        {
+            bytes = fixture();
+            record(bytes, 64u, name, 0u, 3u);
+            rejects([&] { (void)parseBootImage(bytes); }, "invalid filename was accepted");
+        }
+        bytes = fixture();
+        bytes[70u] = 'X';
+        rejects([&] { (void)parseBootImage(bytes); }, "hidden bytes after filename terminator were accepted");
+        bytes = fixture();
+        record(bytes, 64u, "ABCDEFGHIJ", 0u, 3u);
+        const auto parsed = parseBootImage(bytes);
+        require(parsed.entries[4u].name == "ABCDEFGHIJ" &&
+                    bootImageEntryBytes(bytes, parsed.entries[4u]).size() == 3u,
+                "a bounded ten-byte filename needs no terminator beyond its field");
+    }
+
+    void extInfoBoundsAndFraming()
+    {
+        for (uint16_t size : {uint16_t{1u}, uint16_t{7u}, uint16_t{12u}, uint16_t{0xFFFCu}})
+        {
+            auto bytes = fixture();
+            put16(bytes, 58u, size);
+            rejects([&] { (void)parseBootImage(bytes); }, "incorrect per-file EXTINFO size was accepted");
+        }
+        for (uint8_t length : {uint8_t{1u}, uint8_t{8u}, uint8_t{252u}})
+        {
+            auto bytes = fixture();
+            bytes[102u] = length;
+            rejects([&] { (void)parseBootImage(bytes); }, "invalid EXTINFO field framing was accepted");
+        }
+        auto bytes = fixture();
+        bytes[103u] = 0xE1u;
+        require(parseBootImage(bytes).entries.size() == 5u, "unknown but framed EXTINFO type was rejected");
+    }
+
+    void unalignedDirectoryAndSearchLimit()
+    {
+        auto bytes = fixture();
+        bytes.insert(bytes.begin(), 1u, uint8_t{0xA5u});
+        rejects([&] { (void)parseBootImage(bytes); }, "unaligned directory was accepted");
+        bytes = fixture();
+        bytes.insert(bytes.begin(), 0x8000u, uint8_t{0xA5u});
+        put32(bytes, 0x800Cu, 0x8000u);
+        rejects([&] { (void)parseBootImage(bytes); }, "directory search escaped its bounded window");
+    }
+
+    void entryViewBounds()
+    {
+        const auto bytes = fixture();
+        const auto parsed = parseBootImage(bytes);
+        rejects([&] { (void)bootImageEntryBytes(std::span(bytes).first(146u), parsed.entries[4u]); },
+                "entry view accepted a shorter caller buffer");
+        auto invalidEntry = parsed.entries[4u];
+        invalidEntry.offset = static_cast<size_t>(-1);
+        rejects([&] { (void)bootImageEntryBytes(bytes, invalidEntry); }, "entry view offset overflow was accepted");
+    }
+
+    void resourceLimits()
+    {
+        auto bytes = fixture();
+        bytes.resize(kMaxBootImageBytes + 1u, 0u);
+        rejects([&] { (void)parseBootImage(bytes); }, "unbounded image size was accepted");
+        bytes = fixture();
+        bytes.resize((kMaxBootImageEntries + 2u) * 16u, 0u);
+        put32(bytes, 28u, static_cast<uint32_t>(bytes.size()));
+        rejects([&] { (void)parseBootImage(bytes); }, "unbounded directory count was accepted");
+    }
+}
+
+int main()
+{
+    const std::pair<const char *, void (*)()> tests[] = {
+        {"Inventory preserves original bytes and exact unpadded payloads", inventoryAndPayloads},
+        {"Nonempty RESET locates the aligned directory", resetBootstrapPrefix},
+        {"Truncated files and directory bytes are rejected", truncatedImages},
+        {"Required entries and self-location are checked", requiredEntriesAndSelfLocation},
+        {"Directory length and full zero terminator are checked", directoryBoundsAndTermination},
+        {"File extents cannot overflow or leave the image", fileBoundsAndIntegerOverflow},
+        {"Names are bounded, unambiguous and unique", strictNamesAndDuplicates},
+        {"EXTINFO spans and field framing are checked", extInfoBoundsAndFraming},
+        {"Directory alignment and search bounds are enforced", unalignedDirectoryAndSearchLimit},
+        {"Entry views reject a changed or shorter backing buffer", entryViewBounds},
+        {"Input work and inventory allocation are bounded", resourceLimits},
+    };
+    size_t passed = 0u;
+    for (const auto &[name, test] : tests)
+    {
+        try
+        {
+            test();
+            ++passed;
+            std::cout << "[PASS] " << name << '\n';
+        }
+        catch (const std::exception &error)
+        {
+            std::cerr << "[FAIL] " << name << ": " << error.what() << '\n';
+        }
+    }
+    std::cout << passed << '/' << std::size(tests) << " boot-image tests passed\n";
+    return passed == std::size(tests) ? 0 : 1;
+}
