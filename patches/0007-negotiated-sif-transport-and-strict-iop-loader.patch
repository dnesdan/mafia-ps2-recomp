+            catch (const std::runtime_error &failure) { error = failure.what(); }
+            t.IsTrue(error.find("missing import absent:42") != std::string::npos,
+                     "pending IOP error must escape polling even with no queued reply or armed channel");
+        });
+
+        tc.Run("IOP reset discards packet replies and bindings before a new handshake", [](TestCase &t)
+        {
+            PacketEnv env;
+            const uint32_t oldServer = env.bindHeap();
+            env.init();
+            PS2IopTransport::reset(&env.runtime);
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(!env.iop().peekSifReply(reply) && !env.iop().sifCommandsInitialized(), "reset discards old endpoint and queued packets");
+            env.endpoint = env.iop().getSifRegister(2u);
+            auto call = packet(0x8000000Au);
+            put(call, 52u, oldServer);
+            t.IsTrue(env.fails(call), "stale RPC binding cannot survive a new IOP boot");
+        });
+
+        tc.Run("moving an IOP subsystem rebinds endpoint and provider ownership", [](TestCase &t)
+        {
+            PacketEnv env;
+            auto &original = env.iop();
+            ps2x::iop::IopSubsystem moved(std::move(original));
+            struct RestoreOwner
+            {
+                ps2x::iop::IopSubsystem &destination, &source;
+                ~RestoreOwner() { destination = std::move(source); }
+            } restore{original, moved};
+            t.Equals(moved.getSifRegister(2u), env.endpoint, "move constructor preserves the live endpoint");
+            moved.reset();
+            t.IsTrue(moved.getSifRegister(2u) != 0u, "moved endpoint must allocate through its rebound owner");
+            auto init = packet(0x80000002u, 20u);
+            put(init, 16u, kReceive);
+            moved.receiveSifCommand(init.data(), init.size());
+            moved.consumeSifReply();
+            const auto rpcInit = packet(0x80000002u, 16u, 1u);
+            moved.receiveSifCommand(rpcInit.data(), rpcInit.size());
+            auto bind = packet(0x80000009u);
+            put(bind, 32u, 0x80000003u);
+            moved.receiveSifCommand(bind.data(), bind.size());
+            ps2x::iop::SifEeReply reply;
+            t.IsTrue(moved.peekSifReply(reply) && word(reply.packet, 36u) != 0u,
+                     "moved provider must allocate a real bound server using the new owner");
+            const uint32_t server = word(reply.packet, 36u);
+            const uint32_t buffer = word(reply.packet, 40u);
+            moved.consumeSifReply();
+            const uint32_t size = 128u;
+            t.IsTrue(moved.writeMemory(buffer, &size, sizeof(size)), "write moved provider input");
+            auto call = packet(0x8000000Au);
+            put(call, 32u, 1u);
+            put(call, 36u, 4u);
+            put(call, 40u, kResult);
+            put(call, 44u, 4u);
+            put(call, 52u, server);
+            moved.receiveSifCommand(call.data(), call.size());
+            t.IsTrue(moved.peekSifReply(reply) && reply.data.size() == 4u &&
