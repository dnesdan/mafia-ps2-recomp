+
+    BootImage parseBootImage(std::span<const uint8_t> image)
+    {
+        // Public format: https://ps2dev.github.io/ps2sdk/romdrv_8h_source.html
+        // Locations and names are decoded bytewise, independent of host packing.
+        if (image.size() < 4u * kRecordSize || image.size() > kMaxBootImageBytes)
+            invalid("image size is outside the supported 64-byte to 16-MiB range");
+        const size_t directoryOffset = findDirectory(image);
+        if (!contains(image, directoryOffset, 4u * kRecordSize) ||
+            nameAt(image, directoryOffset + 16u) != "ROMDIR" ||
+            nameAt(image, directoryOffset + 32u) != "EXTINFO")
+            invalid("required RESET, ROMDIR, EXTINFO entries are not in order");
+        const uint32_t directorySize = read32(image, directoryOffset + 28u);
+        if ((directorySize & 15u) != 0u || directorySize < 4u * kRecordSize ||
+            directorySize / kRecordSize > kMaxBootImageEntries + 1u ||
+            !contains(image, directoryOffset, directorySize))
+            invalid("ROMDIR length is unaligned, truncated, or exceeds the entry limit");
+
+        BootImage result;
+        result.directoryOffset = directoryOffset;
+        std::unordered_set<std::string> names;
+        const size_t directoryEnd = directoryOffset + directorySize;
+        size_t dataOffset = 0u;
+        size_t extInfoOffset = 0u;
+        bool terminated = false;
+        for (size_t offset = directoryOffset; offset < directoryEnd; offset += kRecordSize)
+        {
+            const auto record = image.subspan(offset, kRecordSize);
+            if (std::all_of(record.begin(), record.end(), [](uint8_t value) { return value == 0u; }))
+            {
+                if (!std::all_of(image.begin() + offset, image.begin() + directoryEnd,
+                                 [](uint8_t value) { return value == 0u; }))
+                    invalid("ROMDIR has nonzero records after its terminator");
+                terminated = true;
+                break;
+            }
+            const std::string name = nameAt(image, offset);
+            const uint16_t extInfoSize = read16(image, offset + 10u);
+            const uint32_t size = read32(image, offset + 12u);
+            if (!names.emplace(name).second)
+                invalid("duplicate ROMDIR filename");
+            if ((extInfoSize & 3u) != 0u)
+                invalid("EXTINFO entry length is not four-byte aligned");
+            if (!contains(image, dataOffset, size))
+                invalid("file extent exceeds the supplied image");
+            result.entries.push_back({name, dataOffset, size, extInfoOffset, extInfoSize});
+            dataOffset += alignedSize(size);
+            extInfoOffset += extInfoSize;
+        }
+        if (!terminated || result.entries.size() < 3u)
+            invalid("ROMDIR lacks its complete zero terminator");
+
+        const BootImageEntry &extInfo = result.entries[2u];
+        if (result.entries[1u].offset != directoryOffset || extInfo.offset != directoryEnd)
+            invalid("directory self-location or EXTINFO location is inconsistent");
+        if (extInfoOffset != extInfo.size)
+            invalid("EXTINFO size does not equal the declared per-file records");
+        for (BootImageEntry &entry : result.entries)
+        {
+            entry.extInfoOffset += extInfo.offset;
+            if (!contains(image, entry.extInfoOffset, entry.extInfoSize))
+                invalid("EXTINFO extent exceeds the supplied image");
+            validateExtInfo(image.subspan(entry.extInfoOffset, entry.extInfoSize));
+        }
+        return result;
+    }
+
+    std::span<const uint8_t> bootImageEntryBytes(std::span<const uint8_t> image, const BootImageEntry &entry)
+    {
+        if (!contains(image, entry.offset, entry.size))
+            invalid("requested entry is outside the supplied image");
+        return image.subspan(entry.offset, entry.size);
+    }
+}
diff --git a/ps2xIOP/src/iop_boot_image.h b/ps2xIOP/src/iop_boot_image.h
new file mode 100644
index 0000000000000000000000000000000000000000..fc7911db8109610ca56a82680709c16892bc741c
--- /dev/null
+++ b/ps2xIOP/src/iop_boot_image.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    struct BootImageEntry
+    {
+        std::string name;
+        size_t offset = 0u;
+        uint32_t size = 0u;
+        size_t extInfoOffset = 0u;
+        uint16_t extInfoSize = 0u;
+    };
+
+    struct BootImage
+    {
+        size_t directoryOffset = 0u;
+        std::vector<BootImageEntry> entries;
+    };
+
+    // This is an inventory parser, not a module loader. Entries refer to the
+    // caller's original bytes by checked offsets; the result owns no raw views.
+    // Limits bound malformed-input work and are well above ordinary IOP images.
+    inline constexpr size_t kMaxBootImageBytes = 16u * 1024u * 1024u;
+    inline constexpr size_t kMaxBootImageEntries = 4096u;
+    [[nodiscard]] BootImage parseBootImage(std::span<const uint8_t> image);
+    [[nodiscard]] std::span<const uint8_t> bootImageEntryBytes(
+        std::span<const uint8_t> image, const BootImageEntry &entry);
+}
diff --git a/ps2xIOP/src/iop_bootstrap_rpc.cpp b/ps2xIOP/src/iop_bootstrap_rpc.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d2e2ffc6b1fe6b0bdb7bc3e9f0f22f96b616578b
--- /dev/null
+++ b/ps2xIOP/src/iop_bootstrap_rpc.cpp
@@ -0,0 +1,186 @@
+#include "iop_bootstrap_rpc.h"
+
+#include "ps2x/iop/iop_subsystem.h"
+
+#include <algorithm>
+#include <array>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kHeap = 0x80000003u;
+        constexpr uint32_t kLoadfile = 0x80000006u;
+        constexpr uint32_t kCdvdInit = 0x80000592u;
+        constexpr uint32_t kCdvdReady = 0x8000059Au;
+
+        uint32_t word(std::span<const uint8_t> bytes, size_t offset)
+        {
+            if (offset > bytes.size() || bytes.size() - offset < 4u)
+                throw std::runtime_error("Truncated IOP bootstrap RPC request");
+            return uint32_t(bytes[offset]) | (uint32_t(bytes[offset + 1u]) << 8u) |
+                   (uint32_t(bytes[offset + 2u]) << 16u) | (uint32_t(bytes[offset + 3u]) << 24u);
+        }
+
+        void put(std::vector<uint8_t> &bytes, size_t offset, uint32_t value)
+        {
+            for (size_t i = 0u; i < 4u; ++i)
+                bytes.at(offset + i) = static_cast<uint8_t>(value >> (i * 8u));
+        }
+
+        std::vector<uint8_t> result(uint32_t value)
+        {
+            std::vector<uint8_t> bytes(4u);
+            put(bytes, 0u, value);
+            return bytes;
+        }
+
+        std::string path(std::span<const uint8_t> input)
+        {
+            if (input.size() < 260u)
+                throw std::runtime_error("Truncated loadfile path field");
+            const auto bytes = input.subspan(8u, 252u);
+            const auto end = std::find(bytes.begin(), bytes.end(), uint8_t{0u});
+            if (end == bytes.begin() || end == bytes.end())
+                throw std::runtime_error("Loadfile path is empty or not terminated within its 252-byte field");
+            return {bytes.begin(), end};
+        }
+
+        void arguments(std::span<const uint8_t> input, uint32_t length)
+        {
+            if (length > 252u || input.size() < 260u || length > input.size() - 260u)
+                throw std::runtime_error("Loadfile argument bytes exceed the bounded packet field");
+            if (length != 0u && input[260u + length - 1u] != 0u)
+                throw std::runtime_error("Loadfile arguments must be complete NUL-terminated strings");
+        }
+
+        [[noreturn]] void unsupported(uint32_t sid, uint32_t function)
+        {
+            std::ostringstream text;
+            text << "Unsupported IOP bootstrap RPC sid=0x" << std::hex << sid
+                 << " function=0x" << function;
+            throw std::runtime_error(text.str());
+        }
+
+        void requiresReply(uint32_t receiveSize, uint32_t required)
+        {
+            if (receiveSize < required)
+                throw std::runtime_error("IOP bootstrap RPC receive buffer is shorter than the service result");
+        }
+    }
+
+    IopBootstrapRpc::IopBootstrapRpc(IopSubsystem &owner) noexcept : m_owner(&owner) {}
+    void IopBootstrapRpc::rebindOwner(IopSubsystem &owner) noexcept { m_owner = &owner; }
+    void IopBootstrapRpc::reset() noexcept {} // Owned allocator/loader/CDVD state resets in IopSubsystem.
+
+    bool IopBootstrapRpc::supports(uint32_t sid) const noexcept
+    {
+        return sid == kHeap || sid == kLoadfile || sid == kCdvdInit || sid == kCdvdReady;
+    }
+
+    void IopBootstrapRpc::validate(uint32_t sid, uint32_t function,
+                                    std::span<const uint8_t> input, uint32_t receiveSize) const
+    {
+        if (sid == kHeap)
+        {
+            if (function != 1u && function != 2u)
+                unsupported(sid, function);
+            (void)word(input, 0u);
+            requiresReply(receiveSize, 4u);
+            return;
+        }
+        if (sid == kLoadfile)
+        {
+            if (function == 0u || function == 6u)
+            {
+                if (input.size() < 512u)
+                    throw std::runtime_error("Truncated 512-byte loadfile module request");
+                const uint32_t length = word(input, function == 0u ? 0u : 4u);
+                arguments(input, length);
+                if (function == 0u)
+                    (void)path(input);
+                else if (!m_owner->isMemoryRange(word(input, 0u), 52u))
+                    throw std::runtime_error("Loadfile buffer is not a bounded IOP RAM address");
+                requiresReply(receiveSize, 8u);
+                return;
+            }
+            if (function == 2u || function == 3u)
+            {
+                const uint32_t type = word(input, 4u);
+                if (type > 2u || !m_owner->isMemoryRange(word(input, 0u), 1u << type))
+                    throw std::runtime_error("Invalid loadfile memory-value type or IOP range");
+                if (function == 2u)
+                    (void)word(input, 8u);
+                requiresReply(receiveSize, 4u);
+                return;
+            }
+            unsupported(sid, function);
+        }
+        if (sid == kCdvdInit || sid == kCdvdReady)
+        {
+            if (function != 0u)
+                unsupported(sid, function);
+            const uint32_t mode = word(input, 0u);
+            if ((sid == kCdvdInit && mode != 0u && mode != 1u && mode != 5u) ||
+                (sid == kCdvdReady && mode > 1u))
+                throw std::runtime_error("Unsupported CDVD initialization/readiness mode");
+            requiresReply(receiveSize, sid == kCdvdInit ? 16u : 4u);
+            return;
+        }
+        unsupported(sid, function);
+    }
+
+    std::vector<uint8_t> IopBootstrapRpc::call(uint32_t sid, uint32_t function,
+                                               std::span<const uint8_t> input, uint32_t receiveSize)
+    {
+        validate(sid, function, input, receiveSize);
+        if (sid == kHeap)
+        {
+            const uint32_t value = word(input, 0u);
+            if (function == 1u)
+                return result(value <= 0x00200000u ? m_owner->allocateMemory(value, 16u) : 0u);
+            return result(m_owner->freeMemory(value) ? 0u : uint32_t(-1));
+        }
+        if (sid == kLoadfile)
+        {
+            if (function == 0u || function == 6u)
+            {
+                const uint32_t length = word(input, function == 0u ? 0u : 4u);
+                const ModuleLoadResult loaded = function == 0u
+                    ? m_owner->loadModuleStrict(path(input), input.data() + 260u, length)
+                    : m_owner->loadModuleIopBuffer(word(input, 0u), input.data() + 260u, length);
+                std::vector<uint8_t> bytes(8u);
+                put(bytes, 0u, static_cast<uint32_t>(loaded.moduleId));
+                put(bytes, 4u, static_cast<uint32_t>(loaded.startResult));
+                return bytes;
+            }
+            const uint32_t address = word(input, 0u);
+            const uint32_t size = 1u << word(input, 4u);
+            if (function == 2u)
+            {
+                const auto value = result(word(input, 8u));
+                if (!m_owner->writeMemory(address, value.data(), size))
+                    throw std::runtime_error("Cannot write loadfile IOP memory value");
+                return result(0u);
+            }
+            std::array<uint8_t, 4u> value{};
+            if (!m_owner->readMemory(address, value.data(), size))
+                throw std::runtime_error("Cannot read loadfile IOP memory value");
+            return result(word(value, 0u));
+        }
+        if (sid == kCdvdInit)
+        {
+            std::vector<uint8_t> bytes(16u, 0u);
+            put(bytes, 0u, m_owner->callCdvdImport(4u, word(input, 0u)));
+            // This version identifies the modeled service; it does not claim
+            // that a physical CDVDFSV module was loaded or infer its version.
+            put(bytes, 4u, 0x0100u);
+            put(bytes, 8u, m_owner->callCdvdImport(50u, uint32_t(-9)));
+            return bytes;
+        }
+        return result(m_owner->callCdvdImport(13u, word(input, 0u)));
+    }
+}
diff --git a/ps2xIOP/src/iop_bootstrap_rpc.h b/ps2xIOP/src/iop_bootstrap_rpc.h
