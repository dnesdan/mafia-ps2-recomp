+bool EeScheduler::hasEnabledIrqHandler(bool dmac, uint32_t cause) const
+{
+    assertExecutor();
+    const uint32_t mask = dmac ? m_enabledDmacMask : m_enabledIntcMask;
+    if (cause < 32u && (mask & (1u << cause)) == 0u)
+        return false;
+    const auto &handlers = dmac ? m_dmacHandlers : m_intcHandlers;
+    return std::any_of(handlers.begin(), handlers.end(), [&](const auto &entry)
+        {
+            const EeIrqHandler &handler = entry.second;
+            return handler.enabled && handler.cause == cause && handler.handler != 0u &&
+                   m_runtime.hasFunction(handler.handler);
+        });
+}
