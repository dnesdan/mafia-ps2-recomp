     private:
+        void checkTrayChange(uint32_t destination)
+        {
+            const uint32_t segment = destination & 0xE0000000u;
+            const uint32_t physical = IopMemory::physicalAddress(destination);
+            if (destination == 0u || (destination & 3u) != 0u ||
+                (segment != 0u && segment != 0x80000000u && segment != 0xA0000000u) ||
+                physical >= IopMemory::RamSize || sizeof(uint32_t) > IopMemory::RamSize - physical ||
+                !memory.ownsRamRange(destination, sizeof(uint32_t)))
+                throw std::runtime_error("IOP CDVD tray-check destination is outside aligned complete owned RAM");
+
+            // PS2SDK cdvdman's mediactl(1) consumes observer 1's change latch.
+            // Its flags initialize to one; this is not a disc-present bit.
+            // The fixed-media model has no tray transitions between resets.
+            // Other observers (file search/read) must not consume this latch.
+            // https://ps2dev.github.io/ps2sdk/cdvdman_8c_source.html#l06095
+            memory.write32(destination, trayChangePending ? 1u : 0u);
+            trayChangePending = false;
