 void register_ps2_runtime_interrupt_tests()
 {
     MiniTest::Case("PS2RuntimeInterrupt", [](TestCase &tc)
     {
+        tc.Run("IRQ frames survive writes throughout the declared top-of-RAM main stack", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(kArenaMainPc, schedulerArenaMain);
+            env.runtime.registerFunction(kArenaHandlerPc, schedulerArenaHandler);
+            g_arenaPreSetupSp = g_arenaIrqSp = 0u;
+            g_arenaReturnPreserved = false;
+            R5900Context mainContext{};
+            mainContext.pc = kArenaMainPc;
+            setRegU32(mainContext, 29, PS2_RAM_SIZE - 16u);
+            env.runtime.eeScheduler().reset(env.rdram.data(), mainContext);
+            env.runtime.eeScheduler().run();
+            t.IsTrue(g_arenaPreSetupSp >= kKernelArenaBegin && g_arenaPreSetupSp < kKernelArenaEnd,
+                     "pre-SetupThread callback lease must own modeled kernel memory");
+            t.IsTrue(g_arenaIrqSp >= kKernelArenaBegin && g_arenaIrqSp < kKernelArenaEnd &&
+                         g_arenaIrqSp != g_arenaPreSetupSp,
+                     "dispatcher and thread callback owners must have distinct bounded stacks");
+            t.IsTrue(g_arenaReturnPreserved,
+                     "legitimate main-stack file data must not overwrite a saved callback return");
+            t.IsTrue(std::all_of(env.rdram.begin() + kArenaGuestStackBegin, env.rdram.end(),
+                                [](uint8_t value) { return value == 0xA5u; }),
+                     "callback stack reservation must not alter or filter the original guest buffer write");
+        });
+
+        tc.Run("callback lease cache and allocator reset as one lifetime", [](TestCase &t)
+        {
+            TestEnv env;
+            R5900Context mainContext{};
+            setRegU32(mainContext, 29, PS2_RAM_SIZE - 16u);
+            auto &ee = env.runtime.eeScheduler();
+            for (uint32_t iteration = 0u; iteration < 3u; ++iteration)
+            {
+                ee.reset(env.rdram.data(), mainContext);
+                ee.bindMainContextForSyscall(mainContext, env.rdram.data());
+                const uint32_t cached = ee.invocationStackTop();
+                const uint32_t second = env.runtime.reserveAsyncCallbackStack(0x4000u);
+                t.Equals(cached, kKernelArenaEnd - 16u,
+                         "reset must recycle the arena instead of retaining prior allocation state");
+                t.Equals(second, kKernelArenaEnd - 0x4000u - 16u,
+                         "a stale cached lease must not alias the first post-reset reservation");
+                t.Equals(ee.invocationStackTop(), cached,
+                         "same owner/depth should reuse its existing lease");
+            }
+        });
+
+        tc.Run("callback arena exhaustion stays below application memory and above kernel mirrors", [](TestCase &t)
+        {
+            TestEnv env;
+            auto *ram = env.rdram.data();
+            std::memset(ram + 0x00080000u, 0xA7u, kKernelArenaBegin - 0x00080000u);
+            for (uint32_t i = 0u; i < kArenaLeaseCount; ++i)
+            {
+                const uint32_t top = env.runtime.reserveAsyncCallbackStack(0x4000u);
+                t.Equals(top, kKernelArenaEnd - i * 0x4000u - 16u,
+                         "each callback lease must be a distinct descending kernel interval");
+                std::memset(ram + top + 16u - 0x4000u, 0x55u, 0x4000u);
+            }
+            t.Equals(env.runtime.reserveAsyncCallbackStack(0x4000u), 0u,
