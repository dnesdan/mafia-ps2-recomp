+            t.IsTrue(std::all_of(ram + 0x00080000u, ram + kKernelArenaBegin,
+                                [](uint8_t value) { return value == 0xA7u; }),
+                     "all callback frames must preserve the original alarm trampoline and its stack workspace");
+        });
