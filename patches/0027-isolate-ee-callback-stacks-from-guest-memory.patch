new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ee_memory_layout.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2x::ee
+{
+    // The modeled kernel's mirrors end at 0x80000. Linked kernel support can
+    // also install the alarm trampoline at 0x82000 and use a stack below it;
+    // preserve that workspace through 0x84000. This is a modeled kernel arena,
+    // not a claim that every PS2 kernel leaves this interval unused. Reject
+    // application ELF, thread and heap declarations that conflict with it.
+    inline constexpr uint32_t kKernelMirrorLimit = 0x00080000u;
+    inline constexpr uint32_t kCallbackStackBase = 0x00084000u;
+    inline constexpr uint32_t kCallbackStackLimit = 0x00100000u;
+    inline constexpr uint32_t kRdramSize = 0x02000000u;
+
+    inline constexpr uint32_t callbackStackPhysicalAddress(uint32_t address)
+    {
+        // Generated RAM helpers support 32 MiB mirrors, including all of the
+        // 0x20000000..0x3fffffff uncached window. Conservatively include every
+        // such alias when checking ownership, not only the KSEG0/KSEG1 bits.
+        return address & (kRdramSize - 1u);
+    }
+
+    inline constexpr bool overlapsCallbackStackArena(uint32_t address, uint64_t size)
+    {
+        if (size == 0u)
+            return false;
+        if (size >= kRdramSize)
+            return true;
+        const uint32_t physical = callbackStackPhysicalAddress(address);
+        const uint64_t end = uint64_t(physical) + size;
+        return (physical < kCallbackStackLimit && end > kCallbackStackBase) ||
+               (end > kRdramSize && end - kRdramSize > kCallbackStackBase);
+    }
+
+    inline constexpr bool callbackStackContainsStackPointer(uint32_t address)
+    {
+        const uint32_t physical = callbackStackPhysicalAddress(address);
+        // A descending stack whose initial SP is the exclusive upper boundary
+        // would immediately enter the reserved arena on its first frame.
+        return physical > kCallbackStackBase && physical <= kCallbackStackLimit;
+    }
+}
