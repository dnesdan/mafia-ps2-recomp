+        const Alter examples[] = {
+            [](auto &, auto &cpu) { cpu.gpr[4] = 0u; },
+            [](auto &, auto &cpu) { cpu.gpr[4] = 0xC0014000u; },
+            [](auto &f, auto &) { f.text(f.path, "authored2147483648:"); },
+            [](auto &f, auto &) { f.memory.write32(f.device + 16u, 0u); },
+            [](auto &f, auto &) { f.memory.write32(f.device + 16u, 0x13201u); },
+            [](auto &f, auto &) { f.memory.write32(f.device + 16u, 0xA01FFFC0u); },
+            [](auto &f, auto &) { f.memory.write32(f.device + 16u, 0x8000u); },
+            [](auto &f, auto &) { f.memory.write32(f.ops + 92u, 0u); },
+            [](auto &f, auto &) { f.memory.write32(f.ops + 92u, 0x13301u); },
+            [](auto &f, auto &) { f.memory.write32(f.ops + 92u, 0xC0013300u); },
+            [](auto &f, auto &) { f.memory.write32(f.ops + 92u, 0x8000u); },
+            [](auto &, auto &cpu) { cpu.gpr[29] = 0u; },
+            [](auto &, auto &cpu) { cpu.gpr[29] = 0x15001u; },
+            [](auto &, auto &cpu) { cpu.gpr[29] = 0xA01FFFF0u; },
+            [](auto &, auto &cpu) { cpu.gpr[29] = 0xFFFFFFF0u; },
+            [](auto &, auto &cpu) { cpu.gpr[29] = 0x8000u; },
+            [](auto &, auto &cpu) { cpu.gpr[6] = 0u; },
+            [](auto &, auto &cpu) { cpu.gpr[6] = 0x8000u; },
+            [](auto &, auto &cpu) { cpu.gpr[6] = 0xC0016000u; },
+            [](auto &, auto &cpu) { cpu.gpr[6] = 0xA01FFFFCu; },
+            [](auto &, auto &cpu) { cpu.gpr[7] = 21u; },
+            [](auto &, auto &cpu) { cpu.gpr[7] = 0xFFFFFFFFu; },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 16u, 0u); },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 16u, 0x8000u); },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 16u, 0xC0017000u); },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 16u, 0xA01FFFFCu); },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 20u, 13u); },
+            [](auto &f, auto &) { f.memory.write32(f.stack + 20u, 0xFFFFFFFFu); },
+        };
+        for (const auto &alter : examples)
+        {
+            RegisteredFixture f;
+            auto cpu = f.arguments();
+            alter(f, cpu);
+            const std::vector<uint8_t> before(f.memory.ram().begin(), f.memory.ram().end());
+            const uint32_t freeBefore = f.memory.totalFreeMemory();
+            bool rejected = false;
+            try { f.invoke(cpu); }
+            catch (const std::runtime_error &error) { rejected = std::string_view(error.what()).find("IOP Devctl") != std::string_view::npos; }
+            require(rejected && f.executor.calls == 0u && cpu.gpr[2] == 0xDEADBEEFu &&
+                        f.memory.totalFreeMemory() == freeBefore &&
+                        std::equal(before.begin(), before.end(), f.memory.ram().begin()),
+                    "invalid registered Devctl reached callback, result write or allocation");
+        }
+    }
+
+    void temporaryRecordCleanupAndRecursiveMutation()
+    {
+        for (bool throwFromCallback : {false, true})
+        {
+            RegisteredFixture f;
+            auto cpu = f.arguments();
+            const uint32_t freeBefore = f.memory.totalFreeMemory();
+            f.executor.callback = [&](const DriverCall &) -> uint32_t
+            {
+                IopCpuState del{};
+                del.gpr[4] = f.name;
+                require(f.ioman.dispatchImport(21u, del, f.executor) && del.gpr[2] == 0u,
+                        "recursive driver deletion failed");
+                if (throwFromCallback)
+                    throw std::runtime_error("authored original driver failure");
+                return 0x5A1234u;
+            };
+            bool rejected = false;
+            try { f.invoke(cpu); }
+            catch (const std::runtime_error &error) { rejected = std::string_view(error.what()) == "authored original driver failure"; }
+            require(rejected == throwFromCallback && f.executor.calls == 1u &&
+                        cpu.gpr[2] == (throwFromCallback ? 0xDEADBEEFu : 0x5A1234u) &&
+                        f.memory.totalFreeMemory() == freeBefore,
+                    "callback return/exception lost or temporary descriptor leaked");
+            require(!f.ioman.dispatchImport(31u, cpu, f.executor), "deleted driver retained a callback");
+        }
+        RegisteredFixture f;
+        auto cpu = f.arguments();
+        uint32_t replacement = 0u;
+        uint64_t replacementIdentity = 0u;
+        f.executor.callback = [&](const DriverCall &call)
+        {
+            require(f.memory.freeAllocation(call.arguments[0]), "fixture could not release temporary record");
+            replacement = f.memory.allocate(16u);
+            require(replacement == call.arguments[0], "fixture did not reuse released address");
+            replacementIdentity = f.memory.allocationContaining(replacement)->identity;
+            f.memory.write32(replacement, 0x1234ABCDu);
+            return 7u;
+        };
+        f.invoke(cpu);
+        const auto live = f.memory.allocationContaining(replacement);
+        require(live && live->identity == replacementIdentity && f.memory.read32(replacement) == 0x1234ABCDu,
+                "temporary-record guard freed a newer guest allocation at the same address");
+    }
+
+    // These programs contain only authored MIPS instructions and data.
+    struct Program
+    {
+        iop_test::Irx &image;
+        uint32_t pc;
+        void emit(uint32_t word) { image.words(pc, {word}); pc += 4u; }
+        void li(uint32_t reg, uint32_t value)
+        { emit(0x3C000000u | (reg << 16u) | (value >> 16u)); emit(0x34000000u | (reg << 21u) | (reg << 16u) | (value & 0xFFFFu)); }
+        void sw(uint32_t reg, uint32_t base, uint16_t offset)
+        { emit(0xAC000000u | (base << 21u) | (reg << 16u) | offset); }
+        void lw(uint32_t reg, uint32_t base, uint16_t offset)
+        { emit(0x8C000000u | (base << 21u) | (reg << 16u) | offset); emit(0u); }
+        void jal(uint32_t address) { emit(0x0C000000u | (address >> 2u)); emit(0u); }
+        void begin() { emit(0x27BDFFC0u); sw(31u, 29u, 60u); }
+        void end() { lw(31u, 29u, 60u); emit(0x27BD0040u); emit(0x03E00008u); emit(0u); }
+    };
+
+    inline void string(iop_test::Irx &image, uint32_t offset, std::string_view value)
+    {
+        require(0x100u + offset + value.size() < image.bytes.size(), "authored string outside image");
+        std::memcpy(image.bytes.data() + 0x100u + offset, value.data(), value.size());
+        image.bytes[0x100u + offset + value.size()] = 0u;
+    }
+
+    inline uint32_t readWord(IopEmulator &iop, uint32_t address)
+    {
+        uint32_t value = 0u;
+        require(iop.readMemory(address, &value, sizeof(value)), "authored observation outside RAM");
+        return value;
+    }
+
+    iop_test::Irx driverImage(bool nested, uint32_t result = 0x13579BDFu,
+                              std::string_view deviceName = "route", uint32_t command = 0x4396u)
+    {
+        constexpr uint32_t base = 0x10000u;
+        iop_test::Irx image(base, 0x1800u);
+        string(image, 0xD00u, deviceName);
+        string(image, 0xD20u, "inner");
+        string(image, 0xD40u, std::string(deviceName) + "12:tail");
+        string(image, 0xD80u, "inner0:child");
+        image.words(0xC00u, {base + 0xD00u, 0x10000010u, 1u, 0u, base + 0xC40u});
+        image.words(0xC20u, {base + 0xD20u, 0x10000010u, 1u, 0u, base + 0xCC0u});
+        image.words(0xC40u + 92u, {base + 0x500u});
+        image.words(0xCC0u + 92u, {base + 0x800u});
+        image.words(0xE00u, {80u, 5u, 0x12345678u, 5u, 0xA5B6C7D8u, 0xCAFEBABEu});
+        image.words(0xE40u, {0xCCCCCCCCu, 0xCCCCCCCCu, 0xCCCCCCCCu});
+        image.words(0xE80u, {0xDDDDDDDDu});
+        image.words(0xA00u, {0x41E00000u, 0u, 0x0104u, 0x616D6F69u, 0x0000006Eu,
+            0x03E00008u, 0x24000014u, 0x03E00008u, 0x24000015u,
+            0x03E00008u, 0x2400001Fu, 0u, 0u});
+        Program entry{image, 0u};
+        entry.begin();
+        entry.li(28u, 0x11223344u);
+        entry.li(4u, base + 0xC00u); entry.jal(base + 0xA14u);
+        if (nested) { entry.li(4u, base + 0xC20u); entry.jal(base + 0xA14u); }
+        entry.li(28u, 0x55667788u);
+        entry.li(8u, base + 0xF00u); entry.sw(29u, 8u, 0u);
+        entry.li(4u, base + 0xD40u); entry.li(5u, command);
+        entry.li(6u, base + 0xE00u); entry.li(7u, 20u);
+        entry.li(8u, base + 0xE40u); entry.sw(8u, 29u, 16u);
+        entry.li(8u, 4u); entry.sw(8u, 29u, 20u);
+        entry.li(8u, 0xCAFE1234u); entry.sw(8u, 29u, 24u);
+        entry.jal(base + 0xA24u);
+        entry.li(8u, base + 0xF00u); entry.sw(2u, 8u, 4u); entry.sw(28u, 8u, 8u);
+        entry.lw(9u, 29u, 24u); entry.sw(9u, 8u, 12u);
+        entry.li(2u, 0u); entry.end();
+
+        Program driver{image, 0x500u};
+        // Observe all arguments before allocating a normal guest frame.
+        driver.li(8u, base + 0xF20u);
+        for (uint32_t reg = 4u; reg <= 7u; ++reg) driver.sw(reg, 8u, static_cast<uint16_t>((reg - 4u) * 4u));
+        for (uint16_t offset : {16u, 20u, 24u}) { driver.lw(9u, 29u, offset); driver.sw(9u, 8u, offset); }
+        driver.sw(28u, 8u, 28u); driver.sw(29u, 8u, 32u);
+        for (uint16_t offset : {0u, 4u, 8u, 12u}) { driver.lw(9u, 4u, offset); driver.sw(9u, 8u, 36u + offset); }
+        driver.lw(9u, 7u, 16u); driver.lw(10u, 29u, 20u); driver.sw(9u, 10u, 0u);
+        driver.begin();
+        if (nested)
+        {
+            driver.li(4u, base + 0xD80u); driver.li(5u, 0x87654321u);
+            driver.li(6u, base + 0xE00u); driver.li(7u, 8u);
+            driver.li(8u, base + 0xE80u); driver.sw(8u, 29u, 16u);
+            driver.li(8u, 4u); driver.sw(8u, 29u, 20u);
+            driver.jal(base + 0xA24u);
+            driver.li(8u, base + 0xF60u); driver.sw(2u, 8u, 0u);
+            for (uint16_t offset : {16u, 20u, 24u})
+            { driver.lw(9u, 29u, 64u + offset); driver.sw(9u, 8u, offset - 12u); }
+        }
+        driver.li(2u, result); driver.end();
+
+        Program inner{image, 0x800u};
+        inner.li(8u, base + 0xFA0u); inner.sw(29u, 8u, 0u); inner.sw(28u, 8u, 4u);
+        inner.sw(6u, 8u, 8u); inner.lw(9u, 29u, 16u); inner.sw(9u, 8u, 12u);
+        inner.lw(10u, 29u, 20u); inner.sw(6u, 10u, 0u);
+        inner.li(2u, 0x123u); inner.emit(0x03E00008u); inner.emit(0u);
+        return image;
+    }
+
+    void authoredDriverReceivesSevenO32Arguments()
+    {
+        for (const auto &[name, command, result] : {
+            std::tuple{"route", 0x4396u, 0x13579BDFu}, std::tuple{"cdrom", 0x4391u, static_cast<uint32_t>(-123)}})
+        {
+            iop_test::Host host;
+            IopEmulator iop(host);
+            const auto image = driverImage(false, result, name, command);
+            const auto loaded = iop.loadModuleImage("authored-driver", image.bytes, nullptr, 0u);
+            require(loaded.moduleId > 0 && loaded.startResult == 0 &&
+                        readWord(iop, 0x10F04u) == result && readWord(iop, 0x10F08u) == 0x55667788u &&
+                        readWord(iop, 0x10F0Cu) == 0xCAFE1234u,
+                    "authored driver result or caller GP/home area was replaced");
+            require(readWord(iop, 0x10F24u) == 0x10D40u + std::string_view(name).size() + 3u &&
+                        readWord(iop, 0x10F28u) == command && readWord(iop, 0x10F2Cu) == 0x10E00u &&
+                        readWord(iop, 0x10F30u) == 20u && readWord(iop, 0x10F34u) == 0x10E40u &&
+                        readWord(iop, 0x10F38u) == 4u && readWord(iop, 0x10F3Cu) == 0x11223344u &&
+                        readWord(iop, 0x10F44u) == 0u && readWord(iop, 0x10F48u) == 12u &&
+                        readWord(iop, 0x10F4Cu) == 0x10C00u && readWord(iop, 0x10F50u) == 0u,
+                    "actual guest driver did not see the declared seven-argument IOMAN ABI");
+            require(readWord(iop, 0x10F40u) < readWord(iop, 0x10F00u) &&
+                        readWord(iop, 0x10E40u) == 0xA5B6C7D8u && readWord(iop, 0x10E44u) == 0xCCCCCCCCu &&
+                        readWord(iop, 0x10E14u) == 0xCAFEBABEu && host.guestWrites == 0u,
+                    "driver bypassed its own instructions, used the caller stack or overran its opaque payload");
+        }
+    }
+
+    void nestedAuthoredDriverCallsKeepIndependentStacks()
+    {
+        iop_test::Host host;
+        IopEmulator iop(host);
+        const auto image = driverImage(true);
+        require(iop.loadModuleImage("authored-nested-driver", image.bytes, nullptr, 0u).moduleId > 0,
+                "nested authored driver failed");
+        require(readWord(iop, 0x10F04u) == 0x13579BDFu && readWord(iop, 0x10F60u) == 0x123u &&
+                    readWord(iop, 0x10F64u) == 20u && readWord(iop, 0x10F68u) == 0x10E40u &&
+                    readWord(iop, 0x10F6Cu) == 4u && readWord(iop, 0x10E80u) == 0x87654321u &&
+                    readWord(iop, 0x10FA0u) < readWord(iop, 0x10F40u) &&
+                    readWord(iop, 0x10FA4u) == 0x11223344u && readWord(iop, 0x10FA8u) == 0x87654321u &&
+                    readWord(iop, 0x10FACu) == 8u,
+                "nested real callbacks overwrote arguments, saved GP or the suspended caller frame");
+    }
+
+    iop_test::Irx suppliedIomanProvider(uint16_t providerVersion, uint16_t requestedVersion)
+    {
+        auto image = driverImage(false);
+        image.words(0xA00u + 8u, {requestedVersion});
+        image.words(0xA80u, {0x41E00000u, 0u, 0x0101u, 0x64616F6Cu, 0x65726F63u,
+            0x03E00008u, 0x24000006u, 0u, 0u});
+        image.words(0xB00u, {0x41C00000u, 0u, providerVersion, 0x616D6F69u, 0x0000006Eu});
+        for (uint32_t ordinal = 0u; ordinal <= 31u; ++ordinal) image.words(0xB14u + ordinal * 4u, {0x10900u});
+        Program entry{image, 0u};
+        entry.begin();
+        entry.li(4u, 0x10C00u); entry.jal(0x10A14u);
+        entry.li(4u, 0x10B00u); entry.jal(0x10A94u);
+        entry.li(4u, 0xFFFFFFFFu); entry.li(5u, 0x4391u); entry.li(6u, 0xDEADBEEFu); entry.li(7u, 0xFFFFFFFFu);
+        entry.jal(0x10A24u);
+        entry.li(8u, 0x10F00u); entry.sw(2u, 8u, 0u);
+        entry.li(2u, 0u); entry.end();
+        Program provider{image, 0x900u};
+        provider.li(8u, 0x10F80u); provider.sw(4u, 8u, 0u); provider.sw(5u, 8u, 4u);
+        provider.li(2u, 0x7B5u); provider.emit(0x03E00008u); provider.emit(0u);
+        return image;
+    }
+
+    void suppliedIomanExportRunsBeforeModeledValidation()
+    {
+        for (const auto &[provided, requested] : {std::pair<uint16_t, uint16_t>{0x0101u, 0x0104u},
+                                                 {0x0106u, 0x0104u}, {0x0201u, 0x0204u}})
+        {
+            iop_test::Host host;
+            IopEmulator iop(host);
+            const auto image = suppliedIomanProvider(provided, requested);
+            require(iop.loadModuleImage("authored-ioman-provider", image.bytes, nullptr, 0u).moduleId > 0 &&
+                        readWord(iop, 0x10F00u) == 0x7B5u && readWord(iop, 0x10F80u) == 0xFFFFFFFFu &&
+                        readWord(iop, 0x10F84u) == 0x4391u && host.guestWrites == 0u,
+                    "modeled Devctl intercepted a compatible original export or validated its private pointers");
+        }
+        iop_test::Host host;
+        IopEmulator iop(host);
+        const auto image = suppliedIomanProvider(0x0101u, 0x0204u);
+        bool rejected = false;
+        try { (void)iop.loadModuleImage("authored-wrong-major", image.bytes, nullptr, 0u); }
+        catch (const std::runtime_error &error) { rejected = std::string_view(error.what()).find("missing import ioman:31") != std::string_view::npos; }
+        require(rejected, "incompatible IOMAN major acquired an export or modeled fallback");
+    }
+
+    void originalDriverFaultsRemainStrict()
+    {
+        for (uint32_t fault : {0xFFFFFFFFu, 0x0000000Du})
+        {
+            iop_test::Host host;
+            IopEmulator iop(host);
+            auto image = driverImage(false);
+            image.words(0x500u, {fault});
+            bool rejected = false;
+            try { (void)iop.loadModuleImage("authored-faulting-driver", image.bytes, nullptr, 0u); }
+            catch (const std::runtime_error &error)
+            { rejected = std::string_view(error.what()).find("CPU instruction exception") != std::string_view::npos; }
+            require(rejected && readWord(iop, 0x10F04u) == 0u && readWord(iop, 0x10E40u) == 0xCCCCCCCCu &&
+                        host.guestWrites == 0u,
+                    "original driver fault became a fabricated return or output");
+        }
+    }
