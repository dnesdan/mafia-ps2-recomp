+        uint32_t address = 0u, gp = 0u;
+        std::array<uint32_t, 7u> arguments{};
+    };
+
+    class RecordingExecutor final : public IopGuestExecutor
+    {
+    public:
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override
+        {
+            throw std::runtime_error("unexpected four-argument driver call");
+        }
+
+        // Kept callable against the prior executor interface for the same
+        // authored test program's failing-baseline build.
+        virtual uint32_t executeGuestFunctionWithStackArguments(
+            uint32_t address, uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3,
+            uint32_t gp, std::span<const uint32_t> tail)
+        {
+            require(tail.size() == 3u, "driver did not receive all three O32 stack arguments");
+            last = {address, gp, {a0, a1, a2, a3, tail[0], tail[1], tail[2]}};
+            ++calls;
+            return callback ? callback(last) : 0xFFFFFF85u;
+        }
+
+        DriverCall last;
+        size_t calls = 0u;
+        std::function<uint32_t(const DriverCall &)> callback;
+    };
+
+    struct RegisteredFixture
+    {
+        static constexpr uint32_t name = 0x13000u, device = 0x13100u, ops = 0x13200u;
+        static constexpr uint32_t function = 0x13300u, path = 0x14000u, stack = 0x15000u;
+        static constexpr uint32_t input = 0x16000u, output = 0x17000u, gp = 0x13572468u;
+        iop_test::Host host;
+        IopMemory memory;
+        IopKernel kernel{memory};
+        IopCdvd cdvd{host, memory, kernel};
+        IopIoman ioman{host, memory, cdvd};
+        RecordingExecutor executor;
+
+        RegisteredFixture()
+        {
+            text(name, "authored");
+            require(memory.zeroRam(device, 20u) && memory.zeroRam(ops, 96u), "driver metadata setup failed");
+            memory.write32(device, name);
+            memory.write32(device + 4u, 0x10000010u);
+            memory.write32(device + 16u, ops);
+            memory.write32(ops + 92u, function);
+            memory.write32(function, 0x03E00008u);
+            add();
+        }
+
+        void text(uint32_t address, std::string_view value)
