+    void le32(uint8_t *p, uint32_t value)
+    { for (size_t i = 0u; i < 4u; ++i) p[i] = static_cast<uint8_t>(value >> (8u * i)); }
+    void both32(uint8_t *p, uint32_t value)
+    {
+        le32(p, value);
+        for (size_t i = 0u; i < 4u; ++i) p[4u + i] = static_cast<uint8_t>(value >> (24u - 8u * i));
+    }
+    void both16(uint8_t *p, uint16_t value)
+    { p[0] = p[3] = static_cast<uint8_t>(value); p[1] = p[2] = static_cast<uint8_t>(value >> 8u); }
+    size_t record(uint8_t *p, uint32_t lsn, uint32_t bytes, uint8_t flags, std::string_view name, bool systemUse = false)
+    {
+        size_t length = 33u + name.size();
+        length += length & 1u;
+        if (systemUse) length += 14u;
+        std::memset(p, 0u, length);
+        p[0] = static_cast<uint8_t>(length);
+        both32(p + 2u, lsn); both32(p + 10u, bytes);
+        const uint8_t date[] = {124u, 2u, 29u, 17u, 43u, 51u, 0xE0u};
+        std::memcpy(p + 18u, date, sizeof(date));
+        p[25] = flags; both16(p + 28u, 1u); p[32] = static_cast<uint8_t>(name.size());
+        std::memcpy(p + 33u, name.data(), name.size());
+        if (systemUse) std::fill_n(p + length - 14u, 14u, 0xA5u);
+        return length;
+    }
