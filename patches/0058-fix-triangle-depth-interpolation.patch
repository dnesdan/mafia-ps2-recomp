+// Triangle depth invariance and bounded interpolation for Z32.
+#include "MiniTest.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/gs/gs_frontend.h"
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+struct ZCase { uint32_t z0, z1, z2; };
+void runTriangle(TestCase &t, bool packed, bool reverse, ZCase z) {
+    std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0);
+    GS gs;
+    gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+    gs.writeRegister(GS_REG_FRAME_1, 1ull << 16);
+    gs.writeRegister(GS_REG_ZBUF_1, 1ull);
+    gs.writeRegister(GS_REG_SCISSOR_1, (7ull << 16) | (7ull << 48));
+    gs.writeRegister(GS_REG_XYOFFSET_1, 0);
+    gs.writeRegister(GS_REG_TEST_1, (1ull << 16) | (2ull << 17)); // Z >=
+    gs.writeRegister(GS_REG_PRMODECONT, 1);
+    gs.writeRegister(GS_REG_PRIM, GS_PRIM_TRIANGLE);
+    gs.writeRegister(GS_REG_RGBAQ, 0x800000ffull);
+    auto vertex = [&](uint32_t x, uint32_t y, uint32_t value) {
+        if (packed) {
+            const uint64_t tag = 1ull | (1ull << 15) | (1ull << 60);
+            const uint64_t reg = 5, xy = (uint64_t(x) << 4) | (uint64_t(y) << 36);
+            const uint64_t depth = value;
+            uint8_t packet[32];
+            std::memcpy(packet, &tag, 8);
+            std::memcpy(packet + 8, &reg, 8);
+            std::memcpy(packet + 16, &xy, 8);
+            std::memcpy(packet + 24, &depth, 8);
+            gs.processGIFPacket(packet, sizeof(packet));
+        } else {
+            gs.writeRegister(GS_REG_XYZ2, (uint64_t(x) << 4) |
+                             (uint64_t(y) << 20) | (uint64_t(value) << 32));
+        }
+    };
+    vertex(0, 0, z.z0);
+    if (reverse) { vertex(0, 7, z.z2); vertex(7, 0, z.z1); }
+    else { vertex(7, 0, z.z1); vertex(0, 7, z.z2); }
+    for (uint32_t y = 0; y < 7; ++y) for (uint32_t x = 0; x < 7; ++x) {
+        if (x + y > 5) continue; // 21 strictly interior pixel centers
+        t.Equals(gs.ReadVram(GS_PSM_CT32, 0, 1, x, y), 0x800000ffu, "interior pixel drawn");
+        if (z.z0 == z.z1 && z.z1 == z.z2)
+            t.Equals(gs.ReadVram(GS_PSM_Z32, 32, 1, x, y), z.z0, "constant triangle depth");
+    }
+    if (z.z0 == 1000 && z.z1 == 3000 && z.z2 == 5000)
+        t.Equals(gs.ReadVram(GS_PSM_Z32, 32, 1, 1, 1), 2286u, "ordinary interpolated depth");
+}
+}
+void register_ps2_gs_triangle_z_tests() {
+    MiniTest::Case("GSTriangleZ", [](TestCase &tests) {
+        constexpr std::array<uint32_t, 8> values{
+            0u, 1u, 0x00ffffffu, 0x01000001u,
+            0x7fffffffu, 0xffffff00u, 0xfffffffeu, 0xffffffffu};
+        const std::array<ZCase,3> gradients{ZCase{1000,3000,5000}, ZCase{0,0xffffffffu,0xffffffffu},
+                                           ZCase{0xffffffffu,0,0}};
+        for (bool packed : {false, true}) for (bool reverse : {false, true}) {
+            const std::string prefix = std::string(packed ? "packed" : "direct") + (reverse ? " reverse " : " forward ");
+            for (size_t i = 0; i < values.size(); ++i) {
+                const uint32_t z = values[i];
+                tests.Run(prefix + "constant " + std::to_string(i), [=](TestCase &t) { runTriangle(t, packed, reverse, {z,z,z}); });
+            }
+            for (size_t i = 0; i < gradients.size(); ++i) {
+                const ZCase z = gradients[i];
+                tests.Run(prefix + "gradient " + std::to_string(i), [=](TestCase &t) { runTriangle(t, packed, reverse, z); });
+            }
+        }
+    });
+}
