+        // PS2SDK ee/startup/include/startup.h: argc, 16 EE argv pointers,
+        // and a 256-byte string payload. crt0 supplies this buffer in $a3.
+        constexpr size_t kStartupArgvCount = 16u;
+        constexpr size_t kStartupPayloadSize = 256u;
+        constexpr size_t kStartupPayloadOffset = sizeof(uint32_t) * (1u + kStartupArgvCount);
+        constexpr size_t kStartupArgsSize = kStartupPayloadOffset + kStartupPayloadSize;
+        static_assert(kStartupArgsSize == 324u);
+
+        bool relativeBootPath(const std::filesystem::path &path,
+                              const std::filesystem::path &root,
+                              std::string &relative)
+        {
+            if (root.empty())
+            {
+                return false;
+            }
+            const std::filesystem::path candidate = path.lexically_normal().lexically_relative(root.lexically_normal());
+            if (candidate.empty() || candidate.is_absolute())
+            {
+                return false;
+            }
+            for (const auto &part : candidate)
+            {
+                if (part == ".." || part == ".")
+                {
+                    return false;
+                }
+            }
+            relative = candidate.generic_string();
+            // A colon would introduce another PS2 device; backslashes in a
+            // native filename would be reinterpreted as guest separators.
+            return !relative.empty() && relative.find_first_of(":\\") == std::string::npos &&
+                   relative.find('\0') == std::string::npos;
+        }
+
+        std::string bootExecutableArgument()
+        {
+            const PS2Runtime::IoPaths &paths = PS2Runtime::getIoPaths();
+            if (paths.elfPath.empty())
+            {
+                return {}; // Bare runtime fixtures have no configured program.
+            }
+            std::string relative;
+            if (relativeBootPath(paths.elfPath, paths.cdRoot, relative))
+            {
+                std::replace(relative.begin(), relative.end(), '/', '\\');
+                // Host extraction commonly strips the ISO9660 version. Preserve
+                // an explicit numeric version; otherwise use the first version.
+                const size_t version = relative.find(';');
+                if (version == std::string::npos)
+                {
+                    relative += ";1";
+                }
+                else if (version + 1u == relative.size() ||
+                         !std::all_of(relative.begin() + version + 1u, relative.end(),
+                                      [](unsigned char character) { return character >= '0' && character <= '9'; }))
+                {
+                    throw std::runtime_error("SetupThread: CD boot path has a malformed ISO9660 version suffix");
+                }
+                return "cdrom0:\\" + relative;
+            }
+            if (relativeBootPath(paths.elfPath, paths.hostRoot, relative))
+            {
+                return "host:" + relative;
+            }
+            throw std::runtime_error("SetupThread: configured ELF is outside the guest CD/host roots or has an invalid guest path");
+        }
+
+        void populateStartupArguments(uint8_t *rdram, uint32_t address)
+        {
+            if (address == 0u)
+            {
+                return; // Older callers may omit the optional argument buffer.
+            }
+            uint32_t offset = 0u;
+            bool scratch = false;
+            if (!rdram || (address & 3u) != 0u ||
+                !resolveEeGuestRange(address, kStartupArgsSize, offset, scratch) || scratch)
+            {
+                throw std::runtime_error("SetupThread: startup argument buffer is not a complete aligned EE RAM range");
+            }
+            const std::string argument = bootExecutableArgument();
+            if (argument.size() >= kStartupPayloadSize)
+            {
+                throw std::runtime_error("SetupThread: executable argument exceeds the 256-byte startup payload");
+            }
+            std::array<uint8_t, kStartupArgsSize> arguments{};
+            if (!argument.empty())
+            {
+                arguments[0] = 1u; // Little-endian argc = 1; argv[1..15] stay null.
+                const uint32_t payloadAddress = address + static_cast<uint32_t>(kStartupPayloadOffset);
+                for (size_t byte = 0; byte < sizeof(uint32_t); ++byte)
+                {
+                    arguments[sizeof(uint32_t) + byte] = static_cast<uint8_t>(payloadAddress >> (byte * 8u));
+                }
+                std::copy(argument.begin(), argument.end(), arguments.begin() + kStartupPayloadOffset);
+            }
+            // Validate everything first so malformed host configuration or guest
+            // bounds cannot partially overwrite the caller's startup storage.
+            std::memcpy(rdram + offset, arguments.data(), arguments.size());
+        }
+    }
