--- a/ps2xRuntime/src/lib/Kernel/Stubs/SIF.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/SIF.cpp
@@ -1023,6 +1023,15 @@ namespace ps2_stubs
 
     void sceSifStopDma(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
+        // PS2SDK kernel.h: this syscall disables SIF0 (IOP -> EE).
+        // Completed transfers stay completed; queued packets remain owned by
+        // the sender until the guest rearms the receive chain or resets IOP.
+        if (runtime)
+        {
+            constexpr uint32_t sif0 = 0x1000C000u;
+            auto &memory = runtime->memory();
+            memory.writeIORegister(sif0, memory.readIORegister(sif0) & ~0x100u);
+        }
         setReturnS32(ctx, 0);
     }
 
