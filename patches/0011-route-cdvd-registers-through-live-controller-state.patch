+        if (!expect(call(8u) == 0u && call(13u, 8u) == 0x41u,
+                    "changing the driver error cache cleared the controller's failed-transfer latch"))
+            return false;
+        host.failSectorRead = false;
+        host.throwSectorRead = true;
+        bool threw = false;
+        try { (void)call(6u, 1u, 1u, destination); }
+        catch (const std::runtime_error &error)
+        {
+            threw = std::string_view(error.what()) == "authored host read failure";
+        }
+        if (!expect(threw && observations == 3u && memory.read32(destination) == 0xAABBCCDDu,
