+    bool testCdvdControllerReadLifecycle()
+    {
+        SectorImageHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopCdvd cdvd(host, memory, kernel);
+        const auto call = [&](uint16_t ordinal, uint32_t a0 = 0u, uint32_t a1 = 0u,
+                              uint32_t a2 = 0u)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = a0;
+            cpu.gpr[5] = a1;
+            cpu.gpr[6] = a2;
+            if (!cdvd.dispatchImport(ordinal, cpu))
+                throw std::runtime_error("authored CDVD import was not handled");
+            return cpu.gpr[2];
+        };
+        (void)call(4u);
+        if (!expect(memory.read8(0xBF40200Fu) == 0x14u && call(12u) == 0x14u,
+                    "available sector backing was not reflected in the common disc-type view") ||
+            !expect(memory.read8(0xBF40200Au) == 0x0Au && call(28u) == 0x0Au && call(13u) == 2u,
+                    "initialized idle media did not have consistent paused state"))
+            return false;
+        const uint32_t destination = memory.allocate(2048u);
+        if (!expect(destination != 0u, "could not allocate the authored sector destination"))
+            return false;
+        uint32_t observations = 0u;
+        host.onSectorRead = [&]
+        {
+            ++observations;
+            if (memory.read8(0xBF402005u) != 0x80u || call(13u, 8u) != 0x80u ||
+                memory.read8(0xBF40200Au) != 0x06u || call(28u) != 0x06u ||
+                call(50u, static_cast<uint32_t>(-3)) != 1u || call(13u) != 6u)
+                throw std::runtime_error("active host read did not expose BUSY/read-active consistently");
+        };
+        if (!expect(call(6u, 1u, 1u, destination) == 1u && observations == 1u,
+                    "authored sector read did not execute the real host read") ||
+            !expect(memory.read32(destination) == 0x36251403u &&
+                    memory.read8(destination + 2047u) == host.image[4095u],
+                    "sector read did not copy the authored bytes") ||
+            !expect(memory.read8(0xBF402005u) == 0x40u && call(50u, static_cast<uint32_t>(-3)) == 0u,
+                    "successful synchronous read left the controller busy"))
+            return false;
+
+        memory.write32(destination, 0xAABBCCDDu);
+        host.failSectorRead = true;
+        if (!expect(call(6u, 1u, 1u, destination) == 0u && observations == 2u,
+                    "failed host transfer acquired a successful result") ||
+            !expect(memory.read32(destination) == 0xAABBCCDDu,
+                    "failed host transfer changed the guest destination") ||
+            !expect(memory.read8(0xBF402005u) == 0x41u && call(8u) == 0x30u &&
+                    call(50u, static_cast<uint32_t>(-3)) == 0u,
+                    "failed transfer did not clear BUSY while retaining its real error"))
+            return false;
+        constexpr uint32_t softwareError = 0x2100u;
