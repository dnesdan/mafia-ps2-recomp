+        SectorImageHost()
+        {
+            // Authored bytes exercise the existing sector-backed device model.
+            // No original image or proprietary module is involved.
+            image[16u * 2048u] = 1u;
+            std::memcpy(image.data() + 16u * 2048u + 1u, "CD001", 5u);
+            image[16u * 2048u + 6u] = 1u;
+            for (size_t i = 0u; i < 2048u; ++i)
+                image[2048u + i] = static_cast<uint8_t>(i * 17u + 3u);
+        }
+
+        std::string hostPath(HostPathKind kind) const override
+        {
+            return kind == HostPathKind::CdImage ? "authored-sectors.iso" : std::string{};
+        }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            return path == "authored-sectors.iso" ? 1u : 0u;
+        }
+        bool hostFileSize(uint64_t handle, uint64_t &size) const override
+        {
+            size = image.size();
+            return handle == 1u;
+        }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *destination,
+                          size_t wanted, size_t &bytesRead) override
+        {
+            bytesRead = 0u;
+            if (handle != 1u || offset > image.size() || wanted > image.size() - offset)
+                return false;
+            if (wanted == 2048u)
+            {
+                if (onSectorRead)
+                    onSectorRead();
+                if (throwSectorRead)
+                    throw std::runtime_error("authored host read failure");
+                if (failSectorRead)
+                    return false;
+            }
+            std::memcpy(destination, image.data() + offset, wanted);
+            bytesRead = wanted;
+            return true;
+        }
+
+        std::array<uint8_t, 18u * 2048u> image{};
+        std::function<void()> onSectorRead;
+        bool failSectorRead = false;
