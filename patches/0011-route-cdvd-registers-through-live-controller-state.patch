+    bool testCdvdControllerWithoutMedia()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopCdvd cdvd(host, memory, kernel);
+        const auto call = [&](uint16_t ordinal, uint32_t a0 = 0u, uint32_t a1 = 0u)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = a0;
+            cpu.gpr[5] = a1;
+            if (!cdvd.dispatchImport(ordinal, cpu))
+                throw std::runtime_error("authored CDVD import was not handled");
+            return cpu.gpr[2];
+        };
+        if (!expect(memory.read8(0xBF402005u) == 0x40u && call(13u, 8u) == 0x40u,
+                    "an idle controller without media must still accept a command") ||
+            !expect(memory.read8(0xBF40200Fu) == 0u && call(12u) == 0u,
+                    "absent backing was reported as an inserted disc") ||
+            !expect(memory.read8(0xBF40200Au) == 0u && call(28u) == 0u,
+                    "uninitialized no-media device reported a spinning drive") ||
+            !expect(call(13u) == 6u && call(50u, static_cast<uint32_t>(-3)) == 0u,
+                    "controller availability was confused with initialized media or an active read"))
+            return false;
+        uint8_t untouched = 0xA5u;
+        if (!expect(!cdvd.readRegisterByte(0x1F402004u, untouched) &&
+                    !cdvd.readRegisterByte(0x1F402006u, untouched) && untouched == 0xA5u,
+                    "unmodeled command or clear-on-read error port acquired a fabricated value"))
+            return false;
+        (void)call(4u);
+        if (!expect(call(13u) == 6u && call(13u, 8u) == 0x40u && call(12u) == 0u,
+                    "initializing the driver manufactured media"))
+            return false;
+
+        constexpr uint32_t errorAddress = 0x2100u;
+        memory.write8(errorAddress, 0x30u);
+        (void)call(50u, static_cast<uint32_t>(-2), errorAddress);
+        if (!expect(call(8u) == 0x30u, "software GetError did not retain its explicit cached error") ||
+            !expect(memory.read8(0xBF402005u) == 0x40u && call(13u, 8u) == 0x40u,
+                    "writing the software error cache fabricated a controller failure"))
+            return false;
+        cdvd.reset();
+        return expect(memory.read8(0xBF402005u) == 0x40u && call(8u) == 0u &&
+                      call(50u, static_cast<uint32_t>(-3)) == 0u && call(13u) == 6u,
+                      "device reset did not restore idle no-media state through the existing binding");
+    }
