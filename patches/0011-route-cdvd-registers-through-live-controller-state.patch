diff --git a/ps2xIOP/tests/iop_cdvd_memory_tests.cpp b/ps2xIOP/tests/iop_cdvd_memory_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e9335540e80d82fc8bf942de1ace174764eafe0e
--- /dev/null
+++ b/ps2xIOP/tests/iop_cdvd_memory_tests.cpp
@@ -0,0 +1,213 @@
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_memory.h"
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+
+    class AuthoredRegisters final : public IopCdvdRegisters
+    {
+    public:
+        bool readCdvdRegister(uint32_t physical, uint8_t &value) override
+        {
+            ++reads;
+            lastAddress = physical;
+            addresses.push_back(physical);
+            if (physical < IopMemory::CdvdBase || physical >= IopMemory::CdvdEnd)
+                return false;
+            const size_t offset = physical - IopMemory::CdvdBase;
+            if (!supported[offset])
+                return false;
+            value = bytes[offset];
+            return true;
+        }
+
+        std::array<uint8_t, IopMemory::CdvdEnd - IopMemory::CdvdBase> bytes{};
+        std::array<bool, IopMemory::CdvdEnd - IopMemory::CdvdBase> supported{};
+        uint32_t reads = 0u;
+        uint32_t lastAddress = 0u;
+        std::vector<uint32_t> addresses;
+    };
+
+    void require(bool condition, std::string_view message)
+    {
+        if (!condition)
+            throw std::runtime_error(std::string(message));
+    }
+
+    template <typename Operation>
+    void rejects(Operation operation, std::string_view text)
+    {
+        try
+        {
+            operation();
+        }
+        catch (const std::runtime_error &error)
+        {
+            require(std::string_view(error.what()).find(text) != std::string_view::npos,
+                    "CDVD failure lost its operation/address diagnostic");
+            return;
+        }
+        throw std::runtime_error("unsupported CDVD access was silently accepted");
+    }
+
+    void aliasesAndWidths()
+    {
+        IopMemory memory;
+        auto registers = std::make_shared<AuthoredRegisters>();
+        registers->supported.fill(true);
+        for (size_t index = 0; index < registers->bytes.size(); ++index)
+            registers->bytes[index] = static_cast<uint8_t>(0x80u + index);
+        memory.bindCdvdRegisters(registers);
+
+        for (const uint32_t alias : {0u, 0x80000000u, 0xA0000000u})
+        {
+            const uint32_t base = alias | IopMemory::CdvdBase;
+            require(memory.isHardwareAddress(base) && memory.isHardwareAddress(base + 0x3Fu),
+                    "CDVD byte range is not recognized as hardware");
+            const uint32_t before = registers->reads;
+            require(memory.read8(base + 5u) == 0x85u && registers->reads == before + 1u &&
+                        registers->lastAddress == IopMemory::CdvdBase + 5u,
+                    "byte read touched adjacent registers or failed to normalize the alias");
+            require(memory.read16(base + 4u) == 0x8584u && memory.read16(base + 5u) == 0x8685u,
+                    "halfword reads did not assemble exact little-endian device bytes");
+            registers->addresses.clear();
+            (void)memory.read16(base + 5u);
+            require(registers->addresses == std::vector<uint32_t>{IopMemory::CdvdBase + 5u,
+                                                                  IopMemory::CdvdBase + 6u},
+                    "halfword register reads were not sequenced in address order");
+            require(memory.read32(base + 4u) == 0x87868584u && memory.read32(base + 5u) == 0x88878685u,
+                    "word reads bypassed the device or assembled bytes incorrectly");
+            for (const uint32_t offset : {4u, 5u})
+            {
+                registers->addresses.clear();
+                (void)memory.read32(base + offset);
+                const uint32_t first = IopMemory::CdvdBase + offset;
+                require(registers->addresses == std::vector<uint32_t>{first, first + 1u, first + 2u, first + 3u},
+                        "word register reads were not sequenced in address order");
+            }
+        }
+        registers->supported[4u] = false;
+        require(memory.read8(0xBF402005u) == 0x85u,
+                "valid byte read depended on the unsupported adjacent command port");
+        rejects([&] { (void)memory.read32(0xBF402004u); }, "0x1f402004");
+    }
+
+    void lifetimeAndStagedCommit()
+    {
+        IopMemory memory;
+        rejects([&] { (void)memory.read8(0xBF402005u); }, "without a live controller");
+        auto registers = std::make_shared<AuthoredRegisters>();
+        registers->supported[5u] = true;
+        registers->bytes[5u] = 0x40u;
+        memory.bindCdvdRegisters(registers);
+        IopMemory staged = memory;
+        staged.write32(0x1000u, 0x12345678u);
+        require(registers.use_count() == 1u, "RAM copy extended controller ownership");
+        memory = std::move(staged);
+        require(memory.read32(0x1000u) == 0x12345678u && memory.read8(0xBF402005u) == 0x40u,
+                "staged RAM commit lost its controller binding");
+        memory.reset();
+        require(memory.read32(0x1000u) == 0u && memory.read8(0xBF402005u) == 0x40u,
+                "RAM reset erased the device route or retained old RAM");
+        IopMemory survivingCopy = memory;
+        registers->bytes[5u] = 0x80u;
+        require(survivingCopy.read8(0xBF402005u) == 0x80u,
+                "copied RAM observes a stale register snapshot");
+        registers.reset();
+        rejects([&] { (void)memory.read8(0xBF402005u); }, "without a live controller");
+        rejects([&] { (void)survivingCopy.read8(0xBF402005u); }, "without a live controller");
+
+        auto replacement = std::make_shared<AuthoredRegisters>();
+        replacement->supported[5u] = true;
+        replacement->bytes[5u] = 0x41u;
+        memory.bindCdvdRegisters(replacement);
+        require(memory.read8(0xBF402005u) == 0x41u, "replacement controller was not bound");
+        rejects([&] { (void)survivingCopy.read8(0xBF402005u); }, "without a live controller");
+    }
+
+    void unsupportedWritesAreAtomic()
+    {
+        IopMemory memory;
+        auto registers = std::make_shared<AuthoredRegisters>();
+        registers->supported.fill(true);
+        registers->bytes[5u] = 0x40u;
+        memory.bindCdvdRegisters(registers);
+        memory.write32(IopMemory::CdvdBase - 4u, 0x12345678u);
+        memory.write32(IopMemory::CdvdEnd, 0x89ABCDEFu);
+        rejects([&] { memory.write8(0xBF402005u, 0u); }, "write");
+        rejects([&] { memory.write16(0x9F402004u, 0u); }, "write");
+        rejects([&] { memory.write32(0x1F402004u, 0u); }, "write");
+        rejects([&] { memory.write16(IopMemory::CdvdBase - 1u, 0u); }, "write");
+        rejects([&] { memory.write32(IopMemory::CdvdBase - 2u, 0u); }, "write");
+        rejects([&] { memory.write32(IopMemory::CdvdEnd - 1u, 0u); }, "write");
+        require(registers->reads == 0u && registers->bytes[5u] == 0x40u &&
+                    memory.read32(IopMemory::CdvdBase - 4u) == 0x12345678u &&
+                    memory.read32(IopMemory::CdvdEnd) == 0x89ABCDEFu,
+                "unsupported write read a device port or partially modified adjacent storage");
+    }
+
+    void authoredCpuPoll()
+    {
+        IopMemory memory;
+        auto registers = std::make_shared<AuthoredRegisters>();
+        registers->supported[5u] = true;
+        registers->bytes[5u] = 0x80u;
+        memory.bindCdvdRegisters(registers);
+        // Authored MIPS poll: the busy device loops, then an actual LBU observes
+        // the changed register and reaches the result instruction. The load and
+        // branch delay slots are intentionally present.
+        constexpr uint32_t code[] = {
+            0x3C08BF40u, // lui t0, 0xbf40
+            0x35082005u, // ori t0, t0, 0x2005
+            0x91090000u, // lbu t1, 0(t0)
+            0x00000000u, // nop
+            0x312900C0u, // andi t1, t1, 0xc0
+            0x240A0040u, // addiu t2, zero, 0x40
+            0x152AFFFBu, // bne t1, t2, poll
+            0x00000000u, // nop
+            0x34021234u, // ori v0, zero, 0x1234
+        };
+        require(memory.writeRam(0x1000u, code, sizeof(code)), "could not install authored code");
+        IopCpuCore core(memory);
+        IopCpuState cpu{};
+        cpu.pc = 0x1000u;
+        for (uint32_t instruction = 0; instruction < 32u; ++instruction)
+            require(core.executeInstruction(cpu) && !cpu.exception, "authored busy poll trapped");
+        require(cpu.gpr[2u] == 0u && registers->reads >= 4u,
+                "busy controller did not hold the original-style CPU poll");
+        registers->bytes[5u] = 0x40u;
+        for (uint32_t instruction = 0; instruction < 16u && cpu.gpr[2u] == 0u; ++instruction)
+            require(core.executeInstruction(cpu) && !cpu.exception, "authored ready poll trapped");
+        require(cpu.gpr[2u] == 0x1234u && cpu.pc == 0x1024u,
+                "CPU byte loads did not observe the live controller state");
+    }
+}
+
+int main()
+{
+    try
+    {
+        aliasesAndWidths();
+        lifetimeAndStagedCommit();
+        unsupportedWritesAreAtomic();
+        authoredCpuPoll();
+        std::cout << "ps2xIOP CDVD memory tests passed (4 groups)\n";
+        return 0;
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "FAIL: " << error.what() << '\n';
+        return 1;
+    }
+}
