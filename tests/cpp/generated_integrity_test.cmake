if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Test paths are required")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/synthetic.cpp" "void synthetic() {}\n")
file(WRITE "${TEST_DIR}/synthetic.h" "void synthetic();\n")
file(SHA256 "${TEST_DIR}/synthetic.cpp" source_hash)
file(SHA256 "${TEST_DIR}/synthetic.h" header_hash)
file(WRITE "${TEST_DIR}/sources.sha256" "${source_hash}  synthetic.cpp\n${header_hash}  synthetic.h\n")
file(SHA256 "${TEST_DIR}/sources.sha256" manifest_hash)
function(check_manifest should_pass)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DGENERATED_DIR=${TEST_DIR}"
        "-DEXPECTED_MANIFEST_SHA256=${manifest_hash}"
        -P "${PROJECT_ROOT}/cmake/VerifyGenerated.cmake"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(should_pass AND NOT status EQUAL 0)
        message(FATAL_ERROR "Valid synthetic source manifest was rejected")
    elseif(NOT should_pass AND status EQUAL 0)
        message(FATAL_ERROR "Modified/incomplete synthetic source manifest was accepted")
    endif()
endfunction()
check_manifest(TRUE)
file(APPEND "${TEST_DIR}/synthetic.cpp" "void unrecorded() {}\n")
check_manifest(FALSE)
file(WRITE "${TEST_DIR}/synthetic.cpp" "void synthetic() {}\n")
file(WRITE "${TEST_DIR}/extra.h" "void extra();\n")
check_manifest(FALSE)
file(REMOVE "${TEST_DIR}/extra.h")
file(REMOVE "${TEST_DIR}/synthetic.h")
check_manifest(FALSE)
file(REMOVE_RECURSE "${TEST_DIR}")
